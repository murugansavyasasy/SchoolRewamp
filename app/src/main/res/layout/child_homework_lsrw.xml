<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ten"
        android:background="@color/PrimaryColor" />

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/statusBarBackground"
        />

    <ScrollView
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbarLayout"
        android:fillViewport="true"
        android:overScrollMode="never">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/header_label"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentTop="true"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/ten"
                android:text="@string/task_details"
                android:textColor="@color/mild_grey_dark"
                android:textSize="@dimen/fifteen_sp" />

            <RelativeLayout
                android:id="@+id/headerrelative_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/header_label"
                android:background="@drawable/rect_shadow_white"
                android:padding="@dimen/twenty">

                <LinearLayout
                    android:id="@+id/iconContainer"
                    android:layout_width="@dimen/fourty_eight"
                    android:layout_height="@dimen/fourty_eight"
                    android:layout_alignParentStart="true"
                    android:layout_marginEnd="@dimen/twele"
                    android:background="@drawable/bg_icon_round_lightyellow"
                    android:gravity="center"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/imgIcon"
                        android:layout_width="@dimen/twenty_eight"
                        android:layout_height="@dimen/twenty_eight"
                        android:contentDescription="icon"
                        android:src="@drawable/booksvgformatstyle" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/titleContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/iconContainer"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/txtTitle"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="ENGLISH"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/sixteen_sp" />

                    <TextView
                        android:id="@+id/txtSubTitle"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Speaking"
                        android:textColor="@color/bright_Blue_2"
                        android:textSize="@dimen/fourteen_sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/txtDescription"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/iconContainer"
                    android:layout_marginTop="@dimen/four"
                    android:layout_marginEnd="@dimen/twenty"
                    android:ellipsize="end"
                    android:maxLines="4"
                    android:text="The Only Way I"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp" />

                <TextView
                    android:id="@+id/txtDescription1"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/txtDescription"
                    android:layout_marginTop="@dimen/four"
                    android:layout_marginEnd="@dimen/twenty"
                    android:text="The First Time the two"
                    android:textColor="@color/light_gray_3"
                    android:textSize="@dimen/thirteen_sp" />

                <LinearLayout
                    android:id="@+id/attachments_container"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/txtDescription1"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/fifteen"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/imgAttachmentIcon"
                        android:layout_width="@dimen/twenty"
                        android:layout_height="@dimen/twenty"
                        android:src="@drawable/ic_attach_file" />

                    <TextView
                        android:id="@+id/lblAttachments"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/eight"
                        android:text="@string/attachments"
                        android:textSize="@dimen/eighteen_sp" />
                </LinearLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcSeekBarAndTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/attachments_container"
                    android:layout_marginStart="@dimen/five"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/five"
                    android:visibility="gone" />

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcChildHW"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rcSeekBarAndTitle"
                    android:layout_marginStart="@dimen/five"
                    android:layout_marginTop="0dp"
                    android:layout_marginEnd="@dimen/five"
                    android:layout_marginBottom="@dimen/ten" />

                <LinearLayout
                    android:id="@+id/bottomRow"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/rcChildHW"
                    android:layout_marginStart="@dimen/five"
                    android:layout_marginTop="@dimen/eight"
                    android:layout_marginBottom="@dimen/five"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <ImageView
                        android:layout_width="@dimen/sixteen"
                        android:layout_height="@dimen/sixteen"
                        android:layout_marginEnd="@dimen/four"
                        android:contentDescription="date"
                        android:src="@drawable/calendersvgformatstyle" />

                    <TextView
                        android:id="@+id/txtDate"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="09 August, 2025"
                        android:textColor="@color/pale_light_gray_7"
                        android:textSize="@dimen/twele_sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />

                    <TextView
                        android:id="@+id/lblviewSubmissions"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/bg_purple_circle"
                        android:padding="@dimen/ten"
                        android:text="@string/my_submission"
                        android:textColor="@color/white"
                        android:textSize="@dimen/twele_sp"
                        android:visibility="gone" />

                </LinearLayout>
            </RelativeLayout>

            <TextView
                android:id="@+id/attachment_label"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/headerrelative_layout"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/ten"
                android:text="@string/add_attachments"
                android:visibility="gone"
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp" />

            <TextView
                android:id="@+id/lblStar9"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/two"
                android:layout_below="@+id/headerrelative_layout"
                android:layout_toEndOf="@id/attachment_label"
                android:text="@string/mandatory"
                android:visibility="gone"
                android:textColor="@color/red" />

            <RelativeLayout
                android:id="@+id/rytRecyclewview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/attachment_label"
                android:visibility="gone">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcyImages"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:nestedScrollingEnabled="false"
                    android:overScrollMode="never"
                    android:layout_marginTop="@dimen/ten"/>


            </RelativeLayout>

            <TextView
                android:id="@+id/description_label"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rytRecyclewview"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/ten"
                android:visibility="gone"
                android:text="@string/add_description"
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp" />

            <TextView
                android:id="@+id/lblStar8"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/two"
                android:layout_below="@+id/rytRecyclewview"
                android:layout_toEndOf="@id/description_label"
                android:text="@string/mandatory"
                android:visibility="gone"
                android:textColor="@color/red" />


            <EditText
                android:id="@+id/edit_description"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/description_label"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/six"
                android:layout_marginEnd="@dimen/ten"
                android:layout_marginBottom="@dimen/ten"
                android:background="@drawable/bg_edittext_rounded"
                android:hint="@string/description2"
                android:visibility="gone"
                android:padding="@dimen/twele"
                android:textSize="@dimen/fifteen_sp" />

            <Button
                android:id="@+id/btnSubmit"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/edit_description"
                android:background="@drawable/rect_shadow_light_primary"
                android:text="@string/submit"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginEnd="@dimen/ten"
                android:textColor="@color/white"
                android:textSize="@dimen/fourteen_sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/footer_label"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/btnSubmit"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/ten"
                android:text="@string/submitted_students"
                android:textColor="@color/mild_grey_dark"
                android:textSize="@dimen/fifteen_sp" />

            <FrameLayout
                android:id="@+id/lsrwgragmentcontainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/footer_label"
                android:visibility="visible" />
        </RelativeLayout>
    </ScrollView>

</RelativeLayout>