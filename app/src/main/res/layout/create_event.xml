<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar" />


    <LinearLayout
        android:layout_marginTop="@dimen/ten"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:layout_below="@+id/toolbarLayout"
        android:id="@+id/toolbarLayout1"
        android:weightSum="1"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/lnrTabOneName"
            android:layout_weight="0.5"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:gravity="center"
                android:text="Create"
                android:id="@+id/tabOneName"
                android:textColor="@color/iconBlue"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
            </TextView>
            <View
                android:id="@+id/line1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/three"
                android:layout_below="@+id/groupheading"
                android:layout_marginTop="@dimen/five"
                android:background="@color/iconBlue">
            </View>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/lnrTabTwoName"
            android:layout_weight="0.5"
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:gravity="center"
                android:text="Report"
                style="@style/CustomTextStylePoppinsBold"
                android:id="@+id/tabTwoName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
            </TextView>
            <View
                android:id="@+id/line2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/three"
                android:layout_below="@+id/groupheading"
                android:layout_marginTop="@dimen/five"
                android:background="@color/gray_color">
            </View>
        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:id="@+id/eventCreate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbarLayout1"
        android:scrollbars="none"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/toolbarLayout">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:padding="@dimen/ten">


            <TextView
                android:id="@+id/lblLocation"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_marginTop="5dp"
                android:text="@string/Venue"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />

            <TextView
                android:id="@+id/lblStar"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/lblLocation"
                android:text="@string/mandatory"
                android:textColor="@color/red"
                android:textSize="@dimen/thirteen_sp" />


            <EditText
                android:id="@+id/txtLocation"
                style="@style/CustomTextStylePoppinsRegular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblLocation"
                android:layout_alignStart="@+id/lblLocation"
                android:layout_marginTop="@dimen/fifteen"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_edittext_view_line"
                android:inputType="text"
                android:paddingBottom="@dimen/ten"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />

            <ImageView
                android:layout_width="@dimen/twenty"
                android:layout_height="@dimen/twenty"
                android:layout_below="@+id/lblLocation"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_location" />


            <TextView
                android:id="@+id/lblEventTitle"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtLocation"
                android:layout_alignStart="@+id/txtLocation"
                android:layout_marginTop="@dimen/fifteen"
                android:text="@string/Title"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />

            <TextView
                android:id="@+id/lblStar1"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtLocation"
                android:layout_marginTop="@dimen/ten"
                android:layout_toEndOf="@id/lblEventTitle"
                android:text="@string/mandatory"
                android:textColor="@color/red"
                android:textSize="@dimen/thirteen_sp" />

            <EditText
                android:id="@+id/txtTitle"
                style="@style/CustomTextStylePoppinsRegular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblEventTitle"
                android:layout_alignStart="@+id/lblEventTitle"
                android:layout_alignEnd="@+id/txtLocation"
                android:layout_marginTop="@dimen/fifteen"
                android:background="@drawable/bg_edittext_view_line"
                android:inputType="text"
                android:paddingBottom="@dimen/ten"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />

            <TextView
                android:id="@+id/lbtitleTextCount"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtTitle"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="15dp"
                android:text="0 of 50"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />

            <TextView
                android:id="@+id/lblEventDesc"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lbtitleTextCount"
                android:layout_alignStart="@+id/txtTitle"
                android:layout_marginTop="@dimen/fifteen"
                android:text="@string/Description"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />


            <TextView
                android:id="@+id/lblStar3"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lbtitleTextCount"
                android:layout_marginTop="@dimen/ten"
                android:layout_toEndOf="@id/lblEventDesc"
                android:text="@string/mandatory"
                android:textColor="@color/red"
                android:textSize="@dimen/thirteen_sp" />


            <RelativeLayout
                android:id="@+id/rytDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblEventDesc"
                android:layout_alignStart="@+id/lblEventDesc">


                <EditText
                    android:id="@+id/txtDesc"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hundred"
                    android:layout_marginTop="@dimen/ten"
                    android:background="@drawable/bg_stroke_rect_black"
                    android:editable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="start"
                    android:hint="@string/Description"
                    android:maxLength="500"
                    android:padding="@dimen/ten"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp">

                </EditText>


            </RelativeLayout>

            <TextView
                android:id="@+id/lbTextCount"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rytDesc"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="15dp"
                android:text="@string/_0_of_500"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rytDesc"
                android:layout_alignStart="@+id/rytDesc"
                android:layout_marginTop="@dimen/fifteen">


                <RelativeLayout
                    android:id="@+id/rytEventDateTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp">


                    <TextView
                        android:id="@+id/lblStart"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ten"
                        android:text="Starts on"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp" />

                    <TextView
                        android:id="@+id/lblStar4"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/five"
                        android:layout_toEndOf="@id/lblStart"
                        android:text="@string/mandatory"
                        android:textColor="@color/red"
                        android:textSize="@dimen/thirteen_sp" />


                    <RelativeLayout
                        android:id="@+id/rytStart"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@+id/lblStart"
                        android:layout_marginTop="@dimen/ten"
                        android:layout_marginEnd="10dp">

                        <RelativeLayout
                            android:id="@+id/rytStartDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">


                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardStart"
                                android:layout_width="@dimen/sixty"
                                android:layout_height="@dimen/sixty"
                                app:cardCornerRadius="@dimen/ten">

                                <LinearLayout
                                    android:id="@+id/lnrStartCalendar"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_stroke_rect_black"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/lblDay"
                                        style="@style/CustomTextStylePoppinsBold"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_horizontal"
                                        android:layout_marginTop="@dimen/five"
                                        android:text="Fri"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/fifteen_sp" />

                                    <TextView
                                        android:id="@+id/lblDate"
                                        style="@style/CustomTextStylePoppinsBold"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@color/primary_light"
                                        android:gravity="center"
                                        android:text="12"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/fifteen_sp" />

                                </LinearLayout>
                            </androidx.cardview.widget.CardView>


                            <ImageView
                                android:id="@+id/imgDateDown"
                                android:layout_width="@dimen/twenty"
                                android:layout_height="@dimen/twenty"
                                android:layout_centerVertical="true"
                                android:layout_toEndOf="@+id/cardStart"
                                android:src="@drawable/ic_down_arrow" />


                            <TextView
                                android:id="@+id/txtStartDate"
                                style="@style/CustomTextStylePoppinsRegular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="@dimen/five"
                                android:layout_marginTop="@dimen/ten"
                                android:layout_toEndOf="@+id/imgDateDown"
                                android:text=""
                                android:textColor="@color/black"
                                android:textSize="@dimen/thirteen_sp" />

                        </RelativeLayout>

                        <RelativeLayout
                            android:id="@+id/rytStartTime"
                            android:layout_toEndOf="@id/rytStartDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true">

                            <ImageView
                                android:id="@+id/imgTimeDown"
                                android:layout_width="@dimen/twenty"
                                android:layout_height="@dimen/twenty"
                                android:layout_centerVertical="true"
                                android:layout_toStartOf="@+id/txtStartTime"
                                android:src="@drawable/ic_down_arrow" />

                            <TextView
                                android:id="@+id/txtStartTime"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text=""
                                android:textColor="@color/black"
                                android:textSize="@dimen/thirteen_sp" />

                        </RelativeLayout>


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/one"
                            android:layout_alignParentBottom="true"
                            android:layout_marginStart="@dimen/sixty"
                            android:background="@color/grey" />

                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rlaFilePicking"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@+id/rytStart"
                        android:layout_marginTop="@dimen/five">

                        <TextView
                            android:id="@+id/lblAddPhoto"
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ten"
                            android:text="Add Attachment"
                            android:textColor="@color/black"
                            android:textSize="@dimen/thirteen_sp">

                        </TextView>

                        <TextView
                            android:id="@+id/lblOptional"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="8dp"
                            android:layout_marginTop="@dimen/ten"
                            android:layout_toEndOf="@+id/lblAddPhoto"
                            android:text="@string/Optional"
                            android:textColor="@color/mild_grey1"
                            android:textSize="@dimen/thirteen_sp">

                        </TextView>

                        <ImageView
                            android:layout_width="@dimen/twenty_five"
                            android:layout_height="@dimen/twenty_five"
                            android:layout_alignParentEnd="true"
                            android:layout_marginTop="@dimen/ten"
                            android:src="@drawable/ic_attach_file">

                        </ImageView>

                        <RelativeLayout
                            android:id="@+id/rytRecyclewview"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/lblAddPhoto">

                            <androidx.recyclerview.widget.RecyclerView
                                android:id="@+id/rcyImages"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ten"
                                android:orientation="vertical">

                            </androidx.recyclerview.widget.RecyclerView>

                            <VideoView
                                android:id="@+id/videoView"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/one_eighty"
                                android:layout_marginStart="@dimen/twenty"
                                android:layout_marginTop="@dimen/thirty"
                                android:layout_marginEnd="@dimen/twenty"
                                android:visibility="gone">

                            </VideoView>


                            <ImageView
                                android:id="@+id/thumbnailView"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/one_eighty"
                                android:layout_marginStart="@dimen/twenty"
                                android:layout_marginTop="@dimen/twenty_five"
                                android:layout_marginEnd="@dimen/twenty"
                                android:scaleType="centerCrop"
                                android:visibility="gone" />

                            <ImageView
                                android:id="@+id/imgDelete"
                                android:layout_width="@dimen/twenty_five"
                                android:layout_height="@dimen/twenty_five"
                                android:layout_alignParentEnd="true"
                                android:layout_marginStart="@dimen/twenty"
                                android:layout_marginTop="@dimen/twenty_five"
                                android:layout_marginEnd="@dimen/twenty"
                                android:background="@drawable/white_circle_bg"
                                android:padding="@dimen/five"
                                android:src="@drawable/del_icon"
                                android:visibility="gone">

                            </ImageView>

                            <ImageView
                                android:id="@+id/imgPlay"
                                android:layout_width="@dimen/fifty"
                                android:layout_height="@dimen/fifty"
                                android:layout_centerInParent="true"
                                android:src="@drawable/video_play"
                                android:visibility="gone">

                            </ImageView>

                        </RelativeLayout>


                        <TextView
                            android:id="@+id/btnNext"
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@id/rytRecyclewview"
                            android:layout_marginStart="@dimen/twenty_five"
                            android:layout_marginTop="@dimen/fifty"
                            android:layout_marginBottom="@dimen/thirty"
                            android:layout_marginEnd="@dimen/twenty_five"
                            android:background="@drawable/rect_btn_orange"
                            android:gravity="center"
                            android:padding="@dimen/ten"
                            android:text="@string/NEXT"
                            android:textColor="@color/white"
                            android:textSize="@dimen/thirteen_sp">

                        </TextView>
                    </RelativeLayout>
                </RelativeLayout>
            </RelativeLayout>
        </RelativeLayout>
    </ScrollView>


    <ScrollView
        android:id="@+id/scroll_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:visibility="gone"
        android:layout_below="@id/toolbarLayout1"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/headerview"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="Ongoing Events"
                android:textColor="@color/black"
                android:textSize="18sp" />




            <RelativeLayout
                android:id="@+id/rytSearch1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/thirty_five"
                android:layout_below="@id/headerview"
                android:layout_marginStart="15dp"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="15dp"
                android:background="@drawable/rect_grey"
                android:visibility="gone">


                <ImageView
                    android:id="@+id/imgSearch1"
                    android:layout_width="@dimen/thirty"
                    android:layout_height="@dimen/thirty"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/ten"
                    android:src="@drawable/ic_search_grey" />

                <EditText
                    android:id="@+id/txtVideoMenu"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/imgSearch1"
                    android:background="@android:color/transparent"
                    android:hint="@string/lblSearch"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp" />
            </RelativeLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcyongoingevent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:fadeScrollbars="false"
                android:layout_marginTop="5dp"
                android:layout_below="@+id/rytSearch1"
                android:paddingHorizontal="10dp"
                android:scrollbars="none" />


            <ImageView
                android:id="@+id/dotindicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rcyongoingevent"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="20dp"
                android:src="@drawable/dotindicator" />





            <TextView
                android:id="@+id/upcomingevent_headerview"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/dotindicator"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="Upcoming Events"
                android:textColor="@color/black"
                android:textSize="18sp" />


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcyupcomingevent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:fadeScrollbars="false"
                android:layout_marginTop="5dp"
                android:layout_below="@+id/upcomingevent_headerview"
                android:paddingHorizontal="10dp"
                android:scrollbars="none" />



            <TextView
                android:id="@+id/completedevent_headerview"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rcyupcomingevent"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="Completed Events"
                android:textColor="@color/black"
                android:textSize="18sp" />


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcycompletedevent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:fadeScrollbars="false"
                android:layout_marginTop="5dp"
                android:layout_below="@+id/completedevent_headerview"
                android:paddingHorizontal="10dp"
                android:scrollbars="none" />


        </RelativeLayout>
    </ScrollView>


</RelativeLayout>