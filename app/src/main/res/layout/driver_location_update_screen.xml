<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:map="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="#F9F9F9">

    <!-- Google Map -->
    <fragment
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/four_hundred" />

    <!-- Driver Info Card -->
    <LinearLayout
        android:id="@+id/driverInfoCard"
        android:layout_below="@id/mapView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/sixteen"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:color/white"
        android:elevation="@dimen/four"
        android:layout_marginTop="@dimen/eight">

        <ImageView
            android:id="@+id/driverImage"
            android:layout_width="@dimen/fifty_six"
            android:layout_height="@dimen/fifty_six"
            android:src="@drawable/profile"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_background"
            android:padding="@dimen/four" />

        <LinearLayout
            android:layout_width="@dimen/zero"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/twele"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/driverName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Doe"
                android:textStyle="bold"
                android:textSize="@dimen/sixteen_sp"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/driverStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/online_location_updating"
                android:textSize="@dimen/fourteen_sp"
                android:textColor="#4CAF50" />
        </LinearLayout>

        <Button
            android:id="@+id/btnToggleStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/go_offline"
            android:backgroundTint="#2196F3"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- Last updated time -->
    <TextView
        android:id="@+id/lastUpdatedText"
        android:layout_below="@id/driverInfoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Last updated: 2:58 PM"
        android:padding="12dp"
        android:textColor="#888888"
        android:textSize="14sp"
        android:gravity="center" />

</RelativeLayout>