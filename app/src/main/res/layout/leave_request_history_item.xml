<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginHorizontal="4dp"
    android:layout_marginVertical="@dimen/ten"
    android:elevation="5dp"
    app:cardUseCompatPadding="true"
    android:padding="@dimen/ten">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


    <RelativeLayout
        android:id="@+id/rytCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="8dp"
        android:elevation="2dp"
        android:padding="@dimen/five">

        <LinearLayout
            android:id="@+id/lnrDateCircle"
            android:layout_width="@dimen/fifty"
            android:layout_height="@dimen/fifty"
            android:layout_alignParentStart="true"
            android:layout_marginStart="@dimen/five"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_light_blue_circle"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textFirstLetter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="A"
                android:textColor="#000000"
                android:textSize="@dimen/twele_sp" />

        </LinearLayout>


        <LinearLayout
            android:id="@+id/lnrDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_toStartOf="@+id/lnrButtons"
            android:layout_toEndOf="@+id/lnrDateCircle"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/textName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Alex Smith"
                android:textColor="#000"
                android:textSize="@dimen/thirteen_sp"
                style="@style/CustomTextStylePoppinsBold" />

            <TextView
                android:id="@+id/textDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/five"
                android:text="15 - 22 Jun 2023"
                style="@style/CustomTextStylePoppinsMedium"
                android:textColor="@color/grey"
                android:textSize="@dimen/thirteen_sp" />

            <TextView
                android:id="@+id/textNoOfDays"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/five"
                android:text="3 Days"
                style="@style/CustomTextStylePoppinsMedium"

                android:textColor="@color/grey"
                android:textSize="@dimen/thirteen_sp" />



        </LinearLayout>


        <LinearLayout
            android:id="@+id/lnrButtons"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:gravity="center"
            android:visibility="visible"
            android:layout_marginEnd="@dimen/five"
            android:orientation="horizontal">

            <RelativeLayout
                android:id="@+id/relbuttons"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:background="@drawable/rect_shadow_white_2"
                android:visibility="gone"
                android:layout_marginEnd="@dimen/five"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/deletebutton"
                    android:layout_width="@dimen/eighty"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="10dp"
                    android:layout_marginStart="10dp"
                    android:gravity="center_vertical"
                    android:layout_alignParentTop="true"
                    android:layout_centerHorizontal="true">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/del_icon"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Delete"
                        android:textAlignment="center"
                        android:textColor="@color/black"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:textSize="15sp" />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/editbutton"
                    android:layout_width="@dimen/eighty"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_below="@id/deletebutton"
                    android:layout_alignStart="@id/deletebutton"
                    android:layout_marginTop="8dp"
                    android:layout_marginBottom="10dp"
                    android:layout_marginStart="10dp"
                    android:gravity="center_vertical">

                    <ImageView
                        android:layout_width="16dp"
                        android:layout_height="16dp"
                        android:src="@drawable/edit_icon"
                        android:layout_marginEnd="6dp" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Edit"
                        android:textAlignment="center"
                        android:textColor="@color/black"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:textSize="15sp" />
                </LinearLayout>
            </RelativeLayout>


            <TextView
                android:id="@+id/btnApprove"
                android:layout_width="@dimen/eighty"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_leave_approved"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="Approve"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="12sp"
                style="@style/CustomTextStylePoppinsMedium"/>

            <ImageView
                android:id="@+id/options"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:visibility="visible"
                android:src="@drawable/threedot" />
        </LinearLayout>


        <TextView
            android:layout_below="@+id/lnrDetails"
            android:layout_marginBottom="@dimen/ten"
            android:id="@+id/textReason"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Casual"
            android:layout_marginTop="7dp"
            android:layout_marginStart="@dimen/eighty"
            style="@style/CustomTextStylePoppinsMedium"
            android:textColor="@color/black"
            android:textSize="@dimen/thirteen_sp" />

    </RelativeLayout>


    </RelativeLayout>

</androidx.cardview.widget.CardView>