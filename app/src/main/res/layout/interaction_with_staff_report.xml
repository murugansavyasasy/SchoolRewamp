<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/relative_layout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/ten"
    android:background="@drawable/rect_white"
    android:padding="@dimen/ten">


    <TextView
        android:id="@+id/lblLogo"
        android:layout_width="@dimen/fifty"
        android:layout_height="@dimen/fifty"
        android:gravity="center"
        android:text="SA"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        android:textColor="@color/white"
        android:textSize="@dimen/sixteen_sp"
        style="@style/CustomTextStylePoppinsBold"
        android:background="@drawable/circle_bg_violet" />


    <RelativeLayout
        android:layout_centerVertical="true"
        android:id="@+id/rytHeader"
        android:layout_toEndOf="@id/lblLogo"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


    <RelativeLayout
        android:layout_alignParentStart="true"
        android:id="@+id/rytDetails"
        android:layout_marginStart="@dimen/ten"
        android:layout_centerVertical="true"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/nameheader"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Saran Raj"
            android:textColor="@color/black" />

        <TextView
            android:id="@+id/subjectheader"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/nameheader"
            android:layout_marginTop="@dimen/eight"
            android:text="TAMIL"
            android:textColor="@color/PrimaryColor" />

        <TextView
            android:layout_marginTop="@dimen/eight"
            android:id="@+id/lblDesc"
            android:layout_below="@id/subjectheader"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textSize="@dimen/twele_sp"
            android:text="A common messages"
            android:textColor="@color/grey" />

    </RelativeLayout>


        <RelativeLayout
            android:layout_alignParentEnd="true"
            android:id="@+id/rytUnread"
            android:layout_centerVertical="true"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">


            <TextView
                android:id="@+id/yesterdayheader"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="@dimen/ten"
                android:text="Yesterday"
                android:textColor="@color/Emerald1" />


            <TextView
                android:id="@+id/unreadcount"
                android:layout_width="@dimen/fourty"
                android:layout_height="@dimen/fourty"
                android:layout_below="@+id/yesterdayheader"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/ten"
                android:background="@drawable/circle_bg_red"
                android:gravity="center"
                android:scaleType="centerCrop"
                android:text="1"
                android:textColor="@color/white" />

        </RelativeLayout>

    </RelativeLayout>






    <View
        android:id="@+id/viewline"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/rytHeader"
        android:layout_marginTop="@dimen/twenty"
        android:background="@color/light_white_4"
        android:visibility="visible" />


</RelativeLayout>




