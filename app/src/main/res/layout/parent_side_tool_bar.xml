<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/rytHeader"
        android:background="@drawable/bg_header_rounded"
        android:paddingTop="@dimen/twenty"
        android:paddingBottom="@dimen/fifteen"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >
            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="@dimen/thirty_five"
                android:layout_centerVertical="true"
                android:layout_marginTop="@dimen/fifteen"
                android:layout_height="@dimen/thirty_five"
                android:src="@drawable/arrow_left_white">
            </ImageView>

            <TextView
                android:id="@+id/lblParentToolBar"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/rlaStudentName"
                android:layout_toEndOf="@+id/imgBack"
                android:text=""
                android:visibility="gone"
                android:textColor="@color/white"
                android:textSize="@dimen/fifteen_sp">

            </TextView>

            <LinearLayout
                android:layout_marginTop="@dimen/twenty"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/imgSearchToolBar"
                android:id="@+id/rlaStudentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@id/imgBack"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblStudentName"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="@dimen/fifteen_sp"
                    >

                </TextView>

                <TextView
                    android:id="@+id/lblStudentSection"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="@dimen/eleven_sp"
                    android:textColor="@color/white">

                </TextView>

                <TextView
                    android:id="@+id/lblSubjectName"
                    android:visibility="gone"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:textColor="@color/white"
                    android:text=""
                    android:layout_marginEnd="@dimen/five"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                </TextView>

            </LinearLayout>

<!--            <TextView-->
<!--                android:id="@+id/lblSubjectName"-->
<!--                android:visibility="gone"-->
<!--                style="@style/CustomTextStylePoppinsMedium"-->
<!--                android:textColor="@color/white"-->
<!--                android:text="ahcbakdbcakdjbcakjdbcakdakd"-->
<!--                android:layout_below="@+id/rlaStudentName"-->
<!--                android:layout_toStartOf="@+id/imgSearchToolBar"-->
<!--                android:layout_toEndOf="@id/imgBack"-->
<!--                android:layout_marginEnd="@dimen/five"-->
<!--                android:layout_width="wrap_content"-->
<!--                android:layout_height="wrap_content">-->

<!--            </TextView>-->

            <TextView
                android:id="@+id/lblPostedOn"
                android:layout_centerVertical="true"
                android:visibility="gone"
                style="@style/CustomTextStylePoppinsMedium"
                android:textColor="@color/white"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/five"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

            </TextView>

            <ImageView
                android:layout_centerVertical="true"
                android:id="@+id/imgSearchToolBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/ten"
                android:padding="@dimen/five"
                android:src="@drawable/search_icon_white"
                android:visibility="gone" />
        </RelativeLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/lnrParent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rytHeader"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="@dimen/ten"
        android:layout_marginTop="0dp"
        android:background="@drawable/bg_light_green"
        android:visibility="gone">

        <TextView
            android:id="@+id/lblRightSideBar"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_weight="1"
            android:background="@drawable/white_radious"
            android:gravity="center"
            android:text=""
            android:textColor="@color/white"
            android:textSize="@dimen/thirteen_sp"
            android:layout_marginTop="@dimen/two"
            android:layout_marginBottom="@dimen/two"
            android:layout_marginStart="@dimen/two"
            android:padding="@dimen/eight"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblLeftSideBar"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:text=""
            android:textColor="@color/white"
            android:textSize="@dimen/thirteen_sp"
            android:layout_marginTop="@dimen/two"
            android:layout_marginBottom="@dimen/two"
            android:layout_marginEnd="@dimen/two"
            android:padding="@dimen/eight"
            android:textStyle="bold" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/rytSearch"
        android:layout_width="match_parent"
        android:layout_height="@dimen/thirty_five"
        android:layout_below="@id/lnrParent"
        android:layout_marginTop="@dimen/fifteen"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:background="@drawable/rect_grey"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgSearch"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/ten"
            android:src="@drawable/ic_search" />

        <EditText
            android:id="@+id/txtVideoMenu"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toEndOf="@id/imgSearch"
            android:background="@android:color/transparent"
            android:hint="@string/lblSearch"
            android:maxLines="1"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:scrollHorizontally="true"
            android:textColor="@color/black"
            android:textSize="@dimen/thirteen_sp" />
    </RelativeLayout>

</RelativeLayout>

