<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/rytHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_rounded"
        android:paddingTop="@dimen/twenty"
        android:paddingBottom="@dimen/fifteen">

        <RelativeLayout
            android:id="@+id/rlaHeaderTab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_alignParentStart="true"
                android:id="@+id/imgBack"
                android:layout_width="@dimen/thirty_five"
                android:layout_height="@dimen/thirty_five"
                android:layout_centerVertical="true"
                android:layout_marginTop="@dimen/fifteen"
                android:src="@drawable/arrow_left_white">

            </ImageView>

        </RelativeLayout>
        <LinearLayout
            android:layout_below="@+id/rlaHeaderTab"
            android:orientation="vertical"
            android:id="@+id/lnrStaffDetailContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:layout_width="wrap_content"
                android:text="SA"
                android:id="@+id/lblStaffInitial"
                android:background="@drawable/primary_rect_square"
                android:layout_gravity="center"
                android:textSize="@dimen/sixteen_sp"
                style="@style/CustomTextStylePoppinsBold"
                android:textColor="@color/white"
                android:paddingHorizontal="@dimen/twenty_five"
                android:paddingVertical="@dimen/twenty_five"
                android:layout_height="wrap_content">

            </TextView>

            <TextView
                android:layout_marginTop="@dimen/six"
                android:layout_width="wrap_content"
                android:text="SARAN RAJ"
                android:id="@+id/lblName"
                android:layout_gravity="center"
                style="@style/CustomTextStylePoppinsBold"
                android:textSize="@dimen/sixteen_sp"
                android:textColor="@color/white"
                android:layout_height="wrap_content">

            </TextView>

            <TextView
                android:layout_marginTop="@dimen/three"
                android:layout_width="wrap_content"
                android:text="English"
                android:id="@+id/lblSubject"
                android:layout_gravity="center"
                style="@style/CustomTextStylePoppinsBold"
                android:textSize="@dimen/thirteen_sp"
                android:textColor="@color/white"
                android:layout_height="wrap_content">

            </TextView>

        </LinearLayout>


    </RelativeLayout>

</RelativeLayout>

