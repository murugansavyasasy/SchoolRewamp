<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/loader_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000">

    <androidx.cardview.widget.CardView
        android:id="@+id/card_loader"
        android:layout_width="@dimen/hundred"
        android:layout_height="@dimen/hundred"
        android:layout_centerInParent="true"
        android:layout_margin="@dimen/sixteen"
        app:cardCornerRadius="@dimen/sixteen"
        app:cardElevation="@dimen/eight"
        app:cardBackgroundColor="@android:color/white">

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/lottie_loader"
            android:layout_width="@dimen/one_fifty"
            android:layout_height="@dimen/one_fifty"
            android:layout_gravity="center"
            android:visibility="visible"
            app:lottie_rawRes="@raw/loader"
            app:lottie_autoPlay="true"
            app:lottie_loop="true" />
    </androidx.cardview.widget.CardView>

</RelativeLayout>
