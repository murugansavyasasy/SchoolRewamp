<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/action_bg">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="@dimen/zero"
        android:layout_height="@dimen/zero"
        android:background="@drawable/action_bg"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <View
        android:id="@+id/glowEffect"
        android:layout_width="@dimen/two_hundred_eighty"
        android:layout_height="@dimen/two_hundred_eighty"
        android:background="@drawable/glow_circle"
        app:layout_constraintBottom_toBottomOf="@id/logoImage"
        app:layout_constraintEnd_toEndOf="@id/logoImage"
        app:layout_constraintStart_toStartOf="@id/logoImage"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground"
        app:layout_constraintTop_toTopOf="@id/logoImage" />

    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="@dimen/two_hundred"
        android:layout_height="@dimen/two_hundred"
        android:contentDescription="School Chimes Logo"
        android:src="@drawable/school_chimes_logo"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintVertical_bias="0.30" />

    <TextView
        android:id="@+id/callerNameText"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/thirty"
        android:text="@string/school_chimes"
        android:textColor="@color/white"
        android:textSize="@dimen/fourty_sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/logoImage" />

    <TextView
        android:id="@+id/callStatusText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ten"
        android:text="@string/incoming_call"
        android:textColor="@color/white"
        android:textSize="@dimen/twenty_sp"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/callerNameText" />

    <TextView
        android:id="@+id/callTimerText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ten"
        android:text="00:00"
        android:textColor="@color/white"
        android:textSize="@dimen/eighteen_sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="@+id/callStatusText"
        app:layout_constraintStart_toStartOf="@+id/callStatusText"
        app:layout_constraintTop_toBottomOf="@+id/callStatusText" />


    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/actionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/twenty_five"
        android:layout_marginEnd="@dimen/twenty_five"
        android:layout_marginBottom="@dimen/fifty"
        android:padding="@dimen/sixteen"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <ImageButton
            android:id="@+id/declineButton"
            android:layout_width="@dimen/seventy"
            android:layout_height="@dimen/seventy"
            android:background="@android:color/transparent"
            android:contentDescription="Decline call"
            android:src="@drawable/ic_end_answer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <TextView
            android:id="@+id/slideText"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="decline or slide to answer"
            android:textColor="@color/gray"
            android:textSize="@dimen/sixteen_sp"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <FrameLayout
            android:id="@+id/ringContainer"
            android:layout_width="match_parent"
            android:layout_height="@dimen/ninety"
            android:background="@drawable/caller_bg"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

            <View
                android:id="@+id/ring1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.4"
                android:background="@drawable/glow_circle" />

            <View
                android:id="@+id/ring2"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.3"
                android:background="@drawable/glow_circle" />

            <View
                android:id="@+id/ring3"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:alpha="0.2"
                android:background="@drawable/glow_circle" />

            <ImageButton
                android:id="@+id/acceptButton"
                android:layout_width="@dimen/seventy"
                android:layout_height="@dimen/seventy"
                android:layout_gravity="center"
                android:background="@drawable/circle_button_white"
                android:contentDescription="Accept call"
                android:src="@drawable/ic_call_answer" />
        </FrameLayout>

        <ImageButton
            android:id="@+id/messageButton"
            android:layout_width="@dimen/seventy"
            android:layout_height="@dimen/seventy"
            android:background="@android:color/transparent"
            android:contentDescription="Send message"
            android:src="@drawable/ic_call_answer"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent" />


        <ImageButton
            android:id="@+id/callEndButton"
            android:layout_width="@dimen/seventy"
            android:layout_height="@dimen/seventy"
            android:layout_gravity="center"
            android:background="@drawable/circle_button_red"
            android:contentDescription="End call"
            android:src="@drawable/ic_call_end"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>