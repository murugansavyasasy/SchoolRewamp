<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    card_view:cardCornerRadius="@dimen/twele"
    card_view:cardElevation="@dimen/four"
    android:layout_margin="@dimen/eight"
    android:backgroundTint="@android:color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/twele">

\        <TextView
            android:id="@+id/avatarText"
            android:layout_width="@dimen/fourty_eight"
            android:layout_height="@dimen/fourty_eight"
            android:layout_alignParentStart="true"
            android:gravity="center"
            android:textSize="@dimen/twenty_sp"
            android:textColor="@android:color/white"
            android:background="@drawable/default_profile"
            android:layout_marginEnd="@dimen/twele" />

        <!-- Top Name -->
        <TextView
            android:id="@+id/lblStudentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/avatarText"
            android:text="SARANRAJ SHANMUGAM"
            android:textColor="@android:color/black"
          style="@style/CustomTextStylePoppinsBold"
            android:textSize="@dimen/fifteen_sp" />

        <!-- Section -->
        <TextView
            android:id="@+id/sectionlabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/lblStudentName"
            android:layout_toEndOf="@id/avatarText"
            android:text="I - B"
            android:textColor="@color/light_gray_5"
            android:textSize="@dimen/thirteen_sp"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_marginTop="@dimen/two" />

        <!-- Submitted Label -->
        <TextView
            android:id="@+id/submittedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/sectionlabel"
            android:layout_toEndOf="@id/avatarText"
            android:text="Submitted:"
          style="@style/CustomTextStylePoppinsBold"
            android:layout_marginTop="@dimen/six"
            />

        <!-- Date Text -->
        <TextView
            android:id="@+id/submittedDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/submittedLabel"
            android:layout_alignTop="@id/submittedLabel"
            android:layout_marginStart="@dimen/four"
            android:text="Mon, 11"
            style="@style/CustomTextStylePoppinsMedium"
            />

        <LinearLayout
            android:id="@+id/statusButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/thirty_six"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:background="@drawable/pending_button_bg"
            android:paddingStart="@dimen/twele"
            android:paddingEnd="@dimen/twele"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="@dimen/sixteen"
                android:layout_height="@dimen/sixteen"
                android:id="@+id/cancelimage"
                android:src="@drawable/close_red_color"
                android:layout_marginEnd="@dimen/six" />

            <TextView
                android:id="@+id/statuslabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                style="@style/CustomTextStylePoppinsMedium"
                android:textColor="@android:color/holo_red_dark"
                />
        </LinearLayout>

    </RelativeLayout>
</androidx.cardview.widget.CardView>
