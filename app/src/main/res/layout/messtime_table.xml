<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/consHeader"
        android:background="@drawable/bg_top_curve"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="0dp"
        android:paddingVertical="@dimen/twenty"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_marginEnd="@dimen/five"
            android:background="@drawable/rect_orange_bg"
            android:id="@+id/imgScreenType"
            app:layout_constraintStart_toEndOf="@+id/lblMessTimeTable"
            android:src="@drawable/waiting_for_approval"
            android:padding="@dimen/ten"
            android:backgroundTint="@color/dark_orange"
            android:layout_marginStart="@dimen/ten"
            app:layout_constraintStart_toStartOf="parent"
            android:tint="@color/white"
            app:layout_constraintEnd_toStartOf="@+id/lblMessTimeTable"
            app:layout_constraintBottom_toBottomOf="@+id/lblWeeklyMessSchedule"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="@dimen/fourty"
            android:layout_height="@dimen/fourty">

        </ImageView>


        <TextView
            android:layout_width="0dp"
            android:layout_marginEnd="@dimen/five"
            app:layout_constraintEnd_toStartOf="@+id/imgClose"
            android:id="@+id/lblMessTimeTable"

            app:layout_constraintBottom_toTopOf="@+id/lblWeeklyMessSchedule"
            app:layout_constraintStart_toEndOf="@+id/imgScreenType"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_marginStart="@dimen/five"
            android:textSize="@dimen/twenty_four_sp"
            app:layout_constrainedWidth="true"
            style="@style/CustomTextStylePoppinsBold"
            android:text="@string/mess_timetable"
            android:layout_height="wrap_content">

        </TextView>
        <ImageView
            android:layout_marginEnd="@dimen/ten"
            android:id="@+id/imgClose"
            app:layout_constraintStart_toEndOf="@+id/lblMessTimeTable"
            android:src="@drawable/close_icon"
            android:padding="@dimen/five"
            android:backgroundTint="@color/light_gray_10"
            android:background="@drawable/bg_circle_gray"
            android:tint="@color/black"
            app:layout_constraintBottom_toBottomOf="@+id/lblWeeklyMessSchedule"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="@dimen/fourty"
            android:layout_height="@dimen/fourty">

        </ImageView>

        <TextView
            android:layout_width="0dp"
            app:layout_constraintTop_toBottomOf="@+id/lblMessTimeTable"
            android:id="@+id/lblWeeklyMessSchedule"
            app:layout_constraintStart_toStartOf="@+id/lblMessTimeTable"
            app:layout_constraintEnd_toEndOf="@+id/lblMessTimeTable"
            android:textSize="@dimen/thirteen_sp"
            android:textColor="@color/light_gray"
            style="@style/CustomTextStylePoppinsBold"
            android:text="@string/weekly_menu_schedule"
            android:layout_height="wrap_content">

        </TextView>

    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/consHeader"
        >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/viewMealTiming"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_width="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/rcMessTimingDetails"
                android:background="@drawable/rect_radius_light_blue"
                android:layout_height="0dp">

            </View>

            <TextView
                android:layout_width="0dp"
                app:layout_constraintTop_toTopOf="@+id/viewMealTiming"
                android:id="@+id/lblMealTiming"
                android:layout_marginHorizontal="@dimen/fifteen"
                android:drawablePadding="@dimen/five"
                android:layout_marginTop="@dimen/fifteen"
                app:layout_constraintStart_toStartOf="@+id/viewMealTiming"
                app:layout_constraintEnd_toEndOf="@+id/viewMealTiming"
                android:textSize="@dimen/fifteen_sp"
                android:drawableStart="@drawable/time_icon"
                android:textColor="@color/light_gray"
                style="@style/CustomTextStylePoppinsBold"
                android:text="@string/meal_timings"
                android:layout_height="wrap_content">

            </TextView>

            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="0dp"
                android:paddingBottom="@dimen/fifteen"
                android:layout_marginTop="@dimen/five"
                android:layout_marginHorizontal="@dimen/fifteen"
                android:id="@+id/rcMessTimingDetails"
                app:layout_constraintBottom_toTopOf="@+id/rcMessDayWiseMenu"
                app:layout_constraintTop_toBottomOf="@+id/lblMealTiming"
                app:layout_constraintStart_toStartOf="@+id/viewMealTiming"
                app:layout_constraintEnd_toEndOf="@+id/viewMealTiming"
                android:layout_height="wrap_content">

            </androidx.recyclerview.widget.RecyclerView>





            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="0dp"
                android:layout_marginHorizontal="@dimen/fifteen"
                android:id="@+id/rcMessDayWiseMenu"
                android:layout_marginTop="@dimen/ten"
                app:layout_constraintTop_toBottomOf="@+id/rcMessTimingDetails"
                app:layout_constraintEnd_toEndOf="parent"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_height="wrap_content">

            </androidx.recyclerview.widget.RecyclerView>
            <ImageView
                android:visibility="gone"
                android:layout_marginTop="@dimen/ten"
                app:layout_constraintTop_toBottomOf="@+id/rcMessDayWiseMenu"
                android:layout_width="@dimen/two_hundred"
                android:id="@+id/imgNoDataFound"
                android:src="@drawable/no_data_found"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_height="@dimen/two_hundred">
            </ImageView>
            <TextView
                android:visibility="gone"
                android:layout_width="0dp"
                android:id="@+id/lblErrorMessage"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:gravity="center"
                android:text="nod"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_marginHorizontal="@dimen/twenty"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imgNoDataFound"
                android:layout_height="wrap_content">

            </TextView>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>
