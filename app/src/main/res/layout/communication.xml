<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/parent_side_tool_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground" />

    <RelativeLayout
        android:id="@+id/relative_layout2"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarLayout">


        <LinearLayout
            android:id="@+id/lnrCommunicationIcon"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:orientation="horizontal"
            android:visibility="gone"
            android:weightSum="2">


            <RelativeLayout
                android:id="@+id/rlaVoiceMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/bg_gradient_redious_parent">

                <ImageView
                    android:id="@+id/imgVoiceMessage"
                    android:layout_width="@dimen/fifty"
                    android:layout_height="@dimen/fifty"
                    android:layout_centerHorizontal="true"
                    android:paddingTop="@dimen/ten"
                    android:src="@drawable/mic_icon">

                </ImageView>

                <TextView
                    android:id="@+id/lblVoiceMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/imgVoiceMessage"
                    android:layout_marginTop="@dimen/five"
                    android:gravity="center"
                    android:paddingStart="@dimen/five"
                    android:paddingEnd="@dimen/five"
                    android:paddingBottom="@dimen/ten"
                    android:text="@string/voice"
                    android:textColor="@color/white"
                    android:textSize="@dimen/fifteen_sp"
                    android:textStyle="bold">

                </TextView>
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rlaTextMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/imgTextMessage"
                    android:layout_width="@dimen/fifty"
                    android:layout_height="@dimen/fifty"
                    android:layout_centerHorizontal="true"
                    android:paddingTop="@dimen/ten"
                    android:src="@drawable/text_icon_black">

                </ImageView>

                <TextView
                    android:id="@+id/lblTextMessage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/imgTextMessage"
                    android:layout_marginTop="@dimen/five"
                    android:gravity="center"
                    android:paddingStart="@dimen/five"
                    android:paddingEnd="@dimen/five"
                    android:paddingBottom="@dimen/ten"
                    android:text="@string/text"
                    android:textColor="@color/black"
                    android:textSize="@dimen/fifteen_sp"
                    android:textStyle="bold"></TextView>
            </RelativeLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/headerview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/twenty"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/twenty"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lblHeaderTitle"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text=""
                android:textColor="@color/black"
                android:textSize="@dimen/twenty_sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearlayout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/headerview"
            android:layout_alignStart="@+id/lnrCommunicationIcon"
            android:layout_alignEnd="@+id/lnrCommunicationIcon"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgFilter"
                android:layout_width="@dimen/twenty_five"
                android:layout_height="@dimen/twenty_five"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginEnd="@dimen/ten"
                android:src="@drawable/filter_icon" />

            <RelativeLayout
                android:id="@+id/rytSearch"
                android:layout_width="@dimen/zero"
                android:layout_height="@dimen/thirty_five"
                android:layout_margin="@dimen/ten"
                android:layout_weight="1"
                android:background="@drawable/rect_grey">

                <ImageView
                    android:id="@+id/imgSearch"
                    android:layout_width="@dimen/twenty_five"
                    android:layout_height="@dimen/twenty_five"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/ten"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/txtSearchMenu"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@+id/imgSearch"
                    android:background="@android:color/transparent"
                    android:hint="@string/lblSearch"
                    android:imeOptions="actionDone"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp" />

            </RelativeLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/rytFilter"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/linearlayout1"
            android:orientation="vertical"
            android:visibility="gone">

            <LinearLayout
                android:id="@+id/lnrDatePicking"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingStart="@dimen/ten"
                android:paddingTop="@dimen/five"
                android:paddingEnd="@dimen/ten"
                android:visibility="gone">

                <!-- FROM DATE -->
                <LinearLayout
                    android:id="@+id/lnrFromDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/five"
                        android:text="@string/FromDate"
                        android:textColor="#666666"
                        android:textSize="@dimen/ten"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/fourty"
                        android:background="@android:drawable/editbox_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/ten">

                        <TextView
                            android:id="@+id/txtFromDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/FromDate"
                            android:textColor="#000000"
                            android:textSize="@dimen/thirteen_sp" />

                        <ImageView
                            android:layout_width="@dimen/fifteen"
                            android:layout_height="@dimen/fifteen"
                            android:src="@drawable/calender_icon_color" />
                    </LinearLayout>
                </LinearLayout>

                <!-- ARROW -->
                <ImageView
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:layout_marginHorizontal="@dimen/ten"
                    android:src="@drawable/right_arrow"
                    android:visibility="gone" />

                <!-- TO DATE -->
                <LinearLayout
                    android:id="@+id/lnrToDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/five"
                        android:text="@string/ToDate"
                        android:textColor="#666666"
                        android:textSize="@dimen/ten"
                        android:visibility="gone" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/fourty"
                        android:background="@android:drawable/editbox_background"
                        android:gravity="center_vertical"
                        android:orientation="horizontal"
                        android:padding="@dimen/ten">

                        <TextView
                            android:id="@+id/txtToDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:text="@string/ToDate"
                            android:textColor="#000000"
                            android:textSize="@dimen/thirteen_sp" />

                        <ImageView
                            android:layout_width="@dimen/fifteen"
                            android:layout_height="@dimen/fifteen"
                            android:src="@drawable/calender_icon_color" />
                    </LinearLayout>
                </LinearLayout>

                <ImageView
                    android:id="@+id/imgClearFilter"
                    android:layout_width="@dimen/twenty_five"
                    android:layout_height="@dimen/twenty_five"
                    android:src="@drawable/close_red_color"
                    android:visibility="gone">

                </ImageView>

            </LinearLayout>


            <RadioGroup
                android:id="@+id/rdgCommunication"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginStart="16dp"
                android:layout_marginTop="8dp"
                android:layout_marginEnd="16dp"
                android:orientation="horizontal">

                <RadioButton
                    android:id="@+id/RdbAll"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:checked="true"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="All"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/RdbVoice"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="Voice"
                    android:textSize="14sp" />

                <RadioButton
                    android:id="@+id/RdbText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:drawablePadding="4dp"
                    android:gravity="center_vertical"
                    android:paddingStart="0dp"
                    android:paddingEnd="0dp"
                    android:text="Text"
                    android:textSize="14sp" />

            </RadioGroup>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="@dimen/thirty_five"
                android:layout_marginStart="@dimen/fifty"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/fifty"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/lblAll"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/ten"
                    android:layout_weight="1"
                    android:background="@drawable/bg_light_green_radious"
                    android:gravity="center"
                    android:text="@string/all"
                    android:textColor="@color/navi_blue2"
                    android:textSize="@dimen/thirteen_sp">

                </TextView>

                <TextView
                    android:id="@+id/lblUnread"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/ten"
                    android:layout_weight="1"
                    android:background="@drawable/bg_gray_light_radiuos"
                    android:gravity="center"
                    android:text="@string/unread"
                    android:textColor="@color/navi_blue2"
                    android:textSize="@dimen/thirteen_sp">

                </TextView>

                <TextView
                    android:id="@+id/lblRead"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_marginEnd="@dimen/ten"
                    android:layout_weight="1"
                    android:background="@drawable/bg_gray_light_radiuos"
                    android:gravity="center"
                    android:text="@string/read"
                    android:textColor="@color/navi_blue2"
                    android:textSize="@dimen/thirteen_sp">

                </TextView>

            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lytList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rytFilter"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerInitial"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/fifty" />

            <ImageView
                android:id="@+id/nomessage"
                android:layout_width="@dimen/two_fifty"
                android:layout_height="@dimen/two_fifty"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/twenty"
                android:src="@drawable/nomessages"
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtNoData"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/twenty"
                android:gravity="center"
                android:text="@string/no_list_found"
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/seeMoreLabel"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginEnd="@dimen/twenty"
                android:layout_marginBottom="@dimen/fifteen"
                android:text="@string/show_older_messages"
                android:textColor="@color/navi_blue2"
                android:textSize="@dimen/fifteen_sp"
                android:visibility="gone" />


        </LinearLayout>


    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>