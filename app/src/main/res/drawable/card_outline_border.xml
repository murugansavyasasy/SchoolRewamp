<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color (set to white or transparent as needed) -->
    <solid android:color="@android:color/white" />

    <!-- Border (stroke) -->
    <stroke
        android:width="1dp"
        android:color="@color/gray4" /> <!-- You can change this to your desired stroke color -->

    <!-- Corner radius (match your CardView corner radius) -->
    <corners android:radius="15dp" /> <!-- Or use @dimen/fifteen if defined -->

</shape>

