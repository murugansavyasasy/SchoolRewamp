<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <RelativeLayout
        android:id="@+id/relative_layout2"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <include
            android:id="@+id/toolbarLayout"
            layout="@layout/parent_side_tool_bar" />

        <androidx.core.widget.NestedScrollView
            android:id="@+id/main"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/toolbarLayout"
            android:fillViewport="true">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:paddingBottom="@dimen/sixteen">

                <TextView
                    android:id="@+id/headerview"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/twenty"
                    android:layout_marginTop="@dimen/twenty"
                    android:text="@string/ongoing_events"
                    android:textSize="@dimen/eighteen_sp" />


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcyongoingevent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/headerview"
                    android:layout_marginTop="@dimen/five"
                    android:clipToPadding="false"
                    android:fadeScrollbars="false"
                    android:paddingHorizontal="@dimen/ten"
                    android:scrollbars="none" />


                <ImageView
                    android:id="@+id/dotindicator"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rcyongoingevent"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="@dimen/twenty"
                    android:src="@drawable/dotindicator" />


                <TextView
                    android:id="@+id/category_headerview"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/dotindicator"
                    android:layout_marginStart="@dimen/twenty"
                    android:layout_marginTop="@dimen/twenty"
                    android:text="@string/event_categories"
                    android:textColor="@color/black"
                    android:textSize="@dimen/eighteen_sp" />


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcycategory_event"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/category_headerview"
                    android:layout_marginTop="@dimen/five"
                    android:clipToPadding="false"
                    android:fadeScrollbars="false"
                    android:paddingHorizontal="@dimen/ten"
                    android:scrollbars="none" />


                <TextView
                    android:id="@+id/upcomingevent_headerview"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rcycategory_event"
                    android:layout_marginStart="@dimen/twenty"
                    android:layout_marginTop="@dimen/twenty"
                    android:text="@string/upcoming_events"
                    android:textSize="@dimen/eighteen_sp" />

                <LinearLayout
                    android:id="@+id/lytNoDataFound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/upcomingevent_headerview"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:padding="20dp"
                    android:visibility="gone">

                    <ImageView
                        android:id="@+id/imgNoDataFound"
                        android:layout_width="@dimen/two_fifty"
                        android:layout_height="@dimen/two_fifty"
                        android:contentDescription="@string/no_data_found"
                        android:src="@drawable/no_events_message" />

                    <TextView
                        android:id="@+id/txtNoDataFound"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/eight"
                        android:text="@string/no_data_found"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fourteen_sp"
                        android:textStyle="bold" />
                </LinearLayout>


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcyupcomingevent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/upcomingevent_headerview"
                    android:layout_marginTop="@dimen/five"
                    android:clipToPadding="false"
                    android:fadeScrollbars="false"
                    android:paddingHorizontal="@dimen/ten"
                    android:scrollbars="none" />


                <TextView
                    android:id="@+id/completedevent_headerview"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rcyupcomingevent"
                    android:layout_marginStart="@dimen/twenty"
                    android:layout_marginTop="@dimen/twenty"
                    android:text="@string/completed_events"
                    android:textColor="@color/black"
                    android:textSize="@dimen/eighteen_sp" />


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcycompletedevent"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/completedevent_headerview"
                    android:layout_marginTop="@dimen/five"
                    android:clipToPadding="false"
                    android:fadeScrollbars="false"
                    android:paddingHorizontal="@dimen/ten"
                    android:scrollbars="none" />



            </RelativeLayout>
        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>