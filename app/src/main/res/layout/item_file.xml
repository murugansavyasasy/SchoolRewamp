<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/item_file_root"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/outline_gray"
    android:padding="@dimen/ten">

    <ImageView
        android:id="@+id/imageView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/eighty"
        android:layout_margin="@dimen/ten"
        android:adjustViewBounds="true"
        android:scaleType="centerCrop" />

    <TextView
        android:id="@+id/fileName"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/imageView"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:layout_marginBottom="@dimen/ten"
        android:ellipsize="end"
        android:gravity="center"
        android:maxLines="1"
        android:text="filename.ext"
        android:textColor="@android:color/black" />

    <ImageView
        android:id="@+id/videoIcon"
        android:layout_width="@dimen/twenty_five"
        android:layout_height="@dimen/twenty_five"
        android:layout_centerInParent="true"
        android:layout_margin="@dimen/ten"
        android:src="@drawable/video_icon_2"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/audioIcon"
        android:layout_width="@dimen/twenty_five"
        android:layout_height="@dimen/twenty_five"
        android:layout_alignEnd="@id/imageView"
        android:layout_alignBottom="@id/imageView"
        android:layout_margin="@dimen/ten"
        android:src="@drawable/voice"
        android:visibility="gone" />

    <ImageView
        android:id="@+id/checkIcon"
        android:layout_width="@dimen/thirty"
        android:layout_height="@dimen/thirty"
        android:layout_alignTop="@id/imageView"
        android:layout_alignEnd="@id/imageView"
        android:layout_margin="@dimen/ten"
        android:src="@drawable/ic_circle_check_mark"
        android:background="@android:color/transparent"
        android:visibility="gone" />

    <ProgressBar
        android:id="@+id/progressBar"
        android:layout_width="@dimen/twenty"
        android:layout_height="@dimen/twenty"
        android:layout_centerInParent="true"
        android:indeterminate="true"
        android:visibility="gone" />
</RelativeLayout>
