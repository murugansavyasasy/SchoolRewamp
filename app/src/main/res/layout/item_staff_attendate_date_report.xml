<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginBottom="@dimen/ten">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/five"
        android:orientation="horizontal"
        android:padding="@dimen/five"
        android:layout_marginTop="@dimen/three"
        android:background="@drawable/bg_light_blue_10">

        <LinearLayout
            android:layout_width="@dimen/fifty"
            android:layout_height="@dimen/fifty"
            android:orientation="vertical"
            android:gravity="center"
            android:background="@drawable/bg_btn_blue">

            <TextView
                android:id="@+id/tvDay"
                android:text=""
                android:textColor="@android:color/white"
                android:textSize="@dimen/fifteen_sp"
                android:textStyle="bold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvWeek"
                android:text=""
                android:textColor="@android:color/white"
                android:textSize="@dimen/fifteen_sp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_weight="1"
            android:layout_gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFullDate"
                android:text="28 February 2025"
                android:textSize="@dimen/fifteen_sp"
                android:textStyle="bold"
                android:textColor="@android:color/black"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

            <TextView
                android:id="@+id/tvSummary"
                android:text=""
                android:textSize="@dimen/thirteen_sp"
                android:visibility="gone"
                android:textColor="#777777"
                android:layout_marginTop="@dimen/five"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"/>

        </LinearLayout>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerChild"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/five"
        android:paddingHorizontal="@dimen/five"
        android:nestedScrollingEnabled="false"/>

</LinearLayout>