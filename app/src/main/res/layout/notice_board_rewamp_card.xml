<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/header"
    android:layout_below="@+id/horizonatal_linearlayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/bg_white_radious_medium"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:orientation="vertical">

    <TextView
        android:id="@+id/LblHWSubjectName"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="4dp"
        android:paddingTop="4dp"
        android:text="Welcome to our new students"
        android:textColor="@color/black"
        android:textSize="15sp" />

    <TextView
        android:id="@+id/lblTitleImage"
        style="@style/CustomTextStylePoppinsMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="4dp"
        android:paddingTop="4dp"
        android:text="Good Morning All"
        android:textColor="@color/black"
        android:textSize="15sp" />


    <TextView
        android:id="@+id/lblContentImage"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="4dp"
        android:paddingTop="4dp"
        android:text="Please use school chimes from tomorrow fir any news fro the school"
        android:textColor="@color/black"
        android:textSize="15sp" />


    <LinearLayout
        android:id="@+id/lnrDataTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="4dp"
        android:layout_marginEnd="@dimen/ten"
        android:layout_marginStart="10dp">

        <TextView
            android:id="@+id/lblDateImage"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/five"
            android:text="15 Nov 2024"
            android:textColor="@color/black"
            android:textSize="@dimen/twele_sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/lblTimeImage"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="99:99 AM"
            android:textColor="@color/grey"
            android:textSize="@dimen/twele_sp"
            android:textStyle="normal" />

    </LinearLayout>



    <RelativeLayout
        android:id="@+id/rytList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/five"
        android:visibility="gone">


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcyImgPDF"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone">
        </androidx.recyclerview.widget.RecyclerView>

        <android.webkit.WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/ten"
            android:background="@color/black"
            android:visibility="gone" />

        <ProgressBar
            android:id="@+id/loadingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:indeterminateDrawable="@drawable/progress_bar_white"
            android:indeterminateOnly="true"
            android:visibility="gone">
        </ProgressBar>

    </RelativeLayout>

    <me.relex.circleindicator.CircleIndicator2
        android:id="@+id/indicator"
        style="@style/IndicatorStyle"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/twenty"
        android:elevation="4dp"
        android:visibility="gone" />


</LinearLayout>
