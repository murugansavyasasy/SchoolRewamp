<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#FFFFFF" />
            <corners android:radius="8dp" />
            <stroke android:width="1dp" android:color="#E0E0E0" />
        </shape>
    </item>

    <item android:top="0dp" android:bottom="10dp">
        <shape android:shape="rectangle">
            <gradient
                android:startColor="#10A0E0FF"
                android:endColor="#00000000"
                android:angle="90" />
        </shape>
    </item>

    <item android:top="40dp" android:bottom="0dp" android:left="0dp" android:right="0dp">
        <bitmap android:src="@drawable/wave_pattern" android:gravity="bottom|fill_horizontal" />
    </item>
</layer-list>