<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/white"
    android:layout_marginBottom="@dimen/ten"
    >

    <!-- Colored Dot -->
    <View
        android:id="@+id/colourPercent"
        android:layout_width="@dimen/fifteen"
        android:layout_height="@dimen/fifteen"
        android:background="@drawable/bg_circle_2"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <!-- Subject Name -->
    <TextView
        android:id="@+id/subjectname"
        android:layout_width="@dimen/zero"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/five"
        android:text="@string/subject_name"
        android:textColor="@color/black"
        android:layout_marginEnd="@dimen/five"
        android:textSize="@dimen/thirteen_sp"
        style="@style/CustomTextStylePoppinsMedium"
        app:layout_constraintStart_toEndOf="@id/colourPercent"
        app:layout_constraintTop_toTopOf="@id/colourPercent"
        app:layout_constraintEnd_toStartOf="@id/markoutof100"
        app:layout_constraintHorizontal_bias="0" />

    <!-- Marks -->
    <TextView
        android:id="@+id/markoutof100"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="80 /100"
        android:textColor="@color/black"
        android:textSize="@dimen/thirteen_sp"
        android:gravity="end"
        style="@style/CustomTextStylePoppinsMedium"
        app:layout_constraintTop_toTopOf="@id/subjectname"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- RecyclerView -->
    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcSplitMark"
        android:layout_width="@dimen/zero"
        android:layout_height="wrap_content"
        android:nestedScrollingEnabled="false"
        android:layout_marginTop="@dimen/five"
        android:layout_marginEnd="@dimen/five"
        app:layout_constraintTop_toBottomOf="@id/subjectname"
        app:layout_constraintStart_toStartOf="@id/subjectname"
        app:layout_constraintEnd_toEndOf="@id/markoutof100" />

    <!-- Divider Line -->
    <View
        android:layout_width="@dimen/zero"
        android:layout_height="@dimen/one"
        android:background="@color/iron"
        android:layout_marginTop="@dimen/ten"
        app:layout_constraintTop_toBottomOf="@id/rcSplitMark"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

</androidx.constraintlayout.widget.ConstraintLayout>
