<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardCornerRadius="8dp"
    app:cardElevation="4dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fifteen"
        android:layout_marginEnd="@dimen/fifteen_sp"
        android:padding="@dimen/five"
        android:layout_marginTop="@dimen/five">

        <TextView
            android:id="@+id/lblgroupname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Group name"
            android:layout_centerVertical="true"
            android:textSize="@dimen/fifteen_sp"
            android:layout_toStartOf="@+id/lblCreated"
            android:textColor="@color/black"
            android:layout_marginStart="10dp"
            android:layout_marginTop="@dimen/five"
            android:layout_toEndOf="@+id/chMultipleSchool"/>

        <TextView
            android:id="@+id/lblEmployeeId"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Employee id :"
            android:textSize="@dimen/fifteen_sp"
            android:visibility="gone"
            android:layout_marginTop="@dimen/ten"
            android:textColor="@color/black"
            android:layout_below="@+id/lblgroupname"
            android:layout_marginStart="10dp"
            android:layout_toEndOf="@+id/chMultipleSchool"/>


        <TextView
            android:id="@+id/lblDestination"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Destination :"
            android:textSize="@dimen/fifteen_sp"
            android:visibility="gone"
            android:textColor="@color/black"
            android:layout_below="@+id/lblEmployeeId"
            android:layout_marginStart="10dp"
            android:layout_marginTop="@dimen/five"
            android:layout_toEndOf="@+id/chMultipleSchool"/>

        <CheckBox
            android:id="@+id/chMultipleSchool"
            android:layout_width="wrap_content"
            style="@style/CustomCheckBox"
            android:layout_centerVertical="true"
            android:layout_height="wrap_content" />

        <TextView
            android:id="@+id/lblCreated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_centerVertical="true"
            android:text="Created on : "
            android:layout_marginTop="@dimen/five"
            android:layout_alignParentEnd="true"
            android:textSize="@dimen/thirteen_sp"
            android:textColor="@color/grey"
            android:layout_marginStart="@dimen/ten"
           />

        <View
            android:layout_width="match_parent"
            android:layout_below="@+id/lblCreated"
            android:layout_marginTop="@dimen/five"
            android:layout_height="0.6dp"
            android:background="@color/grey_mild"
            >

        </View>
    </RelativeLayout>
</RelativeLayout>
