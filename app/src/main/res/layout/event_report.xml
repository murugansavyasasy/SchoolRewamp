<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/light_white">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <RelativeLayout
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar" />

    <RelativeLayout
        android:id="@+id/rytSearch323"
        android:layout_width="match_parent"
        android:layout_height="@dimen/thirty_five"
        android:layout_margin="@dimen/ten"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:background="@drawable/rect_grey"
        android:visibility="gone"
       android:layout_below="@+id/toolbarLayout">

        <ImageView
            android:id="@+id/imgSearch"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/ten"
            android:src="@drawable/ic_search" />

        <EditText
            android:id="@+id/edtSearch"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toEndOf="@id/imgSearch"
            android:background="@android:color/transparent"
            android:hint="@string/lblSearch"
            android:inputType="text"
            android:maxLines="1"
            android:imeOptions="actionDone"
            android:singleLine="true"
            android:scrollHorizontally="true"
            android:textColor="@color/black"
            android:textSize="@dimen/thirteen_sp" />
    </RelativeLayout>

    <ImageView
        android:id="@+id/noDataImage"
        android:layout_width="@dimen/two_fifty"
        android:layout_height="@dimen/two_fifty"
        android:src="@drawable/no_events_message"
        android:visibility="gone"
      android:layout_centerInParent="true" />

    <TextView
        android:id="@+id/noDataText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:text="@string/no_data_found"
        android:textColor="@color/black"
        android:textSize="@dimen/sixteen_sp"
        android:layout_marginTop="@dimen/five"
        android:visibility="gone"
      android:layout_below="@+id/noDataImage"/>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/rytSearch323"
        android:visibility="visible" />

    <ScrollView
        android:id="@+id/scroll_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/rytSearch323"
        android:fillViewport="true"
        android:visibility="visible">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/sixteen">

            <TextView
                android:id="@+id/headerview"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/twenty"
                android:text="Today's Events"
                android:textColor="@color/black"
                android:textSize="@dimen/eighteen_sp" />


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcyongoingevent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/headerview"
                android:layout_marginTop="@dimen/five"
                android:clipToPadding="false"
                android:fadeScrollbars="false"
                android:paddingHorizontal="@dimen/ten"
                android:scrollbars="none" />


            <ImageView
                android:id="@+id/dotindicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rcyongoingevent"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/twenty"
                android:src="@drawable/dotindicator" />


            <TextView
                android:id="@+id/upcomingevent_headerview"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/dotindicator"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/twenty"
                android:text="@string/upcoming_events"
                android:textColor="@color/black"
                android:textSize="@dimen/eighteen_sp" />


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcyupcomingevent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/upcomingevent_headerview"
                android:layout_marginTop="@dimen/five"
                android:clipToPadding="false"
                android:fadeScrollbars="false"
                android:paddingHorizontal="@dimen/ten"
                android:scrollbars="none" />


            <TextView
                android:id="@+id/completedevent_headerview"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rcyupcomingevent"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/twenty"
                android:text="Completed Events"
                android:textColor="@color/black"
                android:textSize="@dimen/eighteen_sp" />


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcycompletedevent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/completedevent_headerview"
                android:layout_marginTop="@dimen/five"
                android:clipToPadding="false"
                android:fadeScrollbars="false"
                android:paddingHorizontal="@dimen/ten"
                android:scrollbars="none" />


        </RelativeLayout>
    </ScrollView>


</RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>