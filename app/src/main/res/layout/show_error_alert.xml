<!-- res/layout/custom_alert.xml -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rect_white"
    android:orientation="vertical"
    android:padding="@dimen/twenty">

    <TextView
        android:id="@+id/alertTitle"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/ten"
        android:gravity="center"
        android:text=""
        android:textColor="@color/black"
        android:textSize="@dimen/sixteen_sp"
        android:visibility="visible" />

    <TextView
        android:id="@+id/alertMessage"
        style="@style/CustomTextStylePoppinsMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/twenty"
        android:text=""
        android:textColor="@color/light_gray_4"
        android:textSize="@dimen/fourteen_sp" />

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/thirty"
        android:layout_marginBottom="@dimen/twenty"
        app:cardBackgroundColor="@color/white"
        app:cardCornerRadius="@dimen/eight"
        app:cardElevation="@dimen/four">

        <TextView
            android:id="@+id/btnOk"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/thirty"
            android:paddingTop="@dimen/twele"
            android:paddingEnd="@dimen/thirty"
            android:paddingBottom="@dimen/twele"
            android:text="@string/permission_ok"
            android:textColor="@color/black"
            android:textSize="@dimen/fourteen_sp" />
    </androidx.cardview.widget.CardView>

</LinearLayout>