<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/one_thirty"
    android:layout_marginTop="@dimen/five"
    android:fitsSystemWindows="true"
    android:layout_height="wrap_content">



    <TextView
        android:id="@+id/totalcount"
        android:layout_width="@dimen/twenty_four"
        android:layout_height="@dimen/twenty_four"
        android:layout_alignParentEnd="true"
        android:background="@drawable/bg_red_circle"
        android:elevation="@dimen/ten"
        android:gravity="center"
        style="@style/CustomTextStylePoppinsRegular"
        android:text="1"
        android:textColor="@color/white"
        android:textSize="@dimen/twele_sp"
        />

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/eight"
        app:cardCornerRadius="@dimen/four"
        app:cardElevation="@dimen/four">
        <LinearLayout
            android:layout_width="@dimen/one_twenty"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="@dimen/one_twenty"
                android:layout_height="wrap_content"
                android:background="@android:color/holo_blue_light"
                android:paddingVertical="@dimen/ten"
                >

                <TextView
                    android:id="@+id/monthtextview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="January"
                    android:textSize="@dimen/seventeen_sp"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:textColor="@android:color/white"
                    android:gravity="center"
                    />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linear_layout1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:paddingVertical="@dimen/eight"
                android:orientation="vertical"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/datetextview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30"
                    android:textSize="@dimen/twenty_five_sp"
                    style="@style/CustomTextStylePoppinsBold"
                    android:textColor="@color/grey"/>

                <TextView
                    android:id="@+id/daytextview"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monday"
                    android:layout_marginTop="@dimen/two"
                    android:textSize="@dimen/seventeen_sp"
                   style="@style/CustomTextStylePoppinsMedium"
                    android:textColor="@color/grey"/>
            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>

</RelativeLayout>
