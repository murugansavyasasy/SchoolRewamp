<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/three"
    android:orientation="horizontal"
    android:gravity="center"
    android:background="@drawable/bg_fee_card_red"
    android:padding="@dimen/eight"
    android:elevation="@dimen/two">

    <RelativeLayout
        android:background="@drawable/bg_rect_white_solid"
        android:padding="@dimen/fifteen"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content">

        <ImageView
            android:layout_width="@dimen/twenty_four"
            android:layout_height="@dimen/twenty_four"
            android:src="@drawable/collect"
            android:tint="@color/PrimaryColor"
            />
    </RelativeLayout>

    <LinearLayout
        android:layout_width="@dimen/zero"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:layout_marginStart="@dimen/twele">

        <TextView
            android:id="@+id/fee_type"
            android:layout_width="@dimen/zero"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="School Fee"
            style="@style/CustomTextStylePoppinsMedium"
            android:textSize="@dimen/fifteen_sp"
            />

        <TextView
            android:id="@+id/fee_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹25000.00"
            android:textColor="@color/red"
            android:textSize="@dimen/fifteen_sp"
            style="@style/CustomTextStylePoppinsMedium" />
    </LinearLayout>
</LinearLayout>