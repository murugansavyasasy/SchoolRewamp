<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#80000000">

    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottieBirthday"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:lottie_autoPlay="true"
        app:lottie_loop="true"
        app:lottie_rawRes="@raw/graduationparty"
        android:scaleType="centerCrop" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardPopup"
        android:layout_width="280dp"
        android:layout_height="wrap_content"
        android:layout_margin="32dp"
        app:cardCornerRadius="16dp"
        app:cardElevation="8dp"
        app:cardBackgroundColor="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintHorizontal_bias="0.5">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgBanner"
                android:layout_width="150dp"
                android:layout_height="40dp"
                android:src="@drawable/ic_flag"
                android:contentDescription="Flag Banner"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/img2StarLeft"
                android:layout_width="13dp"
                android:layout_height="13dp"
                android:src="@drawable/snowstartsvg"
                android:layout_gravity="start"
                android:layout_marginStart="10dp"
                android:contentDescription="Left Star"
                android:layout_marginEnd="8dp" />
            <ImageView
                android:id="@+id/img2929StarLeft"
                android:layout_width="10dp"
                android:layout_height="10dp"
                android:src="@drawable/ic_star"
                android:layout_gravity="end"
                android:contentDescription="Left Star"
                android:layout_marginEnd="20dp" />

            <ImageView
                android:id="@+id/img131232929StarLeft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/snowstartsvg"
                android:layout_gravity="end"
                android:contentDescription="Left Star"
                android:layout_marginEnd="50dp" />

            <ImageView
                android:id="@+id/imgStaqewrLef2t"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_star"
                android:contentDescription="Left Star"
                android:layout_marginEnd="8dp"
                android:layout_gravity="center" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center">

                <ImageView
                    android:id="@+id/imgStarLeft"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/snowstartsvg"
                    android:layout_gravity="start"
                    android:contentDescription="Left Star"
                    android:layout_marginEnd="8dp" />

                <ImageView
                    android:id="@+id/imgStarLef2t"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/ic_star"
                    android:contentDescription="Left Star"
                    android:layout_marginEnd="8dp" />

                <FrameLayout
                    android:layout_width="100dp"
                    android:layout_height="100dp"
                    android:background="@drawable/circle_bg_light_blue">

                    <ImageView
                        android:id="@+id/imgProfile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:src="@drawable/default_profile"
                        android:scaleType="centerCrop"
                        android:contentDescription="Profile"
                        android:padding="5dp" />
                </FrameLayout>

                <ImageView
                    android:id="@+id/imgStarRight"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:src="@drawable/circlesvgformat"
                    android:contentDescription="Right Star"
                    android:layout_marginStart="20dp"
                    android:layout_gravity="end"
                    android:layout_marginTop="0dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/img2StarLeqweft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/ic_star"
                android:layout_gravity="start"
                android:layout_marginStart="10dp"
                android:contentDescription="Left Star"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:id="@+id/img2S123tarLeqweft"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/snowstartsvg"
                android:layout_gravity="center"
                android:contentDescription="Left Star"
                android:layout_marginEnd="8dp" />

            <ImageView
                android:id="@+id/imgDecor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:src="@drawable/ic_star"
                android:layout_marginStart="70dp"
                android:contentDescription="Bottom Star"
                android:layout_gravity="start" />

            <ImageView
                android:id="@+id/imgDqe123123ecor"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"

                android:src="@drawable/ic_star"
                android:layout_marginStart="40dp"
                android:layout_marginEnd="20dp"
                android:contentDescription="Bottom Star"
                android:layout_gravity="end" />

            <TextView
                android:id="@+id/txtHappyBirthday"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Happy Birthday!"
                android:textColor="@color/PrimaryColor"
                android:textSize="20sp"
                android:gravity="center"
               />

            <TextView
                android:id="@+id/txtName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Saran Raj Shannumugam"
                android:textColor="@color/black"
                android:textSize="16sp"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_marginTop="4dp"
                android:gravity="center" />

            <TextView
                android:id="@+id/txtMessage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="May your day be filled with happiness and your year ahead with success"
                android:textColor="@color/clr_grey_dark"
                android:textSize="15sp"
                style="@style/CustomTextStylePoppinsMedium"
                android:gravity="center"
                android:layout_marginTop="4dp"
                android:layout_marginHorizontal="12dp" />

            <TextView
                android:id="@+id/txtDate"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="13, Oct 2025"
                android:textSize="14sp"
                android:textColor="@color/clr_grey_dark"
                android:layout_marginTop="8dp"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_marginBottom="12dp"
                android:gravity="center" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>