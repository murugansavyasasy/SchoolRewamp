<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/athens_gray"
    android:fitsSystemWindows="true">


    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar" />


    <RelativeLayout
        android:id="@+id/rytSearch1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/thirty_five"
        android:layout_below="@id/toolbarLayout"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:layout_marginTop="@dimen/ten"
        android:background="@drawable/rect_grey"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgSearch1"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/ten"
            android:src="@drawable/ic_search" />

        <EditText
            android:id="@+id/txtSearch1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toEndOf="@id/imgSearch1"
            android:background="@android:color/transparent"
            android:hint="@string/lblSearch"
            android:textColor="@color/black"
            android:textSize="@dimen/thirteen_sp" />
    </RelativeLayout>


    <ScrollView
        android:layout_below="@+id/rytSearch1"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout

            android:id="@+id/rlaSubmitReport"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/five"
            android:paddingBottom="@dimen/twenty"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/five">

            <LinearLayout
                android:layout_marginStart="@dimen/ten"
                android:layout_marginEnd="@dimen/ten"
                android:orientation="vertical"
                android:id="@+id/lnrSubjectDetails"
                android:background="@drawable/white_bg_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/lblSubjectID"
                    android:layout_width="match_parent"
                    android:drawableStart="@drawable/book__2_"
                    android:drawablePadding="@dimen/five"
                    android:text="Maths"
                    style="@style/CustomTextStylePoppinsBold"
                    android:drawableTint="@color/PrimaryColor"
                    android:layout_height="wrap_content">
                </TextView>

                <TextView
                    android:text="@string/Title"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:id="@+id/lblTitle"
                    android:gravity="center_vertical"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/ten"
                    android:drawablePadding="@dimen/five"
                    android:drawableStart="@drawable/pin_icon_2"
                    android:drawableTint="@color/PrimaryColor"
                    android:layout_height="wrap_content">
                </TextView>
                <TextView
                    style="@style/CustomTextStylePoppinsBold"
                    android:id="@+id/tvTitle"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginStart="@dimen/ten"
                    android:drawableTint="@color/PrimaryColor"
                    android:layout_height="wrap_content">
                </TextView>

            </LinearLayout>

            <LinearLayout
                android:layout_marginTop="@dimen/ten"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginEnd="@dimen/ten"
                android:orientation="vertical"
                android:layout_below="@+id/lnrSubjectDetails"
                android:id="@+id/lnrDescription"
                android:background="@drawable/white_bg_card"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    style="@style/CustomTextStylePoppinsMedium"
                    android:id="@+id/lblDescription"
                    android:layout_width="match_parent"
                    android:text="@string/Description"
                    android:layout_height="wrap_content">
                </TextView>

                <TextView
                    style="@style/CustomTextStylePoppinsMedium"
                    android:id="@+id/tvDescription"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/five"
                    android:drawablePadding="@dimen/five"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_height="wrap_content">
                </TextView>

            </LinearLayout>

            <androidx.recyclerview.widget.RecyclerView
                android:layout_below="@+id/lnrDescription"
                android:layout_marginTop="@dimen/ten"
                android:id="@+id/rcSubmitReport"
                android:nestedScrollingEnabled="false"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                >
            </androidx.recyclerview.widget.RecyclerView>


            <LinearLayout
                android:id="@+id/lytList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rcSubmitReport"
                android:layout_centerInParent="true"
                android:orientation="vertical"
                android:paddingBottom="@dimen/ten"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/noDataImage"
                    android:layout_width="@dimen/two_hundred"
                    android:layout_height="@dimen/two_hundred"
                    android:layout_gravity="center_horizontal"
                    android:src="@drawable/no_data_found">
                </ImageView>

                <TextView
                    android:id="@+id/txtNoData"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="No Data"
                    android:textSize="@dimen/fifteen_sp">

                </TextView>
            </LinearLayout>
        </RelativeLayout>
    </ScrollView>

</RelativeLayout>