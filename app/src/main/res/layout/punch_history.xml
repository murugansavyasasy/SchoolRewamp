<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_white">

    <RelativeLayout
        android:id="@+id/rytHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="@dimen/twenty_five"
            android:layout_height="@dimen/twenty_five"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:src="@drawable/arrow_back_black">

        </ImageView>

        <TextView
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:layout_toEndOf="@+id/imgBack"
            android:text="@string/punch_history"
            android:textColor="@color/navi_blue2"
            android:textSize="@dimen/fifteen_sp">

        </TextView>

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/rytDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rytHeader"
        android:layout_margin="@dimen/ten"
        android:layout_marginTop="@dimen/twenty"
        android:background="@drawable/rect_stroke_grey"
        android:orientation="vertical">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/ten">

            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/staff_information"
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen" />

            <TextView
                style="@style/CustomTextStylePoppinsRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/five"
                android:text="@string/personal_institutional_details_information"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />

        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginTop="@dimen/ten"
            android:background="@color/gray4" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/one"
            android:background="@color/white"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/fifteen">


                <RelativeLayout
                    android:id="@+id/rytInstitute"
                    android:layout_width="@dimen/thirty"
                    android:layout_height="@dimen/thirty"
                    android:background="@drawable/rect_grey">

                    <ImageView
                        android:layout_width="@dimen/twenty"
                        android:layout_height="@dimen/twenty"
                        android:layout_centerInParent="true"
                        android:src="@drawable/ic_star" />

                </RelativeLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_toEndOf="@+id/rytInstitute"
                    android:orientation="horizontal">


                    <TextView
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="@string/institution"
                        android:textColor="@color/grey"
                        android:textSize="@dimen/thirteen_sp" />

                    <TextView
                        android:id="@+id/lblSchoolName"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:gravity="end"
                        android:text="App rewamp testing school"
                        android:textColor="@color/PrimaryColor"
                        android:textSize="@dimen/thirteen_sp" />

                </LinearLayout>

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/gray4" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/fifteen">


                <RelativeLayout
                    android:id="@+id/rytStaffIcon"
                    android:layout_width="@dimen/thirty"
                    android:layout_height="@dimen/thirty"
                    android:background="@drawable/rect_grey">

                    <ImageView
                        android:layout_width="@dimen/twenty"
                        android:layout_height="@dimen/twenty"
                        android:layout_centerInParent="true"
                        android:src="@drawable/ic_user_icon" />

                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_toEndOf="@+id/rytStaffIcon"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="@string/staff_name"
                        android:textColor="@color/grey"
                        android:textSize="@dimen/thirteen_sp" />

                    <TextView
                        android:id="@+id/lblStaffName"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:gravity="end"
                        android:text="MURUGAN N"
                        android:textColor="@color/PrimaryColor"
                        android:textSize="@dimen/thirteen_sp" />

                </LinearLayout>

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/gray4" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/fifteen">

                <RelativeLayout
                    android:id="@+id/rytDesignationIcon"
                    android:layout_width="@dimen/thirty"
                    android:layout_height="@dimen/thirty"
                    android:background="@drawable/rect_grey">

                    <ImageView
                        android:layout_width="@dimen/twenty"
                        android:layout_height="@dimen/twenty"
                        android:layout_centerInParent="true"
                        android:src="@drawable/ic_checked_icon" />

                </RelativeLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_toEndOf="@+id/rytDesignationIcon"
                    android:orientation="horizontal">

                    <TextView
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="2"
                        android:text="@string/designation"
                        android:textColor="@color/grey"
                        android:textSize="@dimen/thirteen_sp" />

                    <TextView
                        android:id="@+id/lblDesignation"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="3"
                        android:gravity="end"
                        android:text="Principal"
                        android:textColor="@color/PrimaryColor"
                        android:textSize="@dimen/thirteen_sp" />

                </LinearLayout>

            </RelativeLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="0.5dp"
                android:background="@color/gray4" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/fifteen"
                android:visibility="gone">


                <ImageView
                    android:id="@+id/imgDate"
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:layout_centerVertical="true"
                    android:src="@drawable/time_icon" />

                <TextView
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_toEndOf="@+id/imgDate"
                    android:text="@string/date"
                    android:textColor="@color/grey"
                    android:textSize="@dimen/fifteen" />

                <TextView
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/ten"
                    android:text="05-09-2025"
                    android:textColor="@color/PrimaryColor"
                    android:textSize="@dimen/fifteen" />

            </RelativeLayout>

        </LinearLayout>

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/rytAttendance"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rytDetails"
        android:layout_marginTop="@dimen/ten">

        <LinearLayout
            android:id="@+id/lnrDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ten"
                android:text="@string/History"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />

            <TextView
                android:id="@+id/lblDate"
                style="@style/CustomTextStylePoppinsRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/five"
                android:text="Tuesday,09 sep 2025"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />

        </LinearLayout>

        <RelativeLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/ten"
            android:background="@drawable/rect_bg_light_green_present"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/fifteen"
            android:paddingVertical="@dimen/five"
            android:visibility="gone">

            <View
                android:id="@+id/vwCircle"
                android:layout_width="@dimen/ten"
                android:layout_height="@dimen/ten"
                android:layout_centerVertical="true"
                android:background="@drawable/circle_bg_green" />

            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/ten"
                android:layout_toEndOf="@+id/vwCircle"
                android:text="@string/active"
                android:textColor="@color/green"
                android:textSize="@dimen/thirteen_sp" />
        </RelativeLayout>
    </RelativeLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcyPunchList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rytAttendance"
        android:layout_margin="@dimen/ten"
        android:layout_marginTop="@dimen/ten"
        android:padding="@dimen/five"
        tools:listitem="@layout/punch_history_item"></androidx.recyclerview.widget.RecyclerView>


    <TextView
        android:id="@+id/lblNoRecordsFound"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_below="@+id/rytAttendance"
        android:layout_marginTop="@dimen/twenty"
        android:text=""></TextView>

</RelativeLayout>