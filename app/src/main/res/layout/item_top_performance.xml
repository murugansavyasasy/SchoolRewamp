<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="horizontal"
    android:gravity="center_vertical"
    android:padding="@dimen/twele">


    <TextView
        android:id="@+id/avatarText"
        android:layout_width="@dimen/fourty"
        android:layout_height="@dimen/fourty"
        android:gravity="center"
        android:text="J"
        android:textSize="@dimen/sixteen_sp"
        android:textStyle="bold"
        android:textColor="@android:color/white"
        android:background="@drawable/bg_circle_avatar" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/twele">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Jeeva"
            android:textSize="@dimen/fourteen_sp"
            style="@style/CustomTextStylePoppinsBold"
            android:textColor="@android:color/black" />

        <TextView
            android:id="@+id/txtclassname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Class I - B -"
            android:textSize="@dimen/twele_sp"
            style="@style/CustomTextStylePoppinsMedium"
            android:textColor="@android:color/darker_gray" />
    </LinearLayout>


    <TextView
        android:id="@+id/txtValue"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="0.0%"
        android:textSize="@dimen/fourteen_sp"
        style="@style/CustomTextStylePoppinsBold"
        android:textColor="@android:color/holo_green_dark" />

</LinearLayout>
