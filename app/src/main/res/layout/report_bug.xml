<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_white">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground" />

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="@dimen/twenty">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/ten">

                <TextView
                    android:id="@+id/lblDescription"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/select_module"
                    android:textSize="@dimen/thirteen_sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/two"
                    android:text="@string/mandatory"
                    android:textColor="@color/red"
                    app:layout_constraintStart_toEndOf="@id/lblDescription"
                    app:layout_constraintTop_toTopOf="@id/lblDescription" />
            </androidx.constraintlayout.widget.ConstraintLayout>


            <RelativeLayout
                android:id="@+id/spinnerContainer"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/ten"
                android:background="@drawable/field_background"
                android:padding="@dimen/ten">

                <Spinner
                    android:id="@+id/isMenuSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:background="@android:color/transparent"
                    android:paddingEnd="40dp"
                    android:spinnerMode="dropdown"
                    android:textColor="@color/black" />

                <ImageView
                    android:id="@+id/spinnerCorrectAnswerimg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/three"
                    android:src="@drawable/ic_drop_down"
                    app:tint="@color/black" />
            </RelativeLayout>

            <androidx.constraintlayout.widget.ConstraintLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/ten">

                <TextView
                    android:id="@+id/lblRemark"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/remark"
                    android:textSize="@dimen/thirteen_sp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toTopOf="parent" />

                <TextView
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/two"
                    android:text="@string/mandatory"
                    android:textColor="@color/red"
                    app:layout_constraintStart_toEndOf="@id/lblRemark"
                    app:layout_constraintTop_toTopOf="@id/lblRemark" />

            </androidx.constraintlayout.widget.ConstraintLayout>

            <LinearLayout
                android:id="@+id/lnrDesc"
                android:layout_width="match_parent"
                android:layout_height="@dimen/two_hundred"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/ten"
                android:background="@drawable/field_background"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <EditText
                    android:id="@+id/edtReportBug"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:gravity="top"
                    android:hint="@string/lblEntertheBug"
                    android:inputType="textMultiLine|textCapSentences"
                    android:padding="@dimen/ten"
                    android:textSize="@dimen/thirteen_sp" />
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/rlaTitleDescription"
                android:layout_marginTop="@dimen/five">

                <TextView
                    android:id="@+id/lblAddPhoto"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/twenty"
                    android:layout_marginTop="@dimen/ten"
                    android:text="@string/add_attachment">

                </TextView>

                <TextView
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/two"
                    android:layout_marginTop="@dimen/eight"
                    android:layout_toEndOf="@id/lblAddPhoto"
                    android:text="@string/mandatory"
                    android:textColor="@color/red"
                    android:visibility="gone" />

                <TextView
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/eight"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_toEndOf="@+id/lblAddPhoto"
                    android:text="@string/Optional"
                    android:textColor="@color/mild_grey1"
                    android:visibility="gone">

                </TextView>

                <ImageView
                    android:layout_width="@dimen/twenty_five"
                    android:layout_height="@dimen/twenty_five"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/twenty"
                    android:src="@drawable/ic_attach_file"
                    android:visibility="invisible">

                </ImageView>

                <RelativeLayout
                    android:id="@+id/rytRecyclewview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lblAddPhoto">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rcyImages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ten"
                        android:orientation="vertical">

                    </androidx.recyclerview.widget.RecyclerView>

                </RelativeLayout>

                <TextView
                    android:id="@+id/btnReportBug"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rytRecyclewview"
                    android:layout_marginStart="@dimen/twenty_five"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/twenty_five"
                    android:layout_marginBottom="@dimen/twenty"
                    android:background="@drawable/background_radius_button"
                    android:gravity="center"
                    android:padding="@dimen/ten"
                    android:text="@string/send_mail"
                    android:textColor="@color/white"
                    android:textSize="@dimen/fifteen_sp" />

                <TextView
                    android:id="@+id/btnOpenNextPage"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/btnReportBug"
                    android:layout_marginStart="@dimen/twenty_five"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/twenty_five"
                    android:layout_marginBottom="@dimen/twenty"
                    android:background="@drawable/background_radius_button"
                    android:gravity="center"
                    android:padding="@dimen/ten"
                    android:text="Open Quiz Page"
                    android:textColor="@color/white"
                    android:textSize="@dimen/fifteen_sp"
                    android:visibility="gone" />

            </RelativeLayout>


            <!--            <RelativeLayout-->
            <!--                android:id="@+id/rlaPickImage"-->
            <!--                android:layout_width="match_parent"-->
            <!--                android:layout_height="@dimen/sixty"-->
            <!--                android:layout_marginStart="@dimen/ten"-->
            <!--                android:layout_marginTop="@dimen/ten"-->
            <!--                android:layout_marginEnd="@dimen/ten"-->
            <!--                android:background="@drawable/field_background"-->
            <!--                android:gravity="center">-->

            <!--                <ImageView-->
            <!--                    android:id="@+id/imgUpload"-->
            <!--                    android:layout_width="@dimen/thirty"-->
            <!--                    android:layout_height="@dimen/thirty"-->
            <!--                    android:layout_centerVertical="true"-->
            <!--                    android:src="@drawable/upload" />-->

            <!--                <TextView-->
            <!--                    android:layout_width="wrap_content"-->
            <!--                    android:layout_height="wrap_content"-->
            <!--                    android:layout_centerVertical="true"-->
            <!--                    android:layout_marginStart="@dimen/ten"-->
            <!--                    android:layout_toEndOf="@id/imgUpload"-->
            <!--                    android:text="@string/lblAttachment"-->
            <!--                    android:textSize="@dimen/thirteen_sp"-->
            <!--                    android:textStyle="bold" />-->
            <!--            </RelativeLayout>-->

            <!--            <GridView-->
            <!--                android:id="@+id/imgPreview"-->
            <!--                android:layout_width="match_parent"-->
            <!--                android:layout_height="wrap_content"-->
            <!--                android:layout_marginTop="@dimen/ten"-->
            <!--                android:horizontalSpacing="8dp"-->
            <!--                android:numColumns="2"-->
            <!--                android:padding="@dimen/ten"-->
            <!--                android:stretchMode="columnWidth"-->
            <!--                android:verticalSpacing="8dp" />-->

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>