<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingHorizontal="12dp"
    android:paddingTop="12dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/txtReviewTestNumber"
            style="bold"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:background="@drawable/bg_test_number_badge"
            android:gravity="center"
            android:text="1"
            android:textColor="@color/white"
            android:textSize="12sp" />

        <TextView
            android:id="@+id/txtReviewExamName"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text="testing iOS"
            android:textColor="#1A1A2E"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/txtReviewSession"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="26dp"
            android:layout_marginEnd="10dp"
            android:background="@drawable/bg_session_chip"
            android:gravity="center"
            android:paddingHorizontal="10dp"
            android:text="FN"
            android:textColor="@color/PrimaryColor"
            android:textSize="11sp" />

        <ImageView
            android:id="@+id/imgReviewDelete"
            android:layout_width="18dp"
            android:layout_height="18dp"
            android:src="@drawable/delete_bin_12" />

        <TextView
            android:id="@+id/txtReviewRemove"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="4dp"
            android:text="Remove"
            android:textColor="#FF3B30"
            android:textSize="12sp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_review_chip"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="DATE"
                android:textColor="#9E9E9E"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/txtReviewDate"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="30/06/2026"
                android:textColor="#1A1A2E"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="6dp"
            android:layout_height="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_review_chip"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MAX"
                android:textColor="#9E9E9E"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/txtReviewMax"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="100"
                android:textColor="#1A1A2E"
                android:textSize="12sp" />
        </LinearLayout>

        <View
            android:layout_width="6dp"
            android:layout_height="0dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:background="@drawable/bg_review_chip"
            android:orientation="vertical"
            android:padding="8dp">

            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="MIN"
                android:textColor="#9E9E9E"
                android:textSize="10sp" />

            <TextView
                android:id="@+id/txtReviewMin"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="35"
                android:textColor="#1A1A2E"
                android:textSize="12sp" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lytSyllabusSection"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:background="@drawable/bg_review_chip"
        android:orientation="vertical"
        android:padding="8dp"
        android:layout_marginBottom="10dp"
        android:visibility="gone">

        <TextView
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="SYLLABUS"
            android:textColor="#9E9E9E"
            android:textSize="10sp" />

        <TextView
            android:id="@+id/txtReviewSyllabus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="—"
            android:textColor="#1A1A2E"
            android:textSize="12sp" />
    </LinearLayout>

    <View
        android:id="@+id/dividerTestRow"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="12dp"
        android:background="#F0F0F0" />

</LinearLayout>