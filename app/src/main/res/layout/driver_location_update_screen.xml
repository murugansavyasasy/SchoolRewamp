<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:map="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="#F9F9F9">

    <!-- Google Map -->
    <fragment
        android:id="@+id/mapView"
        android:layout_width="match_parent"
        android:layout_height="400dp" />

    <!-- Driver Info Card -->
    <LinearLayout
        android:id="@+id/driverInfoCard"
        android:layout_below="@id/mapView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="16dp"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:background="@android:color/white"
        android:elevation="4dp"
        android:layout_marginTop="8dp">

        <ImageView
            android:id="@+id/driverImage"
            android:layout_width="56dp"
            android:layout_height="56dp"
            android:src="@drawable/profile"
            android:scaleType="centerCrop"
            android:background="@drawable/circle_background"
            android:padding="4dp" />

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="12dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/driverName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="John Doe"
                android:textStyle="bold"
                android:textSize="16sp"
                android:textColor="#000000" />

            <TextView
                android:id="@+id/driverStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Online - Location updating"
                android:textSize="14sp"
                android:textColor="#4CAF50" />
        </LinearLayout>

        <Button
            android:id="@+id/btnToggleStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Go Offline"
            android:backgroundTint="#2196F3"
            android:textColor="@android:color/white" />
    </LinearLayout>

    <!-- Last updated time -->
    <TextView
        android:id="@+id/lastUpdatedText"
        android:layout_below="@id/driverInfoCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="Last updated: 2:58 PM"
        android:padding="12dp"
        android:textColor="#888888"
        android:textSize="14sp"
        android:gravity="center" />

</RelativeLayout>