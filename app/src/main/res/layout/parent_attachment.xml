<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/parent_side_tool_bar" />

    <LinearLayout
        android:id="@+id/linearlayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbarLayout"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgFilter"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:layout_marginStart="@dimen/ten"
            android:visibility="gone"
            android:layout_marginEnd="@dimen/ten"
            android:src="@drawable/filter_icon" />

        <RelativeLayout
            android:id="@+id/rytSearch"
            android:layout_width="@dimen/zero"
            android:layout_height="@dimen/thirty_five"
            android:layout_margin="@dimen/ten"
            android:layout_weight="1"
            android:visibility="gone"
            android:background="@drawable/rect_grey">

            <ImageView
                android:id="@+id/imgSearch"
                android:layout_width="@dimen/twenty_five"
                android:layout_height="@dimen/twenty_five"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/ten"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/txtSearchMenu"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toEndOf="@+id/imgSearch"
                android:background="@android:color/transparent"
                android:hint="@string/lblSearch"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />

        </RelativeLayout>

    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycleracademic"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:layout_width="match_parent"
        android:layout_above="@+id/seeMoreLabel"
        android:layout_height="wrap_content"
        android:layout_below="@+id/linearlayout1">

    </androidx.recyclerview.widget.RecyclerView>


    <LinearLayout
        android:id="@+id/lytList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbarLayout"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nomessage"
            android:layout_width="@dimen/two_fifty"
            android:layout_height="@dimen/two_fifty"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/twenty"
            android:src="@drawable/nomessages"
            android:textColor="@color/black"
            android:textSize="@dimen/eighteen"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtNoData"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/twenty"
            android:text="@string/no_list_found"
            android:textColor="@color/black"
            android:textSize="@dimen/eighteen"
            android:visibility="gone" />


    </LinearLayout>

    <TextView
        android:id="@+id/seeMoreLabel"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="@dimen/twenty"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/fifteen"
        android:text="@string/see_more"
        android:textColor="@color/navi_blue2"
        android:textSize="@dimen/fifteen_sp"
        android:visibility="visible" />

</RelativeLayout>