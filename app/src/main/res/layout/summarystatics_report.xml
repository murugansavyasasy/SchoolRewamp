<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_gradient1"
    android:orientation="vertical"
    android:padding="16dp"
    android:elevation="4dp"
    android:layout_margin="8dp"
    android:clipToOutline="true">

    <!-- Top Row: Icon + Student Count -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/profile" />

        <TextView
            android:id="@+id/student_count"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="11"
            android:textColor="@color/black"
            android:textSize="20sp"
            android:textStyle="bold"
            android:layout_marginStart="6dp" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Students"
            android:textColor="@color/black"
            android:textSize="16sp"
            android:layout_marginStart="4dp" />
    </LinearLayout>


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="8dp"
        android:id="@+id/linear_layoutboysgirls"
        android:weightSum="2"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/boyscount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="boys 3"
            android:layout_weight="1"
            android:textColor="@color/light_gray"
            android:textSize="14sp"
          />

        <TextView
            android:id="@+id/girlscount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="girls 3"
            android:layout_weight="1"
            android:textColor="@color/light_gray"
            android:textSize="14sp"
            android:gravity="end"

            />
    </LinearLayout>



    <ProgressBar
        android:id="@+id/progressbar"
        style="@android:style/Widget.ProgressBar.Horizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:progress="30"
        android:max="100"
        android:progressDrawable="@drawable/progress_custom"
        android:layout_marginTop="6dp" />


    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="8dp"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/growth_value"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="+ 3 from last year"
            android:textColor="@color/light_gray"
            android:textSize="14sp" />

        <ImageView
            android:layout_width="14dp"
            android:layout_height="14dp"
            android:src="@drawable/arrow_up"
            android:layout_marginStart="4dp" />
    </LinearLayout>
</LinearLayout>
