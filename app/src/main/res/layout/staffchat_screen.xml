<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/AthensGray"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/rytHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/AthensGray"
        android:paddingVertical="@dimen/fifteen">

        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="@dimen/thirty_five"
            android:layout_height="@dimen/thirty_five"
            android:layout_centerVertical="true"
            android:src="@drawable/left_arrow" />

        <TextView
            android:id="@+id/lblParentToolBar"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/rlaStudentName"
            android:layout_toEndOf="@+id/imgBack"
            android:text=""
            android:textSize="@dimen/fifteen_sp" />

        <LinearLayout
            android:id="@+id/rlaStudentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/ten"
            android:layout_toEndOf="@+id/imgBack"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lblStudentName"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="@dimen/thirteen_sp" />

            <TextView
                android:id="@+id/lblStudentSection"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                />
        </LinearLayout>
    </RelativeLayout>



    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcystaffchatdata"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rytHeader"
        android:layout_above="@+id/bottomChatInput"
        android:nestedScrollingEnabled="false" />


    <LinearLayout
        android:id="@+id/bottomChatInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/AthensGray"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/ten">

        <ImageView
            android:id="@+id/btnAdd"
            android:layout_width="@dimen/twenty_four"
            android:layout_height="@dimen/twenty_four"
            android:layout_marginEnd="@dimen/ten"
            android:contentDescription="Attchment"
            android:src="@drawable/ic_plus" />

        <EditText
            android:id="@+id/edtMessage"
            android:layout_width="@dimen/zero"
            android:layout_height="@dimen/fourty"
            android:layout_weight="1"
            android:background="@drawable/bg_message_input"
            android:gravity="center_vertical"
            android:hint="@string/type_your_message_here"
            android:inputType="textMultiLine"
            android:maxLines="4"
            android:paddingHorizontal="12dp"
            android:textColor="@color/black"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/btnSend"
            android:layout_width="@dimen/twenty_four"
            android:layout_height="@dimen/twenty_four"
            android:layout_marginStart="@dimen/ten"
            android:contentDescription="@string/send_message"
            android:src="@drawable/sent_message" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/lytList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nomessage"
            android:layout_width="@dimen/two_fifty"
            android:layout_height="@dimen/two_fifty"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/twenty"
            android:src="@drawable/nomessages"
            android:textColor="@color/black"
            android:textSize="@dimen/fifteen_sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtNoData"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/twenty"
            android:gravity="center"
            android:text="@string/no_list_found"
            android:textSize="@dimen/fifteen_sp"
            android:visibility="gone" />


    </LinearLayout>


</RelativeLayout>