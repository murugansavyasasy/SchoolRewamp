<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/rytView"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/five"
        android:background="@drawable/rect_shadow_white_2"
        android:padding="@dimen/twenty"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgPdf"
            android:layout_width="@dimen/fifty"
            android:layout_height="@dimen/fifty"
            android:layout_centerVertical="true"
            android:src="@drawable/pdf_icon" />

        <LinearLayout
            android:id="@+id/lnrInvoiceDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/ten"
            android:layout_toStartOf="@+id/lnrViewContainer"
            android:layout_toEndOf="@+id/imgPdf"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lblInvoiceNo"
                style="@style/CustomTextStylePoppinsRegular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Invoice No : INV001"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen" />

            <TextView
                android:id="@+id/lblInvoiceAmount"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/five"
                android:text="Invoice Amount : 1200" />

        </LinearLayout>

        <LinearLayout
            android:id="@+id/lnrViewContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="vertical"
            android:gravity="center">

            <RelativeLayout
                android:id="@+id/rytViewInvoice"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/white_bg_primary_stoke"
                android:paddingHorizontal="@dimen/thirteen"
                android:paddingVertical="@dimen/four">

                <ImageView
                    android:id="@+id/imgView"
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:layout_centerVertical="true"
                    android:src="@drawable/eye_icon_blue" />

                <TextView
                    android:id="@+id/lblViewReceipt"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/five"
                    android:layout_toEndOf="@+id/imgView"
                    android:text="View"
                    android:textColor="@color/navi_blue6" />
            </RelativeLayout>
        </LinearLayout>


        <LinearLayout
            android:layout_below="@+id/lnrInvoiceDetails"
            android:layout_alignParentEnd="true"
            android:id="@+id/lnrDateTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/ten">

            <TextView
                android:id="@+id/lblInvoiceDate"
                style="@style/CustomTextStylePoppinsRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="01-05-2025"
                android:textColor="@color/grey"
                android:textSize="@dimen/ten" />

            <TextView
                android:id="@+id/lblInvoiceTime"
                style="@style/CustomTextStylePoppinsRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/five"
                android:text="10:45 AM"
                android:textColor="@color/grey"
                android:textSize="@dimen/ten" />
        </LinearLayout>


    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
