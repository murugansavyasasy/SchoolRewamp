<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/tooltipLayout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:background="@drawable/bg_tooltip_background"
    android:padding="8dp"
    android:layout_marginStart="40dp"
    android:layout_marginEnd="40dp"
    android:layout_marginTop="@dimen/twele"
    android:elevation="4dp">

    <ImageView
        android:layout_width="wrap_content"
        android:layout_height="8dp"
        android:src="@drawable/tooltip_arrow"
        android:layout_gravity="center_horizontal"
        android:rotation="0"
        android:layout_marginBottom="-10dp" />

    <!-- Message -->
    <TextView
        android:id="@+id/tooltipText"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="On enabling, this call will be dialed on priority. You can record up to 30 secs only"
        android:textColor="#000000"
        android:textSize="12sp"
        android:background="@android:color/white"
        android:padding="8dp"
        android:layout_marginTop="4dp" />
</LinearLayout>
