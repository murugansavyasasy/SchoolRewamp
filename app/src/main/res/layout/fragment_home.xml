<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    tools:context=".Parent.Coupon.CouponFragment.HomeFragment">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/dual_color_background">

        <ProgressBar
            android:id="@+id/isProgressBar"
            android:layout_width="@dimen/fifty"
            android:visibility="visible"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/fourty"
            android:layout_below="@+id/text_view"
            android:layout_height="@dimen/fifty">

        </ProgressBar>


        <RelativeLayout
            android:id="@+id/relative_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="center">

            <ImageView
                android:id="@+id/back"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/eight"
                android:layout_marginTop="@dimen/twenty"
                android:src="@drawable/left_arrow" />

            <TextView
                android:id="@+id/backtext"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignTop="@id/back"
                android:layout_marginStart="@dimen/eight"
                android:layout_marginTop="@dimen/one"
                android:layout_toEndOf="@id/back"
                android:gravity="center"
                android:text=""
                android:textColor="@color/black"
                android:textStyle="bold" />


            <ImageView
                android:id="@+id/imgSearchToolBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/twenty"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/twenty"
                android:src="@drawable/search_icon_white" />


        </RelativeLayout>


        <androidx.cardview.widget.CardView
            android:id="@+id/totalcoinscardview"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/relative_layout"
            android:layout_alignStart="@+id/recyclerView"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            app:cardBackgroundColor="@android:color/white"
            app:cardCornerRadius="@dimen/eleven"
            app:cardElevation="@dimen/eight">

            <LinearLayout
                android:id="@+id/lnrPoints"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:padding="@dimen/thirteen">

                <FrameLayout
                    android:layout_width="@dimen/fourty_eight"
                    android:layout_height="@dimen/fourty_eight"
                    android:layout_marginEnd="@dimen/twele"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="@dimen/twenty_six"
                        android:layout_height="@dimen/thirty_six"
                        android:layout_gravity="center"
                        android:src="@drawable/dollarsymbol" />
                </FrameLayout>

                <LinearLayout
                    android:layout_width="@dimen/zero"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/totalcoins"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=""
                        android:textColor="@color/black"
                        android:textSize="@dimen/sixteen_sp"
                        android:textStyle="bold" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/usedcoins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Used : "
                            android:textColor="@color/light_gray_6"
                            android:textSize="@dimen/fourteen_sp"
                            android:textStyle="normal" />

                        <TextView
                            android:id="@+id/availablecoins"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="Available : "
                            android:textColor="@color/light_gray_6"
                            android:textSize="@dimen/fourteen_sp"
                            android:textStyle="normal" />
                    </LinearLayout>

                </LinearLayout>
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <LinearLayout
            android:id="@+id/linearlayout"
            android:layout_width="match_parent"
            android:layout_height="@dimen/thirty_five"
            android:layout_below="@+id/totalcoinscardview"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/fifteen"
            android:visibility="gone"
            android:layout_marginEnd="@dimen/ten"
            android:background="@drawable/bg_search"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/twele">

            <ImageView
                android:id="@+id/imgSearch"
                android:layout_width="@dimen/thirty"
                android:layout_height="@dimen/thirty"
                android:src="@drawable/search_icon" />

            <EditText
                android:id="@+id/editSearch"
                android:layout_width="@dimen/zero"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ten"
                android:layout_weight="1"
                android:background="@null"
                android:hint="@string/search"
                android:inputType="text"
                android:textColor="@color/black"
                android:textColorHint="@color/light_gray_7"
                android:textSize="@dimen/sixteen_sp"
                android:visibility="visible" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear_layout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/linearlayout"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/fifteen_sp"
            android:orientation="horizontal">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerview1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:clipToPadding="false"
                android:fadeScrollbars="false"
                android:paddingHorizontal="@dimen/ten"
                android:scrollbars="none" />
        </LinearLayout>

        <TextView
            android:id="@+id/text_view"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/linear_layout1"
            android:layout_alignStart="@+id/recyclerView"
            android:layout_marginStart="@dimen/thirteen"
            android:layout_marginTop="@dimen/five"
            android:text="@string/all_coupons"
            android:textColor="@color/black"
            android:textSize="@dimen/eighteen_sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/text_view"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:layout_marginBottom="@dimen/five"
            android:clipToPadding="false"
            android:scrollIndicators="none"
            android:scrollbars="vertical" />



        <TextView
            android:id="@+id/lblNoRecord"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/text_view"
            android:layout_marginTop="@dimen/hundred"
            android:gravity="center"
            android:text="@string/no_records_found"
            android:textColor="@color/black"
            android:textSize="@dimen/fifteen_sp"
            android:textStyle="bold"
            android:visibility="gone">



        </TextView>


        <ImageView
            android:id="@+id/nomessage"
            android:layout_width="@dimen/two_fifty"
            android:layout_centerHorizontal="true"
            android:layout_height="@dimen/two_fifty"
            android:layout_below="@+id/text_view"
            android:layout_marginTop="@dimen/twenty"
            android:src="@drawable/nomessages"
            android:textColor="@color/black"
            android:textSize="@dimen/eighteen_sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtNoData"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/twenty"
            android:text="@string/no_list_found"
            android:textColor="@color/black"
            android:textSize="@dimen/eighteen_sp"
            android:layout_below="@+id/nomessage"
            android:gravity="center"
            android:visibility="gone" />


    </RelativeLayout>
</FrameLayout>