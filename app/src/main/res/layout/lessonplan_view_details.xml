<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:id="@+id/rlaHeader"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/white">

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar" />
    <HorizontalScrollView
        android:id="@+id/tabLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/five"
        android:layout_marginEnd="@dimen/fifteen"
        android:layout_marginBottom="@dimen/five"
        android:background="@color/white"
        android:layout_below="@+id/toolbarLayout"
        android:fillViewport="true"
        android:padding="@dimen/two"
        android:scrollbars="none">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/ten"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/allbutton"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:gravity="center"
                android:paddingStart="@dimen/thirty_sp"
                android:paddingEnd="@dimen/thirty_sp"
                android:text="@string/all"
                android:textColor="@color/black"
                android:textSize="@dimen/twele_sp">
            </TextView>

            <TextView
                android:id="@+id/ytsbutton"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/fifteen"
                android:layout_marginEnd="@dimen/five"
                android:gravity="center"
                android:padding="@dimen/ten"
                android:text="@string/yet_to_start"
                android:paddingStart="@dimen/eighteen_sp"
                android:paddingEnd="@dimen/eighteen_sp"
                android:textSize="@dimen/twele_sp" />

            <TextView
                android:id="@+id/inprogressbutton"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="@dimen/five"
                android:gravity="center"
                android:padding="@dimen/ten"
                android:paddingStart="@dimen/eighteen_sp"
                android:paddingEnd="@dimen/eighteen_sp"
                android:text="@string/in_progress"
                android:textSize="@dimen/twele_sp" />


            <TextView
                android:id="@+id/completedbutton"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="match_parent"
                android:layout_gravity="center"
                android:layout_marginStart="@dimen/fifteen"
                android:layout_marginEnd="@dimen/ten"
                android:gravity="center"
                android:padding="@dimen/ten"
                android:paddingStart="@dimen/eighteen_sp"
                android:paddingEnd="@dimen/eighteen_sp"
                android:text="@string/completed"
                android:textSize="@dimen/twele_sp">
            </TextView>


        </LinearLayout>
    </HorizontalScrollView>

    <RelativeLayout
        android:id="@+id/rytSearch"
        android:layout_width="match_parent"
        android:layout_height="@dimen/thirty_five"
        android:layout_margin="@dimen/ten"
        android:layout_marginStart="@dimen/ten"
        android:layout_below="@+id/tabLayout1"
        android:background="@drawable/rect_grey">


        <ImageView
            android:id="@+id/imgSearch"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/ten"
            android:src="@drawable/ic_search" />

        <EditText
            android:id="@+id/txtSearchMenu"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toEndOf="@+id/imgSearch"
            android:background="@android:color/transparent"
            android:hint="@string/lblSearch"
           style="@style/CustomTextStylePoppinsRegular"
            android:textSize="@dimen/thirteen_sp" />

    </RelativeLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcyLessonViewPlan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rytSearch"
        android:layout_marginTop="@dimen/ten"
        />

    <ImageView
        android:id="@+id/nomessage"
        android:layout_width="@dimen/two_fifty"
        android:layout_height="@dimen/two_fifty"
        android:layout_centerInParent="true"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/twenty"
        android:src="@drawable/nomessages"
        android:textColor="@color/black"
        android:textSize="@dimen/eighteen_sp"
        android:visibility="gone" />


    <TextView
        android:id="@+id/txtNoData"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/twenty"
        android:text="@string/no_list_found"
        android:textColor="@color/black"
        android:textSize="@dimen/eighteen_sp"
        android:layout_below="@+id/nomessage"
        android:visibility="gone" />


</RelativeLayout>