<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:orientation="vertical"
    android:id="@+id/main"
    android:background="@color/colorPrimaryRadiant">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/PrimaryColor"
        android:orientation="vertical"
        android:paddingStart="16dp"
        android:paddingEnd="16dp"
        android:paddingBottom="28dp">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="12dp">

            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:src="@drawable/arrow_left_white" />

            <TextView
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="8dp"
                android:text="@string/create_class_test"
                android:textColor="@color/white"
                android:textSize="16sp"
                style="@style/CustomTextStylePoppinsBold" />

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Step 4 of 5"
                android:textColor="#CCFFFFFF"
                android:textSize="13sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:id="@+id/linear_layoutcreate"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:paddingTop="@dimen/eight">

            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/create_class_test"
                android:textColor="@color/white"
                android:maxLines="1"
                android:ellipsize="end"
                android:textSize="@dimen/twenty_four_sp" />



        </LinearLayout>




        <TextView
            style="@style/CustomTextStylePoppinsRegular"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/two"
            android:layout_marginTop="@dimen/four"
            android:text="@string/note_these_class_tests_and_its_marks_will_not_be_considered_for_report_card_and_calculations"
            android:textColor="@color/white"
            android:textSize="@dimen/thirteen_sp" />
        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="2dp"
            android:text="@string/configure_each_test"
            android:visibility="gone"
            android:textColor="#CCFFFFFF"
            android:textSize="13sp" />

        <LinearLayout
            android:id="@+id/linear_viewmarkanalysis"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:paddingTop="@dimen/eight">

            <TextView
                android:id="@+id/viewmarkanalysis"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginStart="@dimen/eight"
                android:text="@string/view_mark_analysis"
                android:textColor="@color/white"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="start"
                android:textSize="@dimen/fourteen_sp" />

            <TextView
                android:id="@+id/viewreporttext"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/eight"
                android:layout_marginEnd="@dimen/ten"
                android:text="@string/view_created_test"
                android:textColor="@color/white"
                android:maxLines="1"
                android:ellipsize="end"
                android:gravity="end"
                android:textSize="@dimen/fourteen_sp" />

        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lytContent"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:background="@drawable/rect_white_top_rounded"
        android:orientation="vertical"
        android:layout_marginStart="20dp"
        android:layout_marginEnd="20dp"
        android:layout_marginBottom="5dp"
        android:layout_marginTop="-20dp">

        <include
            android:id="@+id/stepIndicator"
            layout="@layout/layout_step_indicator"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="4dp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="12dp"
            android:paddingBottom="8dp">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/test_name"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    style="@style/CustomTextStylePoppinsBold" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="2dp"
                    android:text="*"
                    android:textColor="@color/red"
                    android:textSize="14sp"
                    android:textStyle="bold" />
            </LinearLayout>

            <EditText
                android:id="@+id/etExamName"
                android:layout_width="match_parent"
                android:layout_height="35dp"
                android:layout_marginTop="8dp"
                android:background="@drawable/input_field_bg"
                android:paddingStart="14dp"
                android:paddingEnd="14dp"
                android:inputType="textCapSentences"
                android:textSize="13sp"
                android:textColor="@color/black"
                android:singleLine="true" />

        </LinearLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcClassList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:paddingTop="4dp"
            android:paddingBottom="8dp"
            android:clipToPadding="false"
            android:visibility="gone" />

        <LinearLayout
            android:id="@+id/lytList"
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <TextView
                android:id="@+id/txtNoData"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="#9E9E9E"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:paddingStart="16dp"
            android:paddingEnd="16dp"
            android:paddingTop="10dp"
            android:paddingBottom="14dp"
            android:background="@color/white"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/btnBack"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="0dp"
                android:layout_height="@dimen/fourty"
                android:layout_marginEnd="@dimen/eight"
                android:layout_weight="0.35"
                android:background="@drawable/rect_white_border_rounded"
                android:text="@string/back_text"
                android:gravity="center"
                android:textColor="@color/PrimaryColor"
                android:textSize="@dimen/twele_sp" />

            <TextView
                android:id="@+id/btnContinue"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="0dp"
                android:layout_height="@dimen/fourty"
                android:layout_weight="0.65"
                android:background="@drawable/rect_primary_rounded"
                android:text="@string/continue_text"
                android:gravity="center"
                android:textColor="@color/white"
                android:textSize="@dimen/twele_sp" />
        </LinearLayout>

    </LinearLayout>

</LinearLayout>