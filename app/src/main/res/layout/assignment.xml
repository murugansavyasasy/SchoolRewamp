<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_white"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/toolbarLayout"
            layout="@layout/school_side_tool_bar" />


        <LinearLayout
            android:id="@+id/toolbarLayout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/toolbarLayout"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:visibility="gone"
            android:layout_marginEnd="@dimen/ten"
            android:orientation="horizontal"
            android:weightSum="1">

            <LinearLayout
                android:id="@+id/lnrTabOneName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tabOneName"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/Create"
                    android:textColor="@color/iconBlue">
                </TextView>

                <View
                    android:id="@+id/line1"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/three"
                    android:layout_below="@+id/groupheading"
                    android:layout_marginTop="@dimen/five"
                    android:background="@color/iconBlue">
                </View>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/lnrTabTwoName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tabTwoName"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/Reports">
                </TextView>

                <View
                    android:id="@+id/line3"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/three"
                    android:layout_below="@+id/groupheading"
                    android:layout_marginTop="@dimen/five"
                    android:background="@color/white">
                </View>
            </LinearLayout>

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/rytCreateAssignment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/toolbarLayout1"
            android:layout_marginTop="@dimen/ten"
            android:visibility="visible">

            <TextView
                android:id="@+id/lblCategory"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:text="@string/Catogory"
                android:textSize="@dimen/fifteen_sp">

            </TextView>

            <RelativeLayout
                android:id="@+id/rytSendingType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblCategory"
                android:layout_marginStart="@dimen/fifteen"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/fifteen"
                android:background="@drawable/bg_white_light_radious"
                android:gravity="center">

                <Spinner
                    android:id="@+id/spinnerType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/custom_spinner_background" />

            </RelativeLayout>

            <TextView
                android:id="@+id/lblTitle"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rytSendingType"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:text="@string/Title"
                android:textSize="@dimen/fifteen_sp">

            </TextView>

            <LinearLayout
                android:id="@+id/lnrTitle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fourty_five"
                android:layout_below="@+id/lblTitle"
                android:layout_marginStart="@dimen/fifteen"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/fifteen"
                android:background="@drawable/field_background"
                android:gravity="center_vertical"
                android:orientation="horizontal">



            <EditText
                android:paddingHorizontal="@dimen/ten"
                android:id="@+id/edtTitle"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="match_parent"
                android:background="@android:color/transparent"
                android:layout_height="match_parent">



            </EditText>

            </LinearLayout>

            <TextView
                android:id="@+id/lblTitleTextCount"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lnrTitle"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/five"
                android:layout_marginEnd="@dimen/fifteen"
                android:text="0 / 50"
                android:visibility="gone"
                android:textColor="@color/light_gray">

            </TextView>

            <TextView
                android:id="@+id/lblDescription"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblTitleTextCount"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:text="@string/Description"
                android:textSize="@dimen/fifteen_sp">

            </TextView>

            <LinearLayout
                android:id="@+id/lnrDesc"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hundred"
                android:layout_below="@+id/lblDescription"
                android:layout_marginStart="@dimen/fifteen"
                android:layout_marginTop="@dimen/fifteen"
                android:layout_marginEnd="@dimen/ten"
                android:background="@drawable/field_background"
                android:gravity="center_vertical"
                android:orientation="horizontal">



            <EditText
                android:id="@+id/edtDescription"
                style="@style/CustomTextStylePoppinsRegular"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:editable="true"
                android:focusable="true"
                android:background="@android:color/transparent"
                android:focusableInTouchMode="true"
                android:gravity="start"
                android:hint="@string/Description"
                android:padding="@dimen/ten"
                android:textSize="@dimen/thirteen_sp">

            </EditText>

            </LinearLayout>


            <TextView
                android:id="@+id/lblTextCount"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lnrDesc"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/fifteen"
                android:text="0 / 500"
                android:visibility="gone"
                android:textColor="@color/light_gray">

            </TextView>

            <TextView
                android:id="@+id/lblSubDate"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblTextCount"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/ten"
                android:text="@string/SubmissionDate"
                android:textSize="@dimen/fifteen_sp">

            </TextView>

            <ImageView
                android:id="@+id/imgCalender"
                android:layout_width="@dimen/twenty_five"
                android:layout_height="@dimen/twenty_five"
                android:layout_below="@+id/lblSubDate"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:src="@drawable/calender_icon">
            </ImageView>


            <TextView
                android:id="@+id/lblDatePick"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblSubDate"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:layout_toEndOf="@+id/imgCalender"
                android:drawableEnd="@drawable/ic_down_arrow"
                android:drawablePadding="@dimen/ten"
                android:text="">

            </TextView>

            <TextView
                android:id="@+id/lblTimePick"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblSubDate"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/fifteen"
                android:drawableEnd="@drawable/ic_down_arrow"
                android:drawablePadding="@dimen/ten"
                android:text="12:12 PM">
            </TextView>


            <RelativeLayout
                android:id="@+id/rlaFilePicking"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/lblTimePick"
                android:layout_marginTop="@dimen/five">

                <TextView
                    android:id="@+id/lblAddPhoto"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fifteen"
                    android:layout_marginTop="@dimen/ten"
                    android:text="@string/add_attachment"
                    android:textColor="@color/black">

                </TextView>

                <TextView
                    android:id="@+id/lblOptional"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_toEndOf="@+id/lblAddPhoto"
                    android:text="@string/Optional"
                    style="@style/CustomTextStylePoppinsBold"
                    android:textColor="@color/mild_grey1"
                    android:textSize="@dimen/thirteen_sp">

                </TextView>

                <ImageView
                    android:layout_width="@dimen/twenty_five"
                    android:layout_height="@dimen/twenty_five"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/twenty"
                    android:src="@drawable/ic_attach_file">

                </ImageView>

                <RelativeLayout
                    android:id="@+id/rytRecyclewview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lblAddPhoto">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rcyImages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ten"
                        android:orientation="vertical">

                    </androidx.recyclerview.widget.RecyclerView>
                </RelativeLayout>


                <TextView
                    android:id="@+id/btnChooseRecipient"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/rytRecyclewview"
                    android:layout_marginStart="@dimen/twenty_five"
                    android:layout_marginTop="@dimen/fifty"
                    android:layout_marginEnd="@dimen/twenty_five"
                    android:layout_marginBottom="@dimen/thirty"
                    android:background="@drawable/rect_btn_orange"
                    android:gravity="center"
                    android:padding="@dimen/ten"
                    android:text="@string/ChooseRecipients"
                    android:textColor="@color/white"
                    android:textSize="@dimen/thirteen_sp">

                </TextView>
            </RelativeLayout>

        </RelativeLayout>

