<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:layout_marginHorizontal="@dimen/sixteen"
        android:paddingVertical="@dimen/twenty"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/subjectName"
        android:text="Mathematics"
        android:textSize="17sp"
        android:paddingStart="12dp"
        android:textColor="@color/black"/>



    <LinearLayout
        android:paddingVertical="@dimen/twenty"
        android:layout_marginHorizontal="@dimen/sixteen"
        android:id="@+id/lnrFlexContainer"
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:paddingTop="@dimen/fifteen"
        android:background="@color/white"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:id="@+id/spinnerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/ten"
            android:background="@drawable/field_background"
            android:padding="@dimen/ten">

            <Spinner
                android:id="@+id/isMenuSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:background="@android:color/transparent"
                android:spinnerMode="dropdown"
                android:paddingEnd="40dp"
                android:textColor="@color/black" />

            <ImageView
                android:id="@+id/spinnerCorrectAnswerimg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/three"
                android:src="@drawable/ic_drop_down"
                app:tint="@color/black" />
        </RelativeLayout>

    </LinearLayout>
    <View
        android:layout_width="match_parent"
        android:background="@color/AthensGray"
        android:layout_height="@dimen/one">

    </View>


</LinearLayout>
