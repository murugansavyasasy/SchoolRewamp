<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/ImageLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/rytHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@+id/imgMoreOptions"
        android:paddingVertical="@dimen/twenty">

        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/fifteen"
            android:src="@drawable/arrow_back_black" />

        <TextView
            android:id="@+id/lblSubject"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="match_parent"
            android:layout_toEndOf="@+id/imgBack"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:text=""
            android:textColor="@color/black"
            android:textSize="@dimen/fifteen_sp"
            android:visibility="visible" />
    </RelativeLayout>

    <ImageView
        android:id="@+id/imgMoreOptions"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="@dimen/twenty"
        android:layout_marginEnd="@dimen/ten"
        android:background="?attr/selectableItemBackgroundBorderless"
        android:padding="@dimen/five"
        android:src="@drawable/ic_more_vert" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcyFile"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/indicator"
        android:layout_below="@+id/rytHeader"
        android:visibility="visible"
        android:layout_marginTop="8dp"
        android:layout_marginBottom="@dimen/ten"
        android:orientation="horizontal"
        android:overScrollMode="never"
        android:scrollbars="horizontal" />

    <me.relex.circleindicator.CircleIndicator2
        android:id="@+id/indicator"
        style="@style/IndicatorStyle"
        android:layout_width="wrap_content"
        android:layout_height="@dimen/thirty"
        android:layout_above="@+id/lnrPrevious"
        android:layout_centerInParent="true"
        android:elevation="4dp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/lnrPrevious"
        android:layout_width="@dimen/seventy"
        android:layout_height="@dimen/seventy"
        android:layout_alignParentStart="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:background="@drawable/bg_round_radious_white"
        android:gravity="center"
        android:paddingStart="@dimen/fifteen"
        android:paddingTop="@dimen/fifteen"
        android:paddingEnd="@dimen/twenty_five"
        android:paddingBottom="@dimen/fifteen">

        <ImageView
            android:id="@+id/imgPre"
            android:layout_width="@dimen/twenty"
            android:layout_height="@dimen/twenty"
            android:src="@drawable/left_arrow" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lnrNext"
        android:layout_width="@dimen/seventy"
        android:layout_height="@dimen/seventy"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_margin="16dp"
        android:background="@drawable/bg_round_radious_white"
        android:gravity="center"
        android:paddingStart="@dimen/twenty_five"
        android:paddingTop="@dimen/fifteen"
        android:paddingEnd="@dimen/twenty_five"
        android:paddingBottom="@dimen/fifteen">

        <ImageView
            android:id="@+id/imgNext"
            android:layout_width="@dimen/twenty"
            android:layout_height="@dimen/twenty"
            android:src="@drawable/rightarrrow" />
    </LinearLayout>

    <LinearLayout
        android:id="@+id/lnrDownloadStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:background="#80000000"
        android:layout_marginEnd="@dimen/twenty_five"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="12dp"
        android:visibility="gone"
        android:elevation="10dp">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:layout_marginEnd="8dp"
            android:indeterminate="true"
            android:visibility="visible" />

        <TextView
            android:id="@+id/lblDownloading"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Downloading..."
            android:textColor="#FFFFFF"
            android:textSize="16sp"
            android:visibility="visible" />
    </LinearLayout>

</RelativeLayout>
