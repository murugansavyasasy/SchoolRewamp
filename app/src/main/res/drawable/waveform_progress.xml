<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:id="@android:id/background">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="4dp" />
            </shape>
        </clip>
        <layer-list>
            <item android:left="0dp" android:right="90mm">
                <shape android:shape="rectangle">
                    <solid android:color="#BDBDBD" />
                    <size android:width="4dp" android:height="2dp" />
                </shape>
            </item>
            <item android:left="5mm" android:right="85mm">
                <shape android:shape="rectangle">
                    <solid android:color="#BDBDBD" />
                    <size android:width="4dp" android:height="8dp" />
                </shape>
            </item>
            <item android:left="10mm" android:right="80mm">
                <shape android:shape="rectangle">
                    <solid android:color="#BDBDBD" />
                    <size android:width="4dp" android:height="4dp" />
                </shape>
            </item>
            <item android:left="15mm" android:right="75mm">
                <shape android:shape="rectangle">
                    <solid android:color="#BDBDBD" />
                    <size android:width="4dp" android:height="12dp" />
                </shape>
            </item>
            <item android:left="20mm" android:right="70mm">
                <shape android:shape="rectangle">
                    <solid android:color="#BDBDBD" />
                    <size android:width="4dp" android:height="6dp" />
                </shape>
            </item>
            <item android:left="25mm" android:right="65mm">
