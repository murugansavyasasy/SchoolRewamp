<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
   >
    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar" />


    <TextView
        android:id="@+id/lbltitle"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/five"
        android:layout_marginTop="@dimen/fifteen"
        android:layout_below="@+id/toolbarLayout"
        android:layout_marginEnd="@dimen/twenty_five"
        android:gravity="start"
        android:textSize="@dimen/twenty_sp"
        android:text="Submission"
        >

    </TextView>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcystudentlistdetail"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lbltitle"
        android:layout_marginTop="@dimen/ten"
        android:visibility="visible">

    </androidx.recyclerview.widget.RecyclerView>



    <ImageView
        android:id="@+id/nomessage"
        android:layout_width="@dimen/two_fifty"
        android:layout_height="@dimen/two_fifty"
        android:layout_centerInParent="true"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/twenty"
        android:src="@drawable/nomessages"
        android:textColor="@color/black"
        android:textSize="@dimen/eighteen_sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtNoData"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/twenty"
        android:text="@string/no_list_found"
        android:textColor="@color/black"
        android:textSize="@dimen/eighteen_sp"
        android:layout_below="@+id/nomessage"
        android:gravity="center"
        android:visibility="gone" />


</RelativeLayout>