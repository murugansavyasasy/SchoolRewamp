<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar" />

    <ScrollView
        android:id="@+id/noticeboardCreate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbarLayout"
        android:layout_marginHorizontal="@dimen/ten"
        android:layout_marginTop="@dimen/ten"
        android:scrollbars="none">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:padding="@dimen/ten">

            <TextView
                android:id="@+id/lblEventTitle"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="10dp"
                android:layout_marginTop="20dp"
                android:text="@string/Title"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />


            <TextView
                android:id="@+id/lblStar"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/two"
                android:layout_marginTop="@dimen/eighteen"
                android:layout_toEndOf="@id/lblEventTitle"
                android:text="@string/mandatory"
                android:textColor="@color/red"
                android:textSize="@dimen/thirteen_sp" />


            <EditText
                android:id="@+id/txtTitle"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblEventTitle"
                android:layout_alignStart="@+id/lblEventTitle"
                android:layout_marginTop="@dimen/fifteen"
                android:layout_marginEnd="10dp"
                android:background="@drawable/bg_edittext_view_line"
                android:hint="Title"
                android:inputType="text"
                android:paddingBottom="@dimen/ten"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />

            <TextView
                android:id="@+id/lbtitleTextCount"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtTitle"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="15dp"
                android:text="0 of 50"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />

            <TextView
                android:id="@+id/lblEventDesc"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lbtitleTextCount"
                android:layout_alignStart="@+id/txtTitle"
                android:layout_marginTop="@dimen/ten"
                android:text="@string/Description"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />


            <TextView
                android:id="@+id/lblStar2"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lbtitleTextCount"
                android:layout_marginStart="@dimen/two"
                android:layout_marginTop="@dimen/eight"
                android:layout_toEndOf="@id/lblEventDesc"
                android:text="@string/mandatory"
                android:textColor="@color/red"
                android:textSize="@dimen/thirteen_sp" />


            <RelativeLayout
                android:id="@+id/rytDesc"
                android:layout_width="match_parent"
                android:layout_height="@dimen/one_twenty"
                android:layout_below="@+id/lblEventDesc"
                android:layout_alignStart="@+id/lblEventDesc"
                android:layout_alignEnd="@+id/txtTitle"
                android:layout_marginTop="@dimen/fifteen"
                android:background="@drawable/bg_stroke_rect_black"
                android:paddingHorizontal="@dimen/ten"
                android:paddingVertical="@dimen/ten">

                <EditText
                    android:id="@+id/txtDesc"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:gravity="top"
                    android:hint="@string/Description"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp" />


            </RelativeLayout>

            <TextView
                android:id="@+id/lbTextCount"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rytDesc"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="15dp"
                android:text="@string/_0_of_500"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lbTextCount"
                android:layout_alignStart="@+id/rytDesc"
                android:layout_alignEnd="@+id/rytDesc"
                android:layout_marginTop="@dimen/ten">


                <RelativeLayout
                    android:id="@+id/rytEventDateTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"

                    >


                    <TextView
                        android:id="@+id/lblStart"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ten"
                        android:text="Notice Display Date Range"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp" />

                    <TextView
                        android:id="@+id/lblStar3"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/two"
                        android:layout_marginTop="@dimen/eight"
                        android:layout_toEndOf="@id/lblStart"
                        android:text="@string/mandatory"
                        android:textColor="@color/red"
                        android:textSize="@dimen/thirteen_sp" />


                    <LinearLayout
                        android:id="@+id/rytStart"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@+id/lblStart"
                        android:layout_marginTop="20dp"
                        android:gravity="center"
                        android:orientation="horizontal"
                        android:weightSum="3">

                        <RelativeLayout
                            android:id="@+id/rytStartDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardStart"
                                android:layout_width="100dp"
                                android:layout_height="80dp"
                                app:cardCornerRadius="@dimen/ten">

                                <LinearLayout
                                    android:id="@+id/lnrStartCalendar"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_stroke_rect_black"
                                    android:orientation="vertical">

                                    <LinearLayout
                                        android:id="@+id/bottomdaylinear"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="@color/primary_light"
                                        android:gravity="center"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/lblDaylabel"
                                            style="@style/CustomTextStylePoppinsBold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center_horizontal"
                                            android:layout_marginTop="@dimen/five"
                                            android:text="From"
                                            android:layout_marginBottom="3dp"
                                            android:textColor="@color/black"
                                            android:textSize="@dimen/fifteen_sp" />

                                    </LinearLayout>

                                    <LinearLayout
                                        android:id="@+id/bottomlineardate"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical">


                                        <TextView
                                            android:id="@+id/lblDay"
                                            style="@style/CustomTextStylePoppinsBold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="12"
                                            android:textColor="@color/black"
                                            android:textSize="@dimen/fifteen_sp" />

                                        <TextView
                                            android:id="@+id/txtStartDate"
                                            style="@style/CustomTextStylePoppinsBold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Fri, Jun 2025"
                                            android:layout_marginTop="3dp"
                                            android:textColor="@color/grey"
                                            android:textSize="12sp" />


                                    </LinearLayout>

                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>


                        <ImageView
                            android:id="@+id/imagearrow_view"
                            android:layout_width="@dimen/sixteen"
                            android:layout_height="@dimen/sixteen"
                            android:layout_weight="1"
                            android:src="@drawable/exchangearrow">
                        </ImageView>


                        <RelativeLayout
                            android:id="@+id/rytEndDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center">

                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardEnd"
                                android:layout_width="100dp"
                                android:layout_height="80dp"
                                app:cardCornerRadius="@dimen/ten">

                                <LinearLayout
                                    android:id="@+id/lnrEndCalendar"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_stroke_rect_black"
                                    android:orientation="vertical">

                                    <LinearLayout
                                        android:id="@+id/bottomdaylinear1"
                                        android:layout_width="match_parent"
                                        android:layout_height="wrap_content"
                                        android:background="@color/primary_light"
                                        android:gravity="center"
                                        android:orientation="vertical">

                                        <TextView
                                            android:id="@+id/lblDay1"
                                            style="@style/CustomTextStylePoppinsBold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_gravity="center_horizontal"
                                            android:layout_marginTop="@dimen/five"
                                            android:text="To"
                                            android:layout_marginBottom="3dp"

                                            android:textColor="@color/black"
                                            android:textSize="@dimen/fifteen_sp" />

                                    </LinearLayout>

                                    <LinearLayout
                                        android:id="@+id/bottomlineardate1"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:orientation="vertical">


                                        <TextView
                                            android:id="@+id/lblEndDay"
                                            style="@style/CustomTextStylePoppinsBold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="28"
                                            android:textColor="@color/black"
                                            android:textSize="@dimen/fifteen_sp" />

                                        <TextView
                                            android:id="@+id/txtEndDate"
                                            style="@style/CustomTextStylePoppinsBold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:text="Fri, Jun 2025"
                                            android:layout_marginTop="3dp"

                                            android:textColor="@color/grey"
                                            android:textSize="12sp" />


                                    </LinearLayout>

                                </LinearLayout>
                            </androidx.cardview.widget.CardView>
                        </RelativeLayout>


                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/linaerlayout"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/rytStart"
                        android:layout_marginTop="20dp"
                        android:orientation="horizontal">


                        <TextView
                            android:id="@+id/lblAddPhoto"
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ten"
                            android:text="Add Attachment"
                            android:textColor="@color/black"
                            android:textSize="@dimen/thirteen_sp" />

                        <TextView
                            android:id="@+id/optionallabel"
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:layout_marginTop="@dimen/ten"
                            android:text="(Optional)"
                            android:textColor="@color/grey"
                            android:textSize="@dimen/thirteen_sp" />


                    </LinearLayout>


                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rcyImages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/linaerlayout"
                        android:layout_marginTop="@dimen/ten"
                        android:orientation="vertical">

                    </androidx.recyclerview.widget.RecyclerView>

                    <TextView
                        android:id="@+id/btnNext"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/fourty"
                        android:layout_below="@+id/rcyImages"
                        android:layout_marginTop="@dimen/thirty"
                        android:layout_marginBottom="20dp"
                        android:background="@drawable/rect_btn_orange"
                        android:gravity="center"
                        android:text="@string/NEXT"
                        android:textColor="@color/white"
                        android:textSize="@dimen/thirteen_sp" />

                </RelativeLayout>
            </RelativeLayout>
        </RelativeLayout>
    </ScrollView>
</RelativeLayout>