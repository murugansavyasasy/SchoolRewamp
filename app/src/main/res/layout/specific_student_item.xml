<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:id="@+id/lytName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/ten">

        <!-- Circular Initial Avatar -->
        <RelativeLayout
            android:id="@+id/fytFirstLetter"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:layout_marginEnd="@dimen/ten"
            android:gravity="center">

            <TextView
                android:id="@+id/lblFirstLetter"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="S"
                android:textColor="@android:color/black"
                android:textSize="@dimen/thirteen_sp"
                android:fontFamily="@font/poppins_bold"
                android:textStyle="bold" />
        </RelativeLayout>

        <!-- Name and Details Section -->
        <LinearLayout
            android:id="@+id/lnrDetails"
            android:layout_width="@dimen/zero"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lblName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="sathish             "
                style="@style/CustomTextStylePoppinsBold"
                android:textColor="@android:color/black"
                android:textSize="@dimen/thirteen_sp"
                />

            <TextView
                android:id="@+id/lblRegNo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ajith"
                style="@style/CustomTextStylePoppinsMedium"
                android:textColor="@color/light_gray"
                android:textSize="@dimen/thirteen_sp"
                 />

        </LinearLayout>

        <!-- Down Arrow Animation -->
        <ImageView
            android:id="@+id/ivArrow"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/fourty"
            android:visibility="gone"
            android:layout_marginEnd="@dimen/thirty"
            android:padding="@dimen/five"
            android:src="@drawable/ic_down_round" />

        <!-- Custom Checkbox -->
<!--        <CheckBox-->
<!--            android:id="@+id/cbSelect"-->
<!--            android:layout_width="@dimen/thirty"-->
<!--            android:layout_height="@dimen/thirty"-->
<!--            style="@style/CustomCheckBox"-->
<!--            android:layout_marginEnd="@dimen/fifteen"-->
<!--            android:button="@drawable/ch_square" />-->

        <CheckBox
            android:id="@+id/cbSelect"
            android:layout_width="wrap_content"
            style="@style/CustomCheckBox"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/point_five"
        android:layout_below="@+id/lytName"
        android:layout_marginTop="@dimen/five"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:background="@color/grey_mild">

    </View>
</RelativeLayout>
