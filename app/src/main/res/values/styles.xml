<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CustomCheckbox" parent="@style/Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:button">@drawable/custom_checkbox</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="HintTextStyle" parent="TextAppearance.Design.Hint">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Teacher_spinnerDropDownItemStyle" parent="android:TextAppearance.Widget.TextView.SpinnerItem"></style>

    <style name="Circular">
        <item name="cornerSize">50%</item>
    </style>

    <style name="IndicatorStyle">
        <item name="ci_width">8dp</item>
        <item name="ci_height">8dp</item>
        <item name="ci_margin">6dp</item>
        <item name="ci_drawable">@drawable/indicator_active</item>
        <item name="ci_drawable_unselected">@drawable/indicator_inactive</item>
    </style>



    <style name="PopupAnimation">
        <item name="android:windowEnterAnimation">@anim/bottom_to_top</item>
    </style>

    <!-- styles.xml -->
    <style name="CustomTextStyle" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/american_typewriter_bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#000000</item>
    </style>


    <!-- styles.xml -->
    <style name="CustomTextStyleAttendanceReportDashBoard" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/futura_bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#000000</item>
    </style>

    <!-- styles.xml -->
    <style name="CustomTextStyleAttendanceReportDashBoardRegular" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/futura_regular</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#000000</item>
    </style>


    <!-- styles.xml -->

    <style name="CustomTextStylePoppinsBold1" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textSize">@dimen/thirteen_sp</item>
        <item name="android:textColor">@color/black</item>
    </style>


    <style name="CustomTextStylePoppinsBold" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/inter_bold</item>
        <item name="android:textSize">@dimen/thirteen_sp</item>
        <item name="android:textColor">@color/black</item>
    </style>



    <style name="CustomTextStylePoppinsRegular" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/inter_regular</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">normal</item>
        <item name="android:lineSpacingExtra">@dimen/line_spacing</item>

    </style>


    <style name="RoundedAllCornersEvenly" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSizeTopLeft">10dp</item>
        <item name="cornerSizeTopRight">10dp</item>
        <item name="cornerSizeBottomLeft">10dp</item>
        <item name="cornerSizeBottomRight">10dp</item>
    </style>

    <style name="CustomTextStylePoppinsMedium1" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textSize">@dimen/thirteen_sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CustomTextStylePoppinsMedium" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textSize">@dimen/thirteen_sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:lineSpacingExtra">@dimen/line_spacing</item>

    </style>


    <style name="TabTextStyle">
        <item name="fontFamily">@font/inter_medium</item>
        <item name="android:textSize">@dimen/thirteen_sp</item>
        <item name="android:textColor">#000000</item>
    </style>


    <!-- res/values/styles.xml -->
    <style name="CustomCheckBox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:buttonTint">@color/black</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="RoundedSquare" parent="">
        <item name="cornerSize">18dp</item>
        <item name="cardCornerRadius">18dp</item>

    </style>

    <style name="ImageMediumRoundedCorners" parent="ShapeAppearance.MaterialComponents.MediumComponent">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">10dp</item>
    </style>


    <style name="WeekDayStyle">
        <item name="android:layout_width">0dp</item>
        <item name="android:layout_weight">1</item>
        <item name="android:layout_height">wrap_content</item>
        <item name="android:gravity">center</item>
        <item name="android:textColor">#000000</item>
        <item name="android:textSize">14sp</item>
        <item name="android:textStyle">bold</item>
        <item name="android:padding">4dp</item>
    </style>


    <style name="CircleImageShape" parent="">
        <item name="cornerFamily">rounded</item>
        <item name="cornerSize">50%</item>
    </style>

    <style name="CustomTabTextAppearance" parent="TextAppearance.Design.Tab">
        <item name="android:textSize">10sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CustomAudioSeekBar" parent="Widget.AppCompat.SeekBar">
        <item name="android:progressDrawable">@drawable/custom_seekbar_progress</item>
        <item name="android:thumb">@drawable/custom_seekbar_thumb</item>
    </style>

    <style name="BottomSheetDialogTheme" parent="Theme.Design.Light.BottomSheetDialog">
        <item name="bottomSheetStyle">@style/BottomSheetStyle</item>
    </style>

    <style name="BottomSheetStyle" parent="Widget.Design.BottomSheet.Modal">
        <item name="android:background">@drawable/bottom_sheet_bg</item>
    </style>




</resources>