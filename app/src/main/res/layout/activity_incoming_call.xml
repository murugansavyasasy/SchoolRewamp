<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/black"
    android:padding="@dimen/twenty_five">

    <TextView
        android:id="@+id/tvCaller"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Incoming Call"
        android:textColor="@android:color/white"
        android:textSize="@dimen/twenty_five_sp"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="80dp"/>

    <ImageView
        android:id="@+id/imgUser"
        android:layout_width="@dimen/one_twenty"
        android:layout_height="@dimen/one_twenty"
        android:layout_below="@+id/tvCaller"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/twenty"
        android:src="@drawable/school_splash_logo"
        android:background="@drawable/circle_bg"
        android:padding="@dimen/twenty" />

    <TextView
        android:id="@+id/tvDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="00:00 / 00:00"
        android:textColor="@android:color/white"
        android:textSize="@dimen/twenty_five_sp"
        android:layout_below="@id/imgUser"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/ten"
        android:visibility="gone"/>

    <LinearLayout
        android:id="@+id/callControls"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:gravity="center"
        android:visibility="gone"
        android:layout_alignParentBottom="true">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/thirty"
            android:gravity="center">

            <ImageButton
                android:id="@+id/btnBackward"
                android:layout_width="@dimen/fourty"
                android:layout_height="@dimen/fourty"
                android:background="@drawable/gray_circle"
                android:src="@drawable/backword_5s"
                android:padding="@dimen/ten"/>
            <ImageButton
                android:id="@+id/btnSpeaker"
                android:layout_width="@dimen/fifty_five"
                android:layout_height="@dimen/fifty_five"
                android:layout_marginStart="@dimen/ten"
                android:background="@drawable/circle_bg_green"
                android:src="@drawable/ic_speaker_off"
                android:padding="@dimen/ten"/>

            <ImageButton
                android:id="@+id/btnPlayPause"
                android:layout_width="@dimen/fifty_five"
                android:layout_height="@dimen/fifty_five"
                android:layout_marginStart="@dimen/ten"
                android:background="@drawable/circle_bg_green"
                android:src="@drawable/pause_icon_2"
                android:padding="@dimen/ten"/>

            <ImageButton
                android:id="@+id/btnForward"
                android:layout_width="@dimen/fourty"
                android:layout_height="@dimen/fourty"
                android:layout_marginStart="@dimen/ten"
                android:background="@drawable/gray_circle"
                android:src="@drawable/forward_5s"
                android:padding="@dimen/ten"/>

        </LinearLayout>
        <ImageButton
            android:id="@+id/btnEndCall"
            android:layout_width="@dimen/sixty"
            android:layout_height="@dimen/sixty"
            android:layout_marginTop="@dimen/fifty"
            android:background="@drawable/circle_bg_red"
            android:src="@drawable/ic_call_decline"
            android:padding="@dimen/fifteen"/>

    </LinearLayout>

    <FrameLayout
        android:id="@+id/answerContainer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/eighty"
        android:layout_above="@id/rejectContainer"
        android:layout_marginBottom="@dimen/twenty_five"
        android:background="@drawable/slider_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Slide Right To Answer"
            android:textColor="@android:color/white"
            android:layout_gravity="center"/>

        <ImageView
            android:id="@+id/btnAnswer"
            android:layout_width="@dimen/seventy"
            android:layout_height="@dimen/seventy"
            android:layout_gravity="start|center_vertical"
            android:layout_marginStart="@dimen/five"
            android:background="@drawable/green_circle"
            android:padding="@dimen/eighteen"
            android:src="@drawable/ic_call"/>
    </FrameLayout>

    <FrameLayout
        android:id="@+id/rejectContainer"
        android:layout_width="match_parent"
        android:layout_height="@dimen/eighty"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/twenty"
        android:background="@drawable/slider_bg">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Slide Left To Reject"
            android:textColor="@android:color/white"
            android:layout_gravity="center"/>

        <ImageView
            android:id="@+id/btnReject"
            android:layout_width="@dimen/seventy"
            android:layout_height="@dimen/seventy"
            android:layout_gravity="end|center_vertical"
            android:layout_marginEnd="@dimen/five"
            android:background="@drawable/red_circle"
            android:padding="@dimen/eighteen"
            android:src="@drawable/ic_call_decline"/>
    </FrameLayout>

    <TextView
        android:id="@+id/tvBusyMessage"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="You are currently on another call. You cannot attend this call."
        android:textColor="@android:color/white"
        android:background="@color/black"
        android:padding="@dimen/ten"
        android:visibility="gone"
        android:gravity="center"
        android:layout_alignParentBottom="true"
        android:layout_centerHorizontal="true"/>

</RelativeLayout>