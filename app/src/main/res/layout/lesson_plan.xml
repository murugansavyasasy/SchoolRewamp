<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">


    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar" />

    <LinearLayout
        android:id="@+id/lnrParent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbarLayout"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="@dimen/ten"
        android:layout_marginStart="@dimen/fifteen"
        android:layout_marginTop="@dimen/fifteen"
        android:layout_marginEnd="@dimen/fifteen"
        android:background="@drawable/bg_light_blue"
        android:padding="@dimen/one">

        <TextView
            android:id="@+id/btnCreate"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/white_bg_radius"
            android:gravity="center"
            android:padding="@dimen/eight"
            android:text="@string/AllClasses"
            android:textColor="@color/black"
            android:textSize="@dimen/thirteen_sp"
            />

        <TextView
            android:id="@+id/btnHistory"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:padding="@dimen/eight"
            android:text="@string/MyClasses"
            android:textColor="@color/dark_blue"
            android:textSize="@dimen/thirteen_sp" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/rlaFilter"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lnrParent"
        android:layout_marginStart="@dimen/five"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginEnd="@dimen/five"
        android:gravity="center">



        <RelativeLayout
            android:visibility="gone"
            android:id="@+id/rytSearch1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/thirty_five"
            android:layout_margin="@dimen/ten"
            android:layout_marginStart="@dimen/ten"
            android:background="@drawable/rect_grey">


            <ImageView
                android:id="@+id/imgSearch"
                android:layout_width="@dimen/thirty"
                android:layout_height="@dimen/thirty"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/ten"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/txtSearchMenu1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toEndOf="@+id/imgSearch"
                android:background="@android:color/transparent"
                android:hint="@string/lblSearch"
               style="@style/CustomTextStylePoppinsRegular"
                android:textSize="@dimen/thirteen_sp" />

        </RelativeLayout>


    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcyLessonPlan"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rlaFilter">
    </androidx.recyclerview.widget.RecyclerView>

    <ImageView
        android:id="@+id/nomessage"
        android:layout_width="@dimen/two_fifty"
        android:layout_height="@dimen/two_fifty"
        android:layout_centerInParent="true"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/twenty"
        android:src="@drawable/nomessages"
        android:textColor="@color/black"
        android:textSize="@dimen/eighteen_sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtNoData"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/twenty"
        android:text="@string/no_list_found"
        android:textColor="@color/black"
        android:textSize="@dimen/eighteen_sp"
        android:layout_below="@+id/nomessage"
        android:visibility="gone" />
</RelativeLayout>