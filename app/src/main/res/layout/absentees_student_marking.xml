<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/rootLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <!-- Main content container (above send button) -->
    <RelativeLayout
        android:id="@+id/relativeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/rytSend"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="8dp">

        <include
            android:id="@+id/toolbarLayout"
            layout="@layout/school_side_tool_bar" />


        <LinearLayout
            android:weightSum="1"
            android:id="@+id/rlaSortSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:layout_below="@+id/toolbarLayout"
            android:orientation="horizontal">

            <RelativeLayout
                android:id="@+id/rlaSort"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/five"
                android:layout_marginEnd="@dimen/five"
                android:layout_weight="0.4"
                android:padding="@dimen/ten">

                <ImageView
                    android:id="@+id/imgSort"
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/five"
                    android:src="@drawable/filter_icon">

                </ImageView>

                <Spinner
                    android:id="@+id/isSpinnerSort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/imgSort"
                    android:background="@null" />

            </RelativeLayout>


            <RelativeLayout
                android:id="@+id/rytSearchBar"
                android:layout_width="0dp"
                android:layout_height="@dimen/thirty_five"
                android:layout_marginEnd="@dimen/five"
                android:layout_weight="0.6"
                android:background="@drawable/rect_grey"
                android:visibility="visible">


                <ImageView
                    android:id="@+id/imgSearch"
                    android:layout_width="@dimen/thirty"
                    android:layout_height="@dimen/thirty"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/ten"
                    android:alpha="0.34"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/txtSearchMenu"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@+id/imgSearch"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:background="@android:color/transparent"
                    android:hint="@string/lblSearch"
                     />

            </RelativeLayout>

        </LinearLayout>

        <!-- Header row -->
        <LinearLayout
            android:id="@+id/lnrHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/rlaSortSearch"
            android:layout_marginTop="@dimen/five"
            android:background="@drawable/rect_light_blue"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lblName"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="@dimen/ten"
                android:text="@string/name"
                android:textColor="@color/black" />

            <TextView
                android:id="@+id/lblRollNo"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:paddingHorizontal="@dimen/five"
                android:paddingVertical="@dimen/five"
                android:text="@string/roll_no"
                android:textColor="@color/black" />

            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ten"
                android:layout_weight="1"
                android:gravity="center"
                android:text="@string/status"
                android:textColor="@color/black" />
        </LinearLayout>

        <!-- RecyclerView for students -->
        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycleStudents"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/lnrHeader"
            tools:listitem="@layout/attendance_student_list" />

        <LinearLayout
            android:id="@+id/lytNoDataFound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/recycleStudents"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/two_hundred"
                android:layout_height="@dimen/two_hundred"
                android:layout_marginTop="@dimen/twenty_five"
                android:src="@drawable/no_data_found"></ImageView>

            <TextView
                android:id="@+id/noDataFound"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/twenty"
                android:text="">

            </TextView>

        </LinearLayout>
    </RelativeLayout>

    <!-- Send Button -->
    <RelativeLayout
        android:id="@+id/rytSend"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fourty"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/twenty_five"
        android:layout_marginEnd="@dimen/twenty_five"
        android:layout_marginBottom="16dp"
        android:background="@drawable/bg_orange"
        android:gravity="center"
        android:padding="@dimen/eight">

        <TextView
            android:id="@+id/lblSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center_horizontal"
            android:text="@string/lblSubmit"
            android:textColor="@color/white"
            android:textSize="@dimen/fifteen_sp"
            android:textStyle="normal" />

        <ImageView
            android:id="@+id/imgSend1"
            android:layout_width="@dimen/twenty"
            android:layout_height="@dimen/twenty"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/five"
            android:layout_marginEnd="@dimen/five"
            android:layout_toEndOf="@+id/lblSend"
            android:src="@drawable/send_icon_white" />
    </RelativeLayout>

</RelativeLayout>