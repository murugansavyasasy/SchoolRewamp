<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/fifteen">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/white_bg_card"
        android:orientation="vertical"
        android:padding="@dimen/ten">

        <TextView
            android:id="@+id/questionText"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten"
            android:gravity="start"
            android:text="@string/question_will_appear_here"
            android:textColor="@color/black"
            android:textSize="@dimen/fifteen_sp"
            android:textStyle="bold" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcAttachement"
            android:layout_width="match_parent"
            android:layout_height="@dimen/one_fifty"
            android:layout_marginTop="@dimen/five"></androidx.recyclerview.widget.RecyclerView>

        <me.relex.circleindicator.CircleIndicator2
            android:id="@+id/indicator"
            style="@style/IndicatorStyle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/twenty"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/five"
            android:elevation="@dimen/four"
            android:visibility="gone" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/eight">

            <!--                            Option A-->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvOptionBullet"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="@dimen/twenty_five"
                    android:layout_height="@dimen/twenty_five"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_circle_dark_gray"
                    android:gravity="center"
                    android:text="a"
                    android:textColor="@color/white"
                    android:textSize="@dimen/fourteen_sp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/five"
                    android:layout_toEndOf="@+id/tvOptionBullet">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/CardOption1"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/five"
                        app:cardCornerRadius="@dimen/five"
                        app:cardElevation="@dimen/five">

                        <LinearLayout
                            android:id="@+id/lnrChangeBgOptionA"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/ten"
                            android:paddingVertical="@dimen/ten">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <RelativeLayout
                                    android:id="@+id/rightIconContainerA"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true">

                                    <ImageView
                                        android:id="@+id/imgCheckmarkA"
                                        android:layout_width="@dimen/thirty_five"
                                        android:layout_height="@dimen/thirty_five"
                                        android:layout_alignParentStart="true"
                                        android:layout_centerVertical="true"
                                        android:src="@drawable/tick_icon_2"
                                        android:visibility="gone" />

                                    <ImageView
                                        android:id="@+id/imgOptionA"
                                        android:layout_width="@dimen/fourty"
                                        android:layout_height="@dimen/fourty"
                                        android:layout_centerVertical="true"
                                        android:layout_toEndOf="@+id/imgCheckmarkA"
                                        android:src="@drawable/default_image_icon"
                                        android:visibility="gone" />
                                </RelativeLayout>

                                <TextView
                                    android:id="@+id/option1"
                                    style="@style/CustomTextStylePoppinsRegular"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentStart="true"
                                    android:layout_centerVertical="true"
                                    android:layout_toStartOf="@id/rightIconContainerA"
                                    android:padding="10dp"
                                    android:text="Option 1"
                                    android:textColor="@color/azure_radiance"
                                    android:textSize="@dimen/fourteen_sp" />

                            </RelativeLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </RelativeLayout>

            </RelativeLayout>

            <!--                            option b-->

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvOptionBullet1"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="@dimen/twenty_five"
                    android:layout_height="@dimen/twenty_five"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_circle_dark_gray"
                    android:gravity="center"
                    android:text="b"
                    android:textColor="@color/white"
                    android:textSize="@dimen/fourteen_sp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/five"
                    android:layout_toEndOf="@+id/tvOptionBullet1">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/CardOption2"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/five"
                        app:cardCornerRadius="@dimen/five"
                        app:cardElevation="@dimen/five">

                        <LinearLayout
                            android:id="@+id/lnrChangeBgOptionB"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/ten"
                            android:paddingVertical="@dimen/ten">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <RelativeLayout
                                    android:id="@+id/rightIconContainerB"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true">

                                    <ImageView
                                        android:id="@+id/imgCheckmarkB"
                                        android:layout_width="@dimen/thirty_five"
                                        android:layout_height="@dimen/thirty_five"
                                        android:src="@drawable/tick_icon_2"
                                        android:visibility="gone" />

                                    <ImageView
                                        android:id="@+id/imgOptionB"
                                        android:layout_width="@dimen/fourty"
                                        android:layout_height="@dimen/fourty"
                                        android:layout_toEndOf="@id/imgCheckmarkB"
                                        android:src="@drawable/default_image_icon"
                                        android:visibility="gone" />
                                </RelativeLayout>

                                <TextView
                                    android:id="@+id/option2"
                                    style="@style/CustomTextStylePoppinsRegular"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_toStartOf="@id/rightIconContainerB"
                                    android:padding="10dp"
                                    android:text="Option 2"
                                    android:textColor="@color/azure_radiance"
                                    android:textSize="@dimen/fourteen_sp" />
                            </RelativeLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </RelativeLayout>

            </RelativeLayout>

            <!--                            Option C-->


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvOptionBullet2"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="@dimen/twenty_five"
                    android:layout_height="@dimen/twenty_five"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_circle_dark_gray"
                    android:gravity="center"
                    android:text="c"
                    android:textColor="@color/white"
                    android:textSize="@dimen/fourteen_sp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/five"
                    android:layout_toEndOf="@+id/tvOptionBullet2">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/CardOption3"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/five"
                        app:cardCornerRadius="@dimen/five"
                        app:cardElevation="@dimen/five">

                        <LinearLayout
                            android:id="@+id/lnrChangeBgOptionC"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/ten"
                            android:paddingVertical="@dimen/ten">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <RelativeLayout
                                    android:id="@+id/rightIconContainerC"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true">

                                    <ImageView
                                        android:id="@+id/imgCheckmarkC"
                                        android:layout_width="@dimen/thirty_five"
                                        android:layout_height="@dimen/thirty_five"
                                        android:src="@drawable/tick_icon_2"
                                        android:visibility="gone" />

                                    <ImageView
                                        android:id="@+id/imgOptionC"
                                        android:layout_width="@dimen/fourty"
                                        android:layout_height="@dimen/fourty"
                                        android:layout_toEndOf="@id/imgCheckmarkC"
                                        android:src="@drawable/default_image_icon"
                                        android:visibility="gone" />
                                </RelativeLayout>

                                <TextView
                                    android:id="@+id/option3"
                                    style="@style/CustomTextStylePoppinsRegular"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_toStartOf="@id/rightIconContainerC"
                                    android:padding="10dp"
                                    android:text="Option 3"
                                    android:textColor="@color/azure_radiance"
                                    android:textSize="@dimen/fourteen_sp" />
                            </RelativeLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </RelativeLayout>

            </RelativeLayout>


            <!--                            Option D-->

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/tvOptionBullet3"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="@dimen/twenty_five"
                    android:layout_height="@dimen/twenty_five"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/bg_circle_dark_gray"
                    android:gravity="center"
                    android:text="d"
                    android:textColor="@color/white"
                    android:textSize="@dimen/fourteen_sp" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/five"
                    android:layout_toEndOf="@+id/tvOptionBullet3">

                    <androidx.cardview.widget.CardView
                        android:id="@+id/CardOption4"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_margin="@dimen/five"
                        app:cardCornerRadius="@dimen/five"
                        app:cardElevation="@dimen/five">

                        <LinearLayout
                            android:id="@+id/lnrChangeBgOptionD"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:orientation="horizontal"
                            android:paddingHorizontal="@dimen/ten"
                            android:paddingVertical="@dimen/ten">

                            <RelativeLayout
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                                <RelativeLayout
                                    android:id="@+id/rightIconContainerD"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_alignParentEnd="true"
                                    android:layout_centerVertical="true">

                                    <ImageView
                                        android:id="@+id/imgCheckmarkD"
                                        android:layout_width="@dimen/thirty_five"
                                        android:layout_height="@dimen/thirty_five"
                                        android:src="@drawable/tick_icon_2"
                                        android:visibility="gone" />

                                    <ImageView
                                        android:id="@+id/imgOptionD"
                                        android:layout_width="@dimen/fourty"
                                        android:layout_height="@dimen/fourty"
                                        android:layout_toEndOf="@id/imgCheckmarkD"
                                        android:src="@drawable/default_image_icon"
                                        android:visibility="gone" />
                                </RelativeLayout>

                                <TextView
                                    android:id="@+id/option4"
                                    style="@style/CustomTextStylePoppinsRegular"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_centerVertical="true"
                                    android:layout_toStartOf="@id/rightIconContainerD"
                                    android:padding="10dp"
                                    android:text="Option 4"
                                    android:textColor="@color/azure_radiance"
                                    android:textSize="@dimen/fourteen_sp" />
                            </RelativeLayout>

                        </LinearLayout>
                    </androidx.cardview.widget.CardView>

                </RelativeLayout>

            </RelativeLayout>


        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/one"
            android:layout_marginTop="@dimen/eight"
            android:background="@color/gray5">

        </View>


        <LinearLayout
            android:id="@+id/lnrAnswerDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eight"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/five">

                    <ImageView
                        android:id="@+id/imgCA"
                        android:layout_width="@dimen/twenty"
                        android:layout_height="@dimen/twenty"
                        android:src="@drawable/correct_answer"></ImageView>

                    <TextView
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/five"
                        android:layout_toEndOf="@+id/imgCA"
                        android:drawablePadding="@dimen/five"
                        android:text="@string/correct_answer1"
                        android:textSize="@dimen/thirteen_sp"></TextView>

                </RelativeLayout>

                <TextView
                    android:id="@+id/lblCorrectanswer"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/twenty_five"
                    android:textSize="@dimen/fourteen_sp"></TextView>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/five">

                    <ImageView
                        android:id="@+id/imgYA"
                        android:layout_width="@dimen/twenty"
                        android:layout_height="@dimen/twenty"
                        android:layout_centerVertical="true"
                        android:src="@drawable/checked_icon">

                    </ImageView>

                    <TextView
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@+id/imgYA"
                        android:drawablePadding="@dimen/five"
                        android:text="@string/your_answer"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>
                </RelativeLayout>

                <TextView
                    android:id="@+id/lblYourResponse"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/twenty_five"
                    android:textSize="@dimen/thirteen_sp"></TextView>
            </LinearLayout>

        </LinearLayout>

    </LinearLayout>


</LinearLayout>
