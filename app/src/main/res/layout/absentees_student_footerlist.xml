<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fitsSystemWindows="true">


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:layout_marginBottom="@dimen/ten"
        android:padding="@dimen/twele"
        app:cardCornerRadius="@dimen/seven"
        app:cardElevation="@dimen/four">

        <LinearLayout
            android:id="@+id/linear_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/Image_value"
                android:layout_width="50dp"
                android:layout_height="50dp"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="J"
                android:layout_marginStart="20dp"
                android:textSize="16sp"
                style="@style/CustomTextStylePoppinsBold"
                android:textColor="@android:color/white"
                android:background="@drawable/bg_circle_avatar" />



            <LinearLayout
                android:id="@+id/relative_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fifteen"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/student_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/twenty"
                    android:text="Saran"
                    android:textSize="@dimen/seventeen_sp"
                    style="@style/CustomTextStylePoppinsBold"
                    >
                </TextView>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/register_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/five"
                        android:text="Admission No :"
                        android:textSize="@dimen/sixteen_sp"
                        android:textColor="@color/light_gray_"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true" />

                    <TextView
                        android:id="@+id/buttoncall"
                        android:layout_width="70dp"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/five"
                        android:text="Call"
                        android:gravity="center"
                        android:textSize="16sp"
                        android:textColor="@color/white"
                        android:layout_marginEnd="20dp"
                        android:padding="10dp"
                        android:background="@drawable/background_radius_button"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_alignParentEnd="true"
                        />

                </RelativeLayout>


                <TextView
                    android:id="@+id/section_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/five"
                    android:layout_marginBottom="@dimen/ten"
                    android:text="SS - 1"
                    android:textColor="@color/light_gray_"
                    android:textSize="@dimen/sixteen_sp"
                    style="@style/CustomTextStylePoppinsMedium">
                </TextView>


            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>