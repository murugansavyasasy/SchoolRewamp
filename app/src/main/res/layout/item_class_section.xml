<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/twele"
    card_view:cardCornerRadius="@dimen/sixteen"
    card_view:cardElevation="@dimen/four"
    card_view:cardUseCompatPadding="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
     >

        <View
            android:id="@+id/leftRibbon"
            android:layout_width="6dp"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:background="@color/orange" />

        <!-- Content Layout -->
        <LinearLayout
            android:layout_centerVertical="true"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sixteen"
            android:orientation="vertical">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <TextView
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:id="@+id/tvTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Grade 10 - Section A"
                    android:textColor="@color/black"
                    android:layout_toStartOf="@+id/imgIcon"
                    android:textStyle="bold"
                    android:textSize="18sp" />

                <ImageView
                    android:id="@+id/imgIcon"
                    android:layout_width="@dimen/thirty"
                    android:layout_height="@dimen/thirty"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/thirty"
                    android:src="@drawable/graduation_hat"
                    android:tint="@color/orange" />
            </RelativeLayout>

            <TextView
                android:id="@+id/tvCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/eight"
                android:text="32 Students"
                android:textColor="@color/gray4"
                android:textSize="@dimen/fifteen_sp" />

        </LinearLayout>


    </RelativeLayout>

</androidx.cardview.widget.CardView>
