<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/five"
        android:layout_marginEnd="@dimen/five">

        <RelativeLayout
            android:id="@+id/fab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginEnd="@dimen/ten">

            <LinearLayout
                android:id="@+id/linear_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/first_letter"
                    android:layout_width="@dimen/twenty_seven"
                    android:layout_height="@dimen/twenty_seven"
                    android:layout_marginEnd="@dimen/ten"
                    android:background="@drawable/notification_contact_bg"
                    android:gravity="center"
                    android:text="A"
                    android:textColor="@color/white"
                    android:textSize="@dimen/sixteen_sp"
                    android:textStyle="bold"
                    android:visibility="gone" />

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:padding="@dimen/ten"
                    android:orientation="vertical"
                    android:paddingBottom="@dimen/twenty">

                    <TextView
                        android:id="@+id/lblTitle"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_marginBottom="@dimen/three"
                        android:text="Text Message"
                        android:layout_marginTop="@dimen/ten"
                        android:textColor="@color/black"
                        android:textSize="@dimen/twenty" />

                    <TextView
                        android:id="@+id/lblContent"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_marginEnd="@dimen/thirty"
                        android:layout_marginTop="@dimen/ten"
                        android:layout_marginBottom="@dimen/five"
                        android:text="Probably at least one of the constraints in the following list is one you don't want."
                        android:textColor="@color/black"
                        android:textSize="@dimen/sixteen" />

                    <TextView
                        android:id="@+id/lblSendBy"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="end"
                        android:layout_above="@+id/lblContent"
                        android:layout_marginTop="@dimen/fourteen"
                        android:layout_marginEnd="@dimen/ten"
                        android:text="Posted by : Saranraj"
                        android:textColor="@color/sky_blue0"
                        android:textSize="@dimen/fourteen" />

                    <View
                        android:id="@+id/line"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/two"
                        android:layout_above="@+id/lblSendBy"
                        android:layout_marginTop="@dimen/fifteen"
                        android:background="@color/gray">
                    </View>

                </LinearLayout>

            </LinearLayout>

            <TextView
                android:id="@+id/lblView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/linear_layout"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/five"
                android:text="@string/view_"
                android:textColor="@color/navi_blue1"
                android:visibility="gone" />

        </RelativeLayout>

        <de.hdodenhof.circleimageview.CircleImageView
            android:id="@+id/imgRoundCard"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:elevation="@dimen/ten"
            android:visibility="gone" />

    </RelativeLayout>

    <TextView
        android:id="@+id/lblNotification"
        android:layout_width="@dimen/fifteen"
        android:layout_height="@dimen/fifteen"
        android:layout_marginTop="@dimen/five"
        android:visibility="gone"
        android:layout_alignParentEnd="true"
        android:elevation="@dimen/ten"
        android:layout_marginEnd="@dimen/twenty_three"
        android:background="@drawable/circle_dark_blue" />

</RelativeLayout>

