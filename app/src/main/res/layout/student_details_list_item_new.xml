<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/ten"
    android:shadowColor="@color/black">


    <!-- Profile Image -->
    <androidx.cardview.widget.CardView
        android:id="@+id/profileContainer"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentStart="true"
        android:layout_centerVertical="true"
        app:cardCornerRadius="30dp"
        app:cardElevation="10dp"
        app:cardPreventCornerOverlap="false">

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/imgStudentProfile"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:scaleType="centerCrop"
            android:padding="@dimen/three"
            android:src="@drawable/profile"
            app:shapeAppearanceOverlay="@style/CircleImageShape" />

    </androidx.cardview.widget.CardView>


    <RelativeLayout
        android:id="@+id/rlaStudent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="-30dp"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@id/profileContainer"
        android:background="@drawable/bg_gradient_student_one"
        app:cardCornerRadius="16dp"
        app:cardElevation="4dp">


        <RelativeLayout
            android:id="@+id/rlaSchoolName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/twenty">


            <LinearLayout
                android:layout_toStartOf="@+id/imgArrow"
                android:gravity="center"
                android:layout_centerVertical="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <LinearLayout
                    android:id="@+id/rlaStudentDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:orientation="horizontal">


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/fifteen"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/lblSchoolName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/five"
                            android:text="xxxxxxxx"
                            style="@style/CustomTextStylePoppinsBold"
                            android:textColor="@color/white"
                            android:textSize="@dimen/thirteen_sp">

                        </TextView>

                        <TextView
                            android:id="@+id/lblSchoolRegionalName"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/five"
                            android:layout_below="@+id/lblSchoolName"
                            android:visibility="gone"
                            android:text="iascisacscanniascnioscnia sdhjshdsdjhsdhjsdhsdjhsdhj"
                            style="@style/CustomTextStylePoppinsRegular"
                            android:textColor="@color/white"
                            android:textSize="@dimen/thirteen_sp">

                        </TextView>


                        <TextView
                            android:id="@+id/lblSchoolPlace"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/lblSchoolRegionalName"
                            android:layout_marginEnd="@dimen/five"
                            android:text="xxxxxxxx"
                            android:textSize="@dimen/thirteen_sp"
                            android:textColor="@color/white"
                            style="@style/CustomTextStylePoppinsRegular">
                        </TextView>

                        <TextView
                            android:id="@+id/lblName"
                            style="@style/CustomTextStylePoppinsRegular"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/ten"
                            android:text="Chandru "
                            android:textColor="@color/white"
                            android:textSize="@dimen/thirteen_sp"></TextView>



                        <TextView
                            android:id="@+id/lblClass"
                            style="@style/CustomTextStylePoppinsRegular"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/ten"
                            android:textColor="@color/white"
                            android:text="IX - A2/EM"
                            android:textSize="@dimen/thirteen_sp">

                        </TextView>
                        <TextView
                            android:id="@+id/lblRegisterNumber"
                            style="@style/CustomTextStylePoppinsRegular"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/ten"
                            android:layout_weight="0.9"
                            android:text="Roll No : SS-16"
                            android:textColor="@color/white"
                            android:textSize="@dimen/thirteen_sp"></TextView>



                        <TextView
                            android:id="@+id/lblacademicyear"
                            style="@style/CustomTextStylePoppinsRegular"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/ten"
                            android:layout_marginBottom="@dimen/ten"
                            android:textColor="@color/white"
                            android:visibility="gone"
                            android:text="Academic year : 2025 - 2026"
                            android:textSize="@dimen/thirteen_sp">

                        </TextView>

                        <TextView
                            android:id="@+id/lblClassTeacher"
                            style="@style/CustomTextStylePoppinsRegular"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/lblClass"
                            android:layout_centerHorizontal="true"
                            android:layout_marginTop="@dimen/eight"
                            android:layout_marginBottom="@dimen/ten"
                            android:gravity="center"
                            android:text="Sathish"
                            android:textColor="@color/white"
                            android:textSize="@dimen/thirteen_sp"
                            android:visibility="gone">

                        </TextView>

                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/eight"></View>

            </LinearLayout>


            <ImageView
                android:layout_marginEnd="@dimen/ten"
                android:id="@+id/imgArrow"
                android:layout_alignParentEnd="true"
                android:layout_width="@dimen/twenty_five"
                android:layout_height="@dimen/twenty_five"
                android:layout_centerVertical="true"
                android:src="@drawable/ic_circle_arrow_right"/>


        </RelativeLayout>


    </RelativeLayout>

</RelativeLayout>
