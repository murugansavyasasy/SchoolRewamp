<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/bottom_sheet"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_bg"
    android:orientation="vertical"
    app:layout_behavior="com.google.android.material.bottomsheet.BottomSheetBehavior">

    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingBottom="100dp">

            <ImageView
                android:id="@+id/dotindicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:layout_marginTop="10dp"
                android:src="@drawable/dotindicator" />

            <LinearLayout
                android:id="@+id/relative_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/eighteen"
                android:layout_marginTop="@dimen/thirty"
                android:layout_marginEnd="@dimen/eighteen"
                android:background="@drawable/rounded_bg"
                android:orientation="vertical"
                android:padding="@dimen/fifteen">

                <TextView
                    android:id="@+id/header_textview"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="10dp"
                    android:text="Saloon &amp; Spa"
                    android:textSize="@dimen/fourteen_sp"
                    android:textStyle="normal" />

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginTop="@dimen/eight"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/thumbnail"
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:src="@drawable/small_postercoupon"
                        app:shapeAppearanceOverlay="@style/ImageMediumRoundedCorners" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/offer_text"
                            style="@style/CustomTextStylePoppinsMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="5dp"
                            android:text="Rs.300 Off"
                            android:textColor="@color/black"
                            android:textSize="@dimen/seventeen_sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/offer_text1"
                            style="@style/CustomTextStylePoppinsMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/five"
                            android:text="TONI&amp;GUY"
                            android:textSize="@dimen/thirteen_sp"
                            android:textStyle="normal" />

                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginTop="@dimen/seven"
                    android:orientation="horizontal">

                    <ImageView
                        android:id="@+id/location_imag2"
                        android:layout_width="@dimen/thirteen"
                        android:layout_height="@dimen/thirteen"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/nine"
                        android:src="@drawable/clockloadericon" />

                    <TextView
                        android:id="@+id/offer_text4"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/five"
                        android:text="Valid till 01.01.2024"
                        android:textSize="@dimen/thirteen_sp"
                        android:textStyle="normal" />
                </LinearLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linear_layout3"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/twenty"
                android:orientation="vertical"
                android:padding="@dimen/ten">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/remember"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_weight="1"
                        android:text="@string/how_to_use"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fifteen_sp"
                        android:textStyle="normal" />

                    <ImageView
                        android:id="@+id/remember_symbol"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/five"
                        android:layout_marginEnd="@dimen/ten"
                        android:src="@drawable/ic_down_black" />

                </LinearLayout>

                <TextView
                    android:id="@+id/expandable_text"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/fourty"
                    android:padding="@dimen/ten"
                    android:text="Here are some important thakdjnkasjdn jkansjdknkjnadksad nkajndkjnkjasnkjasndkings to remember..."
                    android:textColor="@color/grey"
                    android:textSize="@dimen/fourteen_sp"
                    android:textStyle="normal"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:id="@+id/view"
                android:layout_width="match_parent"
                android:layout_height="@dimen/one"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginEnd="@dimen/twenty"
                android:background="@color/grey" />

            <LinearLayout
                android:id="@+id/linear_layout4"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten"
                android:orientation="vertical"
                android:padding="@dimen/ten">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/remember1"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_weight="1"
                        android:text="@string/terms_amp_conditions"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fifteen_sp"
                        android:textStyle="normal" />

                    <ImageView
                        android:id="@+id/remember_symbol1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/five"
                        android:layout_marginEnd="@dimen/ten"
                        android:src="@drawable/ic_down_black" />
                </LinearLayout>

                <TextView
                    android:id="@+id/expandable_text1"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/fourty"
                    android:padding="@dimen/ten"
                    android:text="Here are some important thakdjnkasjdn jkansjdknkjnadksad nkajndkjnkjasnkjasndkings to remember..."
                    android:textColor="@color/grey"
                    android:textSize="@dimen/fourteen_sp"
                    android:textStyle="normal"
                    android:visibility="gone" />
            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/one"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginEnd="@dimen/twenty"
                android:background="@color/grey" />

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

    <ProgressBar
        android:id="@+id/isProgressBar"
        android:layout_width="@dimen/fifty"
        android:layout_height="@dimen/fifty"
        android:layout_centerInParent="true"
        android:layout_marginTop="@dimen/fifty"
        android:visibility="gone" />

</RelativeLayout>