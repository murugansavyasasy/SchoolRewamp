<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/fifteen"
    android:background="@drawable/rect_white"
    android:elevation="4dp"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:layout_marginTop="10dp"
    android:clipToPadding="false">


    <ImageView
        android:id="@+id/imgIcon"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/headphonesvgformat"
        android:padding="5dp"
        android:layout_alignParentStart="true"
        android:background="@drawable/bg_icon_round"
        android:layout_marginEnd="10dp"
        android:contentDescription="@string/app_name" />


    <TextView
        android:id="@+id/txtTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_toEndOf="@id/imgIcon"
        android:text="TAMIL"
        android:textStyle="bold"
        android:textSize="16sp"
        android:textColor="@android:color/black" />

    <TextView
        android:id="@+id/txtSubtitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/txtTitle"
        android:layout_toEndOf="@id/imgIcon"
        android:text="Listening"
        android:textSize="14sp"
        android:textColor="@color/purple_700" />

    <TextView
        android:id="@+id/txtMainDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/imgIcon"
        android:layout_marginTop="10dp"
        android:text="I’m not sure what to say about the beach for"
        android:textSize="14sp"
        android:textStyle="bold"
        android:textColor="@android:color/black" />

    <TextView
        android:id="@+id/txtSubDesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/txtMainDesc"
        android:layout_marginTop="4dp"
        android:text="I’m not going back to the house and the beach for a few hours and then I’m going to bed and then I’ll head back home to get my stuff ready to the beach and then"
        android:textSize="13sp"
        android:ellipsize="end"
        android:maxLines="3"
        android:textColor="@android:color/darker_gray" />

    <TextView
        android:id="@+id/txtProfile"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/txtSubDesc"
        android:layout_alignParentStart="true"
        android:layout_marginTop="10dp"
        android:drawableLeft="@drawable/profile"
        android:drawablePadding="6dp"
        android:text="CHANDHRU V"
        android:textSize="14sp"
        android:textColor="@android:color/black" />

    <TextView
        android:id="@+id/btnStart"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignBaseline="@id/txtProfile"
        android:layout_alignParentEnd="true"
        android:text="START"
        android:textSize="14sp"
        style="@style/CustomTextStylePoppinsBold"
        android:textColor="@color/teal_900"
        android:drawableRight="@drawable/doublearrowsvgformatstyle"
        android:drawablePadding="4dp" />

</RelativeLayout>
