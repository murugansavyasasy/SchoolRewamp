<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        android:background="@color/light_gray4"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:fitsSystemWindows="true"
        >

        <RelativeLayout
            android:id="@+id/rytHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_rounded"
            android:paddingBottom="@dimen/fifty"
            >
            <RelativeLayout
                android:id="@+id/rytHeaderDetail"
                android:layout_marginTop="@dimen/ten"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:id="@+id/imgBack"
                    android:layout_width="@dimen/thirty_five"
                    android:layout_height="@dimen/thirty_five"
                    android:layout_centerVertical="true"
                    android:src="@drawable/left_arrow">

                </ImageView>

                <LinearLayout
                    android:id="@+id/lytTitleAndName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/imgBack"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblStudentName"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Santhosh N"
                        android:textColor="@color/white"
                        android:textSize="@dimen/fifteen_sp">

                    </TextView>

                    <TextView
                        android:id="@+id/lblStudentSection"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="I-B"
                        android:visibility="visible"
                        android:textColor="@color/white"
                        android:textSize="@dimen/twele_sp">

                    </TextView>

                </LinearLayout>

            </RelativeLayout>
            <TextView
                android:id="@+id/lblParentToolBar"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attendance"
                android:layout_marginStart="@dimen/thirty_five"
                android:layout_marginTop="@dimen/ten"
                android:layout_below="@+id/rytHeaderDetail"
                android:textColor="@color/white"
                android:textSize="@dimen/twenty">

            </TextView>

        </RelativeLayout>



        <androidx.cardview.widget.CardView
            android:layout_below="@+id/rytHeader"
            android:layout_width="match_parent"
            app:cardCornerRadius="@dimen/ten"
            android:id="@+id/cardCalendarDetails"
            android:elevation="6dp"
            android:layout_marginStart="@dimen/twenty"
            android:layout_marginEnd="@dimen/twenty"
            android:layout_marginTop="-30dp"
            android:layout_height="wrap_content">
            <RelativeLayout
                android:layout_width="match_parent"
                android:padding="@dimen/twenty"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:id="@+id/lnrCalendarDetails"
                    android:gravity="center"
                    android:layout_width="wrap_content"
                    android:orientation="horizontal"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:id="@+id/lblDate"
                                android:layout_width="wrap_content"
                                android:text="00"
                                style="@style/CustomTextStylePoppinsBold"
                                android:textSize="@dimen/fourty_sp"
                                android:textColor="@color/light_purple1"
                                android:layout_height="wrap_content">
                            </TextView>
                        </LinearLayout>
                        <TextView
                            android:id="@+id/lblDateSuffix"
                            android:layout_width="wrap_content"
                            android:text="th"
                            android:layout_marginStart="@dimen/two"
                            android:layout_marginTop="@dimen/five"
                            android:gravity="top"
                            android:maxLength="2"
                            style="@style/CustomTextStylePoppinsBold"
                            android:textSize="@dimen/twele_sp"
                            android:textColor="@color/light_purple1"
                            android:layout_height="wrap_content">
                        </TextView>

                    </LinearLayout>
                    <LinearLayout
                        android:layout_marginStart="@dimen/five"
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/lblDay"
                            android:layout_width="match_parent"
                            android:text="Wednesday"
                            android:textSize="@dimen/fifteen"
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_height="wrap_content">
                        </TextView>
                        <TextView
                            android:id="@+id/lblMonthYear"
                            android:gravity="center"
                            android:layout_width="match_parent"
                            android:text="August 2025"
                            android:textSize="@dimen/twele_sp"
                            android:textColor="@color/light_gray"
                            style="@style/CustomTextStylePoppinsMedium"
                            android:layout_height="wrap_content">
                        </TextView>
                    </LinearLayout>
                </LinearLayout>
                <TextView
                    android:id="@+id/lblHeading"
                    android:layout_marginTop="@dimen/fifteen"
                    android:layout_below="@+id/lnrCalendarDetails"
                    android:layout_width="match_parent"
                    android:text="@string/this_week_status"
                    style="@style/CustomTextStylePoppinsRegular"
                    android:layout_height="wrap_content">
                </TextView>
                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:layout_below="@+id/lblHeading"
                    android:layout_marginTop="@dimen/ten"
                    android:id="@+id/rcWeekStatus"
                    android:layout_height="wrap_content">
                </androidx.recyclerview.widget.RecyclerView>

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <ScrollView
            android:layout_below="@+id/cardCalendarDetails"
            android:layout_width="match_parent"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
            android:layout_height="match_parent">
            <LinearLayout
                android:paddingBottom="@dimen/thirty"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginEnd="@dimen/twenty"
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="wrap_content">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    app:cardCornerRadius="@dimen/ten"
                    android:id="@+id/cardDayDetails"
                    android:elevation="6dp"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:orientation="horizontal"
                        android:weightSum="3"
                        android:layout_width="match_parent"
                        android:padding="@dimen/twenty"
                        android:layout_height="wrap_content">
                        <LinearLayout
                            android:orientation="vertical"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content">
                            <FrameLayout
                                android:id="@+id/attendanceContainer"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/ninety"

                                >

                                <ProgressBar
                                    android:id="@+id/attendanceProgressBar"
                                    style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Horizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:indeterminate="false"
                                    android:max="100"
                                    android:progress="100"
                                    android:progressDrawable="@drawable/progress_circle_drawable"
                                    android:rotation="270" />

                                <LinearLayout
                                    android:layout_width="match_parent"
                                    android:orientation="horizontal"
                                    android:gravity="center"
                                    android:layout_height="match_parent">
                                    <TextView
                                        android:id="@+id/lblAttendancePercentage"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="100"
                                        android:maxLength="3"
                                        style="@style/CustomTextStylePoppinsMedium"
                                        android:textSize="@dimen/twenty_sp"
                                        android:textColor="@color/light_purple1"
                                        android:textStyle="bold" />
                                    <TextView
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:text="%"
                                        android:layout_marginTop="@dimen/three"
                                        style="@style/CustomTextStylePoppinsMedium"
                                        android:textSize="@dimen/sixteen_sp"
                                        android:textColor="@color/light_purple1"
                                        android:textStyle="bold" />
                                </LinearLayout>
                            </FrameLayout>
                            <TextView
                                android:layout_width="match_parent"
                                android:text="@string/attendance"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:gravity="center"
                                android:layout_marginTop="@dimen/ten"
                                android:layout_height="wrap_content">

                            </TextView>
                        </LinearLayout>
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/very_light_grey" />

                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_height="wrap_content">
                            <FrameLayout
                                android:layout_weight="1"
                                android:layout_width="match_parent"
                                android:id="@+id/leaveTakenContainer"
                                android:layout_height="@dimen/ninety"

                                >

                                <ProgressBar
                                    android:id="@+id/leaveTakenProgressBar"
                                    style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Horizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:indeterminate="false"
                                    android:max="100"
                                    android:progress="50"
                                    android:progressDrawable="@drawable/progress_circle_drawable"
                                    android:rotation="270" />

                                <TextView
                                    android:id="@+id/lblLeaveTakenPercentage"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="50"
                                    android:maxLength="3"
                                    style="@style/CustomTextStylePoppinsBold"
                                    android:textColor="@color/light_purple1"
                                    android:textSize="@dimen/twenty_sp"
                                    android:textStyle="bold" />
                            </FrameLayout>
                            <TextView
                                android:layout_width="match_parent"
                                android:text="@string/leave_taken"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:gravity="center"
                                android:textSize="@dimen/twele_sp"
                                android:layout_marginTop="@dimen/ten"
                                android:layout_height="wrap_content">

                            </TextView>
                        </LinearLayout>
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="@color/very_light_grey" />
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_weight="1"
                            android:orientation="vertical"
                            android:layout_height="wrap_content">
                            <FrameLayout
                                android:id="@+id/ongoingDaysContainer"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/ninety"
                                >

                                <ProgressBar
                                    android:id="@+id/ongoingDaysProgressBar"
                                    style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Horizontal"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:indeterminate="false"
                                    android:max="100"
                                    android:progress="50"
                                    android:progressDrawable="@drawable/progress_circle_drawable"
                                    android:rotation="270" />

                                <TextView
                                    android:id="@+id/lblOngoingDaysPercentage"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:gravity="center"
                                    android:text="50"
                                    android:maxLength="3"
                                    android:textColor="@color/light_purple1"
                                    android:textSize="@dimen/twenty_sp"
                                    android:textStyle="bold" />
                            </FrameLayout>
                            <TextView
                                android:layout_width="match_parent"
                                android:text="@string/ongoing_days"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:gravity="center"
                                android:textSize="@dimen/twele_sp"
                                android:layout_marginTop="@dimen/ten"
                                android:layout_height="wrap_content">

                            </TextView>
                        </LinearLayout>

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    app:cardCornerRadius="@dimen/ten"
                    android:id="@+id/cardMenuDetails"
                    android:elevation="6dp"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginBottom="@dimen/ten"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:padding="@dimen/two"
                        android:orientation="vertical"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">


                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_weight="1"
                                android:id="@+id/lnrLeaveRequest"
                                android:padding="@dimen/twenty"
                                android:gravity="center"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content">
                                <ImageView
                                    android:id="@+id/imgAskLeave"
                                    android:src="@drawable/attendance_marking"
                                    android:layout_width="@dimen/thirty"
                                    android:layout_height="@dimen/thirty">
                                </ImageView>

                                <TextView
                                    android:layout_marginTop="@dimen/five"
                                    android:layout_width="wrap_content"
                                    android:text="@string/ask_leave"
                                    style="@style/CustomTextStylePoppinsMedium"
                                    android:gravity="center"
                                    android:textSize="@dimen/twele_sp"
                                    android:layout_height="wrap_content">

                                </TextView>
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:background="@color/very_light_grey" />

                            <LinearLayout
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:id="@+id/lnrLeaveHistory"
                                android:padding="@dimen/twenty"
                                android:layout_width="0dp"
                                android:gravity="center"
                                android:layout_height="wrap_content">

                                <ImageView
                                    android:id="@+id/imgLeaveRequest"
                                    android:layout_width="@dimen/thirty"
                                    android:layout_height="@dimen/thirty"
                                    android:src="@drawable/leave_request_icon_school"></ImageView>

                                <TextView
                                    android:layout_marginTop="@dimen/five"
                                    android:layout_width="wrap_content"
                                    android:text="@string/leave_requests"
                                    android:gravity="center"
                                    style="@style/CustomTextStylePoppinsMedium"
                                    android:textSize="@dimen/twele_sp"
                                    android:layout_height="wrap_content">

                                </TextView>
                            </LinearLayout>

                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:background="@color/very_light_grey" />

                            <LinearLayout
                                android:orientation="vertical"
                                android:layout_weight="1"
                                android:id="@+id/lnrAttendanceReport"
                                android:padding="@dimen/twenty"
                                android:gravity="center"
                                android:layout_width="0dp"
                                android:layout_height="wrap_content">
                                <ImageView
                                    android:id="@+id/imgAttendanceReport"
                                    android:src="@drawable/absentees_report"
                                    android:layout_width="@dimen/thirty"
                                    android:layout_height="@dimen/thirty">
                                </ImageView>

                                <TextView
                                    android:layout_marginTop="@dimen/five"
                                    android:layout_width="wrap_content"
                                    android:text="@string/attendance_report"
                                    android:gravity="center"
                                    style="@style/CustomTextStylePoppinsMedium"
                                    android:textSize="@dimen/twele_sp"
                                    android:layout_height="wrap_content">

                                </TextView>
                            </LinearLayout>

                        </LinearLayout>
                        <View
                            android:layout_width="match_parent"
                            android:layout_height="1dp"
                            android:background="@color/very_light_grey" />
                        <LinearLayout
                            android:orientation="horizontal"
                            android:weightSum="3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">
                            <LinearLayout

                                android:id="@+id/lnrHoliday"
                                android:padding="@dimen/twenty"
                                android:orientation="vertical"
                                android:layout_weight="1"
                                android:layout_width="0dp"
                                android:gravity="center"
                                android:layout_height="wrap_content">
                                <ImageView
                                    android:src="@drawable/attendance_report_icon"
                                    android:layout_width="@dimen/thirty"
                                    android:layout_height="@dimen/thirty">
                                </ImageView>

                                <TextView
                                    android:layout_width="match_parent"
                                    android:text="@string/HoliDay"
                                    style="@style/CustomTextStylePoppinsMedium"
                                    android:gravity="center"
                                    android:layout_marginTop="@dimen/five"
                                    android:textSize="@dimen/twele_sp"
                                    android:layout_height="wrap_content">

                                </TextView>
                            </LinearLayout>
                            <View
                                android:layout_width="1dp"
                                android:layout_height="match_parent"
                                android:background="@color/very_light_grey" />

                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </ScrollView>

    </RelativeLayout>

</RelativeLayout>