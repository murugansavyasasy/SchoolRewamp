<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="10dp">

    <ImageView
        android:id="@+id/notification_icon"
        android:layout_width="60dp"
        android:layout_height="60dp"
        android:layout_alignParentEnd="true"
        android:background="@drawable/circle_background_customm"
        android:padding="2dp"
        android:scaleType="centerCrop"
        android:src="@drawable/app_logo" />

    <TextView
        android:id="@+id/notification_title_expanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_toStartOf="@id/notification_icon"
        android:text="School Chimes"
        android:textStyle="bold"
        android:textSize="@dimen/fourteen_sp" />

    <TextView
        android:id="@+id/notification_body_expanded"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/notification_title_expanded"
        android:layout_marginTop="4dp"
        android:maxLines="10"
        android:ellipsize="end"
        android:textSize="@dimen/thirteen_sp"
        android:text="Full message goes here..." />

    <ImageView
        android:id="@+id/notification_imageview_expanded"
        android:layout_width="match_parent"
        android:layout_height="200dp"
        android:layout_below="@id/notification_body_expanded"
        android:layout_marginTop="8dp"
        android:scaleType="centerCrop"
        android:visibility="gone" />

</RelativeLayout>
