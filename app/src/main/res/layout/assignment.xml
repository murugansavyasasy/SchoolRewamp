<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/toolbarLayout"
            layout="@layout/school_side_tool_bar" />


        <LinearLayout
            android:id="@+id/toolbarLayout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/toolbarLayout"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:orientation="horizontal"
            android:weightSum="1">

            <LinearLayout
                android:id="@+id/lnrTabOneName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tabOneName"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/Create"
                    android:textColor="@color/iconBlue"></TextView>

                <View
                    android:id="@+id/line1"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/three"
                    android:layout_below="@+id/groupheading"
                    android:layout_marginTop="@dimen/five"
                    android:background="@color/iconBlue"></View>
            </LinearLayout>


            <LinearLayout
                android:id="@+id/lnrTabTwoName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="0.5"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/tabTwoName"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/Reports"></TextView>

                <View
                    android:id="@+id/line3"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/three"
                    android:layout_below="@+id/groupheading"
                    android:layout_marginTop="@dimen/five"
                    android:background="@color/white"></View>
            </LinearLayout>

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/rytCreateAssignment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/toolbarLayout1"
            android:layout_marginTop="@dimen/ten"
            android:visibility="visible">

            <TextView
                android:id="@+id/lblCategory"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                style="@style/CustomTextStylePoppinsBold"
                android:text="@string/Catogory"
                android:textSize="@dimen/fifteen_sp"
                >

            </TextView>

            <RelativeLayout
                android:id="@+id/rytSendingType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblCategory"
                android:layout_marginStart="@dimen/fifteen"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/fifteen"
                android:background="@drawable/bg_white_light_radious"
                android:gravity="center">

                <Spinner
                    android:id="@+id/spinnerType"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/custom_spinner_background" />

            </RelativeLayout>

            <TextView
                android:id="@+id/lblTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rytSendingType"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:text="@string/Title"
               style="@style/CustomTextStylePoppinsBold"
                android:textSize="@dimen/fifteen_sp"
                >

            </TextView>

            <EditText
                android:id="@+id/edtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblTitle"
                android:layout_marginStart="@dimen/fifteen"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/fifteen"
               style="@style/CustomTextStylePoppinsMedium"
                >

            </EditText>

            <TextView
                android:id="@+id/lblTitleTextCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/edtTitle"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/five"
                android:layout_marginEnd="@dimen/fifteen"
                style="@style/CustomTextStylePoppinsMedium"
                android:text="0 / 50"
                android:textColor="@color/light_gray"
                >

            </TextView>

            <TextView
                android:id="@+id/lblDescription"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblTitleTextCount"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:text="@string/Description"
                style="@style/CustomTextStylePoppinsBold"
                android:textSize="@dimen/fifteen_sp"
                >

            </TextView>

            <EditText
                android:id="@+id/edtDescription"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hundred"
                android:layout_below="@+id/lblDescription"
                android:layout_marginStart="@dimen/fifteen"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/fifteen"
                android:background="@drawable/bg_stroke_rect_black"
                android:editable="true"
                android:focusable="true"
                android:focusableInTouchMode="true"
                android:gravity="start"
                android:hint="@string/Description"
                android:padding="@dimen/ten"
                style="@style/CustomTextStylePoppinsRegular"
                android:textSize="@dimen/thirteen_sp"
                >

            </EditText>


            <TextView
                android:id="@+id/lblTextCount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/edtDescription"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/fifteen"
                style="@style/CustomTextStylePoppinsMedium"
                android:text="0 / 500"
                android:textColor="@color/light_gray"
                >

            </TextView>

            <TextView
                android:id="@+id/lblSubDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblTextCount"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/ten"
                android:text="@string/SubmissionDate"
                style="@style/CustomTextStylePoppinsBold"
                android:textSize="@dimen/fifteen_sp"
               >

            </TextView>

            <ImageView
                android:id="@+id/imgCalender"
                android:layout_width="@dimen/twenty_five"
                android:layout_height="@dimen/twenty_five"
                android:layout_below="@+id/lblSubDate"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:src="@drawable/calender_icon">
            </ImageView>


            <TextView
                android:id="@+id/lblDatePick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblSubDate"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:layout_toEndOf="@+id/imgCalender"
                android:drawableEnd="@drawable/ic_down_arrow"
                android:drawablePadding="@dimen/ten"
                style="@style/CustomTextStylePoppinsMedium"
                android:text=""
                >

            </TextView>

            <TextView
                android:id="@+id/lblTimePick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblSubDate"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/fifteen"
                android:drawableEnd="@drawable/ic_down_arrow"
                android:drawablePadding="@dimen/ten"
                style="@style/CustomTextStylePoppinsMedium"
                android:text="12:12 PM"
                ></TextView>


            <RelativeLayout
                android:id="@+id/rlaFilePicking"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/lblTimePick"
                android:layout_marginTop="@dimen/five">

                <TextView
                    android:id="@+id/lblAddPhoto"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fifteen"
                    android:layout_marginTop="@dimen/ten"
                    android:text="@string/add_attachment"
                    android:textColor="@color/black"
                    >

                </TextView>

                <TextView
                    android:id="@+id/lblOptional"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_toEndOf="@+id/lblAddPhoto"
                    android:text="@string/Optional"
                    android:textColor="@color/mild_grey1"
                    android:textSize="@dimen/thirteen_sp">

                </TextView>

                <ImageView
                    android:layout_width="@dimen/twenty_five"
                    android:layout_height="@dimen/twenty_five"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/twenty"
                    android:src="@drawable/ic_attach_file">

                </ImageView>

                <RelativeLayout
                    android:id="@+id/rytRecyclewview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lblAddPhoto">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rcyImages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ten"
                        android:orientation="vertical">

                    </androidx.recyclerview.widget.RecyclerView>
                </RelativeLayout>


                <TextView
                    android:id="@+id/btnChooseRecipient"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/rytRecyclewview"
                    android:layout_marginStart="@dimen/twenty_five"
                    android:layout_marginTop="@dimen/fifty"
                    android:layout_marginEnd="@dimen/twenty_five"
                    android:layout_marginBottom="@dimen/thirty"
                    android:background="@drawable/rect_btn_orange"
                    android:gravity="center"
                    android:padding="@dimen/ten"
                    android:text="@string/ChooseRecipients"
                    android:textColor="@color/white"
                    android:textSize="@dimen/thirteen_sp">

                </TextView>
            </RelativeLayout>

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlaAssignmentReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/toolbarLayout1"
            android:layout_marginStart="5dp"
            android:visibility="gone"
            android:layout_marginTop="@dimen/twenty"
            android:layout_marginEnd="5dp">

            <LinearLayout
                android:id="@+id/AcademicYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/gray_bg_radius"
                android:orientation="horizontal"
                android:weightSum="1">

                <TextView
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fifteen"
                    android:layout_weight="0.5"
                    android:text="@string/academic_year"
                    android:textSize="@dimen/thirteen_sp">

                </TextView>

                <RelativeLayout
                    android:id="@+id/rytAcademicYearDropDown"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fifteen"
                    android:layout_marginEnd="@dimen/fifteen"
                    android:layout_weight="0.5"
                    android:gravity="center">

                    <Spinner
                        android:id="@+id/isSpinner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:background="@drawable/custom_spinner_background" />

                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/search"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/AcademicYear"
                android:layout_margin="@dimen/ten"
                android:visibility="gone"
                android:layout_marginTop="@dimen/ten"
                android:background="@drawable/gray_bg_radius"
                android:gravity="center"
                android:padding="@dimen/five">

                <ImageView
                    android:layout_width="@dimen/twenty_five"
                    android:layout_height="@dimen/twenty_five"
                    android:alpha="0.4"
                    android:src="@drawable/search_icon"></ImageView>

                <EditText
                    android:id="@+id/txtSearchMenu"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/five"
                    android:background="@null"
                    android:hint="@string/search"
                    android:text=""
                    android:textSize="@dimen/fifteen_sp">
                </EditText>


            </LinearLayout>

            <View
                android:id="@+id/line2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/one"
                android:layout_below="@+id/search"
                android:background="@color/gray">

            </View>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcyAssignmentReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:layout_below="@+id/line2">
            </androidx.recyclerview.widget.RecyclerView>


            <LinearLayout
                android:id="@+id/lytNoDataFound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/search"
                android:layout_centerInParent="true"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/noDataImage"
                    android:layout_width="@dimen/two_hundred"
                    android:layout_height="@dimen/two_hundred"
                    android:layout_marginTop="@dimen/twenty_five"
                    android:src="@drawable/no_data_found"></ImageView>

                <TextView
                    android:id="@+id/noDataFound"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/twenty"
                    android:text=""
                    android:textSize="@dimen/fifteen_sp">

                </TextView>
            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>
</ScrollView>