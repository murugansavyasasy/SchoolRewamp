<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/parent_side_tool_bar" />

    <LinearLayout
        android:id="@+id/search"
        android:layout_below="@+id/toolbarLayout"
        android:layout_margin="@dimen/twenty_five"
        android:background="@drawable/search_bg"
        android:weightSum="1"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fourty">

        <ImageView
            android:layout_marginStart="@dimen/zero"
            android:layout_weight="0.1"
            android:layout_width="@dimen/zero"
            android:src="@drawable/search_icon"
            android:layout_height="@dimen/twenty_five">
        </ImageView>

        <EditText
            android:id="@+id/searchText"
            android:textSize="@dimen/sixteen_sp"
            android:background="@android:color/transparent"
            android:layout_weight="0.85"
            android:layout_width="@dimen/zero"
            android:hint="@string/lblSearch"
            android:minHeight="@dimen/fifty"
            android:textStyle="normal"
            android:fontFamily="@font/poppins_medium"
            android:layout_height="wrap_content">
        </EditText>

        <ImageView
            android:id="@+id/close"
            android:clickable="true"
            android:visibility="gone"
            android:layout_marginEnd="@dimen/ten"
            android:layout_weight="0.05"
            android:layout_width="@dimen/zero"
            android:src="@drawable/close_icon_red"
            android:layout_height="@dimen/thirty">
        </ImageView>
    </LinearLayout>
    <ScrollView
        android:layout_below="@+id/search"
        android:layout_width="match_parent"
        android:background="@color/athens_gray"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginBottom="@dimen/twenty_five"
        android:layout_marginEnd="@dimen/ten"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_marginBottom="@dimen/fifty"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_marginTop="@dimen/ten"
                android:id="@+id/examheading"
                android:layout_width="match_parent"
                android:text="@string/exam_mark"
                android:textColor="@color/jumbo"
                android:textStyle="bold"
                android:textSize="@dimen/thirteen_sp"
                android:layout_marginStart="@dimen/fifteen"
                android:layout_height="wrap_content">

            </TextView>
            <androidx.cardview.widget.CardView
                app:cardCornerRadius="@dimen/ten"
                android:id="@+id/examMarkCard"
                android:layout_width="match_parent"
                android:layout_marginStart="@dimen/fifteen"
                android:layout_marginEnd="@dimen/fifteen"
                android:layout_marginTop="@dimen/fifteen"
                android:layout_below="@+id/examheading"
                app:cardElevation="@dimen/five"
                android:layout_height="wrap_content">

                <androidx.recyclerview.widget.RecyclerView
                    android:layout_width="match_parent"
                    android:id="@+id/ExamMarkRV"
                    android:layout_margin="@dimen/ten"
                    android:layout_height="wrap_content">

                </androidx.recyclerview.widget.RecyclerView>

            </androidx.cardview.widget.CardView>
            <androidx.cardview.widget.CardView
                android:id="@+id/examRankCard"
                app:cardCornerRadius="@dimen/ten"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/five"
                android:layout_below="@+id/examMarkCard"
                app:cardElevation="@dimen/five"
                android:layout_marginBottom="@dimen/ten"
                android:layout_alignStart="@+id/examMarkCard"
                android:layout_alignEnd="@+id/examMarkCard"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_marginBottom="@dimen/ten"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="horizontal"
                        android:weightSum="1"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/ten"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_marginStart="@dimen/fifteen"
                            android:layout_weight="0.25"
                            android:text="@string/total"
                            android:textSize="@dimen/fifteen_sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content">

                        </TextView>
                        <TextView
                            android:id="@+id/MarkOutOf500"
                            android:layout_weight="0.75"
                            android:text="372 / 500"
                            android:textStyle="bold"
                            android:textSize="@dimen/fifteen_sp"
                            android:layout_width="match_parent"
                            android:textColor="@color/black"
                            android:layout_height="wrap_content">
                        </TextView>


                    </LinearLayout>
                    <ProgressBar
                        android:layout_marginTop="@dimen/fifteen"
                        android:id="@+id/progressBarOutOf500"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_marginEnd="@dimen/fifty"
                        android:layout_height="@dimen/ten"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@android:drawable/progress_horizontal"
                        android:progressTint="@color/azure_radiance" />
                    <LinearLayout
                        android:layout_margin="@dimen/ten"
                        android:orientation="horizontal"
                        android:weightSum="1"
                        android:gravity="center"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_weight="0.95"
                            android:textSize="@dimen/fourteen_sp"
                            android:textStyle="bold"
                            android:textColor="@color/black"
                            android:fontFamily="@font/poppins_medium"
                            android:layout_width="match_parent"
                            android:text="Rank : 8"
                            android:layout_height="wrap_content">

                        </TextView>
                        <TextView
                            android:layout_weight="0.05"
                            android:textStyle="bold"
                            android:textSize="@dimen/sixteen_sp"
                            android:gravity="center"
                            android:background="@drawable/rank_medal_icon"
                            android:layout_width="@dimen/fourty"
                            android:layout_height="@dimen/fourty">

                        </TextView>

                    </LinearLayout>
                </LinearLayout>

            </androidx.cardview.widget.CardView>

        </RelativeLayout>
    </ScrollView>



</RelativeLayout>