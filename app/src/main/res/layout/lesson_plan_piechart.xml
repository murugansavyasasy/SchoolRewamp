<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
   >

    <androidx.cardview.widget.CardView
        android:id="@+id/rootHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        app:cardBackgroundColor="@android:color/white"
        app:cardCornerRadius="@dimen/eight"
        app:cardElevation="@dimen/three"
        app:cardUseCompatPadding="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lblView"
                android:layout_width="@dimen/eight"
                android:layout_height="match_parent"
                android:background="@color/light_orange4" />

            <RelativeLayout
                android:id="@+id/totalrelative_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <LinearLayout
                    android:id="@+id/linearlayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentTop="true"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/ten"
                    android:gravity="end|center_vertical"
                    android:orientation="horizontal">

                    <com.vs.schoolmessenger.Utils.CustomPieChartView
                        android:id="@+id/customPieChart"
                        android:layout_width="@dimen/hundred"
                        android:layout_height="@dimen/hundred"
                        android:layout_marginEnd="@dimen/ten"
                        android:layout_gravity="center_vertical"
                        android:padding="10dp" />

                    <ImageView
                        android:id="@+id/imgPunchHistory"
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"

                        android:layout_gravity="center_vertical"
                        android:src="@drawable/rightarrrow" />
                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/rlaDetails"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_toStartOf="@+id/linearlayout">


                    <TextView
                        android:id="@+id/lblSubject"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ten"
                        android:text="Principles of  Management"
                      >

                    </TextView>


                    <TextView
                        android:id="@+id/lblStaffName"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/lblSubject"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_marginTop="@dimen/four"
                        android:text="Sathish"
                        >

                    </TextView>


                    <TextView
                        android:id="@+id/lblSection"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/lblStaffName"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_marginTop="@dimen/four"
                        android:text="XII - A"
                      >

                    </TextView>


                    <TextView
                        android:id="@+id/lblStatus"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/lblSection"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_marginTop="@dimen/four"
                        android:gravity="start"
                        android:text="Items completed : 0/0"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp"
                        android:visibility="visible">

                    </TextView>


                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rlaDetails"
                    android:layout_marginTop="@dimen/fifteen"
                    android:paddingBottom="@dimen/ten">

                    <TextView
                        android:id="@+id/lblComplete"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/ten"
                        android:text="20 % Completed"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp"
                        android:textStyle="bold"
                        android:visibility="gone">

                    </TextView>

                    <TextView
                        android:id="@+id/lblPending"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/lblComplete"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="@dimen/ten"
                        android:layout_marginEnd="@dimen/twenty_eight"
                        android:text="80 % Pending"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp"
                        android:textStyle="bold"
                        android:visibility="gone">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty"
                        android:layout_height="@dimen/twenty"
                        android:layout_alignParentEnd="true"
                        android:layout_marginEnd="@dimen/hundred_thirty"
                        android:background="@drawable/green_box"
                        android:visibility="gone">

                    </ImageView>

                    <ImageView
                        android:layout_width="@dimen/twenty"
                        android:layout_height="@dimen/twenty"
                        android:layout_below="@+id/lblComplete"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="@dimen/ten"
                        android:layout_marginEnd="@dimen/hundred_thirty"
                        android:background="@drawable/red_box"
                        android:visibility="gone">

                    </ImageView>


                </RelativeLayout>
            </RelativeLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>
