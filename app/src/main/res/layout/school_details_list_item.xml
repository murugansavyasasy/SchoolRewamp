<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/rlaStaffDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fifteen"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginEnd="@dimen/fifteen"
        android:layout_marginBottom="@dimen/ten"
        android:background="@drawable/bg_blue_gradient"
        android:padding="@dimen/twenty">

        <androidx.cardview.widget.CardView
            android:id="@+id/cardImage"
            android:layout_width="@dimen/fifty"
            android:layout_height="@dimen/fifty"
            app:cardCornerRadius="@dimen/ten"
            android:layout_centerVertical="true"
            android:layout_gravity="center"
            app:cardElevation="@dimen/five">

            <ImageView
                android:id="@+id/imgSchool"
                android:layout_width="@dimen/fifty"
                android:layout_height="@dimen/fifty"
                android:layout_centerVertical="true"
                android:layout_gravity="center"
                android:src="@drawable/splash_icon1" />

        </androidx.cardview.widget.CardView>


        <RelativeLayout
            android:id="@+id/relativelayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/ten"
            android:layout_toEndOf="@+id/cardImage">

            <TextView
                android:id="@+id/lblStaffName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text=""
                android:visibility="visible"
                style="@style/CustomTextStylePoppinsBold"/>

            <TextView
                android:id="@+id/lblSchoolName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblStaffName"
                android:text=""
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp"
                android:layout_marginTop="@dimen/three"
                style="@style/CustomTextStylePoppinsMedium"/>

            <TextView
                android:id="@+id/lblSchoolRegionalName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ten"
                android:layout_below="@+id/lblSchoolName"
                android:visibility="gone"
                android:text=""
                style="@style/CustomTextStylePoppinsMedium"
                android:textSize="@dimen/thirteen_sp">

            </TextView>


            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/relative_layout2"
                android:layout_marginTop="@dimen/three"
                android:layout_below="@+id/lblSchoolRegionalName">

                <TextView
                    android:id="@+id/lblRole"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text=""
                    style="@style/CustomTextStylePoppinsMedium"/>

                <ImageView
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:id="@+id/selectionarrow"
                    android:visibility="visible"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/rightsquarearrow"/>

            </RelativeLayout>

            <TextView
                android:id="@+id/lblCity"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/relative_layout2"
                android:text=""
                android:visibility="visible"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_marginTop="@dimen/three"/>

            <TextView
                android:id="@+id/lblSchoolAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblCity"
                android:text=""
                android:textColor="@color/light_gray"
                android:textSize="@dimen/thirteen_sp"
                android:visibility="visible"
                android:layout_marginTop="@dimen/three"
                style="@style/CustomTextStylePoppinsMedium"/>


        </RelativeLayout>


    </RelativeLayout>

    <CheckBox
        android:id="@+id/terms_checkbox"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_centerVertical="true"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginEnd="@dimen/five"
        android:padding="@dimen/five"
        android:textColor="@color/black"
        android:textSize="@dimen/thirteen_sp"
        android:visibility="gone" />

</RelativeLayout>