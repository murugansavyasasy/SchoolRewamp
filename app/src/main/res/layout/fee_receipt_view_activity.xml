<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/AthensGray">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground">

        <include
            android:id="@+id/toolbarLayout"
            layout="@layout/parent_side_tool_bar"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent" />
        />

        <LinearLayout
            android:id="@+id/lytDownload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/toolbarLayout"
            android:layout_alignParentEnd="true"
            android:layout_margin="@dimen/ten"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/five">

            <LinearLayout
                android:id="@+id/lytShare"
                android:visibility="gone"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ten"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="@dimen/fifteen">

                <TextView
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/five"
                    android:text="@string/share"
                    android:textColor="@color/sky_blue"
                    android:textSize="@dimen/fourteen_sp" />

                <ImageView
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:src="@drawable/share_icon_bg_blue" />

            </LinearLayout>

            <LinearLayout
                android:id="@+id/lytDownloadPdf"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ten"
                android:gravity="center_vertical"
                android:orientation="horizontal"
                android:paddingEnd="@dimen/fifteen">

                <TextView
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/five"
                    android:text="@string/download"
                    android:textColor="@color/sky_blue"
                    android:textSize="@dimen/fourteen_sp" />

                <ImageView
                    android:id="@+id/imgDownload"
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:src="@drawable/downloadicon" />

            </LinearLayout>
        </LinearLayout>

        <WebView
            android:id="@+id/feeReceiptWebview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/lytDownload" />
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/lnrDownloadStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginEnd="@dimen/twenty_five"
        android:background="@color/light_gray_8"
        android:elevation="@dimen/ten"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/twele"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="@dimen/thirty_two"
            android:layout_height="@dimen/thirty_two"
            android:layout_marginEnd="@dimen/eight"
            android:indeterminate="true"
            android:visibility="visible" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/downloading"
            android:textColor="@color/white"
            android:textSize="@dimen/sixteen_sp"
            android:visibility="visible" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>
