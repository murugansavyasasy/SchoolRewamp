<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/five"
    app:cardCornerRadius="@dimen/sixteen"
    app:cardElevation="@dimen/two"
    app:cardBackgroundColor="@color/white">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/sixteen"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lblMealName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Break Fast"
            style="@style/CustomTextStylePoppinsBold"
            android:textSize="@dimen/fourteen_sp"
            />

        <TextView
            android:id="@+id/lblTime"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:textColor="@color/light_gray"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/four"
            android:textSize="@dimen/twele_sp"

            android:text="07:00 AM - 08:00 AM"
           />

    </LinearLayout>

</com.google.android.material.card.MaterialCardView>