<?xml version="1.0" encoding="utf-8"?>
<HorizontalScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:id="@+id/summarystatics_report"
    android:scrollbars="none"
    android:padding="8dp">

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal">


        <LinearLayout
            android:layout_width="170dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_gradient3"
            android:orientation="vertical"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_margin="8dp"
            android:clipToOutline="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/school_needs"
                    android:tint="@color/custom_orange_color"/>

                <TextView
                    android:id="@+id/others_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11"
                    android:textColor="@color/black"
                    android:textSize="17sp"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_marginStart="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/total"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:weightSum="2"
                android:orientation="horizontal">



            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressbar3"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:progress="30"
                android:max="100"
                android:progressDrawable="@drawable/progress_custom12"
                android:layout_marginTop="6dp" />




            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="2"
                android:layout_marginTop="15dp"
                android:id="@+id/linear_layodasndkut">


                <TextView
                    android:id="@+id/total_male"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Staffs 3"
                    android:layout_weight="1"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:textColor="@color/light_gray"
                    android:textSize="11sp" />



                <TextView
                    android:id="@+id/total_female"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Students 3"
                    android:textColor="@color/light_gray"
                    android:textSize="11sp"
                    android:layout_weight="1"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:gravity="end" />

            </LinearLayout>
            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="15dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/growth_value3"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ 3 from last year"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/light_gray"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/arrow_up"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/arrow_up"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="170dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_gradient1"
            android:orientation="vertical"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_margin="8dp"
            android:clipToOutline="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/doubleprofile" />

                <TextView
                    android:id="@+id/student_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11"
                    android:textColor="@color/black"
                    android:textSize="17sp"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_marginStart="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Students"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:weightSum="2"
                android:orientation="horizontal">




            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressbar1"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:progress="30"
                android:max="100"
                android:progressDrawable="@drawable/progress_custom21"
                android:layout_marginTop="6dp" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginTop="13dp"
                android:id="@+id/linear_layout">

                <TextView
                    android:id="@+id/boyscount1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="boys 3"
                    android:gravity="start"
                    android:layout_weight="1"
                    android:textColor="@color/light_gray"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/girlscount1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="girls 3"
                    android:textColor="@color/light_gray"
                    android:textSize="11sp"
                    android:gravity="center"
                    android:layout_weight="1"
                    style="@style/CustomTextStylePoppinsMedium" />

                <TextView
                    android:id="@+id/otherscount1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="others 3"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/light_gray"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:textSize="11sp" />


            </LinearLayout>



            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="15dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/growth_value1"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ 3 from last year"
                    android:maxLines="1"
                    android:ellipsize="end"
                    android:textColor="@color/light_gray"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/arrow_up1"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/arrow_up"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>

        <LinearLayout
            android:layout_width="170dp"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_card_gradient2"
            android:orientation="vertical"
            android:padding="16dp"
            android:elevation="4dp"
            android:layout_margin="8dp"
            android:clipToOutline="true">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center_vertical">

                <ImageView
                    android:layout_width="20dp"
                    android:layout_height="20dp"
                    android:src="@drawable/teachersvgformat"
                    android:tint="@color/green_56"/>

                <TextView
                    android:id="@+id/staff_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="11"
                    android:textColor="@color/black"
                    android:textSize="17sp"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_marginStart="6dp" />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/staff"
                    android:textColor="@color/black"
                    android:textSize="14sp"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_marginStart="4dp" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="8dp"
                android:weightSum="2"
                android:orientation="horizontal">




            </LinearLayout>

            <ProgressBar
                android:id="@+id/progressbar2"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="match_parent"
                android:layout_height="8dp"
                android:progress="30"
                android:max="100"
                android:progressDrawable="@drawable/progress_custom21"
                android:layout_marginTop="6dp" />


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="3"
                android:layout_marginTop="13dp"
                android:id="@+id/linear_layout45">
                <TextView
                    android:id="@+id/malestaff_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="male 3"
                    android:layout_weight="1"
                    android:gravity="start"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:textColor="@color/light_gray"
                    android:textSize="11sp" />

                <TextView
                    android:id="@+id/female_staffcount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="female 3"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:textColor="@color/light_gray"
                    android:textSize="11sp"
                    android:gravity="center" />

                <TextView
                    android:id="@+id/othersstaffcount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="others 3"
                    android:layout_weight="1"
                    android:gravity="end"
                    android:textColor="@color/light_gray"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:textSize="11sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp"
                android:gravity="center_vertical">

                <TextView
                    android:id="@+id/growth_value2"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="+ 3 from last year"
                    android:textColor="@color/light_gray"
                    android:maxLines="1"
                    android:ellipsize="end"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:textSize="13sp" />

                <ImageView
                    android:id="@+id/arrow_up2"
                    android:layout_width="14dp"
                    android:layout_height="14dp"
                    android:src="@drawable/arrow_up"
                    android:layout_marginStart="4dp" />
            </LinearLayout>
        </LinearLayout>


    </LinearLayout>
</HorizontalScrollView>