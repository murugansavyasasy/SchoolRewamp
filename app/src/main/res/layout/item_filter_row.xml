<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:gravity="center_vertical"
    android:orientation="horizontal">

    <!-- TYPE CUSTOM SPINNER -->
    <!-- TYPE CUSTOM SPINNER -->
    <RelativeLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/rect_shadow_white">

        <Spinner
            android:id="@+id/spnType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/imgTypeArrow"
            android:background="@null"
            android:drawSelectorOnTop="true"
            android:paddingVertical="6dp" />

        <ImageView
            android:id="@+id/imgTypeArrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_drop_down"
            android:tint="@color/black" />
    </RelativeLayout>

    <!-- SPACE -->
    <View
        android:layout_width="8dp"
        android:layout_height="1dp" />

    <!-- VALUE CUSTOM SPINNER -->
    <!-- VALUE CUSTOM SPINNER -->
    <RelativeLayout
        android:id="@+id/lytValueSpinner"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:background="@drawable/rect_shadow_white">

        <Spinner
            android:id="@+id/spnValue"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@id/imgValueArrow"
            android:background="@null"
            android:drawSelectorOnTop="true"
            android:paddingVertical="6dp" />

        <ImageView
            android:id="@+id/imgValueArrow"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/ic_drop_down"
            android:tint="@color/black" />
    </RelativeLayout>

    <!-- PLUS ICON -->
    <ImageView
        android:id="@+id/imgAddFilter"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_marginEnd="@dimen/ten"
        android:src="@drawable/ic_plus_blue" />

</LinearLayout>
