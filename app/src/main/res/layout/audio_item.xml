<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    android:id="@+id/rlaSeekBarAndTitle"
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="25dp"
    android:background="@drawable/rect_shadow_white">


    <ImageView
        android:id="@+id/imgVoicePlay"
        android:layout_width="30dp"
        android:layout_height="30dp"
        android:layout_centerVertical="true"
        android:layout_marginStart="8dp"
        android:src="@drawable/video_play" />


    <SeekBar
        android:id="@+id/audioSeekBar"
        android:layout_width="0dp"
        android:layout_height="30dp"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@id/imgVoicePlay"
        android:layout_toStartOf="@id/lblTime"
        android:layout_marginStart="12dp"
        android:layout_marginEnd="12dp"
        android:progressDrawable="@drawable/custom_seekbar_wave"
        android:thumb="@drawable/transparent_thumb"/>


    <TextView
        android:id="@+id/lblTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="8dp"
        android:text="0:03"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:fontFamily="sans-serif-medium"/>

    <TextView
        android:id="@+id/lblCurrentDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerVertical="true"
        android:layout_toEndOf="@id/imgVoicePlay"
        android:layout_marginStart="12dp"
        android:text="00:00"
        android:textColor="@color/black"
        android:textSize="14sp"
        android:visibility="gone"/>

</RelativeLayout>
