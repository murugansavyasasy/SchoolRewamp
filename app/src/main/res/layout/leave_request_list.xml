<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fitsSystemWindows="true">


    <RelativeLayout
        android:id="@+id/rlaLeaveRequest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/five"
        android:background="@drawable/rect_shadow_white">


        <RelativeLayout
            android:id="@+id/relative_layout"
            android:layout_width="@dimen/hundred"
            android:layout_height="@dimen/thirty_three"
            android:layout_marginStart="@dimen/twenty"
            android:layout_marginEnd="@dimen/twenty"
            android:layout_alignParentEnd="true"
            android:gravity="center"
            android:layout_marginTop="@dimen/ten"
            android:visibility="gone"
            android:background="@drawable/bg_green_radoius_10dp"
            android:padding="@dimen/two">


            <TextView
                android:id="@+id/statustext_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/approve"
                android:textSize="13sp"
                android:textColor="@color/white"
               style="@style/CustomTextStylePoppinsBold">

            </TextView>
        </RelativeLayout>


        <LinearLayout
            android:id="@+id/lblLeaveInformation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_below="@+id/relative_layout"
            android:orientation="vertical">




            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="13dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    >

                    <TextView
                        android:id="@+id/lblFromData"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Mar 31, 2023"
                        android:textColor="@color/navi_blue2"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsBold" />

                    <ImageView
                        android:id="@+id/imagearrow_view"
                        android:layout_width="@dimen/sixteen"
                        android:layout_height="@dimen/sixteen"
                        android:layout_marginStart="16dp"
                        android:layout_marginEnd="4dp"
                        android:layout_marginTop="2dp"
                        android:src="@drawable/exchangearrow">
                    </ImageView>

                    <TextView
                        android:id="@+id/lblToDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Apr 2 -2023"
                        android:textColor="@color/navi_blue2"
                        android:textSize="@dimen/fourteen_sp"
                        android:layout_marginStart="2dp"
                        style="@style/CustomTextStylePoppinsBold" />
                </LinearLayout>

                <!-- Row 2: Name -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="10dp"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/namelabel"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Name"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsBold" />

                    <TextView
                        android:id="@+id/dotlabel"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsBold" />

                    <TextView
                        android:id="@+id/lblName"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Sathish"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/light_blue_1"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsMedium" />
                </LinearLayout>

                <!-- Row 3: Class -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp">

                    <TextView
                        android:id="@+id/classlabel"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Class"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsBold" />

                    <TextView
                        android:id="@+id/dotlabel1"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsBold" />

                    <TextView
                        android:id="@+id/lblSection"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="XII - B"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/light_blue_1"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsMedium" />
                </LinearLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"

                    >

                    <TextView
                        android:id="@+id/noofdayslabel"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="No.Of.Days"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsBold" />
                    <TextView
                        android:id="@+id/dotlabel2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsBold" />

                    <TextView
                        android:id="@+id/lbldays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/light_blue_1"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsMedium"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    >

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"

                        android:text="Applied On"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsBold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsBold" />

                    <TextView
                        android:id="@+id/lbldate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="04 Jun 2025 03:38 PM"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/light_blue_1"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsMedium"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/reasonlabel"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Reason"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsBold" />

                    <TextView
                        android:id="@+id/dotlabel3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsBold"  />

                    <TextView
                        android:id="@+id/leaverequestdesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Going to temple"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/light_blue_1"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsMedium" />
                </LinearLayout>

            </LinearLayout>








        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomlinear_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lblLeaveInformation"
            android:layout_margin="@dimen/ten"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <RelativeLayout
                android:id="@+id/btnapprove"
                android:layout_width="@dimen/hundred"
                android:layout_height="@dimen/thirty_three"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginEnd="@dimen/twenty"
                android:layout_weight="0"
                android:background="@drawable/bg_green_radoius_10dp"
                android:gravity="center"
                android:padding="@dimen/two">

                <ImageView
                    android:id="@+id/imgChecked"
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:layout_marginEnd="@dimen/ten"
                    android:src="@drawable/checkimage">

                </ImageView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/imgChecked"
                    android:text="@string/approve"
                    android:textSize="@dimen/fourteen_sp"
                    android:textColor="@color/white"
                    android:textStyle="bold">

                </TextView>
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/btnrejected"
                android:layout_width="@dimen/hundred"
                android:layout_height="@dimen/thirty_three"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginEnd="@dimen/twenty"
                android:layout_weight="0"
                android:background="@drawable/bg_red_radious__all_side_same"
                android:gravity="center"
                android:padding="@dimen/five">

                <ImageView
                    android:id="@+id/imgReject"
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:layout_marginEnd="@dimen/ten"
                    android:src="@drawable/close_icon_red">

                </ImageView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/imgReject"
                    android:text="@string/reject"
                    android:textColor="@color/white"
                    android:textSize="@dimen/fourteen_sp"
                    android:textStyle="bold">

                </TextView>
            </RelativeLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomstatuslinear_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lblLeaveInformation"
            android:layout_margin="@dimen/ten"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="visible">

            <RelativeLayout
                android:id="@+id/bottomstatusrelative_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/thirty_three"
                android:layout_weight="0"
                android:background="@drawable/bg_red_radoius_10dp"
                android:gravity="center"
                android:padding="@dimen/two">


                <TextView
                    android:id="@+id/status_textlabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rejected On 04 Jun 2025 03:50 PM"
                    android:textSize="14sp"
                    android:textColor="@color/red"
                   style="@style/CustomTextStylePoppinsBold">

                </TextView>
            </RelativeLayout>



        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>