<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/ten"
    android:background="@color/white">

    <ImageView
        android:layout_width="@dimen/thirty"
        android:layout_alignParentEnd="true"
        android:id="@+id/imgClose"
        android:src="@drawable/close_red_color"
        android:layout_marginTop="@dimen/fifteen"
        android:layout_marginEnd="@dimen/fifteen"
        android:layout_height="@dimen/thirty">

    </ImageView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcySlotDate"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/ten"
        android:layout_height="wrap_content"
        android:layout_below="@+id/imgClose"
        android:layout_above="@id/lblCreateSlot"
       />

    <TextView
        android:id="@+id/lblCreateSlot"
        style="@style/CustomTextStylePoppinsBold1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/twenty"
        android:layout_marginEnd="@dimen/twenty"
        android:layout_marginBottom="@dimen/twenty"
        android:background="@drawable/bg_orange"
        android:gravity="center"
        android:padding="@dimen/ten"
        android:text="@string/open_above_slots"
        android:textColor="@color/white"
        android:textSize="@dimen/fifteen_sp" />
</RelativeLayout>