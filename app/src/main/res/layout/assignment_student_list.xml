<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    card_view:cardCornerRadius="12dp"
    card_view:cardElevation="4dp"
    android:layout_margin="8dp"
    android:backgroundTint="@android:color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="12dp">

\        <TextView
            android:id="@+id/avatarText"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:gravity="center"
            android:textSize="20sp"
            android:textColor="@android:color/white"
            android:background="@drawable/default_profile"
            android:layout_marginEnd="12dp" />

        <!-- Top Name -->
        <TextView
            android:id="@+id/lblStudentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/avatarText"
            android:text="SARANRAJ SHANMUGAM"
            android:textColor="@android:color/black"
          style="@style/CustomTextStylePoppinsBold"
            android:textSize="15sp" />

        <!-- Section -->
        <TextView
            android:id="@+id/sectionlabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/lblStudentName"
            android:layout_toEndOf="@id/avatarText"
            android:text="I - B"
            android:textColor="#666666"
            android:textSize="13sp"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_marginTop="2dp" />

        <!-- Submitted Label -->
        <TextView
            android:id="@+id/submittedLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/sectionlabel"
            android:layout_toEndOf="@id/avatarText"
            android:text="Submitted:"
          style="@style/CustomTextStylePoppinsBold"
            android:textSize="13sp"
            android:layout_marginTop="6dp"
            android:textColor="@android:color/black" />

        <!-- Date Text -->
        <TextView
            android:id="@+id/submittedDate"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/submittedLabel"
            android:layout_alignTop="@id/submittedLabel"
            android:layout_marginStart="4dp"
            android:text="Mon, 11"
            android:textSize="13sp"
            style="@style/CustomTextStylePoppinsMedium"
            android:textColor="@android:color/black" />

        <LinearLayout
            android:id="@+id/statusButton"
            android:layout_width="wrap_content"
            android:layout_height="36dp"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:orientation="horizontal"
            android:background="@drawable/pending_button_bg"
            android:paddingStart="12dp"
            android:paddingEnd="12dp"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:id="@+id/cancelimage"
                android:src="@drawable/close_red_color"
                android:layout_marginEnd="6dp" />

            <TextView
                android:id="@+id/statuslabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                style="@style/CustomTextStylePoppinsMedium"
                android:textColor="@android:color/holo_red_dark"
                android:textSize="13sp" />
        </LinearLayout>

    </RelativeLayout>
</androidx.cardview.widget.CardView>
