                    <solid android:color="#BDBDBD" />
                    <size android:width="4dp" android:height="14dp" />
                </shape>
            </item>
            <item android:left="40mm" android:right="50mm">
                <shape android:shape="rectangle">
                    <solid android:color="#BDBDBD" />
                    <size android:width="4dp" android:height="6dp" />
                </shape>
            </item>
        </layer-list>
    </item>

    <item android:id="@android:id/progress">
        <clip>
            <shape android:shape="rectangle">
                <size android:height="4dp" />
            </shape>
        </clip>
        <layer-list>
            <item android:left="0dp" android:right="90mm">
                <shape android:shape="rectangle">
                    <solid android:color="#2196F3" />
                    <size android:width="4dp" android:height="2dp" />
                </shape>
            </item>
            <item android:left="5mm" android:right="85mm">
                <shape android:shape="rectangle">
                    <solid android:color="#2196F3" />
                    <size android:width="4dp" android:height="8dp" />
                </shape>
            </item>

        </layer-list>
    </item>
</layer-list>