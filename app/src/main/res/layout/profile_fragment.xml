<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/white"
    android:orientation="vertical">

    <RelativeLayout
        android:id="@+id/scrollView"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_weight="1"
        android:fillViewport="true">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="70dp"
                    android:background="@color/PrimaryColor" />

                <FrameLayout
                    android:layout_width="@dimen/hundred"
                    android:layout_height="@dimen/hundred"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/one_sixty"
                    android:translationY="-200dp">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/imgProfile"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:scaleType="centerCrop"
                        android:src="@drawable/default_profile"
                        app:shapeAppearanceOverlay="@style/CircleImageShape" />

                    <!-- Camera icon: changes the profile photo -->
                    <ImageView
                        android:id="@+id/imgEdit"
                        android:layout_width="@dimen/twenty_eight"
                        android:layout_height="@dimen/twenty_eight"
                        android:layout_gravity="bottom|end"
                        android:background="@drawable/circle_white_bg"
                        android:padding="@dimen/four"
                        android:src="@drawable/camerasvgformat" />

                    <ImageView
                        android:id="@+id/imgEditFields"
                        android:layout_width="@dimen/twenty_eight"
                        android:layout_height="@dimen/twenty_eight"
                        android:layout_gravity="top|end"
                        android:background="@drawable/circle_white_bg"
                        android:padding="@dimen/four"
                        android:contentDescription="Edit Profile"
                        android:src="@drawable/ic_edit_pencil" />
                </FrameLayout>
            </FrameLayout>


            <LinearLayout
                android:id="@+id/lytNoDataFound"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_horizontal"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/noDataImage"
                    android:layout_width="@dimen/two_hundred"
                    android:layout_height="@dimen/two_hundred"
                    android:layout_marginTop="@dimen/twenty_five"
                    android:src="@drawable/no_data_found" />

                <TextView
                    android:id="@+id/noDataFound"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/twenty"
                    android:text="@string/no_data_found"
                    android:textSize="@dimen/fifteen_sp" />
            </LinearLayout>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recyclerview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="-110dp"
                android:scrollbars="none" />

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcyImages"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="visible" />

        </LinearLayout>

    </RelativeLayout>


    <TextView
        android:id="@+id/btnupdateprofile"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/twenty_five"
        android:layout_marginEnd="@dimen/twenty_five"
        android:layout_marginBottom="@dimen/twenty"
        android:background="@drawable/background_radius_button"
        android:gravity="center"
        android:padding="@dimen/ten"
        android:text="@string/UpdateProfile"
        android:textColor="@color/white"
        android:textSize="@dimen/fifteen_sp" />
</LinearLayout>