<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/ten"
    card_view:cardCornerRadius="@dimen/sixteen"
    card_view:cardElevation="@dimen/four"
    card_view:cardUseCompatPadding="true">

    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:id="@+id/Header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <View
                android:id="@+id/leftRibbon"
                android:layout_width="8dp"
                android:layout_alignStart="@+id/lnrDetail"
                android:layout_height="@dimen/one_fifty"
                android:layout_alignParentStart="true"
                android:background="@color/dark_orange_2" />




            <LinearLayout
                android:id="@+id/lnrDetail"
                android:layout_marginStart="@dimen/ten"
                android:layout_centerVertical="true"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                >

                <!-- Exam Header -->
                <LinearLayout
                    android:padding="16dp"
                    android:id="@+id/header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <!-- Radio Indicator -->
                    <ImageView
                        android:src="@drawable/circle_icon"
                        android:id="@+id/imgCheck"
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/examTitle"
                            android:text="Mid-Term Examination"
                            android:textColor="@color/black"
                            android:textSize="18sp" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:id="@+id/examMonth"
                            android:layout_marginTop="@dimen/ten"
                            android:text="October 2024"
                            android:alpha="0.6"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <ImageView
                        android:tint="@color/gnt_gray"
                        android:id="@+id/arrow"
                        android:layout_width="@dimen/fifteen"
                        android:layout_height="@dimen/fifteen"
                        android:src="@drawable/down_arrow_3" />
                </LinearLayout>
            </LinearLayout>

        </RelativeLayout>
        <View
            android:id="@+id/viewDiv"
            android:layout_width="match_parent"
            android:background="@color/AthensGray"
            android:layout_height="@dimen/one">
        </View>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcSubject"
            android:background="@color/very_light_gray_13"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone" />
    </LinearLayout>

</androidx.cardview.widget.CardView>
