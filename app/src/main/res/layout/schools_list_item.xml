<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/five"
    android:background="@drawable/rect_white_light_radious"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/rlaHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/ten"
        app:layout_constraintTop_toTopOf="parent">


        <CheckBox
            android:id="@+id/chMultipleSchool"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:visibility="visible">

        </CheckBox>


        <RelativeLayout
            android:id="@+id/rytSchoolImage"
            android:layout_width="@dimen/sixty"
            android:layout_height="@dimen/sixty"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/ten"
            android:layout_toEndOf="@+id/chMultipleSchool"
            android:background="@drawable/rect_grey">

            <ImageView
                android:id="@+id/imgSchoolLogo"
                android:layout_width="@dimen/fourty"
                android:layout_height="@dimen/fourty"
                android:layout_centerInParent="true"
                android:src="@drawable/school_sample" />

        </RelativeLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/fifteen"
            android:layout_toStartOf="@+id/imgSingleSchoolArrow"
            android:layout_toEndOf="@+id/rytSchoolImage">

            <TextView
                android:id="@+id/lblSchoolName"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_bold"
                android:text="Savyasasy software solution pvt ltd.," />

            <TextView
                android:id="@+id/lblSchoolRegionalName"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblSchoolName"
                android:layout_marginEnd="@dimen/ten"
                android:text=""
                android:visibility="gone">

            </TextView>

            <TextView
                android:id="@+id/lblSchoolAddress"
                style="@style/CustomTextStylePoppinsRegular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblSchoolRegionalName"
                android:layout_marginTop="@dimen/five"
                android:text="Chennai, Nungambakkam"
                android:textColor="@color/grey"
                android:textSize="@dimen/thirteen_sp" />


        </RelativeLayout>


        <ImageView
            android:id="@+id/imgSingleSchoolArrow"
            android:layout_width="@dimen/twenty"
            android:layout_height="@dimen/twenty"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/arrow_right_gray"
            android:visibility="gone" />


    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>