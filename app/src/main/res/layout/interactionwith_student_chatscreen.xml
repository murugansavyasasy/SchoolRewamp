<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
  >

    <RelativeLayout
        android:id="@+id/rytHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_theme_school"
        android:paddingVertical="@dimen/fifteen">

        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="@dimen/thirty_five"
            android:layout_height="@dimen/thirty_five"
            android:layout_centerVertical="true"
            android:src="@drawable/arrow_left_white">

        </ImageView>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/profileImage"
            android:layout_width="@dimen/fourty"
            android:layout_height="@dimen/fourty"
            android:src="@drawable/default_profile"
            android:scaleType="centerCrop"
            android:layout_marginTop="@dimen/three"
            app:shapeAppearanceOverlay="@style/CircleImageShape"
            android:layout_toEndOf="@+id/imgBack"/>




        <LinearLayout
            android:id="@+id/rlaStudentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/ten"
            android:layout_toEndOf="@+id/profileImage"
            android:layout_marginTop="@dimen/five"
            android:layout_marginStart="@dimen/five"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lblStudentName"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="SARAN"
                android:textColor="@color/white"
                >

            </TextView>

            <TextView
                android:id="@+id/lblStudentSection"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblStudentName"
                android:text="ENGLISH"
                android:textColor="@color/white"
               >

            </TextView>

        </LinearLayout>

    </RelativeLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcystaffQuestionchatdata"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/rytHeader"
        android:layout_above="@+id/bottomChatInput"
        android:nestedScrollingEnabled="false" />


    <LinearLayout
        android:id="@+id/bottomChatInput"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:background="@color/white"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/ten">

        <ImageView
            android:id="@+id/btnAdd"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/ten"
            android:layout_gravity="bottom"
            android:visibility="gone"
            android:layout_marginBottom="@dimen/ten"
            android:contentDescription="Attachment"
            android:src="@drawable/ic_plus" />

        <LinearLayout
            android:layout_width="@dimen/zero"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:layout_marginEnd="@dimen/ten"
            android:orientation="vertical">

            <LinearLayout
                android:id="@+id/reply_linearlayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginBottom="@dimen/five"
                android:visibility="gone"
                android:background="@drawable/bg_message_input">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:layout_marginBottom="@dimen/five">

                    <TextView
                        android:id="@+id/txtReplyingTo"
                        android:layout_width="@dimen/zero"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:text="Replying "
                        android:textColor="@color/black"
                        android:textSize="@dimen/twele_sp"
                        style="@style/CustomTextStylePoppinsBold"

                        android:paddingBottom="@dimen/four" />

                    <ImageView
                        android:id="@+id/imgCloseReply"
                        android:layout_width="@dimen/twenty"
                        android:layout_height="@dimen/twenty"
                        android:src="@drawable/close_red_color"
                        android:layout_marginEnd="@dimen/eight"
                        android:contentDescription="@string/close_reply" />
                </LinearLayout>


                <TextView
                    android:id="@+id/txtquestion"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Hi How are you"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:textSize="@dimen/twele_sp"
                    android:layout_marginBottom="@dimen/five"
                    android:paddingBottom="@dimen/four" />


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical"
                    android:weightSum="2"
                    android:layout_marginBottom="@dimen/five">


                <TextView
                    android:id="@+id/replytext"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/reply"
                    android:gravity="center"
                    android:textColor="@color/iconBlue"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_weight="1"
                    android:textSize="@dimen/fifteen_sp"
                    android:layout_marginBottom="@dimen/five"
                    android:paddingBottom="@dimen/four" />


                    <TextView
                        android:id="@+id/replyalltext"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/reply_all"
                        android:textColor="@color/iconBlue"
                        android:layout_weight="1"
                        style="@style/CustomTextStylePoppinsBold"
                        android:textSize="@dimen/fifteen_sp"
                        android:gravity="center"
                        android:layout_marginBottom="@dimen/five"
                        android:paddingBottom="@dimen/four" />

                </LinearLayout>
            </LinearLayout>

            <EditText
                android:id="@+id/edtMessage"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fourty"
                android:background="@drawable/bg_message_input"
                android:gravity="center_vertical"
                android:visibility="gone"
                android:hint="@string/type_your_message_here"
                android:inputType="textMultiLine"
                android:paddingHorizontal="@dimen/twele"
                android:textColor="@color/black"
                android:textSize="@dimen/fourteen_sp" />
        </LinearLayout>

    </LinearLayout>



    <LinearLayout
        android:id="@+id/lytList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/nomessage"
            android:layout_width="@dimen/two_fifty"
            android:layout_height="@dimen/two_fifty"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/twenty"
            android:src="@drawable/nomessages"
            android:textColor="@color/black"
            android:textSize="@dimen/fifteen_sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtNoData"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/twenty"
            android:gravity="center"
            android:text="@string/no_list_found"
            android:textSize="@dimen/fifteen_sp"
            android:visibility="gone" />


    </LinearLayout>


</RelativeLayout>