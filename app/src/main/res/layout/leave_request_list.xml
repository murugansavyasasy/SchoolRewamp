<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fitsSystemWindows="true">


    <RelativeLayout
        android:id="@+id/rlaLeaveRequest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/five"
        android:background="@drawable/rect_shadow_white">


        <RelativeLayout
            android:id="@+id/relative_layout"
            android:layout_width="@dimen/hundred"
            android:layout_height="@dimen/thirty_three"
            android:layout_marginStart="@dimen/twenty"
            android:layout_marginEnd="@dimen/twenty"
            android:layout_alignParentEnd="true"
            android:gravity="center"
            android:layout_marginTop="@dimen/ten"
            android:background="@drawable/bg_green_radoius_10dp"
            android:padding="@dimen/two">


            <TextView
                android:id="@+id/statustext_top"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/approve"
                android:textSize="13sp"
                android:textColor="@color/white"
               style="@style/CustomTextStylePoppinsBold">

            </TextView>
        </RelativeLayout>


        <LinearLayout
            android:id="@+id/lblLeaveInformation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_below="@+id/relative_layout"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/five"
                android:weightSum="0">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:text="@string/name"
                    android:gravity="start"
                    android:textColor="@color/black"
                    android:textSize="@dimen/fourteen_sp"
                    style="@style/CustomTextStylePoppinsMedium" />

                <TextView
                    android:id="@+id/lblName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/twenty_five"
                    android:layout_weight="0"
                    android:text="Sathish"
                    android:textColor="@color/black"
                    android:textSize="@dimen/fourteen_sp"
                    style="@style/CustomTextStylePoppinsMedium"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:weightSum="0">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:text="@string/Class"
                    android:textColor="@color/black"
                    android:textSize="@dimen/fourteen_sp"
                    style="@style/CustomTextStylePoppinsMedium" />

                <TextView
                    android:id="@+id/lblSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="28dp"
                    android:layout_weight="0"
                    android:text="XII - B"
                    android:textColor="@color/black"
                    android:textSize="@dimen/fourteen_sp"
                    style="@style/CustomTextStylePoppinsMedium"/>
            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten"
                >

                <TextView
                    android:id="@+id/lblFromData"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="start"
                    android:text="Mar 31, 2023"
                    android:textColor="@color/black"
                    android:textSize="@dimen/fourteen_sp"
                   style="@style/CustomTextStylePoppinsBold" />

                <ImageView
                    android:layout_width="@dimen/sixteen"
                    android:layout_height="@dimen/sixteen"
                    android:layout_marginStart="@dimen/ninety"
                    android:src="@drawable/exchangearrow">
                </ImageView>

                <TextView
                    android:id="@+id/lblToDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="120dp"
                    android:text="Apr 2 -2023"
                    android:textColor="@color/black"
                    android:textSize="@dimen/fourteen_sp"
                    style="@style/CustomTextStylePoppinsBold" />
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:weightSum="0">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:text="No.Of.Days"
                    android:textColor="@color/black"
                    android:textSize="@dimen/fourteen_sp"
                    style="@style/CustomTextStylePoppinsMedium" />

                <TextView
                    android:id="@+id/lbldays"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="28dp"
                    android:layout_weight="0"
                    android:text="3"
                    android:textColor="@color/black"
                    android:textSize="@dimen/fourteen_sp"
                    style="@style/CustomTextStylePoppinsMedium"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:weightSum="0">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:text="Applied On:"
                    android:textColor="@color/black"
                    android:textSize="@dimen/fourteen_sp"
                    style="@style/CustomTextStylePoppinsMedium" />

                <TextView
                    android:id="@+id/lbldate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="28dp"
                    android:layout_weight="0"
                    android:text="04 Jun 2025 03:38 PM"
                    android:textColor="@color/black"
                    android:textSize="@dimen/fourteen_sp"
                    style="@style/CustomTextStylePoppinsMedium"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:weightSum="0">

                <TextView
                    android:id="@+id/leaverequestdesc"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_weight="0"
                    android:text="Going to temple"
                    android:textColor="@color/black"
                    android:textSize="@dimen/fourteen_sp"
                    style="@style/CustomTextStylePoppinsMedium" />
            </LinearLayout>



        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomlinear_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lblLeaveInformation"
            android:layout_margin="@dimen/ten"
            android:gravity="center"
            android:orientation="horizontal"
            android:layout_marginTop="10dp"
            android:visibility="gone">

            <RelativeLayout
                android:id="@+id/btnapprove"
                android:layout_width="@dimen/hundred"
                android:layout_height="@dimen/thirty_three"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginEnd="@dimen/twenty"
                android:layout_weight="0"
                android:background="@drawable/bg_green_radoius_10dp"
                android:gravity="center"
                android:padding="@dimen/two">

                <ImageView
                    android:id="@+id/imgChecked"
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:layout_marginEnd="@dimen/ten"
                    android:src="@drawable/checkimage">

                </ImageView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/imgChecked"
                    android:text="@string/approve"
                    android:textSize="@dimen/fourteen_sp"
                    android:textColor="@color/white"
                    android:textStyle="bold">

                </TextView>
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/btnrejected"
                android:layout_width="@dimen/hundred"
                android:layout_height="@dimen/thirty_three"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginEnd="@dimen/twenty"
                android:layout_weight="0"
                android:background="@drawable/bg_red_radious__all_side_same"
                android:gravity="center"
                android:padding="@dimen/five">

                <ImageView
                    android:id="@+id/imgReject"
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:layout_marginEnd="@dimen/ten"
                    android:src="@drawable/close_icon_red">

                </ImageView>

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/imgReject"
                    android:text="@string/reject"
                    android:textColor="@color/white"
                    android:textSize="@dimen/fourteen_sp"
                    android:textStyle="bold">

                </TextView>
            </RelativeLayout>

        </LinearLayout>

        <LinearLayout
            android:id="@+id/bottomstatuslinear_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lblLeaveInformation"
            android:layout_margin="@dimen/ten"
            android:gravity="center"
            android:layout_marginTop="10dp"
            android:orientation="horizontal"
            android:visibility="visible">

            <RelativeLayout
                android:id="@+id/bottomstatusrelative_layout"
                android:layout_width="match_parent"
                android:layout_height="@dimen/thirty_three"
                android:layout_weight="0"
                android:background="@drawable/bg_red_radoius_10dp"
                android:gravity="center"
                android:padding="@dimen/two">


                <TextView
                    android:id="@+id/status_textlabel"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Rejected On 04 Jun 2025 03:50 PM"
                    android:textSize="14sp"
                    android:textColor="@color/red"
                   style="@style/CustomTextStylePoppinsBold">

                </TextView>
            </RelativeLayout>



        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>