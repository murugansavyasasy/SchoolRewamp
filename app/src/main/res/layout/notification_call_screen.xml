<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/action_bg"
    android:keepScreenOn="true">


    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="@dimen/two_hundred"
        android:layout_height="@dimen/two_hundred"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/thirty"
        android:background="@drawable/glow_circle"
        android:contentDescription="School Chimes Logo"
        android:padding="20dp"
        android:src="@drawable/app_logo"
        app:layout_constraintVertical_bias="0.30" />

    <TextView
        android:id="@+id/lblMemberName"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/logoImage"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/thirty"
        android:gravity="center"
        android:text="Calling Murugan"
        android:textColor="@color/white"
        android:textSize="@dimen/fifteen_sp" />

    <TextView
        android:id="@+id/lblSchoolName"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lblMemberName"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/ten"
        android:gravity="center"
        android:text="@string/school_chimes"
        android:textColor="@color/white"
        android:textSize="@dimen/twenty_sp" />


    <LinearLayout
        android:id="@+id/lnrDuration"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lblSchoolName"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:orientation="horizontal">


        <TextView
            android:id="@+id/lblCurrentDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten"
            android:text="00:00"
            android:textColor="@color/white"
            android:textSize="@dimen/eighteen_sp"
            android:visibility="visible" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten"
            android:text=" / "
            android:textColor="@color/white"
            android:textSize="@dimen/eighteen_sp"
            android:visibility="visible" />


        <TextView
            android:id="@+id/lblTotalDuration"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten"
            android:text="00:00"
            android:textColor="@color/white"
            android:textSize="@dimen/fifteen_sp"
            android:visibility="visible" />

    </LinearLayout>


    <TextView
        android:id="@+id/lblCallTitle"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lnrDuration"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/fifty"
        android:gravity="center"
        android:text=""
        android:textColor="@color/white"
        android:textSize="@dimen/fifteen_sp"
        android:visibility="visible" />

    <RelativeLayout
        android:id="@+id/actionContainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/fifty_five">

        <!-- Decline Container -->
        <LinearLayout
            android:id="@+id/lytDecline"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_marginStart="@dimen/fifty_five"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/imgDeclineCall"
                android:layout_width="@dimen/fifty_five"
                android:layout_height="@dimen/fifty_five"
                android:background="@drawable/circle_button_red"
                android:contentDescription="Decline Call"
                android:scaleType="centerInside"
                android:src="@drawable/ic_call_end" />

            <TextView
                android:id="@+id/txtDecline"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Decline"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lytAccept"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/fifty_five"
            android:gravity="center"
            android:orientation="vertical">

            <ImageButton
                android:id="@+id/imgAcceptCall"
                android:layout_width="@dimen/fifty_five"
                android:layout_height="@dimen/fifty_five"
                android:background="@drawable/circle_bg_green"
                android:contentDescription="Accept Call"
                android:scaleType="centerInside"
                android:src="@drawable/ic_call_end" />

            <TextView
                android:id="@+id/txtAccept"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="6dp"
                android:text="Accept"
                android:textColor="@android:color/white"
                android:textSize="14sp" />
        </LinearLayout>
    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rytCutCll"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/fifty"
        android:gravity="center"
        android:visibility="gone">

        <ImageButton
            android:id="@+id/callEndButton"
            android:layout_width="@dimen/seventy"
            android:layout_height="@dimen/seventy"
            android:background="@drawable/circle_button_red"
            android:contentDescription="End call"
            android:src="@drawable/ic_call_end" />

        <ImageButton
            android:id="@+id/imgSpecker"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/fifteen"
            android:layout_toEndOf="@+id/callEndButton"
            android:background="@drawable/volume_low" />
    </RelativeLayout>
</RelativeLayout>

