<com.facebook.shimmer.ShimmerFrameLayout android:id="@+id/shimmer_view_container"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="12dp"
    xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- inside here put your shimmer placeholders -->
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <View
            android:id="@+id/shimmerDate"
            android:layout_width="@dimen/three_hundred"
            android:layout_height="16dp"
            android:background="@android:color/darker_gray"
            android:layout_marginBottom="8dp"/>

        <View
            android:id="@+id/shimmerTitle"
            android:layout_width="@dimen/one_fifty"
            android:layout_height="20dp"
            android:background="@android:color/darker_gray"
            android:layout_marginBottom="8dp"/>

        <View
            android:id="@+id/shimmerMode"
            android:layout_width="@dimen/two_hundred"
            android:layout_height="16dp"
            android:background="@android:color/darker_gray"
            android:layout_marginBottom="4dp"/>

        <View
            android:id="@+id/shimmerTime"
            android:layout_width="100dp"
            android:layout_height="16dp"
            android:background="@android:color/darker_gray"
            android:layout_marginBottom="8dp"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="24dp">
            <View
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/darker_gray"
                android:layout_marginEnd="4dp"/>
            <View
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/darker_gray"
                android:layout_marginEnd="4dp"/>
            <View
                android:layout_width="24dp"
                android:layout_height="24dp"
                android:background="@android:color/darker_gray"/>
        </LinearLayout>

    </LinearLayout>
</com.facebook.shimmer.ShimmerFrameLayout>
