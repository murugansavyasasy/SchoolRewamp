<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/header_layout"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fitsSystemWindows="true">

    <androidx.cardview.widget.CardView
        android:layout_width="@dimen/one_fifty"
        android:layout_height="@dimen/fifty"
        android:layout_margin="@dimen/eight"
        android:background="@color/grey"
        app:cardCornerRadius="@dimen/four"
        app:cardElevation="@dimen/four">

        <RelativeLayout
            android:id="@+id/cardview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/rect_white_light_radious">

            <TextView
                android:id="@+id/badge_count"
                android:layout_width="25dp"
                android:layout_height="25dp"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/two"
                android:layout_marginEnd="@dimen/two"
                android:background="@drawable/circle_background1"
                android:elevation="@dimen/ten"
               style="@style/CustomTextStylePoppinsBold"
                android:gravity="center"
                android:text="0"
                android:textColor="@color/black"
                android:textSize="@dimen/twele_sp"
           />

            <TextView
                android:id="@+id/section_values"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                 style="@style/CustomTextStylePoppinsBold"
                android:text="VII - A"
                android:textColor="@color/grey"
                android:textSize="@dimen/fifteen_sp"
          />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>


</RelativeLayout>

