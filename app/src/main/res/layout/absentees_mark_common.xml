<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingBottom="@dimen/sixty"
    >

    <RelativeLayout
        android:id="@+id/rytHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_rounded"
        android:paddingBottom="@dimen/eighty"
        >
        <RelativeLayout
            android:layout_marginTop="@dimen/ten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="@dimen/thirty_five"
                android:layout_height="@dimen/thirty_five"
                android:layout_centerVertical="true"
                android:src="@drawable/left_arrow">

            </ImageView>

            <LinearLayout
                android:layout_toStartOf="@+id/imgSearch"
                android:id="@+id/lytTitleAndName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/imgBack"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblParentToolBar"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="I-B"
                    android:textColor="@color/white"
                    android:textSize="@dimen/fifteen_sp">

                </TextView>

                <TextView
                    android:id="@+id/lblSchoolName"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="New School Rewamp Chennai"
                    android:visibility="visible"
                    android:textColor="@color/white"
                    android:textSize="@dimen/twele_sp">

                </TextView>

            </LinearLayout>
            <ImageView
                android:id="@+id/imgSearch"
                android:layout_width="@dimen/thirty"
                android:layout_alignParentEnd="true"
                android:src="@drawable/search_icon"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/fifteen"
                android:layout_height="@dimen/thirty">

            </ImageView>
        </RelativeLayout>
    </RelativeLayout>
    <LinearLayout
        android:weightSum="1"
        android:id="@+id/statsLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:gravity="center"
        android:layout_alignBottom="@id/rytHeader"
        android:translationY="50dp"
        android:paddingBottom="@dimen/five"
        android:clipToPadding="false"
        android:clipChildren="false"
        >

        <!-- Present Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:layout_marginEnd="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingVertical="@dimen/twenty_five"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvPresentCount"
                    android:text="-"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#00AA7F"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Present"
                    android:textSize="@dimen/fourteen_sp"
                    android:textColor="#333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>

        <!-- Absent Card -->
        <androidx.cardview.widget.CardView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.3"
            android:layout_marginStart="8dp"
            app:cardCornerRadius="12dp"
            app:cardElevation="6dp"
            app:cardBackgroundColor="@android:color/white">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:orientation="vertical"
                android:paddingVertical="@dimen/twenty_five"
                android:gravity="center">

                <TextView
                    android:id="@+id/tvAbsentCount"
                    android:text="-"
                    android:textSize="22sp"
                    android:textStyle="bold"
                    android:textColor="#FF4444"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />

                <TextView
                    android:text="Absent"
                    android:textSize="@dimen/fourteen_sp"
                    android:textColor="#333333"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content" />
            </LinearLayout>
        </androidx.cardview.widget.CardView>
    </LinearLayout>

</RelativeLayout>