<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rect_shadow_white"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/lblSubject"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:text="Science"
        android:textColor="@color/black"
        android:textSize="20sp" />



    <ImageView
        android:id="@+id/options"
        android:layout_width="18dp"
        android:layout_height="18dp"
       android:layout_alignParentEnd="true"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="10dp"
        android:src="@drawable/ic_more_vert"
        android:contentDescription="Calendar icon" />

    <TextView
        android:id="@+id/createddate"
        style="@style/CustomTextStylePoppinsMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/options"
        android:layout_toStartOf="@id/options"
        android:layout_marginEnd="10dp"
        android:text="21/05/2025"
        android:textColor="@color/grey"
        android:textSize="13sp" />




<TextView
        android:id="@+id/lblTitle"
        style="@style/CustomTextStylePoppinsMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lblSubject"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:text="Experiment with solar power building and connection between them is the real power"
        android:textColor="@color/clr_grey_dark"
        android:textSize="13sp" />


    <TextView
        android:id="@+id/lblDescription"
        style="@style/CustomTextStylePoppinsMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lblTitle"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:text="Experiment with solar power building and connection between them is the real power"
        android:textColor="@color/clr_grey_dark"
        android:textSize="13sp" />



    <LinearLayout
        android:id="@+id/lnrSendBy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lblDescription"
        android:layout_marginTop="@dimen/ten"
        android:orientation="horizontal"
        android:visibility="visible"
        android:weightSum="1">

        <TextView
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_weight="0.6"
            android:text="@string/send_by"
            android:textColor="@color/navi_blue3"
            android:textSize="@dimen/thirteen_sp">

        </TextView>

        <TextView
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" : "
            android:textColor="@color/black"
            android:textSize="@dimen/thirteen_sp">

        </TextView>

        <TextView
            android:id="@+id/lblSendby"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:layout_weight="0.5"
            android:text="Abi"
            android:textColor="@color/black"
            android:textSize="@dimen/thirteen_sp">

        </TextView>
    </LinearLayout>



    <TextView
        android:id="@+id/lblCategotry"
        style="@style/CustomTextStylePoppinsMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lnrSendBy"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/rect_shadow_light_green1"
        android:padding="8dp"
        android:text="Category - Electronics"
        android:textColor="@color/black"
        android:textSize="13sp" />


    <TextView
        android:id="@+id/lblSubmissionDue"
        style="@style/CustomTextStylePoppinsMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lnrSendBy"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_toEndOf="@+id/lblCategotry"
        android:background="@drawable/rect_shadow_light_yellow1"
        android:padding="8dp"
        android:text="Submission Due - 05/07/2021"
        android:textColor="@color/clr_grey_dark"
        android:textSize="13sp" />




    <RelativeLayout
        android:id="@+id/rytList"
        android:layout_width="match_parent"
        android:layout_height="@dimen/one_fifty"
        android:layout_below="@+id/lblCategotry"
        android:layout_marginTop="@dimen/five"
        android:visibility="gone">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcyAssignment"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"/>

        <android.webkit.WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="#000000"
            android:visibility="gone" />


        <ProgressBar
            android:id="@+id/loadingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:indeterminateDrawable="@drawable/progress_bar_white"
            android:indeterminateOnly="true"
            android:visibility="gone">

        </ProgressBar>
    </RelativeLayout>




    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rytList"
        android:layout_marginStart="10dp"
        android:layout_marginTop="@dimen/fifteen"
        android:layout_marginBottom="@dimen/ten">

        <TextView
            android:id="@+id/lblSubmitted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rect_shadow_light_yellow1"
            android:gravity="center"
            android:padding="8dp"
            android:text="@string/submitted"
            android:textColor="@color/black"
            android:textSize="13sp"
            style="@style/CustomTextStylePoppinsMedium">
        </TextView>


        <TextView
            android:id="@+id/lblNotSubmitted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_toEndOf="@+id/lblSubmitted"
            android:background="@drawable/rect_shadow_light_yellow1"
            android:gravity="center"
            android:padding="8dp"
            style="@style/CustomTextStylePoppinsMedium"
            android:text="Not Submitted : 1"
            android:textColor="@color/black"
            android:textSize="13sp"
           >
        </TextView>

        <ImageView
            android:id="@+id/imgDelete"
            android:layout_width="@dimen/twenty_five"
            android:layout_height="@dimen/twenty_five"
            android:layout_marginStart="@dimen/ten"
            android:layout_toEndOf="@+id/lblNotSubmitted"
            android:gravity="center"
            android:visibility="gone"
            android:src="@drawable/delete_bin">
        </ImageView>

    </RelativeLayout>

</RelativeLayout>
