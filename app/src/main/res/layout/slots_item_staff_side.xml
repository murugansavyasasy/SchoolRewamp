<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/rytSlots"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/five"
        android:background="@drawable/bg_gradient"
        android:padding="@dimen/ten">

        <TextView
            android:id="@+id/lblDate"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:background="@drawable/white_bg_radius"
            android:padding="@dimen/ten"
            android:text="10 MAY 2005"
            android:textColor="@color/black"
            android:textSize="@dimen/thirteen_sp">
        </TextView>

        <TextView
            android:id="@+id/lblTime"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:layout_toEndOf="@+id/lblDate"
            android:background="@drawable/white_bg_radius"
            android:padding="@dimen/ten"
            android:text="12:00 PM - 03:00 PM"
            android:textColor="@color/black"
            android:textSize="@dimen/thirteen_sp">
        </TextView>

        <ImageView
            android:id="@+id/imgDot"
            android:layout_width="@dimen/thirty_five"
            android:layout_height="@dimen/thirty_five"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/five"
            android:background="@drawable/rounded_grey_background"
            android:padding="@dimen/ten"
            android:src="@drawable/threedot">
        </ImageView>


        <TextView
            android:id="@+id/lblTitle"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lblDate"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/twenty"
            android:text="Exam Meeting"
            android:textColor="@color/black"
            android:textSize="@dimen/sixteen">

        </TextView>

        <TextView
            android:id="@+id/lblMode"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lblTitle"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/five"
            android:text="Mode - Online"
            android:textColor="@color/black"
            android:textSize="@dimen/thirteen">

        </TextView>

        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img1"
            android:layout_width="@dimen/fourty"
            android:layout_height="@dimen/fourty"
            android:layout_below="@+id/lblMode"
            android:layout_marginTop="@dimen/twenty"
            android:layout_marginBottom="@dimen/ten"
            android:background="@drawable/bg_image_background_white_coupon"
            android:scaleType="fitXY"
            android:src="@drawable/user_sample"
            app:shapeAppearanceOverlay="@style/RoundedSquare" />


        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img2"
            android:layout_width="@dimen/fourty"
            android:layout_height="@dimen/fourty"
            android:layout_below="@+id/lblMode"
            android:layout_marginStart="30dp"
            android:layout_marginTop="@dimen/twenty"
            android:layout_marginBottom="@dimen/ten"
            android:background="@drawable/bg_image_background_white_coupon"
            android:scaleType="fitXY"
            android:src="@drawable/user_sample"
            app:shapeAppearanceOverlay="@style/RoundedSquare" />


        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/img3"
            android:layout_width="@dimen/fourty"
            android:layout_height="@dimen/fourty"
            android:layout_below="@+id/lblMode"
            android:layout_marginStart="60dp"
            android:layout_marginTop="@dimen/twenty"
            android:layout_marginBottom="@dimen/ten"
            android:background="@drawable/bg_image_background_white_coupon"
            android:scaleType="fitXY"
            android:src="@drawable/user_sample"
            app:shapeAppearanceOverlay="@style/RoundedSquare" />



        <TextView
            android:id="@+id/tvNoProfiles"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/lblMode"
            android:layout_alignStart="@id/img1"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/twenty"
            android:text="No slot booked yet"
            android:textColor="@color/black"
            android:textSize="@dimen/fourteen_sp"
            android:drawableStart="@drawable/expired"
            android:drawablePadding="8dp"
            android:visibility="gone"/>


        <TextView
            android:id="@+id/lblCount"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lblMode"
            android:layout_marginTop="@dimen/sixteen"
            android:layout_toEndOf="@+id/img3"
            android:background="@drawable/rounded_bg"
            android:padding="@dimen/five"
            android:text="+3"
            android:textColor="@color/black"
            android:textSize="@dimen/twenty"
            android:visibility="gone">

        </TextView>

        <RelativeLayout
            android:id="@+id/rltJoinNow"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lblMode"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/twenty"
            android:background="@drawable/rounded_bg"
            android:visibility="gone"
            android:padding="@dimen/five">

            <TextView
                android:id="@+id/lblJoin"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Join Now"
                android:textColor="@color/PrimaryColor"
                android:textSize="@dimen/thirteen_sp">
            </TextView>

            <ImageView
                android:layout_width="@dimen/twenty"
                android:layout_height="@dimen/twenty"
                android:layout_marginStart="@dimen/five"
                android:layout_toEndOf="@+id/lblJoin"
                android:src="@drawable/arrow_right_blue">
            </ImageView>

        </RelativeLayout>

    </RelativeLayout>

</RelativeLayout>