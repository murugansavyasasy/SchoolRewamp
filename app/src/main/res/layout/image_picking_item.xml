<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:padding="@dimen/ten">

    <RelativeLayout

        android:layout_width="@dimen/eighty"
        android:layout_height="@dimen/eighty">

        <ImageView
            android:id="@+id/imgPicking"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:src="@drawable/add_image"></ImageView>

        <ImageView
            android:background="@drawable/white_circle_bg"
            android:id="@+id/imgDelete"
            android:padding="@dimen/five"
            android:layout_width="@dimen/twenty_five"
            android:layout_height="@dimen/twenty_five"
            android:layout_alignParentEnd="true"
            android:layout_alignParentTop="true"
            android:src="@drawable/del_icon">

        </ImageView>


    </RelativeLayout>
</RelativeLayout>