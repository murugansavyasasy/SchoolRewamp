<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:background="@drawable/rect_bottom_radius"
    android:id="@+id/lnrEntireHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:paddingStart="12dp"
        android:layout_marginHorizontal="@dimen/sixteen"
        android:paddingVertical="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:id="@+id/imgCheck"
            android:layout_width="@dimen/twenty_five"
            android:layout_height="@dimen/twenty_five"
            android:src="@drawable/circle_icon" />

        <RelativeLayout
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/five"
            android:layout_toEndOf="@+id/imgCheck"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:id="@+id/subjectName"
                android:text="Mathematics"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:textSize="17sp"
                android:layout_toStartOf="@+id/lblClear"
                android:textColor="@color/black"/>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/lblClear"
                android:visibility="gone"
                android:text="@string/clear"
                android:layout_centerVertical="true"
                android:paddingVertical="@dimen/three"
                android:paddingHorizontal="@dimen/five"
                android:layout_alignParentEnd="true"
                android:background="@drawable/gray_bg_radius"
                android:textSize="@dimen/fourteen_sp"
                android:textColor="@color/black"/>

        </RelativeLayout>
    </RelativeLayout>

    <LinearLayout
        android:layout_marginHorizontal="@dimen/sixteen"
        android:id="@+id/lnrFlexContainer"
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:background="@color/white"
        android:layout_height="wrap_content">

        <RelativeLayout
            android:visibility="gone"
            android:id="@+id/spinnerContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/ten"
            android:background="@drawable/field_background"
            android:paddingHorizontal="@dimen/ten"
            android:paddingVertical="@dimen/five"
            >

            <Spinner
                android:id="@+id/isSpinnerColumn"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:background="@android:color/transparent"
                android:spinnerMode="dropdown"
                android:focusable="false"
                android:focusableInTouchMode="false"
                android:clickable="true"
                android:layout_toStartOf="@+id/spinnerimg"
                android:textColor="@color/black" />

            <ImageView
                android:id="@+id/spinnerimg"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/three"
                android:src="@drawable/ic_drop_down"
                app:tint="@color/black" />
        </RelativeLayout>

        <TextView
            android:visibility="gone"
            android:id="@+id/lblHint"
            android:layout_width="match_parent"
            style="@style/CustomTextStylePoppinsRegular"
            android:textSize="@dimen/fifteen_sp"
            android:layout_marginHorizontal="@dimen/ten"
            android:paddingHorizontal="@dimen/fifteen"
            android:layout_height="wrap_content"
            android:paddingBottom="@dimen/five"

            >
        </TextView>



    </LinearLayout>
    <View
        android:paddingVertical="@dimen/twenty"
        android:layout_marginHorizontal="@dimen/sixteen"
        android:layout_width="match_parent"
        android:background="@color/AthensGray"
        android:layout_height="@dimen/one">

    </View>


</LinearLayout>
