<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_gray_9">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground" />


    <ScrollView
        android:id="@+id/svOverallCreateQE"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarLayout">

        <RelativeLayout
            android:id="@+id/rlaQuizExamReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/five"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/five"
            android:paddingBottom="@dimen/twenty">


            <TextView
                android:id="@+id/lblSelectClass"
                style="@style/CustomTextStylePoppinsRegular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rytSearch1"
                android:layout_marginHorizontal="@dimen/ten"
                android:text="@string/upload_mark_sheet"
                android:textColor="@color/dark_orange_2"
                android:textSize="@dimen/eighteen"></TextView>

            <TextView
                android:id="@+id/lblClassDetail"
                style="@style/CustomTextStylePoppinsRegular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblSelectClass"
                android:layout_marginHorizontal="@dimen/ten"
                android:layout_marginTop="@dimen/ten"
                android:text="@string/upload_an_image_for_ai_processing_or_skip_to_map_manually"
                android:textSize="@dimen/fifteen">

            </TextView>

            <androidx.cardview.widget.CardView
                android:id="@+id/cardUploadImage"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblClassDetail"
                android:layout_marginHorizontal="@dimen/ten"
                android:layout_marginTop="@dimen/fifteen"
                android:layout_marginBottom="@dimen/fifteen"
                app:cardBackgroundColor="@android:color/transparent"
                app:cardCornerRadius="12dp"
                app:cardElevation="@dimen/five">

                <LinearLayout
                    android:id="@+id/lnrUploadImage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/card_border"
                    android:orientation="vertical">

                    <RelativeLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/ten"
                        android:paddingHorizontal="@dimen/fifteen"
                        android:paddingVertical="@dimen/thirty">

                        <ImageView
                            android:id="@+id/imgUpload"
                            android:layout_width="@dimen/fourty_five"
                            android:layout_height="@dimen/sixty"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/rect_bg_gray"
                            android:padding="@dimen/ten"
                            android:src="@drawable/upload_image"></ImageView>

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginHorizontal="@dimen/ten"
                            android:layout_toStartOf="@+id/imgArrow"
                            android:layout_toEndOf="@+id/imgUpload"
                            android:orientation="vertical">

                            <TextView
                                style="@style/CustomTextStylePoppinsBold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ten"
                                android:text="@string/ai_powered_upload"
                                android:textSize="@dimen/eighteen_sp"></TextView>

                            <TextView
                                style="@style/CustomTextStylePoppinsBold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/five"
                                android:alpha="0.6"
                                android:text="@string/upload_image_for_automatic_detection"
                                android:textColor="@color/black"
                                android:textSize="@dimen/fifteen_sp"></TextView>
                        </LinearLayout>

                        <ImageView
                            android:id="@+id/imgArrow"
                            android:layout_width="@dimen/twenty"
                            android:layout_height="@dimen/twenty"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/twenty"
                            android:src="@drawable/right_arrow_ic"
                            android:tint="#99a1af">

                        </ImageView>
                    </RelativeLayout>

                    <LinearLayout
                        android:id="@+id/lnrContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="@dimen/ten"
                        android:layout_marginBottom="@dimen/fifteen"

                        android:orientation="vertical"
                        android:visibility="gone">

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/one"
                            android:layout_marginVertical="@dimen/five"
                            android:background="@color/AthensGray"></View>

                        <!-- TOP INFORMATION CARD -->
                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/five"
                            android:layout_marginBottom="24dp"
                            android:background="@drawable/bg_orange_border"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <TextView
                                android:id="@+id/titleInfo"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableStart="@drawable/alert_icon"
                                android:drawablePadding="@dimen/five"
                                android:paddingBottom="10dp"
                                android:text="@string/ai_will_automatically_detect"
                                android:textColor="@color/orange"
                                android:textSize="16sp"

                                android:textStyle="bold" />

                            <TextView
                                android:id="@+id/lblIns1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingBottom="6dp"
                                android:text=""
                                android:textColor="@color/black"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/lblIns2"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:paddingBottom="6dp"
                                android:textColor="@color/black"
                                android:textSize="14sp" />

                            <TextView
                                android:id="@+id/lblIns3"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:textColor="@color/black"
                                android:textSize="14sp" />
                        </LinearLayout>


                        <!-- UPLOAD BOX -->
                        <LinearLayout
                            android:id="@+id/lnrUploadFile"
                            android:layout_width="match_parent"
                            android:layout_height="200dp"
                            android:background="@drawable/bg_dashed_border"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:padding="16dp">

                            <ImageView
                                android:layout_width="60dp"
                                android:layout_height="60dp"
                                android:background="@drawable/circle_bg_orange"
                                android:padding="@dimen/fifteen"
                                android:src="@drawable/upload_image2" />

                            <TextView
                                android:id="@+id/lblFileName"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="12dp"
                                android:text="@string/click_to_upload_or_drag_and_drop"
                                android:textAlignment="center"
                                android:textColor="@color/black"
                                android:textSize="16sp" />

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="6dp"
                                android:text="@string/png_jpg_pdf_up_to_10mb"
                                android:textColor="#7A7A7A"
                                android:textSize="14sp" />
                        </LinearLayout>
                    </LinearLayout>

                    <Button
                        android:id="@+id/btnUpload"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Upload">

                    </Button>

                </LinearLayout>


            </androidx.cardview.widget.CardView>


            <androidx.cardview.widget.CardView
                android:id="@+id/cardManual"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/cardUploadImage"
                android:layout_marginTop="@dimen/ten"
                android:background="@drawable/card_border"
                app:cardCornerRadius="12dp"
                app:cardElevation="5dp"
                app:cardUseCompatPadding="true">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/ten"
                    android:paddingHorizontal="@dimen/fifteen"
                    android:paddingVertical="@dimen/thirty">

                    <ImageView
                        android:id="@+id/imgUpload1"
                        android:layout_width="@dimen/fourty_five"
                        android:layout_height="@dimen/sixty"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/rect_bg_gray"
                        android:padding="@dimen/ten"
                        android:src="@drawable/pen_edit"></ImageView>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginHorizontal="@dimen/ten"
                        android:layout_toStartOf="@+id/imgArrow1"
                        android:layout_toEndOf="@+id/imgUpload1"
                        android:orientation="vertical">

                        <TextView
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ten"
                            android:text="@string/manually_entry"
                            android:textSize="@dimen/eighteen_sp"></TextView>

                        <TextView
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/five"
                            android:alpha="0.6"
                            android:text="@string/skip_upload_and_enter_marks_manually"
                            android:textColor="@color/black"
                            android:textSize="@dimen/fifteen_sp"></TextView>
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/imgArrow1"
                        android:layout_width="@dimen/twenty"
                        android:layout_height="@dimen/twenty"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/twenty"
                        android:src="@drawable/right_arrow_ic"
                        android:tint="#99a1af">

                    </ImageView>
                </RelativeLayout>

            </androidx.cardview.widget.CardView>


            <LinearLayout
                android:id="@+id/lytList"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/rcClassList"
                android:layout_centerInParent="true"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/noDataImage"
                    android:layout_width="@dimen/two_hundred"
                    android:layout_height="@dimen/two_hundred"
                    android:layout_marginTop="@dimen/twenty_five"
                    android:src="@drawable/no_data_found"></ImageView>

                <TextView
                    android:id="@+id/txtNoData"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/twenty"
                    android:text=""
                    android:textSize="@dimen/fifteen_sp">

                </TextView>
            </LinearLayout>
        </RelativeLayout>

    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>