<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/card_view"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/eight"
    app:cardCornerRadius="@dimen/sixteen"
    app:cardElevation="@dimen/four">

    <LinearLayout
        android:id="@+id/linearLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/eight"
        android:layout_marginBottom="@dimen/eight"
        android:orientation="vertical">

        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:src="@drawable/customsubtract"
                app:shapeAppearanceOverlay="@style/RoundedSquare" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/center_image"
                    android:layout_width="@dimen/eighty"
                    android:layout_height="@dimen/fifty_six"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/twenty"
                    android:src="@drawable/dizzeworldlogo" />

                <TextView
                    android:id="@+id/couponstatus"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/thirty_five"
                    android:layout_gravity="center"
                    android:layout_margin="@dimen/twele"
                    android:background="@drawable/redeemed_background"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/eight"
                    android:paddingVertical="@dimen/four"
                    android:text="@string/redeemed"
                    android:textColor="@color/white"
                    android:textSize="@dimen/twele_sp"
                    android:textStyle="bold" />
            </LinearLayout>


        </FrameLayout>


        <TextView
            android:id="@+id/categoryname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:paddingTop="@dimen/four"
            android:text="MGM Dizzee World"
            android:textSize="@dimen/twele_sp"
            android:textStyle="normal" />

        <TextView
            android:id="@+id/discount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/eight"
            android:text="20% Off"
            android:textColor="@color/black"
            android:textSize="@dimen/sixteen_sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/merchantname"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/three"
            android:text="Expires in 5 Days"
            android:textColor="@color/clr_grey_dark"
            android:textSize="@dimen/twele_sp"
            android:textStyle="normal" />

    </LinearLayout>
</androidx.cardview.widget.CardView>