<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true">
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/image_banner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/two_fifty"
            android:layout_marginTop="@dimen/twenty"
            android:adjustViewBounds="true"
            android:src="@drawable/login_image" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/happy_to_have_you_with_us"
            android:textColor="@color/black"
            android:textSize="@dimen/eighteen_sp"
            style="@style/CustomTextStylePoppinsBold">

        </TextView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/ten"
            android:gravity="center"
            android:text="@string/your_password_has_already_been_created_use_your_credentials_to_log_in_and_access_schoolchimes_for_seamless_school_communication_and_management"
            android:textColor="@color/black"
            android:textSize="@dimen/thirteen_sp"
            style="@style/CustomTextStylePoppinsRegular">

        </TextView>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_top_radious">

            <RelativeLayout
                android:id="@+id/rytMobileNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/lblLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/twenty"
                    android:gravity="center"
                    android:text="@string/login"
                    android:textColor="@color/white"
                    style="@style/CustomTextStylePoppinsRegular"
                    android:textSize="@dimen/eighteen_sp" />

                <TextView
                    android:id="@+id/lblPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lblLogin"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/ten"
                    android:text="@string/lblPassword"
                    android:textColor="@color/white"
                    android:textSize="@dimen/fifteen_sp"
                    style="@style/CustomTextStylePoppinsRegular"/>





                <RelativeLayout
                    android:id="@+id/rytMobile"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fourty_five"
                    android:layout_below="@+id/lblPassword"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginTop="@dimen/fifteen"
                    android:layout_marginEnd="@dimen/ten"
                    android:background="@drawable/rect_white">

                    <EditText
                        android:id="@+id/txtPassword"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@null"
                        android:hint="@string/star"
                        android:inputType="textPassword"
                        android:paddingHorizontal="@dimen/ten"
                        android:textColor="@color/black"
                        android:textColorHint="@color/grey"
                        android:textSize="@dimen/thirteen_sp" />

                    <ImageView
                        android:id="@+id/imgHide"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/ten"
                        android:src="@drawable/password_hide" />

                </RelativeLayout>

                <TextView
                    android:id="@+id/lblForgetPassword"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rytMobile"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="@dimen/twenty"
                    android:text="@string/lblForgotPassword"
                    android:textColor="@color/white"
                    android:textSize="@dimen/fifteen_sp"
                    style="@style/CustomTextStylePoppinsRegular"
                    android:layout_marginEnd="@dimen/ten"/>




                <androidx.cardview.widget.CardView
                    android:id="@+id/btnLoginContinue"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lblForgetPassword"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginTop="@dimen/thirty"
                    android:layout_marginEnd="@dimen/ten"
                    android:layout_marginBottom="@dimen/ten"
                    card_view:cardCornerRadius="@dimen/ten"
                    card_view:cardElevation="@dimen/five">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@drawable/rect_btn_blue"
                        android:gravity="center"
                        android:text="@string/lblValidate"
                        android:padding="@dimen/ten"
                        android:textColor="@color/white"
                        android:textSize="@dimen/fifteen_sp"
                        style="@style/CustomTextStylePoppinsBold"
                        />
                </androidx.cardview.widget.CardView>
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>
    </ScrollView>
</androidx.coordinatorlayout.widget.CoordinatorLayout>