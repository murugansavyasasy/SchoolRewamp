<?xml version="1.0" encoding="utf-8"?>
    <RelativeLayout
        xmlns:app="http://schemas.android.com/apk/res-auto"
        xmlns:android="http://schemas.android.com/apk/res/android"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/twele">
    <RelativeLayout
        android:id="@+id/rlaDetails"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <FrameLayout

            android:id="@+id/avatarContainer"
            android:layout_width="@dimen/fifty"
            android:layout_height="@dimen/fifty"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true">

            <ImageView
                android:id="@+id/imgAvatar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="centerInside"
                android:src="@drawable/default_profile"
                />
        </FrameLayout>

        <!-- Name and class container -->
        <LinearLayout

            android:id="@+id/textContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/avatarContainer"
            android:layout_toStartOf="@+id/tvStatus"

            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/twele"
            android:layout_marginEnd="@dimen/twele"
            android:orientation="vertical">

            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:id="@+id/tvName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Lakshmanan"
                android:textSize="@dimen/sixteen_sp"
                />

            <TextView
                android:id="@+id/tvClass"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Class : 10 B"
                android:textSize="@dimen/thirteen_sp"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_marginTop="@dimen/six"
                />
        </LinearLayout>

        <!-- Submitted pill -->


        <LinearLayout
            android:id="@+id/tvStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:paddingHorizontal="@dimen/ten"
            android:paddingVertical="@dimen/five"
            android:orientation="vertical"

            android:paddingBottom="@dimen/eight"
            android:background="@drawable/green_bg_radius"
            >
            <TextView
                android:id="@+id/tvStatus1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Submitted"
                android:layout_gravity="center"
                style="@style/CustomTextStylePoppinsMedium"
                android:textSize="@dimen/fourteen_sp"
                android:textColor="@color/white"
                />
            <TextView
                android:visibility="gone"
                android:id="@+id/tvSubmittedOn"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="12/09/2002"
                android:layout_gravity="center"
                style="@style/CustomTextStylePoppinsMedium"
                android:textSize="@dimen/eleven_sp"
                android:textColor="@color/white"
                />

        </LinearLayout>
    </RelativeLayout>
    <View
        android:layout_width="match_parent"
        android:background="@color/athens_gray"
        android:layout_below="@+id/rlaDetails"
        android:layout_marginTop="@dimen/five"
        android:layout_height="@dimen/two">

    </View>

    </RelativeLayout>
