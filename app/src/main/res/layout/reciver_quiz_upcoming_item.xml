<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:id="@+id/lnrEntireQuiz"
    android:orientation="vertical"
    android:paddingStart="@dimen/ten"
    android:paddingBottom="@dimen/fifteen"
    android:paddingEnd="@dimen/ten"
    android:background="@drawable/rect_shadow_bg"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:background="@drawable/rect_five_dp_radius"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_width="@dimen/fifty"
            android:src="@drawable/quiz_book"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginBottom="@dimen/fifteen"
            android:layout_height="@dimen/fifty">
        </ImageView>
    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_marginTop="@dimen/minus_ten"
        android:layout_width="match_parent"
        android:paddingBottom="@dimen/ten"
        android:background="@drawable/rect_five_dp_radius"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/lblTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/five"
            android:layout_marginEnd="@dimen/ten"
            android:gravity="start"
            style="@style/CustomTextStylePoppinsBold"
            android:textColor="@color/white"
            android:text="@string/online_quiz"
            android:textSize="@dimen/sixteen_sp"
            >

        </TextView>

        <TextView
            android:id="@+id/lblQuizDescription"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:layout_marginTop="@dimen/five"
            android:textColor="@color/white"
            style="@style/CustomTextStylePoppinsMedium"
            android:text="Play Quiz games to improve the learning in a funnier way it will reduce the stress and improve the brain activities "
            >
        </TextView>

    </LinearLayout>
    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/minus_five"
        android:padding="@dimen/ten"
        android:background="@drawable/rect_radius_five_white"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="horizontal"
            android:weightSum="2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <!-- First Column -->
            <LinearLayout
                android:layout_weight="1"
                android:layout_marginEnd="@dimen/fifteen"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_weight="0.3"
                        android:layout_width="0dp"
                        android:textSize="@dimen/twele_sp"
                        android:layout_height="wrap_content"
                        android:text="@string/subject" />

                    <TextView
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_weight="0.05"
                        android:textSize="@dimen/twele_sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=":" />

                    <TextView
                        android:id="@+id/lblSubject"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_weight="0.495"
                        android:textColor="@color/iconBlue"
                        android:layout_width="0dp"
                        android:textSize="@dimen/twele_sp"
                        android:layout_height="wrap_content"
                        android:text="Tamil" />
                </LinearLayout>

                <LinearLayout
                    android:layout_marginTop="@dimen/five"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_weight="0.3"
                        android:textSize="@dimen/twele_sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/level" />

                    <TextView
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_weight="0.05"
                        android:textSize="@dimen/twele_sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=":" />

                    <TextView
                        android:id="@+id/lblLevel"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_weight="0.495"
                        android:textSize="@dimen/twele_sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="1" />
                </LinearLayout>
            </LinearLayout>
            <View
                android:layout_width="@dimen/one"
                android:background="@color/gray4"
                android:layout_height="match_parent">

            </View>

            <!-- Second Column -->
            <LinearLayout
                android:layout_marginStart="@dimen/fifteen"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_width="0dp"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_weight="0.5"
                        android:textSize="@dimen/twele_sp"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="@string/max_marks" />

                    <TextView
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_weight="0.05"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text=":" />

                    <TextView
                        android:id="@+id/lblMaxMarks"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:textSize="@dimen/twele_sp"
                        android:layout_weight="0.495"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="50" />
                </LinearLayout>

                <LinearLayout
                    android:gravity="center"
                    android:layout_marginTop="@dimen/five"
                    android:orientation="horizontal"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_weight="0.5"
                        android:layout_width="0dp"
                        android:textSize="@dimen/twele_sp"
                        android:layout_height="wrap_content"
                        android:text="@string/question" />

                    <TextView
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_weight="0.05"
                        android:layout_width="0dp"
                        android:textSize="@dimen/twele_sp"
                        android:layout_height="wrap_content"
                        android:text=":" />

                    <TextView
                        android:id="@+id/lblQuestion"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:textSize="@dimen/twele_sp"
                        android:layout_weight="0.495"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:text="10" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/one"
            android:layout_marginTop="@dimen/three"
            android:background="@color/gray4">

        </View>

        <TextView
            style="@style/CustomTextStylePoppinsMedium"
            android:id="@+id/lblCreatedOn"
            android:layout_marginTop="@dimen/five"
            android:textColor="@color/mild_grey_dark"
            android:layout_width="match_parent"
            android:text="Created Date : 13 Jul 2002"
            android:layout_height="wrap_content">
        </TextView>

        <RelativeLayout

            android:layout_marginTop="@dimen/five"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <TextView
                android:layout_centerVertical="true"
                android:id="@+id/lblPostedby"
                android:layout_alignParentStart="true"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_toStartOf="@+id/lblPlayNow"
                android:text="Posted by : saranraj"
                android:textColor="@color/mild_grey_dark"
                android:layout_height="wrap_content">
            </TextView>
            <TextView
                android:layout_centerVertical="true"
                android:id="@+id/lblPlayNow"
                android:text="@string/play_now"
                style="@style/CustomTextStylePoppinsMedium"
                android:textColor="@color/white"
                android:background="@drawable/rect_radius_five_white"
                android:layout_alignParentEnd="true"
                android:backgroundTint="@color/PrimaryColor"
                android:gravity="center"
                android:paddingStart="@dimen/ten"
                android:paddingEnd="@dimen/ten"
                android:drawableTint="@color/white"
                android:paddingTop="@dimen/three"
                android:paddingBottom="@dimen/three"
                android:layout_width="wrap_content"
                android:drawableStart="@drawable/play_icon_3"
                android:layout_height="wrap_content">
            </TextView>
            <ImageView
                android:layout_centerVertical="true"
                android:id="@+id/lblnext"
                android:visibility="gone"
                android:layout_alignParentEnd="true"
                android:layout_width="@dimen/twenty"
                android:tint="@color/PrimaryColor"
                android:src="@drawable/arrow_right_circle"
                android:layout_height="@dimen/twenty">

            </ImageView>

        </RelativeLayout>

    </LinearLayout>
</LinearLayout>