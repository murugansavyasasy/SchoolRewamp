<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fillViewport="true"
    android:id="@+id/main"
    android:background="@color/white">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

        <include
            android:id="@+id/toolbarLayout"
            layout="@layout/school_side_tool_bar"
            app:layout_constraintTop_toBottomOf="@id/statusBarBackground"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            />

        <RelativeLayout
            app:layout_constraintTop_toBottomOf="@+id/toolbarLayout"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            android:gravity="center"
            android:id="@+id/AcademicYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/toolbarLayout"
            android:orientation="horizontal"
            android:layout_marginStart="@dimen/five"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/ten">

            <TextView
                android:layout_centerVertical="true"
                android:id="@+id/lblAcademicYearPick"
                android:layout_width="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_height="wrap_content"
                android:text="@string/choose_academic_year"
                style="@style/CustomTextStylePoppinsMedium">

            </TextView>

            <RelativeLayout
                android:layout_toEndOf="@+id/lblAcademicYearPick"
                android:layout_alignParentEnd="true"
                android:id="@+id/rytAcademicYearDropDown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/twenty"
                android:background="@drawable/bg_white_light_radious">

                <Spinner
                    android:paddingVertical="@dimen/five"
                    android:id="@+id/isSpinner"
                    android:layout_marginStart="@dimen/three"
                    android:layout_centerVertical="true"
                    android:layout_width="wrap_content"
                    android:background="@null"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/isSpinnerimg"
                    android:drawSelectorOnTop="true"
                    android:layout_height="wrap_content"
                    />
                <ImageView
                    android:id="@+id/isSpinnerimg"
                    android:layout_centerVertical="true"
                    android:layout_width="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_drop_down"
                    android:layout_marginEnd="@dimen/three"

                    android:layout_height="wrap_content">

                </ImageView>

            </RelativeLayout>
        </RelativeLayout>

        <androidx.core.widget.NestedScrollView
            app:layout_constraintTop_toBottomOf="@+id/AcademicYear"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_width="match_parent"
            android:layout_height="0dp">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/summary_statics"
                    android:text="SUMMARY STATICS"
                    android:textColor="@color/black"
                    android:layout_marginStart="10dp"
                    style="@style/CustomTextStylePoppinsBold"
                    android:textSize="18sp"/>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcysummarystatics"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginStart="@dimen/five"
                    android:layout_marginEnd="@dimen/five"
                    android:overScrollMode="never"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginBottom="@dimen/ten">
                </androidx.recyclerview.widget.RecyclerView>



                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/genderdistributionlabel"
                    android:text="GENDER DISTRIBUTION VISUALIZATION"
                    android:textColor="@color/black"
                    android:layout_marginStart="10dp"
                    style="@style/CustomTextStylePoppinsBold"
                    android:textSize="18sp"/>


                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rlaabsenteesreport2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginStart="@dimen/five"
                    android:layout_marginEnd="@dimen/five"
                    android:overScrollMode="never"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginBottom="@dimen/ten">
                </androidx.recyclerview.widget.RecyclerView>


            </LinearLayout>
        </androidx.core.widget.NestedScrollView>

    <ImageView
        app:layout_constraintTop_toBottomOf="@+id/AcademicYear"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/txtNoData"
        android:id="@+id/nomessage"
        android:layout_width="@dimen/two_fifty"
        android:layout_height="@dimen/two_fifty"
        android:layout_gravity="center"
        android:src="@drawable/no_schoolstrength_message"
        android:textColor="@color/black"
        android:textSize="@dimen/fifteen_sp"
        android:visibility="gone" />

    <TextView
        app:layout_constraintTop_toBottomOf="@+id/nomessage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        android:id="@+id/txtNoData"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:text="@string/no_list_found"
        android:textColor="@color/black"
        android:textSize="@dimen/fifteen_sp"
        android:visibility="gone" />
</androidx.constraintlayout.widget.ConstraintLayout>