<?xml version="1.0" encoding="utf-8"?>
<!-- Toggle track: blue when ON, grey when OFF (matches design) -->
<selector xmlns:android="http://schemas.android.com/apk/res/android">
    <item android:state_checked="true">
        <shape android:shape="rectangle">
            <solid android:color="#2F7BF5" />
            <stroke
                android:width="1.5dp"
                android:color="#2F7BF5" />
            <corners android:radius="20dp" />
            <size
                android:width="56dp"
                android:height="32dp" />
        </shape>
    </item>
    <item>
        <shape android:shape="rectangle">
            <solid android:color="#C7C7CC" />
            <stroke
                android:width="1.5dp"
                android:color="#B0B0B6" />
            <corners android:radius="20dp" />
            <size
                android:width="56dp"
                android:height="32dp" />
        </shape>
    </item>
</selector>