<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent">

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar" />





    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/relative_layout8"
        android:layout_below="@+id/toolbarLayout"
        android:weightSum="2"
        android:gravity="center_vertical"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/bg_light_blue">


        <TextView
            android:id="@+id/category_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/white_radious"
            android:layout_weight="1"
            android:gravity="center"
            android:text="CATEGORY WISE"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_marginStart="2dp"
            android:padding="@dimen/eight"
            style="@style/CustomTextStylePoppinsMedium">
        </TextView>

        <TextView
            android:id="@+id/class_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="CLASS WISE"

            android:textColor="@color/black"
            android:textSize="13sp"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:padding="@dimen/eight"
            android:gravity="center"
            style="@style/CustomTextStylePoppinsMedium">
        </TextView>

    </LinearLayout>

    <androidx.cardview.widget.CardView
        android:id="@+id/cardview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        app:cardElevation="6dp"
        app:cardCornerRadius="10dp"
        app:cardBackgroundColor="@android:color/white"
        app:cardUseCompatPadding="true"
        android:layout_below="@+id/relative_layout8">

        <LinearLayout
            android:id="@+id/AcademicYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:padding="10dp"
            android:weightSum="1"
            android:gravity="center_vertical">

            <TextView
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.4"
                android:text="@string/academic_year"
                android:textSize="@dimen/thirteen_sp" />

            <TextView
                android:id="@+id/lblAcademicYear"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.6"
                android:drawableEnd="@drawable/down_arrow"
                android:drawablePadding="6dp"
                android:paddingEnd="10dp"
                android:text="2024-2025"
                android:textColor="#5F5FD1"
            android:textSize="@dimen/ten_sp"
            android:gravity="end|center_vertical" />
        </LinearLayout>
    </androidx.cardview.widget.CardView>


    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/relative_layout5"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/cardview"
        >
        <TextView
            android:id="@+id/total_collection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Collection"
            android:layout_alignParentEnd="true"
            android:textColor="@color/orange"
            android:layout_marginEnd="15dp"
            style="@style/CustomTextStylePoppinsBold"
            android:textSize="13sp"/>


    </RelativeLayout>


    <LinearLayout
        android:id="@+id/lytList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/relative_layout5"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/totalsummary1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/relative_layout8"
            android:layout_marginTop="@dimen/ten">
        </androidx.recyclerview.widget.RecyclerView>

        <ImageView
            android:id="@+id/nomessage"
            android:layout_width="@dimen/two_fifty"
            android:layout_height="@dimen/two_fifty"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/twenty"
            android:src="@drawable/nomessages"
            android:textColor="@color/black"
            android:textSize="@dimen/eighteen"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtNoData"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/twenty"
            android:text="@string/no_list_found"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:gravity="center"
            android:visibility="gone" />

    </LinearLayout>



</RelativeLayout>