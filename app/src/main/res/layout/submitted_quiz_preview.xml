<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/very_light_grey"
    android:layout_height="match_parent">


    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/parent_side_tool_bar" />

    <TextView
        android:paddingStart="@dimen/sixteen"
        android:id="@+id/lblParentToolBar"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/quiz_submission"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginStart="@dimen/five"
        android:layout_below="@+id/toolbarLayout"
        android:textColor="@color/black"
        android:textSize="@dimen/twenty">

    </TextView>


    <androidx.core.widget.NestedScrollView
        android:scrollbars="none"
        android:layout_below="@+id/lblParentToolBar"
        android:layout_width="match_parent"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:layout_height="match_parent">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            >

            <LinearLayout
                android:layout_marginTop="@dimen/ten"
                android:layout_marginStart="@dimen/sixteen"
                android:layout_marginEnd="@dimen/sixteen"
                android:background="@drawable/white_bg_card"
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="wrap_content">

                <FrameLayout
                    android:layout_gravity="center"
                    android:id="@+id/attendanceContainer"
                    android:layout_width="@dimen/hundred"
                    android:layout_height="@dimen/hundred"
                    >

                    <ProgressBar
                        android:id="@+id/quizPercent"
                        style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="100"
                        android:progressDrawable="@drawable/progress_circle"
                        android:rotation="270" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="horizontal"
                        android:gravity="center"
                        android:layout_height="match_parent">
                        <TextView
                            android:id="@+id/lblQuizPercent"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="100"
                            android:maxLength="4"
                            style="@style/CustomTextStylePoppinsBold"
                            android:textSize="@dimen/eighteen_sp"
                            android:textColor="@color/PrimaryColor"
                            />
                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="%"
                            android:layout_marginTop="@dimen/three"
                            style="@style/CustomTextStylePoppinsBold"
                            android:textSize="@dimen/fourteen_sp"
                            android:textColor="@color/PrimaryColor"
                            />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/lblMessage"
                    android:layout_width="match_parent"
                    android:text="Great Job"
                    android:textSize="@dimen/seventeen_sp"
                    style="@style/CustomTextStylePoppinsBold"
                    android:gravity="center"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_height="wrap_content">
                </TextView>
                <TextView
                    android:id="@+id/lblCompletedAt"
                    android:layout_width="match_parent"
                    android:text="Completed at :04.00 Am"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:gravity="center"
                    android:textColor="@color/mild_grey_dark"
                    android:layout_marginTop="@dimen/five"
                    android:layout_height="wrap_content">
                </TextView>

                <TextView
                    android:id="@+id/lblSubjectTitle"
                    android:layout_width="match_parent"
                    android:text="Maths Quiz"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:gravity="center"
                    android:textColor="@color/mild_grey_dark"
                    android:layout_marginTop="@dimen/five"
                    android:layout_height="wrap_content">
                </TextView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:weightSum="3"
                    android:layout_marginTop="@dimen/five"
                    android:layout_height="wrap_content">
                    <TextView
                        style="@style/CustomTextStylePoppinsBold"
                        android:textSize="@dimen/eleven_sp"
                        android:id="@+id/lblCorrectAnswer"
                        android:layout_weight="1"
                        android:layout_width="match_parent"
                        android:drawableStart="@drawable/correct_answer"
                        android:text="Correct : 15/20"
                        android:padding="@dimen/five"
                        android:gravity="center_vertical"
                        android:textColor="@color/green"
                        android:drawablePadding="@dimen/five"
                        android:background="@drawable/gray_bg_radius"
                        android:layout_marginEnd="@dimen/five"
                        android:layout_height="wrap_content">
                    </TextView>

                    <TextView
                        style="@style/CustomTextStylePoppinsBold"
                        android:textSize="@dimen/eleven_sp"
                        android:id="@+id/lblWrongAnswer"
                        android:layout_weight="1"
                        android:layout_width="match_parent"
                        android:drawableStart="@drawable/wrong_answer"
                        android:text="Wrong : 03/20"
                        android:textColor="@color/red"
                        android:gravity="center_vertical"
                        android:layout_marginEnd="@dimen/five"
                        android:padding="@dimen/five"
                        android:drawablePadding="@dimen/five"
                        android:background="@drawable/gray_bg_radius"
                        android:layout_height="wrap_content">
                    </TextView>

                    <TextView
                        style="@style/CustomTextStylePoppinsBold"
                        android:textSize="@dimen/eleven_sp"
                        android:id="@+id/lblNotAnswer"
                        android:layout_weight="1"
                        android:gravity="center_vertical"
                        android:textColor="@color/orange"
                        android:layout_width="match_parent"
                        android:drawableStart="@drawable/not_answered"
                        android:text="Not Answer : 02/20"
                        android:padding="@dimen/five"
                        android:drawablePadding="@dimen/five"
                        android:background="@drawable/gray_bg_radius"
                        android:layout_height="wrap_content">
                    </TextView>

                </LinearLayout>

            </LinearLayout>

            <View
                android:layout_marginStart="@dimen/sixteen"
                android:layout_marginEnd="@dimen/sixteen"
                android:layout_width="match_parent"
                android:layout_marginTop="@dimen/ten"
                android:background="@color/gray4"
                android:layout_height="@dimen/one">

            </View>

            <androidx.recyclerview.widget.RecyclerView
                android:paddingStart="@dimen/sixteen"
                android:paddingEnd="@dimen/sixteen"
                android:layout_marginTop="@dimen/ten"
                android:id="@+id/rcSubmitedQuiz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false"
                >
            </androidx.recyclerview.widget.RecyclerView>

            <LinearLayout
                android:paddingStart="@dimen/sixteen"
                android:paddingEnd="@dimen/sixteen"
                android:id="@+id/lytList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/nomessage"
                    android:layout_width="@dimen/two_fifty"
                    android:layout_height="@dimen/two_fifty"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/twenty"
                    android:src="@drawable/nomessages"
                    android:textColor="@color/black"
                    android:textSize="@dimen/fifteen_sp"
                    />

                <TextView
                    android:id="@+id/txtNoData"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/twenty"
                    android:gravity="center"
                    android:text="@string/no_list_found"
                    android:textSize="@dimen/fifteen_sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>



</RelativeLayout>
