<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">


    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/staff_leave_request_toolbar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground" />


    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarLayout"

        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">



            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:id="@+id/cardStaffLeaveDetails"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/sixteen"
                app:cardCornerRadius="@dimen/ten"
                app:strokeColor="@color/light_gray_10"
                app:strokeWidth="0.5dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardElevation="@dimen/two">

                <RelativeLayout
                    android:id="@+id/rlaCurrentLeaveRequest"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:paddingBottom="@dimen/ten"
                    >
                    <TextView
                        android:layout_marginStart="@dimen/ten"
                        android:id="@+id/lblCurrentLeave"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/ten"
                        android:text="@string/current_leave_request"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:textColor="@color/light_gray"
                        android:layout_height="wrap_content">

                    </TextView>
                    <LinearLayout
                        android:paddingHorizontal="@dimen/ten"
                        android:gravity="center"
                        android:id="@+id/LnrCatoryDetails"
                        android:layout_marginTop="@dimen/ten"
                        android:layout_below="@+id/lblCurrentLeave"
                        android:layout_width="match_parent"
                        android:orientation="horizontal"
                        android:weightSum="4"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:src="@drawable/hospital_icon"
                                android:layout_width="@dimen/twenty"
                                android:padding="@dimen/one"
                                android:layout_height="@dimen/twenty">
                            </ImageView>
                            <TextView
                                android:gravity="center"
                                android:layout_width="match_parent"
                                android:text="@string/type"
                                android:textAllCaps="true"
                                android:textColor="@color/light_gray"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:textSize="@dimen/twele_sp"
                                android:layout_height="wrap_content">
                            </TextView>
                            <TextView
                                android:gravity="center"
                                android:id="@+id/lblLeaveType"
                                android:text="Casual"
                                style="@style/CustomTextStylePoppinsBold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content">

                            </TextView>
                        </LinearLayout>

                        <LinearLayout
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:gravity="center"
                            android:orientation="vertical"
                            android:layout_height="wrap_content">

                            <ImageView
                                android:src="@drawable/stopwatch_gray"
                                android:layout_width="@dimen/twenty"
                                android:layout_height="@dimen/twenty"></ImageView>
                            <TextView
                                android:gravity="center"
                                android:id="@+id/lbltxtDays"
                                android:layout_width="match_parent"
                                android:text="@string/days"
                                android:textAllCaps="true"
                                android:textColor="@color/light_gray"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:textSize="@dimen/twele_sp"
                                android:layout_height="wrap_content">

                            </TextView>
                            <TextView
                                android:gravity="center"
                                android:id="@+id/lblDays"
                                android:text="3"
                                android:layout_width="match_parent"
                                style="@style/CustomTextStylePoppinsBold"
                                android:layout_height="wrap_content">

                            </TextView>
                        </LinearLayout>

                        <LinearLayout
                            android:gravity="center"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:orientation="vertical"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:src="@drawable/calendar_icon_5"
                                android:layout_width="@dimen/twenty"
                                android:layout_height="@dimen/twenty">
                            </ImageView>
                            <TextView
                                android:gravity="center"
                                android:layout_width="match_parent"
                                android:text="@string/Start"
                                android:textAllCaps="true"
                                android:textColor="@color/light_gray"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:textSize="@dimen/twele_sp"
                                android:layout_height="wrap_content">

                            </TextView>
                            <TextView
                                android:id="@+id/lblStartDate"
                                android:layout_width="match_parent"
                                android:text="Feb 16"
                                android:gravity="center"
                                style="@style/CustomTextStylePoppinsBold"
                                android:layout_height="wrap_content">

                            </TextView>
                        </LinearLayout>

                        <LinearLayout
                            android:gravity="center"
                            android:layout_weight="1"
                            android:layout_width="0dp"
                            android:orientation="vertical"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:src="@drawable/calendar_icon_5"
                                android:layout_width="@dimen/twenty"
                                android:layout_height="@dimen/twenty">
                            </ImageView>
                            <TextView
                                android:layout_width="match_parent"
                                android:gravity="center"
                                android:text="@string/end"
                                android:textColor="@color/light_gray"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:textSize="@dimen/twele_sp"
                                android:layout_height="wrap_content">

                            </TextView>
                            <TextView
                                android:gravity="center"
                                android:id="@+id/lblEndDate"
                                android:text="Feb 29"
                                android:layout_width="match_parent"
                                style="@style/CustomTextStylePoppinsBold"
                                android:layout_height="wrap_content">

                            </TextView>
                        </LinearLayout>



                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/LnrReason"
                        android:paddingHorizontal="@dimen/ten"
                        android:layout_marginTop="@dimen/ten"
                        android:layout_below="@+id/LnrCatoryDetails"
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        android:paddingVertical="@dimen/eight"
                        android:background="@color/light_gray1"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/lblReason"
                            android:layout_width="wrap_content"
                            android:text="@string/reason_for_leave"
                            style="@style/CustomTextStylePoppinsMedium"
                            android:textColor="@color/light_gray"
                            android:layout_height="wrap_content">
                        </TextView>

                        <TextView
                            android:id="@+id/Reason"
                            android:layout_width="wrap_content"
                            android:text="I am having cold"
                            android:layout_marginTop="@dimen/five"
                            style="@style/CustomTextStylePoppinsMedium"
                            android:layout_height="wrap_content">

                        </TextView>

                    </LinearLayout>

                    <androidx.constraintlayout.widget.ConstraintLayout
                        android:layout_below="@+id/LnrReason"
                        android:layout_width="match_parent"
                        android:id="@+id/constStatus"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ten"
                        android:paddingHorizontal="@dimen/ten">

                        <TextView
                            android:id="@+id/btnCancel"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/reject"
                            android:gravity="center"
                            android:layout_marginHorizontal="@dimen/ten"
                            android:paddingVertical="@dimen/eight"
                            android:textColor="@color/red"
                            android:background="@drawable/red_stoke_rect_radius"
                            style="@style/CustomTextStylePoppinsBold"
                            app:layout_constraintStart_toStartOf="parent"
                            app:layout_constraintEnd_toStartOf="@id/btnApprove"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintHorizontal_weight="1" />

                        <TextView
                            android:id="@+id/btnApprove"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:text="@string/approve"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:layout_marginHorizontal="@dimen/ten"
                            android:paddingVertical="@dimen/eight"
                            style="@style/CustomTextStylePoppinsBold"
                            android:background="@drawable/green_bg_radius"
                            app:layout_constraintStart_toEndOf="@id/btnCancel"
                            app:layout_constraintEnd_toEndOf="parent"
                            app:layout_constraintTop_toTopOf="parent"
                            app:layout_constraintHorizontal_weight="1" />

                    </androidx.constraintlayout.widget.ConstraintLayout>


                </RelativeLayout>

            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:id="@+id/cardLeaveHistoryDetails"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/sixteen"
                app:cardCornerRadius="@dimen/ten"
                app:strokeColor="@color/light_gray_10"
                app:strokeWidth="0.5dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardElevation="@dimen/two">
                <LinearLayout
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_marginStart="@dimen/ten"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/ten"
                        android:text="@string/leave_history"
                        android:textAllCaps="true"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:textColor="@color/light_gray"
                        android:layout_height="wrap_content">

                    </TextView>
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rcyStaffLeaveHistory"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:nestedScrollingEnabled="false"
                        android:overScrollMode="never"
                        android:layout_marginHorizontal="@dimen/fifteen"
                        android:layout_marginVertical="@dimen/ten"
                        >

                    </androidx.recyclerview.widget.RecyclerView>

                    <LinearLayout
                        android:id="@+id/lytList"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/toolbarLayout"
                        android:orientation="vertical"
                        >

                        <ImageView
                            android:id="@+id/nomessage"
                            android:layout_width="@dimen/two_fifty"
                            android:layout_height="@dimen/two_fifty"
                            android:layout_centerInParent="true"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/eighty"
                            android:src="@drawable/no_leave_request_message"
                            android:textColor="@color/black"
                            android:textSize="@dimen/fifteen_sp"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/txtNoData"
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/twenty"
                            android:text="@string/no_list_found"
                            android:textSize="@dimen/fifteen_sp"
                            android:visibility="gone" />
                    </LinearLayout>
                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>


            <com.google.android.material.card.MaterialCardView
                android:layout_width="match_parent"
                android:id="@+id/cardStaffContactDetails"
                android:layout_height="wrap_content"
                android:layout_margin="@dimen/sixteen"
                app:cardCornerRadius="@dimen/ten"
                app:strokeColor="@color/light_gray_10"
                app:strokeWidth="0.5dp"
                app:cardBackgroundColor="@android:color/white"
                app:cardElevation="@dimen/two">
                <LinearLayout
                    android:layout_marginBottom="@dimen/five"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <TextView
                        android:layout_marginStart="@dimen/ten"
                        android:layout_width="match_parent"
                        android:layout_marginTop="@dimen/ten"
                        android:text="@string/contact_information"
                        android:textAllCaps="true"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:textColor="@color/light_gray"
                        android:layout_height="wrap_content">

                    </TextView>

                    <RelativeLayout
                        android:id="@+id/rlaEntireCall"
                        android:layout_marginTop="@dimen/ten"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_alignParentStart="true"
                            android:id="@+id/imgPhone"
                            android:padding="@dimen/five"
                            android:src="@drawable/phone_call_icon"
                            android:layout_width="@dimen/fourty"
                            android:layout_height="@dimen/fourty">
                        </ImageView>
                        <LinearLayout
                            android:layout_marginStart="@dimen/five"
                            android:layout_toEndOf="@+id/imgPhone"
                            android:id="@+id/lnrPhoneDetails"
                            android:orientation="vertical"
                            android:layout_alignParentEnd="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:text="@string/phone"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:textColor="@color/light_gray"
                                android:layout_height="wrap_content">
                            </TextView>
                            <TextView
                                android:layout_marginTop="@dimen/five"
                                android:id="@+id/lblPhoneNumber"
                                android:layout_width="wrap_content"
                                android:text="0000000000"
                                android:textSize="@dimen/fifteen_sp"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:textColor="@color/light_gray"
                                android:layout_height="wrap_content">
                            </TextView>

                        </LinearLayout>
                    </RelativeLayout>

<!--                    Email-->
                    <RelativeLayout
                        android:id="@+id/rlaEntireMail"
                        android:layout_marginTop="@dimen/ten"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_alignParentStart="true"
                            android:id="@+id/imgEmail"
                            android:padding="@dimen/five"
                            android:src="@drawable/mail_icon"
                            android:layout_width="@dimen/fourty"
                            android:layout_height="@dimen/fourty">
                        </ImageView>
                        <LinearLayout
                            android:layout_marginStart="@dimen/five"
                            android:layout_toEndOf="@+id/imgEmail"
                            android:orientation="vertical"
                            android:layout_alignParentEnd="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:text="@string/email"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:textColor="@color/light_gray"
                                android:layout_height="wrap_content">
                            </TextView>
                            <TextView
                                android:id="@+id/lblEmail"
                                android:layout_marginTop="@dimen/five"
                                android:layout_width="wrap_content"
                                android:text="santhosh@gamil.com"
                                android:textSize="@dimen/fifteen_sp"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:textColor="@color/bpBlue"
                                android:layout_height="wrap_content">
                            </TextView>

                        </LinearLayout>
                    </RelativeLayout>

<!--                    Address-->

                    <RelativeLayout
                        android:layout_marginTop="@dimen/ten"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:layout_alignParentStart="true"
                            android:id="@+id/imgAddress"
                            android:padding="@dimen/five"
                            android:src="@drawable/ic_location"
                            android:layout_width="@dimen/fourty"
                            android:layout_height="@dimen/fourty">
                        </ImageView>
                        <LinearLayout
                            android:layout_marginStart="@dimen/five"
                            android:layout_toEndOf="@+id/imgAddress"
                            android:orientation="vertical"
                            android:layout_alignParentEnd="true"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">
                            <TextView
                                android:layout_width="wrap_content"
                                android:text="@string/address"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:textColor="@color/light_gray"
                                android:layout_height="wrap_content">
                            </TextView>
                            <TextView
                                android:layout_marginTop="@dimen/five"
                                android:id="@+id/lblAddress"
                                android:layout_width="wrap_content"
                                android:text="00 abc street india"
                                android:textSize="@dimen/fifteen_sp"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:layout_height="wrap_content">
                            </TextView>

                        </LinearLayout>
                    </RelativeLayout>

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>



        </LinearLayout>

    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>