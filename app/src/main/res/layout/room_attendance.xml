<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/consHeader"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@color/dark_blue_4"
        android:paddingVertical="@dimen/twenty"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent">

        <TextView
            android:id="@+id/lblRoomNo"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginEnd="@dimen/five"
            android:text="Room 101"
            android:textColor="@color/white"
            android:textSize="@dimen/twenty_four_sp"
            app:layout_constraintEnd_toStartOf="@+id/imgClose"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent">

        </TextView>

        <ImageView
            android:id="@+id/imgClose"
            android:layout_width="@dimen/fifty"
            android:layout_height="@dimen/fifty"
            android:layout_marginEnd="@dimen/ten"
            android:src="@drawable/close_icon"
            app:layout_constraintBottom_toBottomOf="@+id/lblRoomNo"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/lblRoomNo"
            app:layout_constraintTop_toTopOf="@+id/lblRoomNo">

        </ImageView>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/brRoomClose"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="lblRoomNo,imgClose">

        </androidx.constraintlayout.widget.Barrier>

        <TextView
            android:id="@+id/lblStudentsBeds"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:text="3 Students 5 Beds"
            android:textColor="@color/white"
            android:textSize="@dimen/thirteen_sp"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/brRoomClose">

        </TextView>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/twenty"
            android:layout_marginTop="@dimen/ten"
            android:background="@drawable/green_bg_radius"
            android:backgroundTint="@color/very_little_blue_7"
            android:padding="@dimen/ten"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="@+id/lblStudentsBeds"
            app:layout_constraintStart_toStartOf="@id/lblStudentsBeds"
            app:layout_constraintTop_toBottomOf="@+id/lblStudentsBeds">

            <TextView
                android:id="@+id/lblProgress"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/five"
                android:text="@string/progress"
                android:textColor="@color/white"
                app:layout_constraintEnd_toStartOf="@+id/lblMarkedPercentage"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <TextView
                android:id="@+id/lblMarkedPercentage"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/five"
                android:gravity="end"
                android:text="0/0"
                android:textColor="@color/white"
                android:textSize="@dimen/sixteen_sp"
                app:layout_constraintBottom_toBottomOf="@+id/lblProgress"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintHorizontal_weight="0.2"
                app:layout_constraintStart_toEndOf="@+id/lblProgress"
                app:layout_constraintTop_toTopOf="@+id/lblProgress"></TextView>

            <androidx.constraintlayout.widget.Barrier
                android:id="@+id/brOccupancyPecentage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:barrierDirection="bottom"
                app:constraint_referenced_ids="lblProgress,lblMarkedPercentage"></androidx.constraintlayout.widget.Barrier>

            <ProgressBar
                android:id="@+id/proAttendanceProgressBar"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:layout_width="0dp"
                android:layout_height="@dimen/five"
                android:layout_marginTop="@dimen/fifteen"
                android:layout_marginBottom="@dimen/eight"
                android:max="100"
                android:progress="0"
                android:progressDrawable="@drawable/progress_white"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/brOccupancyPecentage" />
        </androidx.constraintlayout.widget.ConstraintLayout>


    </androidx.constraintlayout.widget.ConstraintLayout>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nested_scrollview"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginBottom="@dimen/five"
        app:layout_constraintBottom_toTopOf="@+id/lblMarkAttendance"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/consHeader">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="0dp">

        <TextView
            android:layout_marginTop="@dimen/ten"
            android:layout_marginHorizontal="@dimen/ten"
            android:id="@+id/lblSelectDate"
            app:layout_constraintStart_toStartOf="parent"
            android:text="@string/select_date"
            android:textAllCaps="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/lnrDateDetails"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

        </TextView>
    <LinearLayout
        android:layout_marginTop="@dimen/ten"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblSelectDate"
        android:id="@+id/lnrDateDetails"
        app:layout_constraintBottom_toTopOf="@+id/activityMain"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/ten">

        <!-- Icon -->
        <LinearLayout
            android:id="@+id/lnrFromDateImg"
            android:layout_width="@dimen/fourty"
            android:layout_height="@dimen/fourty"
            android:layout_marginEnd="@dimen/twele"
            android:background="@drawable/background_radius_button"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:layout_width="@dimen/twenty"
                android:layout_height="@dimen/twenty"
                android:scaleType="centerInside"
                android:src="@drawable/from_icon" />
        </LinearLayout>

        <!-- Date & Session Layout -->
        <LinearLayout
            android:layout_width="@dimen/zero"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <!-- From Date -->
            <LinearLayout
                android:id="@+id/lnrFromDate"
                android:layout_width="@dimen/zero"
                android:layout_height="wrap_content"
                android:layout_weight="0.55"
                android:orientation="vertical"
                android:paddingEnd="@dimen/eight">

                <TextView
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:textSize="@dimen/fourteen_sp"
                    android:layout_height="wrap_content"
                    android:text="@string/select_date"
                  />

                <TextView
                    android:id="@+id/tvSelectedDate"
                    style="@style/CustomTextStylePoppinsRegular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textSize="@dimen/twele_sp"
                    android:drawableEnd="@drawable/down_arrow_3"
                    android:drawablePadding="@dimen/five"
                    android:textColor="@color/light_gray_2"
                    />

            </LinearLayout>

            <!-- Divider -->
            <View
                android:layout_width="@dimen/one"
                android:layout_height="match_parent"
                android:background="@color/gray4" />

            <!-- Session Spinner -->
            <LinearLayout
                android:layout_width="@dimen/zero"
                android:layout_height="wrap_content"
                android:layout_weight="0.455"
                android:orientation="vertical"
                android:paddingStart="@dimen/eight">

                <TextView
                    style="@style/CustomTextStylePoppinsRegular"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="@string/session"
                    android:textColor="@color/light_gray_2"
                    android:textSize="@dimen/fourteen_sp" />

                <Spinner
                    android:id="@+id/isFromSession"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@null"
                    android:spinnerMode="dropdown" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        app:layout_constraintBottom_toTopOf="@+id/rcRoomAttendance"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lnrDateDetails"
        app:layout_constraintStart_toStartOf="parent"
        android:id="@+id/activityMain"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:paddingTop="@dimen/sixteen"
        android:paddingBottom="@dimen/sixteen"
        android:visibility="gone">

        <TextView
            android:id="@+id/lblSelect"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:gravity="center"
            android:text="Select Date"
            android:textSize="@dimen/sixteen_sp">

        </TextView>

        <FrameLayout
            android:id="@+id/calendarFromFragmentContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingStart="@dimen/fifteen"
            android:paddingEnd="@dimen/fifteen" />

        <TextView
            android:id="@+id/FromDone"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="@dimen/five"
            android:layout_marginEnd="@dimen/fifteen"
            android:background="@drawable/button_radius_bg"
            android:paddingStart="@dimen/ten"
            android:paddingTop="@dimen/five"
            android:paddingEnd="@dimen/ten"
            android:paddingBottom="@dimen/five"
            android:text="@string/done"
            android:textColor="@color/white"
            android:visibility="gone">

        </TextView>
    </LinearLayout>


    <androidx.recyclerview.widget.RecyclerView
        app:layout_constraintTop_toBottomOf="@+id/activityMain"
        android:id="@+id/rcRoomAttendance"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ten"
        android:layout_marginTop="@dimen/ten"
        android:nestedScrollingEnabled="false"
        android:overScrollMode="never"
        app:layout_constraintBottom_toTopOf="@+id/imgNoDataFound"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        >

    </androidx.recyclerview.widget.RecyclerView>

    <ImageView
        android:id="@+id/imgNoDataFound"
        android:layout_width="@dimen/two_hundred"
        android:layout_height="@dimen/two_hundred"
        android:layout_marginTop="@dimen/ten"
        android:src="@drawable/no_data_found"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/rcRoomAttendance"></ImageView>

    <TextView
        android:id="@+id/lblErrorMessage"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/twenty"
        android:gravity="center"
        android:text="nod"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/imgNoDataFound">

    </TextView>

    <androidx.constraintlayout.widget.Group
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:visibility="gone"
        app:constraint_referenced_ids="imgNoDataFound,lblErrorMessage">

    </androidx.constraintlayout.widget.Group>


</androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>


<com.google.android.material.button.MaterialButton
style="@style/CustomTextStylePoppinsBold"
android:background="@drawable/primary_rect_radius"
android:id="@+id/lblMarkAttendance"
android:layout_height="wrap_content"
android:layout_marginBottom="@dimen/ten"
android:layout_marginHorizontal="@dimen/fifteen"
android:layout_marginTop="@dimen/five"
android:layout_width="0dp"
android:minHeight="0dp"
android:paddingVertical="@dimen/ten"
android:text="@string/mark_all_students"
android:textColor="@color/white"
android:textSize="@dimen/thirteen_sp"
app:layout_constrainedHeight="true"
app:layout_constrainedWidth="true"
app:layout_constraintBottom_toBottomOf="parent"
app:layout_constraintEnd_toEndOf="parent"
app:layout_constraintStart_toStartOf="parent"
app:layout_constraintTop_toBottomOf="@+id/nested_scrollview">

</com.google.android.material.button.MaterialButton>


    </androidx.constraintlayout.widget.ConstraintLayout>
