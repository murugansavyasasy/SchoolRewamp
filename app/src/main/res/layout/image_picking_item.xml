<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="@dimen/ninety"
    android:layout_height="@dimen/ninety"
    android:layout_marginStart="@dimen/twenty"
    android:layout_marginTop="@dimen/ten"
    android:layout_marginEnd="@dimen/twenty"
    >

    <ImageView
        android:id="@+id/imgPicking"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:scaleType="centerCrop"
        android:src="@drawable/add_image">

    </ImageView>

    <ImageView
        android:id="@+id/imgVideoPlay"
        android:layout_width="@dimen/twenty_five"
        android:layout_height="@dimen/twenty_five"
        android:visibility="gone"
        android:layout_centerInParent="true"
        android:background="@drawable/white_circle_bg"
        android:src="@drawable/video_play">

    </ImageView>

    <ImageView
        android:id="@+id/imgDelete"
        android:layout_width="@dimen/twenty_five"
        android:layout_height="@dimen/twenty_five"
        android:layout_alignParentEnd="true"
        android:background="@drawable/white_circle_bg"
        android:src="@drawable/del_icon">

    </ImageView>
</RelativeLayout>




