<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/very_light_grey"
    android:layout_height="match_parent">


    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/parent_side_tool_bar" />





    <LinearLayout
        android:layout_below="@+id/toolbarLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        >

        <TextView
            android:paddingStart="@dimen/sixteen"
            android:id="@+id/lblParentToolBar"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/quiz_submission"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginStart="@dimen/five"
            android:layout_below="@+id/rytHeader"

            android:textColor="@color/black"
            android:textSize="@dimen/twenty">

        </TextView>
        <HorizontalScrollView
            android:scrollbars="none"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:orientation="horizontal"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">


                <androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
                    xmlns:card_view="http://schemas.android.com/apk/res-auto"
                    android:layout_width="@dimen/one_fifty"
                    android:layout_height="@dimen/hundred"
                    android:layout_margin="@dimen/eight"
                    android:background="@drawable/rect_shadow_white"
                    card_view:cardCornerRadius="@dimen/sixteen"
                    card_view:cardElevation="@dimen/four">

                    <LinearLayout
                        android:id="@+id/root_linearlayout"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/twele">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/imgIcon"
                                android:layout_width="@dimen/fourty"
                                android:layout_height="@dimen/fourty"
                                android:padding="@dimen/six"
                                android:src="@drawable/correct_answer" />

                            <TextView
                                android:id="@+id/txtCount"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:layout_gravity="center"
                                android:gravity="end"
                                android:visibility="visible"
                                android:textColor="@android:color/black"
                                android:textSize="@dimen/twenty_sp"
                                style="@style/CustomTextStylePoppinsBold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/five"
                            android:text="@string/correct_answer1"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@android:color/black"
                            android:textSize="@dimen/sixteen_sp"
                            style="@style/CustomTextStylePoppinsBold" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>


                <androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
                    xmlns:card_view="http://schemas.android.com/apk/res-auto"
                    android:layout_width="@dimen/one_fifty"
                    android:layout_height="@dimen/hundred"
                    android:layout_margin="@dimen/eight"
                    android:background="@drawable/rect_shadow_white"
                    card_view:cardCornerRadius="@dimen/sixteen"
                    card_view:cardElevation="@dimen/four">

                    <LinearLayout
                        android:id="@+id/root_linearlayout1"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/twele">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"

                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/imgIcon1"
                                android:layout_width="@dimen/fourty"
                                android:layout_height="@dimen/fourty"
                                android:padding="@dimen/six"
                                android:src="@drawable/wrong_answer" />

                            <TextView
                                android:id="@+id/txtCount1"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:gravity="end"
                                android:layout_gravity="center"
                                android:visibility="visible"
                                android:textColor="@android:color/black"
                                android:textSize="@dimen/twenty_sp"
                                style="@style/CustomTextStylePoppinsBold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtTitle1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/five"
                            android:text="@string/wrong_answer1"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@android:color/black"
                            android:textSize="@dimen/sixteen_sp"
                            style="@style/CustomTextStylePoppinsBold" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
                    xmlns:card_view="http://schemas.android.com/apk/res-auto"
                    android:layout_width="@dimen/one_fifty"
                    android:layout_height="@dimen/hundred"
                    android:layout_margin="@dimen/eight"
                    android:background="@drawable/rect_shadow_white"
                    card_view:cardCornerRadius="@dimen/sixteen"
                    card_view:cardElevation="@dimen/four">

                    <LinearLayout
                        android:id="@+id/root_linearlayout2"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:padding="@dimen/twele">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <ImageView
                                android:id="@+id/imgIcon2"
                                android:layout_width="@dimen/fourty"
                                android:layout_height="@dimen/fourty"
                                android:padding="@dimen/six"
                                android:src="@drawable/not_answered" />

                            <TextView
                                android:id="@+id/txtCount2"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="0"
                                android:layout_gravity="center"
                                android:gravity="end"
                                android:visibility="visible"
                                android:textColor="@android:color/black"
                                android:textSize="@dimen/twenty_sp"
                                style="@style/CustomTextStylePoppinsBold" />
                        </LinearLayout>

                        <TextView
                            android:id="@+id/txtTitle2"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/five"
                            android:text="@string/not_answered1"
                            android:maxLines="1"
                            android:ellipsize="end"
                            android:textColor="@android:color/black"
                            android:textSize="@dimen/sixteen_sp"
                            style="@style/CustomTextStylePoppinsBold" />

                    </LinearLayout>
                </androidx.cardview.widget.CardView>


            </LinearLayout>

        </HorizontalScrollView>

        <androidx.recyclerview.widget.RecyclerView
            android:paddingStart="@dimen/sixteen"
            android:paddingEnd="@dimen/sixteen"
            android:layout_marginTop="@dimen/ten"
            android:id="@+id/rcSubmitedQuiz"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        </androidx.recyclerview.widget.RecyclerView>

        <LinearLayout
            android:paddingStart="@dimen/sixteen"
            android:paddingEnd="@dimen/sixteen"
            android:id="@+id/lytList"
            android:layout_width="match_parent"
            android:layout_centerInParent="true"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nomessage"
                android:layout_width="@dimen/two_fifty"
                android:layout_height="@dimen/two_fifty"
                android:layout_centerInParent="true"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/twenty"
                android:src="@drawable/nomessages"
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp"
                />

            <TextView
                android:id="@+id/txtNoData"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/twenty"
                android:gravity="center"
                android:text="@string/no_list_found"
                android:textSize="@dimen/fifteen_sp" />
        </LinearLayout>

    </LinearLayout>



</RelativeLayout>

