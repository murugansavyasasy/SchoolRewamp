<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:background="#f4f6f9"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/parent_side_tool_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground"
         />


    <androidx.core.widget.NestedScrollView
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarLayout"
        android:layout_width="0dp"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:layout_height="0dp">

        <LinearLayout
            app:layout_constraintTop_toBottomOf="@id/hsvProofStatusTabs"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_width="match_parent"
            android:id="@+id/LnrMainLay"
            android:layout_marginTop="@dimen/five"
            android:orientation="vertical"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:layout_marginHorizontal="@dimen/eight"
                android:id="@+id/lnrMainFeeProof"
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="wrap_content">

                <TextView
                    android:layout_width="match_parent"
                    android:textAlignment="viewStart"
                    style="@style/CustomTextStylePoppinsBold"
                    android:textAllCaps="true"
                    android:id="@+id/lblFeeBreakDown"
                    android:textColor="@color/light_gray_44"
                    android:layout_marginHorizontal="@dimen/five"
                    android:text="@string/fee_breakdown"
                    android:layout_height="wrap_content">

                </TextView>

                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_marginHorizontal="@dimen/ten"
                    android:layout_marginTop="@dimen/five"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/fifteen"
                    app:strokeWidth="0dp"
                    android:id="@+id/cardLnrFeeBreakDownDetails"
                    android:elevation="@dimen/five"
                    app:strokeColor="@color/white"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        android:layout_margin="@dimen/ten"
                        android:layout_height="wrap_content">

                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_width="match_parent"
                            android:nestedScrollingEnabled="false"
                            android:id="@+id/rcFeesBreakDown"
                            android:overScrollMode="never"
                            android:layout_height="wrap_content">

                        </androidx.recyclerview.widget.RecyclerView>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>



                <TextView
                    android:layout_width="match_parent"
                    android:textAlignment="viewStart"
                    style="@style/CustomTextStylePoppinsBold"
                    android:textAllCaps="true"
                    android:layout_marginTop="@dimen/ten"
                    android:textColor="@color/light_gray_44"
                    android:layout_marginHorizontal="@dimen/five"
                    android:text="@string/amount_breakdown"
                    android:layout_height="wrap_content">

                </TextView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_marginHorizontal="@dimen/ten"
                    android:layout_marginTop="@dimen/five"
                    app:cardBackgroundColor="@color/white"
                    app:cardCornerRadius="@dimen/fifteen"
                    app:strokeWidth="0dp"
                    android:elevation="@dimen/five"
                    app:strokeColor="@color/white"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        android:layout_margin="@dimen/ten"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:weightSum="2"
                            android:gravity="center_vertical"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="0.7"
                                android:gravity="start"
                                android:textAlignment="viewStart"
                                android:textColor="@color/mid_black_gray"
                                android:text="@string/total_payment"
                                android:textSize="@dimen/thirteen_sp"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:layout_height="wrap_content">

                            </TextView>

                            <TextView
                                android:id="@+id/lblTotalPayment"
                                android:gravity="end"
                                android:textAlignment="viewEnd"
                                android:layout_marginHorizontal="@dimen/three"
                                android:layout_width="0dp"
                                android:layout_weight="1.3"
                                android:textSize="@dimen/fourteen_sp"
                                style="@style/CustomTextStylePoppinsBold"
                                android:layout_height="wrap_content">
                            </TextView>
                        </LinearLayout>


                        <View
                            android:layout_marginVertical="@dimen/five"
                            android:background="#e9eff6"
                            android:layout_width="match_parent"
                            android:layout_height="1dp">

                        </View>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:weightSum="2"
                            android:gravity="center_vertical"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="0.7"
                                android:textColor="@color/mid_black_gray"
                                android:text="@string/user_entered"
                                android:textSize="@dimen/thirteen_sp"
                                android:gravity="start"
                                android:textAlignment="viewStart"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:layout_height="wrap_content">

                            </TextView>

                            <TextView
                                android:id="@+id/lblUserEntered"
                                android:layout_marginHorizontal="@dimen/three"
                                android:layout_width="0dp"
                                android:layout_weight="1.3"
                                android:textSize="@dimen/fourteen_sp"
                                android:gravity="end"
                                android:textAlignment="viewEnd"
                                style="@style/CustomTextStylePoppinsBold"
                                android:layout_height="wrap_content">
                            </TextView>
                        </LinearLayout>


                        <View
                            android:layout_marginVertical="@dimen/five"
                            android:background="#e9eff6"
                            android:layout_width="match_parent"
                            android:layout_height="1dp">

                        </View>


                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:weightSum="2"
                            android:gravity="center_vertical"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="0.7"

                                android:gravity="start"
                                android:textAlignment="viewStart"
                                android:textColor="@color/mid_black_gray"
                                android:text="AI Deteched"
                                android:textSize="@dimen/thirteen_sp"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:layout_height="wrap_content">

                            </TextView>

                            <TextView
                                android:id="@+id/lblAIDeteched"
                                android:layout_width="0dp"
                                android:layout_marginHorizontal="@dimen/three"
                                android:layout_weight="1.3"
                                android:textColor="#2273ec"
                                android:textSize="@dimen/fourteen_sp"
                                android:gravity="end"
                                android:textAlignment="viewEnd"
                                style="@style/CustomTextStylePoppinsBold"
                                android:layout_height="wrap_content">
                            </TextView>
                        </LinearLayout>

                        <View
                            android:layout_marginVertical="@dimen/five"
                            android:background="#e9eff6"
                            android:layout_width="match_parent"
                            android:layout_height="1dp">

                        </View>

                        <LinearLayout
                            android:visibility="gone"
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:weightSum="2"
                            android:gravity="center_vertical"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="0.7"
                                android:textColor="@color/mid_black_gray"
                                android:text="@string/difference"
                                android:textSize="@dimen/thirteen_sp"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:layout_height="wrap_content">

                            </TextView>

                            <TextView
                                android:gravity="end"
                                android:id="@+id/lblDifference"
                                android:layout_width="0dp"
                                android:layout_marginHorizontal="@dimen/three"
                                android:layout_weight="1.3"
                                android:textColor="@color/red"
                                android:textSize="@dimen/fourteen_sp"
                                style="@style/CustomTextStylePoppinsBold"
                                android:layout_height="wrap_content">
                            </TextView>
                        </LinearLayout>

                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>

                <TextView
                    android:layout_width="match_parent"
                    android:textAlignment="viewStart"
                    style="@style/CustomTextStylePoppinsBold"
                    android:textAllCaps="true"
                    android:layout_marginTop="@dimen/ten"
                    android:textColor="@color/light_gray_44"
                    android:layout_marginHorizontal="@dimen/five"
                    android:text="@string/validation_status"
                    android:layout_height="wrap_content">

                </TextView>
                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_marginHorizontal="@dimen/ten"
                    android:layout_marginTop="@dimen/five"
                    app:cardBackgroundColor="@color/white"
                    app:strokeWidth="0dp"
                    android:elevation="@dimen/five"
                    app:strokeColor="@color/white"
                    app:cardCornerRadius="@dimen/fifteen"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        android:layout_margin="@dimen/ten"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:weightSum="2"
                            android:gravity="center_vertical"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="0.7"
                                android:textColor="@color/mid_black_gray"
                                android:text="@string/status"
                                android:gravity="start"
                                android:textAlignment="viewStart"
                                android:textSize="@dimen/thirteen_sp"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:layout_height="wrap_content">

                            </TextView>

                            <TextView
                                android:id="@+id/lblStatus"
                                android:layout_width="0dp"
                                android:layout_weight="1.3"
                                android:gravity="end"
                                android:textAlignment="viewEnd"
                                android:layout_marginHorizontal="@dimen/three"
                                android:textSize="@dimen/fourteen_sp"
                                style="@style/CustomTextStylePoppinsBold"
                                android:layout_height="wrap_content">
                            </TextView>
                        </LinearLayout>


                        <View
                            android:layout_marginVertical="@dimen/five"
                            android:background="#e9eff6"
                            android:layout_width="match_parent"
                            android:layout_height="1dp">

                        </View>


                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:weightSum="2"
                            android:gravity="center_vertical"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="0.7"
                                android:gravity="start"
                                android:textAlignment="viewStart"
                                android:textColor="@color/mid_black_gray"
                                android:text="@string/validated_by"
                                android:textSize="@dimen/thirteen_sp"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:layout_height="wrap_content">

                            </TextView>

                            <TextView
                                android:gravity="end"
                                android:layout_width="0dp"
                                android:textAlignment="viewEnd"
                                android:id="@+id/lblValidatedBy"
                                android:layout_weight="1.3"
                                android:layout_marginHorizontal="@dimen/three"
                                android:textSize="@dimen/fourteen_sp"
                                style="@style/CustomTextStylePoppinsBold"
                                android:layout_height="wrap_content">
                            </TextView>
                        </LinearLayout>

                        <View
                            android:layout_marginVertical="@dimen/five"
                            android:background="#e9eff6"
                            android:layout_width="match_parent"
                            android:layout_height="1dp">

                        </View>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:weightSum="2"
                            android:gravity="center_vertical"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="0.7"
                                android:textColor="@color/mid_black_gray"
                                android:text="@string/validated_on"
                                android:textSize="@dimen/thirteen_sp"
                                android:gravity="start"
                                android:textAlignment="viewStart"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:layout_height="wrap_content">

                            </TextView>

                            <TextView
                                android:gravity="end"
                                android:id="@+id/lblValidatedOn"
                                android:layout_width="0dp"
                                android:layout_weight="1.3"
                                android:textSize="@dimen/fourteen_sp"
                                android:textAlignment="viewEnd"
                                android:layout_marginHorizontal="@dimen/three"
                                style="@style/CustomTextStylePoppinsBold"
                                android:layout_height="wrap_content">
                            </TextView>
                        </LinearLayout>

                        <View
                            android:layout_marginVertical="@dimen/five"
                            android:background="#e9eff6"
                            android:layout_width="match_parent"
                            android:layout_height="1dp">

                        </View>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:weightSum="2"
                            android:gravity="center_vertical"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="0.7"
                                android:textColor="@color/mid_black_gray"
                                android:text="@string/payment_id"
                                android:textSize="@dimen/thirteen_sp"
                                android:gravity="start"
                                android:textAlignment="viewStart"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:layout_height="wrap_content">

                            </TextView>

                            <TextView
                                android:gravity="end"
                                android:layout_width="0dp"
                                android:id="@+id/lblPaymentID"
                                android:layout_weight="1.3"
                                android:textAlignment="viewEnd"
                                android:layout_marginHorizontal="@dimen/three"
                                android:textSize="@dimen/fourteen_sp"
                                style="@style/CustomTextStylePoppinsBold"
                                android:layout_height="wrap_content">
                            </TextView>
                        </LinearLayout>




                        <View
                            android:layout_marginVertical="@dimen/five"
                            android:background="#e9eff6"
                            android:layout_width="match_parent"
                            android:layout_height="1dp">

                        </View>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:weightSum="2"
                            android:gravity="center_vertical"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="0.7"
                                android:textColor="@color/mid_black_gray"
                                android:text="@string/created_on"
                                android:textSize="@dimen/thirteen_sp"
                                android:gravity="start"
                                android:textAlignment="viewStart"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:layout_height="wrap_content">

                            </TextView>

                            <TextView
                                android:gravity="end"
                                android:layout_width="0dp"
                                android:layout_weight="1.3"
                                android:id="@+id/lblCreatedOn"
                                android:layout_marginHorizontal="@dimen/three"
                                android:textSize="@dimen/fourteen_sp"
                                android:textAlignment="viewEnd"
                                style="@style/CustomTextStylePoppinsBold"
                                android:layout_height="wrap_content">
                            </TextView>
                        </LinearLayout>


                        <View
                            android:layout_marginVertical="@dimen/five"
                            android:background="#e9eff6"
                            android:layout_width="match_parent"
                            android:layout_height="1dp">

                        </View>

                        <LinearLayout
                            android:orientation="horizontal"
                            android:layout_width="match_parent"
                            android:weightSum="2"
                            android:gravity="center_vertical"
                            android:layout_height="wrap_content">

                            <TextView
                                android:layout_width="0dp"
                                android:layout_weight="0.7"
                                android:textColor="@color/mid_black_gray"
                                android:text="@string/Remarks"
                                android:textSize="@dimen/thirteen_sp"
                                android:gravity="start"
                                android:textAlignment="viewStart"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:layout_height="wrap_content">

                            </TextView>

                            <TextView
                                android:gravity="end"
                                android:layout_width="0dp"
                                android:id="@+id/lblRemarks"
                                android:layout_weight="1.3"
                                android:layout_marginHorizontal="@dimen/three"
                                android:textSize="@dimen/fourteen_sp"
                                android:textAlignment="viewEnd"
                                style="@style/CustomTextStylePoppinsBold"
                                android:layout_height="wrap_content">
                            </TextView>
                        </LinearLayout>


                    </LinearLayout>

                </com.google.android.material.card.MaterialCardView>


                <com.google.android.material.card.MaterialCardView
                    android:layout_width="match_parent"
                    android:layout_marginHorizontal="@dimen/five"
                    android:layout_marginTop="@dimen/ten"
                    app:cardBackgroundColor="@color/white"
                    app:strokeWidth="0dp"
                    android:elevation="@dimen/five"
                    app:strokeColor="@color/white"
                    app:cardCornerRadius="@dimen/fifteen"
                    android:layout_height="wrap_content">
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:orientation="vertical"
                        android:layout_margin="@dimen/ten"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_width="match_parent"
                            android:text="@string/proofs"
                            android:drawablePadding="@dimen/seven"
                            style="@style/CustomTextStylePoppinsBold"
                            android:textSize="@dimen/fourteen_sp"
                            android:textAlignment="viewStart"
                            android:drawableStart="@drawable/ic_attach_file"
                            android:layout_height="wrap_content">

                        </TextView>

                        <androidx.recyclerview.widget.RecyclerView
                            android:id="@+id/rcPaymentProofAttachments"
                            android:layout_width="match_parent"
                            android:layout_marginTop="@dimen/five"
                            android:layout_height="wrap_content">
                        </androidx.recyclerview.widget.RecyclerView>

                        <TextView
                            android:id="@+id/lblNoDataFoundForFeeUploadAttachment"
                            android:gravity="center"
                            android:visibility="gone"
                            android:layout_marginTop="@dimen/ten"
                            android:layout_width="match_parent"
                            android:text="@string/no_proof_uploaded"
                            android:drawablePadding="@dimen/seven"
                            style="@style/CustomTextStylePoppinsBold"
                            android:textSize="@dimen/fourteen_sp"
                            android:layout_height="wrap_content">

                        </TextView>

                    </LinearLayout>
                </com.google.android.material.card.MaterialCardView>


                <TextView
                    android:layout_width="match_parent"
                    android:textAlignment="viewStart"
                    style="@style/CustomTextStylePoppinsBold"
                    android:textAllCaps="true"
                    android:id="@+id/lblTransactionDetailsAndCount"
                    android:layout_marginTop="@dimen/ten"
                    android:textColor="@color/light_gray_44"
                    android:layout_marginHorizontal="@dimen/five"
                    android:text=""
                    android:layout_height="wrap_content">

                </TextView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcTransactionReceipts"
                    android:layout_width="match_parent"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginTop="@dimen/ten"
                    android:overScrollMode="never"
                    android:layout_marginHorizontal="@dimen/ten"
                    android:layout_height="wrap_content">
                </androidx.recyclerview.widget.RecyclerView>

                <TextView
                    android:id="@+id/lblNoDataFoundForTransactionReceipts"
                    android:gravity="center"
                    android:visibility="gone"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_width="match_parent"
                    android:text="@string/no_transaction_details"
                    android:drawablePadding="@dimen/seven"
                    style="@style/CustomTextStylePoppinsBold"
                    android:textSize="@dimen/fourteen_sp"
                    android:layout_height="wrap_content">

                </TextView>

            </LinearLayout>



            <LinearLayout
                android:id="@+id/lytList"
                android:visibility="gone"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/nomessage"
                    android:layout_width="@dimen/two_fifty"
                    android:layout_height="@dimen/two_fifty"
                    android:layout_gravity="center"
                    android:src="@drawable/no_fee_pending_message"
                    android:textColor="@color/black"
                    android:textSize="@dimen/fifteen_sp"
                    />

                <TextView
                    android:id="@+id/txtNoData"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:text="@string/no_list_found"
                    android:textColor="@color/black"
                    android:textSize="@dimen/fifteen_sp"
                    />

            </LinearLayout>
        </LinearLayout>
    </androidx.core.widget.NestedScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>