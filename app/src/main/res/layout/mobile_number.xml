<?xml version="1.0" encoding="utf-8"?>
<androidx.coordinatorlayout.widget.CoordinatorLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
   >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@android:color/white"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/image_banner"
            android:layout_width="match_parent"
            android:layout_height="@dimen/two_fifty"
            android:layout_marginTop="@dimen/twenty"
            android:adjustViewBounds="true"
            android:src="@drawable/login_image" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:textSize="@dimen/fifteen_sp"
            android:text="@string/welcome_aboard"
           style="@style/CustomTextStylePoppinsBold"
            >

        </TextView>

        <TextView
            android:id="@id/lblContent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/ten"
            android:gravity="center"
            android:textSize="@dimen/fifteen_sp"
            android:text="@string/stay_connected_with_your_school_community_your_updates_communication_and_school_life_all_in_one_place"
            style="@style/CustomTextStylePoppinsRegular">
        </TextView>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:background="@drawable/bg_top_radious">

            <RelativeLayout
                android:id="@+id/rytMobileNumber"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/lblLogin"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/twenty_five"
                    android:gravity="center"
                    android:text="@string/let_s_get_started"
                    style="@style/CustomTextStylePoppinsBold"
                    android:textSize="@dimen/eighteen_sp"
                    android:textColor="@color/white"
                    />

                <TextView
                    android:id="@+id/lblMobile"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lblLogin"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/ten"
                    android:text="@string/lblMobileNumber"
                    android:textColor="@color/white"
                    style="@style/CustomTextStylePoppinsRegular"
                    android:textSize="@dimen/fifteen_sp" />

                <RelativeLayout
                    android:id="@+id/rytMobile"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fourty_five"
                    android:layout_below="@+id/lblMobile"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/ten"
                    android:background="@drawable/rect_white">

                    <ImageView
                        android:id="@+id/imgMobile"
                        android:layout_width="@dimen/twenty_five"
                        android:layout_height="@dimen/twenty_five"
                        android:layout_centerVertical="true"
                        android:src="@drawable/mobile"
                        android:visibility="gone" />

                    <View
                        android:id="@+id/vwMobile"
                        android:layout_width="@dimen/one"
                        android:layout_height="match_parent"
                        android:layout_marginVertical="@dimen/ten"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_toEndOf="@+id/imgMobile"
                        android:background="@color/mild_grey1"
                        android:visibility="gone" />

                    <EditText
                        android:id="@+id/txtMobileNumber"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_toEndOf="@+id/vwMobile"
                        android:background="@null"
                        android:hint="@string/_00000_00000"
                        android:inputType="number"
                        android:maxLength="10"
                        android:paddingHorizontal="@dimen/ten"
                       style="@style/CustomTextStylePoppinsRegular"
                        android:textColorHint="@color/light_gray_"
                      />


                </RelativeLayout>

                <TextView
                    android:id="@+id/btnLoginContinue"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_below="@+id/rytMobile"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginTop="@dimen/thirty"
                    android:layout_marginEnd="@dimen/ten"
                    android:layout_marginBottom="@dimen/ten"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rect_btn_blue"
                    android:gravity="center"
                    android:padding="@dimen/fifteen"
                    android:text="@string/next"
                    android:textColor="@color/white"
                    android:textSize="@dimen/fifteen_sp"
                    />
            </RelativeLayout>
        </RelativeLayout>
    </LinearLayout>
</androidx.coordinatorlayout.widget.CoordinatorLayout>
