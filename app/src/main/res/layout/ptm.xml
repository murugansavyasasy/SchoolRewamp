<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/cltDateSelection"
        android:layout_width="match_parent"
        android:layout_height="@dimen/one_fourty"
        android:background="@drawable/bottom_right_left_radious">

        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="@dimen/thirty_five"
            android:layout_height="@dimen/thirty_five"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/twenty_five"
            android:src="@drawable/arrow_left_white">

        </ImageView>

        <TextView
            android:id="@+id/lblMenuName"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:layout_toEndOf="@+id/imgBack"
            android:text="PTM"
            android:textColor="@color/white"
            android:textSize="@dimen/twenty">

        </TextView>

        <TextView
            android:id="@+id/lblSchoolName"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lblMenuName"
            android:layout_marginStart="@dimen/ten"
            android:layout_toEndOf="@+id/imgBack"
            android:text="sathish"
            android:textColor="@color/white"
            android:textSize="@dimen/thirteen_sp"></TextView>

        <TextView
            android:id="@+id/lblSectionName"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lblSchoolName"
            android:layout_marginStart="@dimen/ten"
            android:layout_toEndOf="@+id/imgBack"
            android:text="XII - A"
            android:textColor="@color/white"
            android:textSize="@dimen/thirteen_sp"></TextView>


        <ImageView
            android:id="@+id/imgSearch"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/twenty"
            android:layout_marginEnd="@dimen/twenty"
            android:src="@drawable/ic_search_white_color" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lblSectionName"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/fifteen"
            android:layout_marginEnd="@dimen/ten"
            android:orientation="horizontal"
            android:weightSum="2">

            <TextView
                android:id="@+id/lblScheduleMeeting"
                style="@style/CustomTextStylePoppinsBold1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/white_bg_card"
                android:gravity="center"
                android:padding="@dimen/ten"
                android:text="Schedule Meeting"
                android:textColor="@color/black">

            </TextView>

            <TextView
                android:id="@+id/lblYourMeeting"
                style="@style/CustomTextStylePoppinsBold1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="@dimen/ten"
                android:text="Your Meetings"
                android:textColor="@color/black">

            </TextView>

        </LinearLayout>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rytScheduleMeeting"
        android:layout_width="match_parent"
        android:layout_below="@+id/cltDateSelection"
        android:layout_height="wrap_content">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewDates"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"

            android:padding="16dp" />

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViewSlots"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/recyclerViewDates"
            android:padding="16dp" />

        <LinearLayout
            android:id="@+id/rytNoDataFound"
            android:layout_width="match_parent"
            android:visibility="gone"
            android:orientation="vertical"
            android:layout_below="@+id/recyclerViewDates"
            android:layout_height="wrap_content">

            <ImageView
                android:layout_width="match_parent"
                android:src="@drawable/nodataimage"
                android:layout_height="@dimen/two_hundred"></ImageView>


            <TextView
                android:layout_width="match_parent"
                android:textColor="@color/black"
                style="@style/CustomTextStylePoppinsBold1"
                android:textSize="@dimen/fifteen_sp"
                android:gravity="center"
                android:layout_marginTop="@dimen/fifteen"
                android:text="No meeting found."
                android:layout_height="wrap_content">

            </TextView>
        </LinearLayout>

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rytYourMeeting"
        android:layout_width="match_parent"
        android:visibility="gone"
        android:layout_below="@+id/cltDateSelection"
        android:layout_height="wrap_content">


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcyMeetingHistory"
            android:layout_width="match_parent"
            android:layout_marginEnd="@dimen/ten"
            android:layout_marginStart="@dimen/ten"
            android:layout_height="wrap_content">

        </androidx.recyclerview.widget.RecyclerView>

    </RelativeLayout>


</RelativeLayout>