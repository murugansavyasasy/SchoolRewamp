<?xml version="1.0" encoding="utf-8"?>
<LinearLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="@dimen/twele"
    android:background="@drawable/bg_card"
    android:layout_margin="@dimen/eight">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <TextView
            android:id="@+id/sectionname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="A"
            style="@style/CustomTextStylePoppinsBold"
           />


        <TextView
            android:id="@+id/totalcount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_pill"
            android:text="0 Students"
            android:paddingHorizontal="@dimen/twele"
            android:paddingVertical="@dimen/four"
            style="@style/CustomTextStylePoppinsBold"/>
    </RelativeLayout>


    <TextView
        android:id="@+id/boyscount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👦 Boys : 0"
        android:layout_marginTop="@dimen/eight"
        style="@style/CustomTextStylePoppinsMedium"
        />


    <TextView
        android:id="@+id/girlscount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="👧 Girls: 0"
        android:textColor="@color/black"
        android:layout_marginTop="@dimen/ten"
        style="@style/CustomTextStylePoppinsMedium"
        />


    <TextView
        android:id="@+id/otherscount"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="🧑 Others: 0"
        android:textColor="@color/black"
        android:layout_marginTop="@dimen/ten"
        style="@style/CustomTextStylePoppinsMedium"
        />

</LinearLayout>
