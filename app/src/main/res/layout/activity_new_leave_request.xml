<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/white"
    android:layout_height="match_parent"
    >
    <RelativeLayout
        android:id="@+id/rytHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_rounded"
        android:paddingBottom="@dimen/thirty"
        >
        <RelativeLayout
            android:id="@+id/rytHeaderDetail"
            android:layout_marginTop="@dimen/ten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="@dimen/thirty_five"
                android:layout_height="@dimen/thirty_five"
                android:layout_centerVertical="true"
                android:src="@drawable/left_arrow">

            </ImageView>

            <LinearLayout
                android:id="@+id/lytTitleAndName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@+id/imgBack"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblStudentName"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="@dimen/fifteen_sp">

                </TextView>

                <TextView
                    android:id="@+id/lblStudentSection"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:visibility="visible"
                    android:textColor="@color/white"
                    android:textSize="@dimen/twele_sp">

                </TextView>

            </LinearLayout>

        </RelativeLayout>

    </RelativeLayout>
    <TextView
        android:layout_marginStart="@dimen/fifteen"
        android:id="@+id/lblParentToolBar"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/leave_requests"
        android:layout_marginTop="@dimen/ten"
        android:layout_below="@+id/rytHeader"
        android:textColor="@color/black"
        android:textSize="@dimen/twenty">

    </TextView>

    <ScrollView
        android:layout_below="@+id/lblParentToolBar"
        android:layout_width="match_parent"
        android:clipToPadding="false"
        android:layout_height="wrap_content">
        <LinearLayout
            android:paddingBottom="@dimen/thirty"
            android:layout_margin="@dimen/fifteen"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="wrap_content">
            <LinearLayout
                android:paddingBottom="@dimen/fifteen"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_top_rounded_container"
                android:orientation="vertical"
                >

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ten"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/ten">

                    <LinearLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/background_radius_button"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="40dp"
                            android:layout_height="40dp"
                            android:scaleType="centerInside"
                            android:src="@drawable/grid_view" />

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Type"
                            android:textColor="#888888"
                            android:textSize="@dimen/fourteen_sp" />

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            style="@style/CustomTextStylePoppinsBold"
                            android:text="Casual"
                            android:textColor="#000000"
                            android:textSize="@dimen/thirteen_sp"
                            />
                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/ten"
                    android:background="#D1D1D6" />
                <!-- Reason -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/ten">

                    <LinearLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/background_radius_button"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="@dimen/twenty"
                            android:layout_height="@dimen/twenty"
                            android:background="@drawable/marker_border"
                            android:scaleType="centerInside" />
                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Cause"
                            android:textColor="#888888"
                            android:textSize="@dimen/fourteen_sp" />

                        <EditText
                            android:id="@+id/etLeaveReason"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:background="@android:color/transparent"
                            android:inputType="textCapSentences"
                            android:paddingTop="4dp"
                            android:paddingBottom="4dp"
                            android:text="Trip to Cannes"
                            style="@style/CustomTextStylePoppinsBold"
                            android:textColorHint="#888888"
                            android:textSize="@dimen/thirteen_sp" />

                    </LinearLayout>
                </LinearLayout>

                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/ten"
                    android:background="#D1D1D6" />
                <!-- From Date -->
                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/ten">

                    <!-- Icon -->
                    <LinearLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/background_radius_button"
                        android:gravity="center"
                        android:orientation="vertical">

                        <ImageView
                            android:layout_width="@dimen/twenty"
                            android:layout_height="@dimen/twenty"
                            android:src="@drawable/from_icon"
                            android:scaleType="centerInside" />
                    </LinearLayout>

                    <!-- Date & Session Layout -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- From Date -->
                        <LinearLayout
                            android:id="@+id/lnrFromDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.45"
                            android:orientation="vertical"
                            android:paddingEnd="8dp">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="From"
                                android:textColor="#888888"
                                android:textSize="@dimen/fourteen_sp" />

                            <TextView
                                android:id="@+id/tvFromDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                style="@style/CustomTextStylePoppinsBold"
                                android:text="@string/select_date"
                                android:drawablePadding="@dimen/three"
                                android:textSize="@dimen/thirteen_sp"
                                android:drawableEnd="@drawable/down_arrow" />
                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#D1D1D6" />

                        <!-- Session Spinner -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.555"
                            android:orientation="vertical"
                            android:paddingStart="8dp">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/session"
                                android:textColor="#888888"
                                android:textSize="@dimen/fourteen_sp" />

                            <Spinner
                                android:id="@+id/isFromSession"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/custom_spinner_background" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>


                <View
                    android:layout_width="match_parent"
                    android:layout_height="1dp"
                    android:layout_marginTop="@dimen/ten"
                    android:background="#D1D1D6" />
                <!--            <CalendarView-->

                <LinearLayout
                    android:visibility="gone"
                    android:paddingBottom="@dimen/sixteen"
                    android:paddingTop="@dimen/sixteen"
                    android:id="@+id/activityMain"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    >

                    <TextView
                        android:id="@+id/lblSelect"
                        android:layout_width="match_parent"
                        android:text="Select Date"
                        android:gravity="center"
                        android:layout_marginStart="@dimen/ten"
                        android:textSize="@dimen/sixteen_sp"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_height="wrap_content">

                    </TextView>
                    <FrameLayout
                        android:paddingStart="@dimen/fifteen"
                        android:paddingEnd="@dimen/fifteen"
                        android:id="@+id/calendarFromFragmentContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:id="@+id/FromDone"
                        android:layout_marginTop="@dimen/five"
                        android:layout_width="wrap_content"
                        android:text="Done"
                        android:layout_marginEnd="@dimen/fifteen"
                        android:visibility="gone"
                        android:layout_gravity="end"
                        android:paddingEnd="@dimen/ten"
                        android:paddingBottom="@dimen/five"
                        android:paddingStart="@dimen/ten"
                        android:paddingTop="@dimen/five"
                        android:textColor="@color/white"
                        android:background="@drawable/button_radius_bg"
                        android:layout_height="wrap_content">
                    </TextView>

                    <FrameLayout
                        android:paddingStart="@dimen/fifteen"
                        android:paddingEnd="@dimen/fifteen"
                        android:id="@+id/calendarToFragmentContainer"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content" />
                    <TextView
                        android:layout_marginTop="@dimen/five"
                        android:id="@+id/ToDone"
                        android:layout_width="wrap_content"
                        android:text="Done"
                        android:layout_marginEnd="@dimen/fifteen"
                        android:visibility="gone"
                        android:layout_gravity="end"
                        android:paddingEnd="@dimen/ten"
                        android:paddingBottom="@dimen/five"
                        android:paddingStart="@dimen/ten"
                        android:paddingTop="@dimen/five"
                        android:textColor="@color/white"
                        android:background="@drawable/button_radius_bg"
                        android:layout_height="wrap_content">
                    </TextView>

                    <View
                        android:layout_width="match_parent"
                        android:layout_height="1dp"
                        android:layout_marginTop="@dimen/ten"
                        android:background="#D1D1D6" />


                </LinearLayout>



                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/ten">

                    <!-- Icon -->
                    <LinearLayout
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginEnd="12dp"
                        android:background="@drawable/background_radius_button"
                        android:gravity="center">

                        <ImageView
                            android:layout_width="@dimen/twenty"
                            android:layout_height="@dimen/twenty"
                            android:src="@drawable/from_to_icom"
                            android:scaleType="centerInside" />
                    </LinearLayout>

                    <!-- Date & Session Container -->
                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:orientation="horizontal"
                        android:gravity="center_vertical">

                        <!-- To Date -->
                        <LinearLayout
                            android:id="@+id/lnrToDate"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.45"
                            android:orientation="vertical"
                            android:layout_marginEnd="@dimen/three">

                            <TextView
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="To"
                                android:textColor="#888888"
                                android:textSize="@dimen/fourteen_sp" />

                            <TextView
                                android:id="@+id/tvToDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:drawableEnd="@drawable/down_arrow"
                                android:drawablePadding="@dimen/three"
                                android:text="@string/select_date"
                                android:textSize="@dimen/thirteen_sp"
                                style="@style/CustomTextStylePoppinsBold" />
                        </LinearLayout>

                        <!-- Divider -->
                        <View
                            android:layout_width="1dp"
                            android:layout_height="match_parent"
                            android:background="#D1D1D6" />

                        <!-- To Session -->
                        <LinearLayout
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.55"
                            android:orientation="vertical"
                            android:layout_marginStart="@dimen/three">

                            <TextView
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:text="@string/session"
                                android:textColor="#888888"
                                android:textSize="@dimen/fourteen_sp" />

                            <Spinner
                                android:id="@+id/isToSession"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:background="@drawable/custom_spinner_background" />
                        </LinearLayout>
                    </LinearLayout>
                </LinearLayout>

            </LinearLayout>

            <TextView
                android:layout_marginStart="@dimen/five"
                android:layout_marginEnd="@dimen/five"
                android:id="@+id/lblErrorMessage"
                android:layout_marginTop="@dimen/ten"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                style="@style/CustomTextStylePoppinsMedium"
                android:text=""
                android:textColor="@color/red"
               />


            <!-- Submit Button -->

            <TextView
                android:id="@+id/btnApplyLeave"
                android:background="@drawable/background_radius_button"
                android:fontFamily="@font/poppins_bold"
                android:layout_width="match_parent"
                android:padding="@dimen/ten"
                android:layout_marginTop="@dimen/fifteen"
                android:gravity="center"
                android:text="Apply for Leave"
                android:textColor="#FFFFFF"
                android:textSize="16sp"
                android:layout_height="wrap_content">

            </TextView>

            <LinearLayout
                android:id="@+id/linear_layout9"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lbTextCount"
                android:layout_alignParentBottom="true"
                android:layout_marginTop="10dp"
                android:gravity="center"
                android:orientation="horizontal"
                android:paddingTop="8dp"
                android:paddingBottom="8dp"
                android:visibility="gone">

                <TextView
                    android:id="@+id/btncancel"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="12dp"
                    android:background="@drawable/bg_red_radious__all_side_same"
                    android:padding="10dp"
                    android:paddingStart="@dimen/eighteen_sp"
                    android:paddingEnd="@dimen/eighteen_sp"
                    android:text="Cancel"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

                <TextView
                    android:id="@+id/btnupdate"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="30dp"
                    android:background="@drawable/bg_green_radious"
                    android:padding="10dp"
                    android:paddingStart="@dimen/eighteen_sp"
                    android:paddingEnd="@dimen/eighteen_sp"
                    android:text="Update"
                    android:textColor="@color/white"
                    android:textSize="13sp" />

            </LinearLayout>


        </LinearLayout>

    </ScrollView>




</RelativeLayout>
