<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/rlaLbCommunication"
        android:layout_width="match_parent"
        android:layout_height="@dimen/eighty"
        android:background="@color/primary_light"
        android:paddingBottom="@dimen/thirty">
        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:layout_marginStart="@dimen/twenty"
            android:layout_marginTop="@dimen/twenty"
            android:src="@drawable/arrow_back_black">

        </ImageView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sixty"
            android:layout_marginTop="@dimen/twenty"
            android:text="@string/daily_collection_fees"
            android:textColor="@color/black"
            android:textSize="@dimen/twenty_sp"
            android:textStyle="bold">

        </TextView>
    </RelativeLayout>




    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/relative_layout"
        android:layout_below="@+id/rlaLbCommunication"
        android:gravity="center_horizontal"
        android:layout_marginTop="@dimen/ten">



        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/linear_layout2"
            android:layout_marginEnd="@dimen/thirty"
            android:orientation="vertical">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/from_date"
            style="@style/CustomTextStylePoppinsMedium"
            android:textColor="@color/black"
            android:textSize="@dimen/thirteen_sp"
            android:layout_gravity="center"
            android:layout_marginEnd="@dimen/ten"
            android:text="@string/FromDate"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/linear_layout3"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:background="@drawable/custom_rounded_background"
                android:padding="@dimen/three"
                android:layout_marginTop="@dimen/ten">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/from_date2"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp"
                android:layout_marginEnd="@dimen/ten"
                android:text="Feb 13,2025"
                android:layout_marginStart="@dimen/ten"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_marginTop="@dimen/five"
                android:gravity="center"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/five"/>


                <ImageView
                    android:layout_width="@dimen/eighteen"
                    android:layout_height="@dimen/eighteen"
                    android:id="@+id/image_view"
                    android:textStyle="normal"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp"
                    android:layout_marginEnd="@dimen/ten"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/three"
                    android:src="@drawable/calender_icon_color"/>
            </LinearLayout>
        </LinearLayout>
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/linear_layout4"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/from_date1"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp"
                android:layout_gravity="center"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_marginEnd="@dimen/ten"
                android:text="@string/ToDate"/>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:id="@+id/linear_layout5"
                android:layout_gravity="center_horizontal"
                android:orientation="horizontal"
                android:background="@drawable/custom_rounded_background"
                android:padding="@dimen/three"
                android:layout_marginTop="@dimen/ten">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:id="@+id/from_date3"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp"
                    android:layout_marginEnd="@dimen/ten"
                    android:text="Feb 13,2025"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginTop="@dimen/five"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_marginBottom="@dimen/five"/>


                <ImageView
                    android:layout_width="@dimen/eighteen"
                    android:layout_height="@dimen/eighteen"
                    android:id="@+id/image_view1"
                    android:textStyle="normal"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp"
                    android:layout_marginEnd="@dimen/ten"
                    android:gravity="center"
                    android:layout_gravity="center"
                    android:layout_marginStart="@dimen/three"
                    android:src="@drawable/calender_icon_color"/>


            </LinearLayout>

        </LinearLayout>

    </LinearLayout>




    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/fifty"
        android:id="@+id/relative_layout8"
        android:layout_below="@+id/relative_layout"
        android:weightSum="3"
        android:gravity="center_vertical"
        android:layout_marginTop="@dimen/ten">


        <TextView
            android:id="@+id/category_name"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/fifty"
            android:layout_marginTop="@dimen/five"
            android:layout_weight="1"
            android:background="@drawable/custom_category_background"
            android:gravity="center"
            android:text="@string/DC_category"
            android:textColor="@color/white"
            android:textSize="@dimen/fifteen_sp"
            style="@style/CustomTextStylePoppinsMedium">
        </TextView>

        <TextView
            android:id="@+id/class_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/DailyCollection_class"
            android:textColor="@color/grey"
            android:textSize="@dimen/fifteen_sp"
            android:layout_marginTop="@dimen/five"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/three"
            android:background="@drawable/custom_rounded_background2"
            android:layout_marginEnd="@dimen/three"
            android:gravity="center"
            style="@style/CustomTextStylePoppinsMedium">
        </TextView>


        <TextView
            android:id="@+id/mode_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="@string/mode"
            android:textColor="@color/grey"
            android:textSize="@dimen/fifteen_sp"
            android:layout_marginTop="@dimen/five"
            android:layout_weight="1"
            android:gravity="center"
            style="@style/CustomTextStylePoppinsMedium"
            android:background="@drawable/custom_rounded_background2"
           >
        </TextView>

     </LinearLayout>

