<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fitsSystemWindows="true">


    <RelativeLayout
        android:id="@+id/rlaLeaveRequest"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/five"
        android:background="@drawable/rect_shadow_white">


        <LinearLayout
            android:id="@+id/lblLeaveInformation"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/five"
            android:layout_marginStart="@dimen/ten"
            android:orientation="vertical">


            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="13dp">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="horizontal"
                    android:weightSum="2"
                    android:gravity="center"
                    android:layout_height="wrap_content">

                    <LinearLayout
                        android:layout_weight="1.3"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        >

                        <TextView
                            android:id="@+id/lblFromData"
                            style="@style/CustomTextStylePoppinsBold1"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:text="Mar 31, 2023"
                            android:textColor="@color/navi_blue2"
                            android:textSize="@dimen/fourteen_sp" />

                        <ImageView
                            android:id="@+id/imagearrow_view"
                            android:layout_width="@dimen/sixteen"
                            android:layout_height="@dimen/sixteen"
                            android:layout_marginStart="16dp"
                            android:layout_marginEnd="4dp"
                            android:layout_marginTop="2dp"
                            android:src="@drawable/exchangearrow">
                        </ImageView>

                        <TextView
                            android:id="@+id/lblToDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Apr 2 -2023"
                            android:textColor="@color/navi_blue2"
                            android:textSize="@dimen/fourteen_sp"
                            android:layout_marginStart="2dp"
                            style="@style/CustomTextStylePoppinsBold1" />
                    </LinearLayout>

                    <RelativeLayout
                        android:layout_weight="0.7"
                        android:id="@+id/rlaStatus"
                        android:layout_width="0dp"
                        android:layout_marginEnd="@dimen/ten"
                        android:layout_height="wrap_content"
                        >

                        <ImageView
                            android:id="@+id/imgStatus"
                            android:layout_width="@dimen/twenty_five"
                            android:layout_height="@dimen/twenty_five"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/five"
                            >

                        </ImageView>

                        <TextView
                            android:id="@+id/lblStatus"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginEnd="@dimen/ten"
                            android:layout_toEndOf="@+id/imgStatus"
                            android:padding="@dimen/five"
                            android:text="@string/status"
                            android:textColor="@color/white"
                            style="@style/CustomTextStylePoppinsMedium1"
                            >

                        </TextView>
                    </RelativeLayout>



                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">
                    <TextView
                        android:id="@+id/reasonlabel"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="Reason"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsMedium1" />

                    <TextView
                        android:id="@+id/dotlabel3"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsMedium1"  />

                    <TextView
                        android:id="@+id/leaverequestdesc"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Going to temple"
                        android:layout_marginStart="8dp"
                        android:layout_marginEnd="@dimen/ten"
                        android:textColor="@color/light_blue_1"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsMedium1" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal"

                    >

                    <TextView
                        android:id="@+id/noofdayslabel"
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="No.Of.Days"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsMedium1" />
                    <TextView
                        android:id="@+id/dotlabel2"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsMedium1" />

                    <TextView
                        android:id="@+id/lbldays"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="3"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/light_blue_1"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsMedium1"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    >

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"

                        android:text="Applied On"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsMedium1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsMedium1" />

                    <TextView
                        android:id="@+id/lbldate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="04 Jun 2025 03:38 PM"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/light_blue_1"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsMedium1"/>
                </LinearLayout>

<!--                updated On-->

                <LinearLayout
                    android:id="@+id/lnrUpdatedOn"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="8dp"
                    >

                    <TextView
                        android:layout_width="100dp"
                        android:layout_height="wrap_content"
                        android:text="@string/updated_on"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsMedium1" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=":"
                        android:layout_marginStart="4dp"
                        android:layout_marginEnd="4dp"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsMedium1" />

                    <TextView
                        android:id="@+id/lblUpdatedOn"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="04 Jun 2025 03:38 PM"
                        android:layout_marginStart="8dp"
                        android:textColor="@color/light_blue_1"
                        android:textSize="@dimen/fourteen_sp"
                        style="@style/CustomTextStylePoppinsMedium1"/>
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>

    </RelativeLayout>
</RelativeLayout>


