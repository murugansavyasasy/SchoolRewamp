<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:padding="@dimen/five"
    android:background="@color/light_white">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="@dimen/fifty"
        android:background="@color/PrimaryColor"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"/>

    <androidx.core.widget.NestedScrollView
        android:id="@+id/nestedScrollView"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/conBarChartDetails"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_rect_white_solid"                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/lblSubjectWisePerformance"
                    android:layout_width="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginStart="@dimen/ten"
                    app:layout_constraintStart_toStartOf="parent"
                    android:text="Subject-wise Performance"
                    android:textColor="@color/black"
                    style="@style/CustomTextStylePoppinsBold1"
                    android:layout_height="wrap_content">

                </TextView>

                <TextView
                    android:id="@+id/lblStorngest"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fifteen"
                    android:text="Storngest : Math"
                    android:textColor="@color/green"
                    android:padding="@dimen/eight"
                    android:layout_marginStart="@dimen/ten"
                    android:background="@drawable/bg_light_green_radious"
                    android:drawableStart="@drawable/alarm"
                    android:drawablePadding="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/lblSubjectWisePerformance"
                    style="@style/CustomTextStylePoppinsBold1"/>

                <TextView
                    android:id="@+id/lblWeak"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fifteen"
                    android:text="Weak : Computer"
                    android:textColor="@color/red"
                    android:padding="@dimen/eight"
                    app:layout_constraintStart_toEndOf="@+id/lblStorngest"
                    android:layout_marginStart="@dimen/ten"
                    android:background="@drawable/bg_light_red_radious"
                    android:drawableStart="@drawable/alarm"
                    android:drawablePadding="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/lblSubjectWisePerformance"
                    style="@style/CustomTextStylePoppinsBold1"/>


                <com.vs.schoolmessenger.School.StudentDetails.Charts.YAxisView
                    android:id="@+id/YAxisView"
                    android:layout_width="@dimen/fourty"
                    android:layout_height="@dimen/three_hundred"
                    android:layout_marginStart="@dimen/ten"
                    app:layout_constraintTop_toBottomOf="@+id/lblStorngest"
                    app:layout_constraintStart_toStartOf="parent"/>

                <HorizontalScrollView
                    android:id="@+id/hsBarChart"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/three_hundred"
                    android:scrollbars="horizontal"
                    app:layout_constraintTop_toBottomOf="@+id/lblStorngest"
                    app:layout_constraintStart_toEndOf="@id/YAxisView"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.vs.schoolmessenger.School.StudentDetails.Charts.BarChartView
                        android:id="@+id/barChart"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"/>

                </HorizontalScrollView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvLegend"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ten"
                    app:layout_constraintTop_toBottomOf="@id/hsBarChart"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintEnd_toEndOf="parent"/>

            </androidx.constraintlayout.widget.ConstraintLayout>


            <androidx.constraintlayout.widget.ConstraintLayout
                android:id="@+id/conLineChart"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/twenty"
                android:background="@drawable/bg_rect_white_solid"
                app:layout_constraintTop_toBottomOf="@id/conBarChartDetails"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <TextView
                    android:id="@+id/lblExamPerformance"
                    android:layout_width="wrap_content"
                    app:layout_constraintTop_toTopOf="parent"
                    android:layout_marginTop="@dimen/twenty"
                    app:layout_constraintStart_toStartOf="parent"
                    android:text="Exam Performance Trend"
                    android:layout_marginStart="@dimen/ten"
                    android:textColor="@color/black"
                    style="@style/CustomTextStylePoppinsBold1"
                    android:layout_height="wrap_content">

                </TextView>

                <TextView
                    android:id="@+id/lblExamCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fifteen"
                    android:text="Last 4 Examnination"
                    android:textColor="@color/gray4"
                    android:padding="@dimen/eight"
                    android:layout_marginStart="@dimen/ten"
                    android:drawablePadding="8dp"
                    app:layout_constraintStart_toStartOf="parent"
                    app:layout_constraintTop_toBottomOf="@+id/lblExamPerformance"
                    style="@style/CustomTextStylePoppinsBold1"/>

                <TextView
                    android:id="@+id/lblExamTrend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fifteen"
                    android:text="+ 15%"
                    android:layout_marginEnd="@dimen/ten"
                    app:layout_constraintEnd_toEndOf="parent"
                    android:textColor="@color/green"
                    android:padding="@dimen/eight"
                    android:layout_marginStart="@dimen/ten"
                    android:background="@drawable/bg_light_green_radious"
                    android:drawableStart="@drawable/alarm"
                    android:drawablePadding="8dp"
                    app:layout_constraintTop_toBottomOf="@+id/lblExamPerformance"
                    style="@style/CustomTextStylePoppinsBold1"/>

                <com.vs.schoolmessenger.School.StudentDetails.Charts.LineYAxisView
                    android:id="@+id/LineYAxisView"
                    android:layout_width="@dimen/fourty"
                    android:layout_height="@dimen/three_hundred"
                   app:layout_constraintTop_toBottomOf="@+id/lblExamTrend"
                    app:layout_constraintStart_toStartOf="parent"/>

                <HorizontalScrollView
                    android:id="@+id/hsLineChart"
                    android:layout_width="0dp"
                    android:layout_height="@dimen/three_hundred"
                    android:scrollbars="horizontal"
                  app:layout_constraintTop_toBottomOf="@+id/lblExamTrend"
                    app:layout_constraintStart_toEndOf="@id/LineYAxisView"
                    app:layout_constraintEnd_toEndOf="parent">

                    <com.vs.schoolmessenger.School.StudentDetails.Charts.ScrollableLineChartView
                        android:id="@+id/lineChart"
                        android:layout_width="wrap_content"
                        android:layout_height="match_parent"/>

                </HorizontalScrollView>


                <TextView
                    android:id="@+id/lblHigherScore"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/ten"
                    android:textSize="@dimen/fifteen_sp"
                    android:gravity="center"
                    android:textStyle="bold"
                    app:layout_constraintTop_toBottomOf="@+id/hsLineChart"
                    android:layout_height="wrap_content">

                </TextView>
            </androidx.constraintlayout.widget.ConstraintLayout>
        </androidx.constraintlayout.widget.ConstraintLayout>
    </androidx.core.widget.NestedScrollView>
</androidx.constraintlayout.widget.ConstraintLayout>