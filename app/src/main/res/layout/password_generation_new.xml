<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <androidx.coordinatorlayout.widget.CoordinatorLayout
        android:id="@+id/toolbarLayout"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <RelativeLayout
            android:id="@+id/rytBack"
            android:layout_width="@dimen/fourty"
            android:layout_height="@dimen/fourty"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:background="@drawable/bg_circle_white"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="@dimen/fifteen"
                android:layout_height="@dimen/fifteen"
                android:layout_centerInParent="true"
                android:src="@drawable/ic_arrow_back_black" />
        </RelativeLayout>

    </androidx.coordinatorlayout.widget.CoordinatorLayout>

    <ScrollView
        app:layout_constraintTop_toBottomOf="@id/toolbarLayout"
        app:layout_constraintBottom_toTopOf="@id/footerLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:fillViewport="true"
        android:background="@color/PrimaryColor"

        android:layout_width="0dp"
        android:layout_height="0dp">
        <LinearLayout
            android:layout_marginTop="@dimen/thirty"
            android:paddingBottom="@dimen/thirty"
            android:background="@drawable/bg_rect_white_large_top_radius"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lblHeading"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/twenty"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="start"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_marginEnd="@dimen/twenty"
                android:text="@string/ResetThePassword"
                android:textColor="@color/black"
                android:textSize="@dimen/eighteen_sp">

            </TextView>

            <ImageView
                android:layout_width="match_parent"
                android:layout_height="@dimen/two_hundred"
                android:layout_marginTop="@dimen/twenty"
                android:adjustViewBounds="true"
                android:src="@drawable/ic_password_generate_svg" />





            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ten">

                    <TextView
                        android:id="@+id/lblTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/five"
                        android:gravity="center"
                        android:visibility="gone"
                        style="@style/CustomTextStylePoppinsBold"
                        android:text="@string/ResetThePassword"
                        android:textSize="@dimen/eighteen_sp" />

                    <TextView
                        android:id="@+id/lblCreatePassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/lblTitle"
                        android:layout_marginStart="@dimen/twenty"
                        android:layout_marginTop="@dimen/ten"
                        android:layout_marginEnd="@dimen/twenty"
                        style="@style/CustomTextStylePoppinsRegular"
                        android:text="@string/ResetThePassword"
                        android:textSize="@dimen/thirteen_sp" />

                    <RelativeLayout
                        android:focusable="true"
                        android:background="@drawable/ryt_password_selector"
                        android:focusableInTouchMode="true"
                        android:id="@+id/rytMobile"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/fourty_five"
                        android:layout_below="@+id/lblCreatePassword"
                        android:layout_marginStart="@dimen/twenty"
                        android:layout_marginTop="@dimen/ten"
                        android:layout_marginEnd="@dimen/twenty"
                       >


                        <EditText
                            android:layout_alignParentStart="true"
                            android:id="@+id/txtCreatePassword"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_toStartOf="@+id/imgHide"
                            android:layout_marginEnd="@dimen/five"
                            android:background="@null"
                            android:imeOptions="actionDone"
                            style="@style/CustomTextStylePoppinsRegular"
                            android:hint="@string/star"
                            android:layout_alignStart="@+id/imgHide"
                            android:inputType="textPassword"
                            android:paddingHorizontal="@dimen/ten"
                            android:textColorHint="@color/light_gray_"
                            android:textSize="@dimen/thirteen_sp" />

                        <ImageView
                            android:id="@+id/imgHide"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/ten"
                            android:src="@drawable/password_hide" />



                    </RelativeLayout>

                    <TextView
                        android:id="@+id/lblPassword"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/rytMobile"
                        style="@style/CustomTextStylePoppinsRegular"
                        android:layout_marginStart="@dimen/twenty"
                        android:layout_marginTop="@dimen/ten"
                        android:layout_marginEnd="@dimen/twenty"
                        android:text="@string/EnterTheConformPassword"
                        android:textSize="@dimen/thirteen_sp" />


                    <RelativeLayout
                        android:id="@+id/rytPassword"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/fourty_five"
                        android:layout_below="@+id/lblPassword"
                        android:layout_marginStart="@dimen/twenty"
                        android:focusable="true"
                        android:background="@drawable/ryt_password_selector"
                        android:focusableInTouchMode="true"
                        android:layout_marginTop="@dimen/ten"
                        android:layout_marginEnd="@dimen/twenty"
                      >


                        <EditText
                            android:layout_alignParentStart="true"
                            android:id="@+id/txtConfirmPassword"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:hint="@string/star"
                            android:imeOptions="actionDone"
                            android:layout_toStartOf="@+id/imgHide1"
                            android:layout_marginEnd="@dimen/five"
                            style="@style/CustomTextStylePoppinsRegular"
                            android:inputType="textPassword"
                            android:paddingHorizontal="@dimen/ten"
                            android:background="@null"
                            android:textColorHint="@color/grey"
                            android:textSize="@dimen/thirteen_sp" />

                        <ImageView
                            android:id="@+id/imgHide1"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true"
                            android:layout_marginEnd="@dimen/ten"
                            android:src="@drawable/password_hide" />

                    </RelativeLayout>

                    <TextView
                        android:id="@+id/btnCreate"
                        android:layout_below="@+id/rytPassword"
                        android:layout_marginStart="@dimen/twenty"
                        android:layout_marginTop="@dimen/thirty"
                        android:layout_marginEnd="@dimen/twenty"
                        android:layout_marginBottom="@dimen/ten"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        style="@style/CustomTextStylePoppinsBold"
                        android:background="@drawable/rect_btn_blue"
                        android:gravity="center"
                        android:padding="@dimen/ten"
                        android:text="@string/next"
                        android:textColor="@color/white"
                        android:textSize="@dimen/fifteen_sp"
                        />

                </RelativeLayout>

            </RelativeLayout>
        </LinearLayout>
    </ScrollView>


    <RelativeLayout
        android:id="@+id/footerLayout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/fifteen"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <ImageView
            android:id="@+id/imgSavyasasy"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:src="@drawable/savyasasy" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/imgSavyasasy"
            android:text="@string/powered_by_savyasasy"
            android:textColor="@color/grey" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>


