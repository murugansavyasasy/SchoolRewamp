<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintTop_toTopOf="parent">

        <include
            android:id="@+id/toolbarLayout"
            layout="@layout/parent_side_tool_bar" />

        <LinearLayout
            android:id="@+id/lytDownload"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/toolbarLayout"
            android:layout_alignParentEnd="true"
            android:layout_margin="@dimen/ten"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/five">

            <TextView
                android:id="@+id/txtDownload"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/five"
                android:text="Download"
                android:textColor="@color/sky_blue"
                android:textSize="@dimen/fourteen_sp" />

            <ImageView
                android:id="@+id/imgDownload"
                android:layout_width="@dimen/twenty_five"
                android:layout_height="@dimen/twenty_five"
                android:src="@drawable/downloadicon" />
        </LinearLayout>

        <WebView
            android:id="@+id/feeReceiptWebview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@id/lytDownload" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
