<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">


    <RelativeLayout
        android:gravity="center"
        android:id="@+id/rytHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gradient_theme_school"
        android:padding="@dimen/ten">

        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:layout_marginTop="@dimen/ten"
            android:src="@drawable/left_arrow">

        </ImageView>

        <TextView
            android:layout_toEndOf="@+id/imgBack"
            android:id="@+id/NavStudentReport"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten"
            android:text="@string/StudentReport"
            android:textColor="@color/black"
            android:textSize="@dimen/twenty_sp"
            android:textStyle="bold">

        </TextView>
        <ImageView
            android:id="@+id/SearchNotification"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:layout_marginTop="@dimen/ten"
            android:layout_alignParentEnd="true"
            android:alpha="0.5"
            android:layout_marginEnd="@dimen/ten"
            android:src="@drawable/ic_search" />
    </RelativeLayout>

    <RelativeLayout
        android:layout_marginTop="@dimen/five"
        android:layout_width="match_parent"
        android:layout_below="@+id/rytHeader"
        android:id="@+id/rytSearch"
        android:visibility="gone"
        android:layout_marginStart="@dimen/five"
        android:layout_marginEnd="@dimen/five"
        android:layout_height="wrap_content">
        <RelativeLayout

            android:layout_width="match_parent"
            android:layout_height="@dimen/thirty_five"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:background="@drawable/rect_grey">


            <ImageView
                android:id="@+id/imgSearch"
                android:layout_width="@dimen/thirty"
                android:layout_height="@dimen/thirty"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/ten"
                android:alpha="0.34"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/txtSearchMenu"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toEndOf="@+id/imgSearch"
                android:background="@android:color/transparent"
                android:fontFamily="@font/poppins_regular"
                android:hint="@string/lblSearch"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />

        </RelativeLayout>

        <ImageView
            android:background="@drawable/white_circle_bg"
            android:id="@+id/imgDelete"
            android:padding="@dimen/five"
            android:layout_width="@dimen/twenty_five"
            android:layout_height="@dimen/twenty_five"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/eight"
            android:layout_alignParentTop="true"
            android:src="@drawable/del_icon">

        </ImageView>
    </RelativeLayout>


    <LinearLayout
        android:id="@+id/lnrSort"
        android:layout_marginTop="@dimen/ten"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rytSearch"
        android:layout_marginStart="@dimen/five"
        android:layout_marginEnd="@dimen/two"
        android:orientation="horizontal"
        android:weightSum="1">

        <RelativeLayout
            android:id="@+id/rlaSort"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:layout_weight="0.4"
            android:background="@drawable/rect_white_light_radious"
            android:padding="@dimen/ten">

            <ImageView
                android:id="@+id/imgSort"
                android:layout_width="@dimen/twenty"
                android:layout_height="@dimen/twenty"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/ten"
                android:src="@drawable/filter_icon">

            </ImageView>

            <TextView
                android:id="@+id/dropdownTextView"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/five"
                android:layout_toEndOf="@+id/imgSort"
                android:fontFamily="@font/poppins_regular"
                android:gravity="center_vertical"
                android:padding="@dimen/seven"
                android:text=""
                android:textColor="@color/black"
                android:textSize="@dimen/eleven_sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/AcademicYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:layout_weight="0.6"
            android:background="@drawable/rect_white_light_radious"
            android:padding="@dimen/ten">

            <TextView
                android:id="@id/lblAcademicYear"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:drawableEnd="@drawable/down_arrow"
                android:padding="@dimen/eight"
                android:paddingEnd="@dimen/five"
                android:text=""
                android:textSize="@dimen/ten_sp"
                android:textStyle="bold"></TextView>
        </RelativeLayout>

    </LinearLayout>



    <LinearLayout
        android:orientation="horizontal"
        android:id="@+id/rlaStandardPicking"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:weightSum="1"
        android:layout_marginEnd="@dimen/five"
        android:layout_marginStart="@dimen/five"
        android:layout_below="@+id/lnrSort"
        android:visibility="visible">

        <LinearLayout
            android:visibility="visible"
            android:id="@+id/lnrStandardDetails"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_weight="0.5"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/lblStandardPick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/five"
                android:text="@string/Standard"
                android:textColor="@color/black"
                android:textSize="@dimen/twele_sp"
                android:textStyle="bold"></TextView>

            <TextView
                android:id="@+id/dropdownTextViewStandard"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblStandardPick"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginEnd="@dimen/ten"
                android:background="@drawable/rect_white_light_radious"
                android:drawableEnd="@drawable/down_arrow"
                android:gravity="center_vertical"
                android:padding="@dimen/fifteen"
                android:text="XII"
                android:textColor="@color/navi_blue2"
                android:textSize="@dimen/eleven_sp"
                android:textStyle="bold" />

        </LinearLayout>
        <LinearLayout
            android:id="@+id/lnrSectionDetails"
            android:visibility="visible"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_weight="0.5"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/lblSectionPick"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/dropdownTextViewStandard"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/five"
                android:text="@string/Section"
                android:textColor="@color/black"
                android:textSize="@dimen/twele_sp"
                android:textStyle="bold"></TextView>

            <TextView

                android:id="@+id/dropdownTextViewSection"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblSectionPick"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginEnd="@dimen/ten"
                android:background="@drawable/rect_white_light_radious"
                android:drawableEnd="@drawable/down_arrow"
                android:gravity="center_vertical"
                android:padding="@dimen/fifteen"
                android:text="B"
                android:textColor="@color/navi_blue2"
                android:textSize="@dimen/eleven_sp"
                android:textStyle="bold" />
        </LinearLayout>
    </LinearLayout>
    <LinearLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/thirty"
        android:layout_below="@+id/rlaStandardPicking"
        android:layout_marginStart="@dimen/fifteen"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginEnd="@dimen/fifteen"
        android:layout_marginBottom="@dimen/five"
        android:background="@drawable/rect_light_gray"
        android:orientation="horizontal"
        android:padding="@dimen/one">

        <TextView
            android:id="@+id/tapNameAsc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_weight="1"

            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            style="@style/CustomTextStylePoppinsBold"
            android:text="@string/nameasc"
            android:textColor="@color/black"
            android:textSize="@dimen/ten_sp">
        </TextView>



        <TextView
            android:id="@+id/tapNameDsc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_weight="1"
            style="@style/CustomTextStylePoppinsBold"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:textSize="@dimen/ten_sp"
            android:text="@string/namedsc"
            android:textColor="@color/black"/>

        <TextView
            android:id="@+id/tapNoAsc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_weight="1"
            style="@style/CustomTextStylePoppinsBold"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:textSize="@dimen/ten_sp"
            android:text="@string/no_asc"
            android:textColor="@color/black"/>


        <TextView
            android:id="@+id/tapNoDsc"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_weight="1"
            style="@style/CustomTextStylePoppinsBold"
            android:fontFamily="@font/poppins_bold"
            android:gravity="center"
            android:textSize="@dimen/ten_sp"
            android:text="@string/no_dsc"
            android:textColor="@color/black">
        </TextView>


    </LinearLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcyStudentReport"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tabLayout">
    </androidx.recyclerview.widget.RecyclerView>

    <LinearLayout
        android:id="@+id/lytNoDataFound"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rcyStudentReport"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/two_hundred"
            android:layout_height="@dimen/two_hundred"
            android:layout_marginTop="@dimen/twenty_five"
            android:src="@drawable/no_data_found"></ImageView>

        <TextView
            android:id="@+id/noDataFound"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/twenty"
            android:text="">

        </TextView>

    </LinearLayout>


</RelativeLayout>

