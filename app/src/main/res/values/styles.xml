<?xml version="1.0" encoding="utf-8"?>
<resources>

    <style name="CustomCheckbox" parent="@style/Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:button">@drawable/custom_checkbox</item>
        <item name="android:background">@android:color/transparent</item>
    </style>

    <style name="HintTextStyle" parent="TextAppearance.Design.Hint">
        <item name="android:textSize">16sp</item>
    </style>

    <style name="Teacher_spinnerDropDownItemStyle" parent="android:TextAppearance.Widget.TextView.SpinnerItem"></style>

    <style name="Circular">
        <item name="cornerSize">50%</item>
    </style>

    <style name="IndicatorStyle">
        <item name="ci_width">8dp</item>
        <item name="ci_height">8dp</item>
        <item name="ci_margin">6dp</item>
        <item name="ci_drawable">@drawable/indicator_active</item>
        <item name="ci_drawable_unselected">@drawable/indicator_inactive</item>
    </style>

    <style name="PopupAnimation">
        <item name="android:windowEnterAnimation">@anim/bottom_to_top</item>
    </style>

    <!-- styles.xml -->
    <style name="CustomTextStyle" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/american_typewriter_bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#000000</item>
    </style>


    <!-- styles.xml -->
    <style name="CustomTextStyleAttendanceReportDashBoard" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/futura_bold</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#000000</item>
    </style>

    <!-- styles.xml -->
    <style name="CustomTextStyleAttendanceReportDashBoardRegular" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/futura_regular</item>
        <item name="android:textSize">18sp</item>
        <item name="android:textColor">#000000</item>
    </style>


    <!-- styles.xml -->
    <style name="CustomTextStylePoppinsBold" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/open_sans_bold</item>
        <item name="android:textSize">@dimen/thirteen_sp</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CustomTextStylePoppinsRegular" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/open_sans_medium</item>
        <item name="android:textSize">12sp</item>
        <item name="android:textColor">@color/black</item>
        <item name="android:textStyle">normal</item>
    </style>



    <style name="CustomTextStylePoppinsMedium" parent="TextAppearance.AppCompat">
        <item name="fontFamily">@font/open_sans_medium</item>
        <item name="android:textSize">@dimen/thirteen_sp</item>
        <item name="android:textColor">@color/black</item>
    </style>


    <style name="TabTextStyle">
        <item name="fontFamily">@font/open_sans_medium</item>
        <item name="android:textSize">@dimen/thirteen_sp</item>
        <item name="android:textColor">#000000</item>
    </style>


    <!-- res/values/styles.xml -->
    <style name="CustomCheckBox" parent="Widget.AppCompat.CompoundButton.CheckBox">
        <item name="android:buttonTint">@color/black</item>
        <item name="android:textColor">@color/black</item>
    </style>

    <style name="CustomProgressBar" parent="android:Widget.ProgressBar.Horizontal">
        <item name="android:indeterminateOnly">false</item>
        <item name="android:progressDrawable">@drawable/progressbar_loading</item>
        <item name="android:minHeight">10dp</item>
        <item name="android:maxHeight">20dp</item>
    </style>



</resources>