<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardHeader"
    android:layout_marginBottom="@dimen/ten"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:elevation="@dimen/five"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/twenty"
    app:strokeColor="@color/light_gray_10">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/twenty">

        <TextView
            app:layout_constraintHorizontal_weight="0.15"
            android:id="@+id/lblInitialName"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:text="s"
            app:layout_constraintDimensionRatio="1:1"
            android:textColor="@color/white"
            android:padding="@dimen/three"
            android:background="@drawable/circle_bg"
            android:gravity="center"
            app:layout_constraintEnd_toStartOf="@+id/lblFullName"
            app:layout_constraintBottom_toBottomOf="@+id/lblStudentDetails"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="@+id/lblFullName">

        </TextView>

        <TextView

            android:id="@+id/lblFullName"
            android:layout_marginEnd="@dimen/ten"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:text="Sathish"
            android:textSize="@dimen/fourteen_sp"
            app:layout_constrainedHeight="true"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constrainedWidth="true"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toEndOf="@+id/lblInitialName"
            app:layout_constraintTop_toTopOf="parent"></TextView>

        <TextView
            android:id="@+id/lblStudentDetails"
            style="@style/CustomTextStylePoppinsRegular"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Mobile 12345467789"
            android:textColor="@color/light_gray"
            android:textSize="@dimen/twele_sp"
            app:layout_constraintBottom_toTopOf="@+id/lblParentMobile"
            app:layout_constrainedHeight="true"
            android:layout_marginTop="@dimen/two"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="@+id/lblFullName"
            app:layout_constraintStart_toStartOf="@+id/lblFullName"
            app:layout_constraintTop_toBottomOf="@+id/lblFullName"></TextView>

        <TextView
            android:id="@+id/lblParentMobile"
            style="@style/CustomTextStylePoppinsRegular"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Mobile 12345467789"
            android:textColor="@color/light_gray"
            android:textSize="@dimen/twele_sp"
            app:layout_constraintBottom_toTopOf="@+id/viewOutpassAppliedBg"
            app:layout_constrainedHeight="true"
            android:layout_marginTop="@dimen/two"
            app:layout_constrainedWidth="true"
            app:layout_constraintEnd_toEndOf="@+id/lblFullName"
            app:layout_constraintStart_toStartOf="@+id/lblFullName"
            app:layout_constraintTop_toBottomOf="@+id/lblStudentDetails"></TextView>



        <View
            app:layout_constraintTop_toBottomOf="@+id/lblParentMobile"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:id="@+id/viewOutpassAppliedBg"
            android:layout_marginTop="@dimen/ten"
            android:background="@drawable/rect_radius_light_blue"
            app:layout_constraintBottom_toTopOf="@+id/lblPresent"
            android:layout_width="0dp"
            android:layout_height="0dp">

        </View>

        <TextView
            android:layout_marginEnd="@dimen/five"
            app:layout_constraintHorizontal_weight="1"
            android:layout_marginStart="@dimen/ten"
            style="@style/CustomTextStylePoppinsMedium"
            android:text="@string/outpass_applied"
            android:id="@+id/lblOutpassApplied"
            app:layout_constraintStart_toStartOf="@+id/viewOutpassAppliedBg"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@+id/lblOutpassReason"
            app:layout_constraintEnd_toStartOf="@+id/lblOutpassStatus"
            app:layout_constraintTop_toTopOf="@+id/viewOutpassAppliedBg"
            android:layout_height="wrap_content">

        </TextView>

        <TextView
            android:gravity="center"
            android:layout_marginEnd="@dimen/ten"
            style="@style/CustomTextStylePoppinsBold"
            android:paddingVertical="@dimen/five"
            android:textColor="@color/white"
            app:layout_constraintHorizontal_weight="0.45"
            android:id="@+id/lblOutpassStatus"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintBottom_toBottomOf="@+id/lblOutpassApplied"
            app:layout_constraintTop_toTopOf="@+id/lblOutpassApplied"
            app:layout_constraintStart_toEndOf="@+id/lblOutpassApplied"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            >

        </TextView>

        <TextView
            android:layout_marginHorizontal="@dimen/ten"
            app:layout_constraintEnd_toEndOf="@+id/viewOutpassAppliedBg"
            app:layout_constraintStart_toStartOf="@+id/viewOutpassAppliedBg"
            app:layout_constraintTop_toBottomOf="@+id/lblOutpassStatus"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@+id/lblOutpassPermissionFromTimeDuration"
            android:text="------------"
            style="@style/CustomTextStylePoppinsMedium"
            android:textColor="@color/dark_gray__1"
            android:layout_marginTop="@dimen/eight"
            android:id="@+id/lblOutpassReason"
            android:layout_height="wrap_content">

        </TextView>

        <TextView
            android:layout_marginHorizontal="@dimen/ten"
            app:layout_constraintEnd_toEndOf="@+id/viewOutpassAppliedBg"
            app:layout_constraintStart_toStartOf="@+id/viewOutpassAppliedBg"
            app:layout_constraintTop_toBottomOf="@+id/lblOutpassReason"
            android:layout_width="0dp"
            app:layout_constraintBottom_toTopOf="@+id/lblOutpassPermissionToTimeDuration"
            android:text="----------"
            app:layout_goneMarginBottom="@dimen/ten"
            style="@style/CustomTextStylePoppinsRegular"
            android:layout_marginTop="@dimen/eight"
            android:id="@+id/lblOutpassPermissionFromTimeDuration"
            android:layout_height="wrap_content">

        </TextView>

        <TextView
            android:layout_marginHorizontal="@dimen/ten"
            app:layout_constraintEnd_toEndOf="@+id/viewOutpassAppliedBg"
            app:layout_constraintStart_toStartOf="@+id/viewOutpassAppliedBg"
            app:layout_constraintTop_toBottomOf="@+id/lblOutpassPermissionFromTimeDuration"
            android:layout_width="0dp"
            style="@style/CustomTextStylePoppinsRegular"
            app:layout_constraintBottom_toTopOf="@+id/lblAccept"
            android:text="----------"
            app:layout_goneMarginBottom="@dimen/ten"
            android:layout_marginTop="@dimen/eight"
            android:id="@+id/lblOutpassPermissionToTimeDuration"
            android:layout_height="wrap_content">

        </TextView>

        <com.google.android.material.button.MaterialButton
            app:layout_constraintHorizontal_chainStyle="spread"
            android:id="@+id/lblAccept"
            android:minHeight="0dp"
            android:paddingVertical="@dimen/ten"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_marginTop="@dimen/ten"
            app:layout_constrainedHeight="true"
            app:layout_constraintHorizontal_weight="1"
            android:textSize="@dimen/thirteen_sp"
            app:iconSize="10dp"
            app:layout_constrainedWidth="true"
            android:layout_marginBottom="@dimen/ten"
            app:layout_constraintStart_toStartOf="@+id/viewOutpassAppliedBg"
            android:layout_width="0dp"
            android:layout_marginHorizontal="@dimen/fifteen"
            android:textColor="@color/white"
            app:icon="@drawable/tick_mark_icon_2"
            app:layout_constraintEnd_toStartOf="@+id/lblDecline"
            app:iconTint="@color/white"
            app:layout_constraintBottom_toBottomOf="@+id/viewOutpassAppliedBg"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:layout_constraintTop_toBottomOf="@+id/lblOutpassPermissionToTimeDuration"
            android:text="@string/accept"
            android:layout_height="wrap_content">

        </com.google.android.material.button.MaterialButton>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lblDecline"
            android:minHeight="0dp"
            app:layout_constraintHorizontal_weight="1"
            style="@style/CustomTextStylePoppinsBold"
            app:layout_constrainedHeight="true"
            android:textSize="@dimen/thirteen_sp"
            app:iconSize="10dp"
            android:paddingVertical="@dimen/ten"
            app:layout_constraintBottom_toBottomOf="@+id/viewOutpassAppliedBg"
            app:layout_constraintEnd_toEndOf="@+id/viewOutpassAppliedBg"
            app:layout_constrainedWidth="true"
            android:layout_marginBottom="@dimen/ten"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/ten"
            app:layout_constraintStart_toEndOf="@+id/lblAccept"
            android:layout_marginHorizontal="@dimen/fifteen"
            android:textColor="@color/white"
            app:icon="@drawable/close_icon_4"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:layout_constraintTop_toBottomOf="@+id/lblOutpassPermissionToTimeDuration"
            android:text="@string/decline"
            android:layout_height="wrap_content">

        </com.google.android.material.button.MaterialButton>

        <androidx.constraintlayout.widget.Group
            android:id="@+id/groupsEntireOutPass"
            android:layout_width="wrap_content"
            app:constraint_referenced_ids="viewOutpassAppliedBg,lblOutpassApplied,lblOutpassStatus,lblOutpassReason,lblOutpassPermissionFromTimeDuration,lblOutpassPermissionToTimeDuration"
            android:layout_height="wrap_content">

        </androidx.constraintlayout.widget.Group>



        <com.google.android.material.button.MaterialButton
            app:layout_constraintHorizontal_chainStyle="spread"
            android:id="@+id/lblPresent"
            android:minHeight="0dp"
            android:paddingVertical="@dimen/ten"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_marginTop="@dimen/ten"
            app:layout_constrainedHeight="true"
            app:layout_constraintHorizontal_weight="1"
            android:textSize="@dimen/thirteen_sp"
            app:layout_constrainedWidth="true"
            android:layout_marginBottom="@dimen/ten"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_width="0dp"
            app:iconSize="10dp"
            android:layout_marginHorizontal="@dimen/fifteen"
            android:textColor="@color/white"
            app:icon="@drawable/tick_mark_icon_2"
            app:layout_constraintEnd_toStartOf="@+id/lblAbsent"
            app:iconTint="@color/white"
            app:layout_constraintBottom_toBottomOf="parent"
            app:iconGravity="textStart"
            app:iconPadding="4dp"
            app:layout_constraintTop_toBottomOf="@+id/viewOutpassAppliedBg"
            android:text="@string/present"
            android:layout_height="wrap_content">

        </com.google.android.material.button.MaterialButton>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/lblAbsent"
            android:minHeight="0dp"
            app:layout_constraintHorizontal_weight="1"
            style="@style/CustomTextStylePoppinsBold"
            app:layout_constrainedHeight="true"
            android:textSize="@dimen/thirteen_sp"
            android:paddingVertical="@dimen/ten"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constrainedWidth="true"
            android:layout_marginBottom="@dimen/ten"
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/ten"
            app:layout_constraintStart_toEndOf="@+id/lblPresent"
            android:layout_marginHorizontal="@dimen/fifteen"
            android:textColor="@color/white"
            app:icon="@drawable/close_icon_4"
            app:iconTint="@color/white"
            app:iconGravity="textStart"
            app:iconSize="10dp"
            app:iconPadding="4dp"
            app:layout_constraintTop_toBottomOf="@+id/viewOutpassAppliedBg"
            android:text="@string/absent"
            android:layout_height="wrap_content">

        </com.google.android.material.button.MaterialButton>

    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>