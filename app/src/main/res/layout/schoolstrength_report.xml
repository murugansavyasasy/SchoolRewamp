<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:background="@drawable/bg_card_white"
    android:elevation="4dp"
    android:padding="12dp">


    <LinearLayout
        android:id="@+id/linear_layout2"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/header1"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="Standard  I"
                android:textColor="@color/black"
                android:textSize="16sp" />

            <TextView
                android:id="@+id/btnViewDetails"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:background="@drawable/bg_green_button"
                android:gravity="center"
                android:paddingHorizontal="12dp"
                android:paddingVertical="6dp"
                android:text="@string/view_details"
                android:textColor="@color/white"
                android:textSize="14sp" />
        </LinearLayout>

        <!-- Total Students -->
        <TextView
            android:id="@+id/totallabel"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:text="Total Students: 7"
            android:textColor="@color/black"
            android:textSize="12sp" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="end"
            android:orientation="horizontal">


            <ImageView
                android:id="@+id/boyslabel1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:src="@drawable/schoolstrengthmale"
                app:tint="@color/PrimaryColor" />

            <ImageView
                android:id="@+id/boyslabel2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:src="@drawable/schoolstrengthmale"
                app:tint="@color/PrimaryColor" />

            <ImageView
                android:id="@+id/girlslabel1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:src="@drawable/schoolstrengthfemale"
                app:tint="@color/pinkcolorcustom" />

            <ImageView
                android:id="@+id/girlslabel2"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:src="@drawable/schoolstrengthfemale"
                app:tint="@color/pinkcolorcustom" />

            <ImageView
                android:id="@+id/unknownimage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:src="@drawable/unknownimagesvg" />

            <ImageView
                android:id="@+id/unknownimage1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="4dp"
                android:gravity="end"
                android:src="@drawable/unknownimagesvg" />


        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="6dp"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="10dp"
            android:background="@color/pink_color"
            android:orientation="horizontal">

            <View
                android:id="@+id/viewBoys"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="6"
                android:background="@color/PrimaryColor" />

            <View
                android:id="@+id/viewGirls"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@color/pink" />

            <View
                android:id="@+id/viewUnspecified"
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="#9E9E9E" />
        </LinearLayout>


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            android:orientation="horizontal"
            android:weightSum="3">

            <TextView
                android:id="@+id/boyslabel"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"

                android:text="Boys : 6"
                android:textColor="@color/PrimaryColor"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/girlslabel"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="center"
                android:text="Girls : 1"
                android:textColor="@color/pink"
                android:textSize="12sp" />

            <TextView
                android:id="@+id/unspecified_count"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:gravity="end"
                android:text="Not specified : 1"
                android:textColor="#9E9E9E"
                android:textSize="12sp" />
        </LinearLayout>

    </LinearLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rlaabsenteesreport3"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/linear_layout2"
        android:layout_marginTop="20dp"
        android:layout_marginBottom="@dimen/ten"
        android:visibility="gone"></androidx.recyclerview.widget.RecyclerView>


</RelativeLayout>
