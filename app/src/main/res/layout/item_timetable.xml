<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginTop="@dimen/ten">
        <LinearLayout
            android:id="@+id/time"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">
            <ImageView
                android:id="@+id/statusImage"
                android:layout_width="@dimen/twenty_four"
                android:layout_height="@dimen/twenty_four"
                android:src="@drawable/pending"/>
            <TextView
                android:id="@+id/time_value"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="08:00 AM"
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp"
               style="@style/CustomTextStylePoppinsBold"
                android:layout_marginStart="@dimen/eight"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/timebase"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginTop="@dimen/ten">

            <ProgressBar
                android:id="@+id/progressBar"
                android:layout_width="@dimen/five"
                android:layout_height="@dimen/hundred"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="@dimen/ten"
                android:indeterminate="false"
                style="@android:style/Widget.ProgressBar.Horizontal"
                android:progressDrawable="@drawable/vertical_progress"
                android:max="100" />

            <androidx.cardview.widget.CardView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                app:cardCornerRadius="@dimen/eight"
                android:background="@color/white"
                android:layout_marginStart="@dimen/fifteen"
                android:layout_marginEnd="@dimen/five"
                android:layout_marginTop="@dimen/five"
                android:layout_marginBottom="@dimen/five">
                <LinearLayout
                    android:id="@+id/subjectname"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical"
                    android:layout_marginTop="@dimen/eight">
                    <TextView
                        android:id="@+id/subject_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Tamil"
                        android:textSize="@dimen/thirteen_sp"
                        style="@style/CustomTextStylePoppinsBold"
                        android:textColor="@color/bpBlue"
                        android:layout_marginStart="@dimen/five" />
                    <TextView
                        android:id="@+id/name_value"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Lakshmanan"
                        android:textSize="@dimen/thirteen_sp"
                        android:textColor="@color/black"
                        android:layout_marginTop="@dimen/eight"
                        android:layout_marginStart="@dimen/five"/>
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="1"
                        android:layout_marginTop="@dimen/eight"
                        android:layout_marginBottom="@dimen/eight">
                        <TextView
                            android:id="@+id/lblFromToTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="8 AM - 9 AM"
                            android:textColor="@color/black"
                            android:layout_weight=".4"
                            android:textSize="@dimen/thirteen_sp"
                            android:layout_marginStart="@dimen/five"/>
                        <TextView
                            android:id="@+id/duration_value"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="30 mins"
                            android:textColor="@color/grey"
                            android:layout_weight=".6"
                            android:textSize="@dimen/thirteen_sp"/>
                    </LinearLayout>
                </LinearLayout>
            </androidx.cardview.widget.CardView>
        </LinearLayout>
    </LinearLayout>

</RelativeLayout>
