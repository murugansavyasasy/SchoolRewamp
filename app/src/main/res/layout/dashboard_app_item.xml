<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/header"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/five"
    android:layout_marginTop="@dimen/ten"
    android:layout_marginEnd="@dimen/five"
    android:layout_margin="@dimen/eight"
    android:backgroundTint="@color/white"
    android:elevation="@dimen/fifteen"
    app:cardElevation="@dimen/fifteen"
    app:cardCornerRadius="@dimen/five">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:orientation="vertical"
        android:padding="@dimen/sixteen">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/eight"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/itemIcon"
                android:layout_width="@dimen/thirty"
                android:layout_height="@dimen/thirty"
                android:layout_marginEnd="@dimen/eight"
                android:background="@android:color/transparent"
                android:src="@drawable/user_icon" />

            <TextView
                android:id="@+id/itemTitle"
                android:layout_width="@dimen/zero"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:maxLines="2"
                android:ellipsize="end"
                android:text="Your Feed"
                android:textColor="@color/dark_blue_1"
                android:textSize="@dimen/thirteen_sp"
                style="@style/CustomTextStylePoppinsBold"/>
        </LinearLayout>

        <TextView
            android:id="@+id/itemDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="2"
            android:textColor="@color/mild_grey6"
            android:text="Lorem ipsum dolor sit amet, consectetur adipiscing elit."
            style="@style/CustomTextStylePoppinsMedium"
            android:textSize="@dimen/fifteen" />

    </LinearLayout>

</androidx.cardview.widget.CardView>