<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/five"
    android:layout_marginEnd="@dimen/five"
    android:elevation="@dimen/four"
    android:orientation="vertical">

    <!-- Title row: Title + circular image -->
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/notification_title"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:ellipsize="end"
            android:maxLines="2"
            android:text="School Chimes"
            android:textColor="@color/black"
            android:textSize="@dimen/sixteen_sp" />

        <ImageView
            android:id="@+id/notification_icon"
            android:layout_width="60dp"
            android:layout_height="60dp"
            android:layout_marginStart="@dimen/eight"
            android:background="@drawable/circle_background_customm"
            android:padding="2dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:scaleType="centerCrop"
            android:src="@drawable/school_chimes_logo"
            android:visibility="visible" />
    </LinearLayout>

    <TextView
        android:id="@+id/notification_body"
        style="@style/CustomTextStylePoppinsMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:ellipsize="end"
        android:maxLines="3"
        android:text="This is a new message from your school"
        android:textColor="@color/black"
        android:textSize="@dimen/fourteen_sp" />

    <ImageView
        android:id="@+id/notification_imageview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/eight"
        android:scaleType="centerCrop"
        android:visibility="gone" />
</LinearLayout>
