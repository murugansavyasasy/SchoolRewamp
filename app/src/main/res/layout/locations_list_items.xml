<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rect_shadow_white"
        android:padding="@dimen/ten"
        app:layout_constraintTop_toTopOf="parent">


        <RelativeLayout
            android:id="@+id/rytDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_toStartOf="@+id/rytActions">

            <TextView

                android:id="@+id/lblPlaceName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/five"
                android:text="T.nagar"
                android:textColor="@color/bpBlue"
                android:textSize="@dimen/fifteen_sp" />

            <TextView
                android:id="@+id/lblLatLong"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblPlaceName"
                android:layout_marginTop="@dimen/five"
                android:text=""
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp" />


            <TextView
                android:id="@+id/lblDistance"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblLatLong"
                android:layout_marginTop="@dimen/five"
                android:layout_marginBottom="@dimen/ten"
                android:text="10 Meters"
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rytActions"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true">

            <ImageView
                android:id="@+id/imgEdit"
                android:layout_width="@dimen/twenty"
                android:layout_height="@dimen/twenty_five"
                android:layout_marginEnd="@dimen/ten"
                android:src="@drawable/edit_icon_blue"
                android:visibility="visible" />

            <ImageView
                android:id="@+id/imgDelete"
                android:layout_width="@dimen/twenty_five"
                android:layout_height="@dimen/twenty_five"
                android:layout_marginEnd="@dimen/ten"
                android:layout_toStartOf="@+id/imgEdit"
                android:src="@drawable/delete_icon_blue" />

        </RelativeLayout>

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>