<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rect_shadow_white"
    android:fitsSystemWindows="true">

    <TextView
        android:id="@+id/lblTitle"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:text="Hello Title"
        android:textColor="@color/black"
        android:textSize="20sp" />


    <ImageView
        android:id="@+id/options"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="15dp"
        android:layout_marginEnd="10dp"
        android:contentDescription="Calendar icon"
        android:src="@drawable/ic_more_vert" />

    <TextView
        android:id="@+id/createddate"
        style="@style/CustomTextStylePoppinsMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignTop="@id/options"
        android:layout_marginEnd="10dp"
        android:layout_toStartOf="@id/options"
        android:text="21/05/2025"
        android:textColor="@color/grey"
        android:textSize="13sp"
        android:visibility="gone" />


    <TextView
        android:id="@+id/lblDescription"
        style="@style/CustomTextStylePoppinsMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lblTitle"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:text="Experiment with solar power building and connection between them is the real power"
        android:textColor="@color/clr_grey_dark"
        android:textSize="13sp" />


    <LinearLayout
        android:id="@+id/lnrSendBy"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lblDescription"
        android:layout_marginTop="@dimen/ten"
        android:orientation="horizontal"
        android:visibility="gone"
        android:weightSum="1">

        <TextView
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_weight="0.6"
            android:text="@string/send_by"
            android:textColor="@color/navi_blue3"
            android:textSize="@dimen/thirteen_sp">

        </TextView>

        <TextView
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=" : "
            android:textColor="@color/black"
            android:textSize="@dimen/thirteen_sp">

        </TextView>

        <TextView
            android:id="@+id/lblSendby"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:layout_weight="0.5"
            android:text="Abi"
            android:textColor="@color/black"
            android:textSize="@dimen/thirteen_sp">

        </TextView>
    </LinearLayout>


    <TextView
        android:id="@+id/lblassigned"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lnrSendBy"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:background="@drawable/rect_shadow_light_green1"
        android:padding="8dp"
        android:text="Assigned - 03/07/2025"
        android:textColor="@color/dark_blue_1"
        android:textSize="13sp" />


    <TextView
        android:id="@+id/lblCategory"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lnrSendBy"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginBottom="10dp"
        android:layout_toEndOf="@+id/lblassigned"
        android:background="@drawable/rect_light_grey"
        android:padding="8dp"
        android:text="GENERAL"
        android:textColor="@color/clr_grey_dark"
        android:textSize="13sp" />





    <RelativeLayout
        android:id="@+id/relative_layout1"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/lblCategory"
        android:layout_marginStart="10dp"
        android:layout_marginTop="5dp"
        android:layout_marginBottom="@dimen/ten">

        <TextView
            android:id="@+id/lblSubject"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rect_shadow_light_green1"
            android:gravity="center"
            android:padding="8dp"
            android:text="TAMIL"
            android:textColor="@color/dark_blue_1"
            android:textSize="13sp">
        </TextView>


        <TextView
            android:id="@+id/lbldeadline"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_toEndOf="@+id/lblSubject"
            android:background="@drawable/rect_shadow_light_yellow1"
            android:gravity="center"
            android:padding="8dp"
            android:text="Deadline 04-07-2025"
            android:textColor="@color/dark_orange"
            android:textSize="13sp">
        </TextView>
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/lblassignmentprogress"
        android:text="Assignment Progress"
        android:textColor="@color/black"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_below="@+id/relative_layout1"
        android:layout_marginStart="10dp"
        android:textSize="15sp"/>


    <ProgressBar
        android:id="@+id/progressBarAssignment"
        style="?android:attr/progressBarStyleHorizontal"
        android:layout_width="match_parent"
        android:layout_height="8dp"
        android:progressDrawable="@drawable/progress_bar_assignment"
        android:progress="30"
        android:max="100"
        android:layout_below="@+id/lblassignmentprogress"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="8dp"/>



    <LinearLayout
        android:id="@+id/rytList"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/progressBarAssignment"
        android:layout_marginStart="5dp"
        android:layout_marginBottom="2dp"
        android:orientation="horizontal">

        <RelativeLayout
            android:id="@+id/rytList2"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginBottom="10dp"
            android:minHeight="60dp"
            android:orientation="horizontal"
            android:visibility="gone">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcyAssignment"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:paddingStart="5dp"
                android:paddingEnd="5dp" />

            <TextView
                android:id="@+id/total_numbers"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:layout_centerVertical="true"
                android:layout_marginStart="-15dp"
                android:layout_marginTop="10dp"
                android:layout_marginEnd="5dp"
                android:layout_marginBottom="10dp"
                android:layout_toEndOf="@id/rcyAssignment"
                android:background="@drawable/bg_image_background_white_coupon"
                android:gravity="center"
                android:text=""
                android:textColor="@color/black"
                android:textSize="15sp" />

        </RelativeLayout>


        <ImageView
            android:id="@+id/video_player"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/bg_image_background_white_coupon"
            android:scaleType="fitXY"
            android:src="@drawable/video_play"
            android:visibility="gone"
            app:shapeAppearanceOverlay="@style/RoundedSquare" />

        <ProgressBar
            android:id="@+id/loadingBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:indeterminateDrawable="@drawable/progress_bar_white"
            android:indeterminateOnly="true"
            android:visibility="gone">

        </ProgressBar>

        <View
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_weight="1" />


        <ImageView
            android:id="@+id/arrow_icon"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="10dp"
            android:layout_marginEnd="20dp"
            android:layout_marginBottom="10dp"
            android:background="@drawable/dark_pink_background"
            android:paddingStart="10dp"
            android:paddingTop="8dp"
            android:paddingEnd="10dp"
            android:paddingBottom="8dp"
            android:src="@drawable/arrow_right_white"
            android:visibility="gone" />

    </LinearLayout>





    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rytList"
        android:layout_centerHorizontal="false"
        android:layout_marginTop="5dp"
        android:layout_marginStart="10dp"
        android:layout_marginBottom="@dimen/ten">

        <TextView
            android:id="@+id/lblSubmitted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:background="@drawable/rect_shadow_light_yellow1"
            android:gravity="center"
            style="@style/CustomTextStylePoppinsBold"
            android:padding="8dp"
            android:text="@string/submitted"
            android:textColor="@color/dark_orange"
            android:textSize="@dimen/thirteen_sp">
        </TextView>


        <TextView
            android:id="@+id/lblNotSubmitted"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_toEndOf="@+id/lblSubmitted"
            android:background="@drawable/rect_shadow_light_yellow1"
            android:gravity="center"
            android:padding="8dp"
            android:text="NotSubmitted : 1"
            android:textColor="@color/dark_orange"
            android:textSize="@dimen/thirteen_sp"
            style="@style/CustomTextStylePoppinsBold">
        </TextView>



    </RelativeLayout>

</RelativeLayout>
