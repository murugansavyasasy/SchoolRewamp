<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/header_relativelayout"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/AthensGray">


    <LinearLayout
        android:id="@+id/linear_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:background="@drawable/circle_background"
        android:orientation="vertical"
        android:padding="@dimen/ten">

        <TextView
            android:id="@+id/user_name"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:text="Saran"
            android:visibility="gone"
            android:textColor="@color/black"
            android:textSize="12sp" />


        <TextView
            android:id="@+id/questionText"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:text="How are you doing im fiena and how about you everything good ?"
            android:textColor="@color/black"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/time_value"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="5dp"
            android:text="10 min ago"
            android:textColor="@color/black"
            android:textSize="10sp" />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/linear_layo212ut"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/linear_layout"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:background="@drawable/circle_answer_background"
        android:orientation="vertical"
        android:padding="@dimen/ten">


        <TextView
            android:id="@+id/answerText"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Im doing great"
            android:textColor="@color/black"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/time"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="5dp"
            android:text="5 min ago"
            android:textColor="@color/black"
            android:textSize="10sp" />


    </LinearLayout>



    <androidx.cardview.widget.CardView
        android:id="@+id/card_view"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_margin="12dp"
        android:visibility="gone"
        android:layout_below="@+id/linear_layo212ut"
        app:cardCornerRadius="18dp"
        app:cardElevation="2dp"
        android:padding="0dp">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:background="#F6F6F6"
                android:padding="14dp">

                <TextView
                    android:id="@+id/txtQuestion"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Hello Sir"
                    android:textSize="13sp"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:textColor="#000000" />

                <TextView
                    android:id="@+id/txtAskedBy"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="6dp"
                    android:text="Asked by - Amir Khan"
                    android:textSize="12sp"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:textColor="#555555" />

            </LinearLayout>

            <TextView
                android:id="@+id/txtAnswer"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Hellioo"
                android:padding="16dp"
                android:textColor="#000000"
                style="@style/CustomTextStylePoppinsBold"
                android:textSize="14sp" />

            <TextView
                android:id="@+id/txtTimestamp"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
            android:layout_marginStart="10dp"
                android:layout_marginEnd="10dp"
                android:layout_marginBottom="12dp"
                android:gravity="end"
                android:text="24 Oct 2025"
                android:textSize="12sp"
                android:textColor="#555555"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_gravity="end"/>

        </LinearLayout>

    </androidx.cardview.widget.CardView>


</RelativeLayout>