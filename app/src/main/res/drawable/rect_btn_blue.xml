<?xml version="1.0" encoding="utf-8"?>
<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Soft Drop Shadow Stack (Light and Spread Out) -->
    <item>
        <shape>
            <padding android:top="3dp" android:bottom="3dp" android:left="3dp" android:right="3dp" />
            <solid android:color="#05000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <item>
        <shape>
            <padding android:top="2dp" android:bottom="2dp" android:left="2dp" android:right="2dp" />
            <solid android:color="#0A000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <item>
        <shape>
            <padding android:top="1dp" android:bottom="1dp" android:left="1dp" android:right="1dp" />
            <solid android:color="#10000000" />
            <corners android:radius="10dp" />
        </shape>
    </item>

    <!-- Main Background -->
    <item>
        <shape>
            <solid android:color="@color/sky_blue0" />
            <corners android:radius="10dp" />
        </shape>
    </item>

</layer-list>

