<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">
    <androidx.cardview.widget.CardView
        android:id="@+id/CardSelectDate"
        android:layout_width="match_parent"
        android:layout_marginStart="@dimen/ten"
        app:cardCornerRadius="@dimen/fifteen"
        android:layout_marginEnd="@dimen/ten"
        android:layout_height="wrap_content">
        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/selectDate"
                android:layout_marginStart="@dimen/ten"
                android:layout_width="match_parent"
                android:text="Select Date"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/ten"
                android:textStyle="bold"
                android:drawableStart="@drawable/calendar"
                android:textSize="@dimen/twenty_sp"
                android:drawablePadding="@dimen/ten"
                android:textColor="@color/black"
                android:layout_height="wrap_content">
            </TextView>
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/SelectDateRecyclerView"
                android:layout_marginTop="@dimen/twenty"
                android:layout_width="match_parent"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginEnd="@dimen/ten"
                android:layout_marginBottom="@dimen/fifteen"
                android:layout_height="wrap_content">

            </androidx.recyclerview.widget.RecyclerView>
        </LinearLayout>

    </androidx.cardview.widget.CardView>

    <androidx.cardview.widget.CardView
        android:id="@+id/card_search_subject"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:layout_below="@+id/CardSelectDate"
        android:layout_marginTop="@dimen/ten"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:cardCornerRadius="@dimen/twenty"
        >
        <Spinner
            android:id="@+id/search_subject"
            android:padding="@dimen/ten"
            android:layout_width="match_parent"
            android:minHeight="@dimen/fifty"
            android:spinnerMode="dropdown"
            android:layout_marginStart="@dimen/fifteen"
            android:layout_marginEnd="@dimen/fifteen"
            android:layout_height="wrap_content">
        </Spinner>
    </androidx.cardview.widget.CardView>

    <androidx.recyclerview.widget.RecyclerView
        android:layout_marginStart="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:id="@+id/parent_meeting"
        android:layout_below="@+id/card_search_subject"
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/fifteen"
        android:layout_height="wrap_content">
    </androidx.recyclerview.widget.RecyclerView>

</RelativeLayout>