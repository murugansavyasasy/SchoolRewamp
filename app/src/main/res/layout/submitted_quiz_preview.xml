<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/very_light_grey">


    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="@dimen/zero"
        android:layout_height="@dimen/zero"
        android:background="@color/PrimaryColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/parent_side_tool_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground" />

    <TextView
        android:id="@+id/lblParentToolBar"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/five"
        android:layout_marginTop="@dimen/ten"
        android:paddingStart="@dimen/sixteen"
        android:text="@string/quiz_submission"
        android:textAlignment="viewStart"
        android:textColor="@color/black"
        android:textSize="@dimen/twenty"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarLayout">

    </TextView>


    <androidx.core.widget.NestedScrollView
        android:layout_width="@dimen/zero"
        android:layout_height="@dimen/zero"
        android:layout_below="@+id/lblParentToolBar"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/lblParentToolBar">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/sixteen"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/sixteen"
                android:background="@drawable/white_bg_card"
                android:orientation="vertical">

                <FrameLayout
                    android:layout_width="@dimen/hundred"
                    android:layout_height="@dimen/hundred"
                    android:layout_gravity="center">

                    <ProgressBar
                        android:id="@+id/quizPercent"
                        style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Horizontal"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:indeterminate="false"
                        android:max="100"
                        android:progress="100"
                        android:progressDrawable="@drawable/progress_circle"
                        android:rotation="270" />

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:gravity="center"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/lblQuizPercent"
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:maxLength="4"
                            android:text="100"
                            android:textColor="@color/PrimaryColor"
                            android:textSize="@dimen/eighteen_sp" />

                        <TextView
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/three"
                            android:text="%"
                            android:textColor="@color/PrimaryColor"
                            android:textSize="@dimen/fourteen_sp" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/lblMessage"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ten"
                    android:gravity="center"
                    android:text="Great Job"
                    android:textSize="@dimen/seventeen_sp"></TextView>

                <TextView
                    android:id="@+id/lblCompletedAt"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/five"
                    android:gravity="center"
                    android:text="Completed at :04.00 Am"
                    android:textColor="@color/mild_grey_dark"></TextView>

                <TextView
                    android:id="@+id/lblSubjectTitle"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/five"
                    android:gravity="center"
                    android:text="Maths Quiz"
                    android:textColor="@color/mild_grey_dark"></TextView>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:layout_marginHorizontal="@dimen/fourty"
                    android:layout_marginTop="@dimen/five"
                    android:weightSum="2">


                    <TextView
                        android:id="@+id/lblCorrectAnswer"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/five"
                        android:layout_weight="1"
                        android:background="@drawable/gray_bg_radius"
                        android:drawableStart="@drawable/correct_answer"
                        android:drawablePadding="@dimen/five"
                        android:gravity="center_vertical"
                        android:padding="@dimen/five"
                        android:text="Correct : 15/20"
                        android:textColor="@color/green"
                        android:textSize="@dimen/eleven_sp"></TextView>

                    <TextView
                        android:id="@+id/lblWrongAnswer"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/five"
                        android:layout_weight="1"
                        android:background="@drawable/gray_bg_radius"
                        android:drawableStart="@drawable/wrong_answer"
                        android:drawablePadding="@dimen/five"
                        android:gravity="center_vertical"
                        android:padding="@dimen/five"
                        android:text="Wrong : 03/20"
                        android:textColor="@color/red"
                        android:textSize="@dimen/eleven_sp"></TextView>

                </LinearLayout>

                <TextView
                    android:layout_gravity="center"
                    android:id="@+id/lblNotAnswer"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/gray_bg_radius"
                    android:drawableStart="@drawable/not_answered"
                    android:drawablePadding="@dimen/five"
                    android:gravity="center_vertical"
                    android:paddingHorizontal="@dimen/ten"
                    android:paddingVertical="@dimen/five"
                    android:layout_marginTop="@dimen/five"
                    android:text="Not Answer : 02/20"
                    android:textColor="@color/orange"
                    android:textSize="@dimen/eleven_sp"></TextView>

            </LinearLayout>

            <View
                android:layout_width="match_parent"
                android:layout_height="@dimen/one"
                android:layout_marginStart="@dimen/sixteen"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/sixteen"
                android:background="@color/gray4">

            </View>

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcSubmitedQuiz"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten"
                android:nestedScrollingEnabled="false"
                android:paddingStart="@dimen/sixteen"
                android:paddingEnd="@dimen/sixteen"></androidx.recyclerview.widget.RecyclerView>

            <LinearLayout
                android:id="@+id/lytList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:paddingStart="@dimen/sixteen"
                android:paddingEnd="@dimen/sixteen"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/nomessage"
                    android:layout_width="@dimen/two_fifty"
                    android:layout_height="@dimen/two_fifty"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/twenty"
                    android:src="@drawable/nomessages"
                    android:textColor="@color/black"
                    android:textSize="@dimen/fifteen_sp" />

                <TextView
                    android:id="@+id/txtNoData"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/twenty"
                    android:gravity="center"
                    android:text="@string/no_list_found"
                    android:textSize="@dimen/fifteen_sp" />
            </LinearLayout>

        </LinearLayout>
    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>