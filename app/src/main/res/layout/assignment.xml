<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_white">


    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground" />


    <LinearLayout
        android:id="@+id/toolbarLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbarLayout"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:orientation="horizontal"
        android:visibility="gone"
        android:weightSum="1"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarLayout">

        <LinearLayout
            android:id="@+id/lnrTabOneName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tabOneName"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/Create"
                android:textColor="@color/iconBlue"></TextView>

            <View
                android:id="@+id/line1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/three"
                android:layout_below="@+id/groupheading"
                android:layout_marginTop="@dimen/five"
                android:background="@color/iconBlue"></View>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/lnrTabTwoName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0.5"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tabTwoName"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/Reports"></TextView>

            <View
                android:id="@+id/line3"
                android:layout_width="match_parent"
                android:layout_height="@dimen/three"
                android:layout_below="@+id/groupheading"
                android:layout_marginTop="@dimen/five"
                android:background="@color/white"></View>
        </LinearLayout>

    </LinearLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarLayout1">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/toolbarLayout1"
            android:layout_marginTop="@dimen/ten"
            android:visibility="visible">


            <RelativeLayout
                android:id="@+id/rytTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten">

                <TextView
                    android:id="@+id/lblStar8"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/two"
                    android:layout_toEndOf="@id/lblCategory"
                    android:text="@string/mandatory"
                    android:textColor="@color/red" />

                <TextView
                    android:id="@+id/lblCategory"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Catogory">

                </TextView>


                <RelativeLayout
                    android:id="@+id/rytHistory"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/fifteen"
                    android:paddingHorizontal="@dimen/ten">

                    <ImageView
                        android:id="@+id/imgHistory"
                        android:layout_width="@dimen/twenty"
                        android:layout_height="@dimen/twenty"
                        android:layout_centerVertical="true"
                        android:layout_marginTop="@dimen/ten"
                        android:layout_marginEnd="@dimen/five"
                        android:backgroundTint="@color/PrimaryColor"
                        android:src="@drawable/ic_history">

                    </ImageView>

                    <TextView
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_toEndOf="@+id/imgHistory"
                        android:text="@string/history"
                        android:textColor="@color/PrimaryColor" />

                </RelativeLayout>

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rytSendingType"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rytTitle"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginEnd="@dimen/ten"
                android:background="@drawable/rect_shadow_white"
                android:gravity="center">


                <Spinner
                    android:id="@+id/spinnerType"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/three"
                    android:layout_toStartOf="@+id/spinnerTypeimg"
                    android:background="@null"
                    android:drawSelectorOnTop="true"
                    android:paddingVertical="@dimen/five" />

                <ImageView
                    android:id="@+id/spinnerTypeimg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/three"
                    android:src="@drawable/ic_drop_down"
                    app:tint="@color/black">

                </ImageView>


            </RelativeLayout>

            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rytSendingType"
                android:layout_marginStart="@dimen/two"
                android:layout_marginTop="8dp"
                android:layout_toEndOf="@id/lblTitle"
                android:text="@string/mandatory"
                android:textColor="@color/red" />


            <TextView
                android:id="@+id/lblTitle"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rytSendingType"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:text="@string/Title"></TextView>


            <LinearLayout
                android:id="@+id/lnrTitle"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fourty_five"
                android:layout_below="@+id/lblTitle"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/twenty"
                android:background="@drawable/field_background"
                android:gravity="center_vertical"
                android:orientation="horizontal">


                <EditText
                    android:id="@+id/edtTitle"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:hint="@string/enter_title"
                    android:paddingHorizontal="@dimen/ten">


                </EditText>

            </LinearLayout>

            <TextView
                android:id="@+id/lblTitleTextCount"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lnrTitle"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/five"
                android:layout_marginEnd="@dimen/fifteen"
                android:text="0 / 50"
                android:textColor="@color/light_gray"
                android:visibility="gone">

            </TextView>

            <TextView
                android:id="@+id/lblDescription"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblTitleTextCount"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:text="@string/Description">

            </TextView>

            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblTitleTextCount"
                android:layout_marginStart="@dimen/two"
                android:layout_marginTop="@dimen/eight"
                android:layout_toEndOf="@id/lblDescription"
                android:text="@string/mandatory"
                android:textColor="@color/red" />


            <LinearLayout
                android:id="@+id/lnrDesc"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hundred"
                android:layout_below="@+id/lblDescription"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/fifteen"
                android:layout_marginEnd="@dimen/twenty"
                android:background="@drawable/field_background"
                android:orientation="horizontal">


                <EditText
                    android:id="@+id/edtDescription"
                    style="@style/CustomTextStylePoppinsRegular"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:background="@android:color/transparent"
                    android:ellipsize="none"
                    android:gravity="start|top"
                    android:hint="@string/Enterdescription"
                    android:inputType="textMultiLine|textCapSentences"
                    android:overScrollMode="always"
                    android:padding="@dimen/ten"
                    android:scrollbars="vertical"
                    android:singleLine="false"
                    android:text=""
                    android:textSize="@dimen/thirteen_sp" />


            </LinearLayout>


            <TextView
                android:id="@+id/lblTextCount"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lnrDesc"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/fifteen"
                android:text="0 / 500"
                android:textColor="@color/light_gray"
                android:visibility="gone">

            </TextView>


            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblTextCount"
                android:layout_marginTop="@dimen/eight"
                android:layout_toEndOf="@id/lblSubDate"
                android:text="@string/mandatory"
                android:textColor="@color/red" />


            <TextView
                android:id="@+id/lblSubDate"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblTextCount"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/ten"
                android:text="@string/SubmissionDate">

            </TextView>

            <LinearLayout
                android:id="@+id/rytStart1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblSubDate"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/twenty"
                android:background="@drawable/field_background"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/ten"
                android:paddingVertical="@dimen/eight"
                android:weightSum="1">

                <RelativeLayout
                    android:id="@+id/rlaStartDate"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="0.65">

                    <RelativeLayout
                        android:id="@+id/rytStartDate"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/imgCalendar"
                            android:layout_width="@dimen/fourty"
                            android:layout_height="@dimen/fourty"
                            android:layout_alignParentStart="true"
                            android:layout_centerVertical="true"
                            android:background="@drawable/rect_purple_rounded"
                            android:padding="@dimen/ten"
                            android:src="@drawable/white_calendar_icon">

                        </ImageView>

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/five"
                            android:layout_toEndOf="@+id/imgCalendar"
                            android:orientation="vertical">

                            <TextView
                                android:id="@+id/lblDay"
                                style="@style/CustomTextStylePoppinsRegular"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="@color/mild_grey_dark"></TextView>

                            <TextView
                                android:id="@+id/txtStartDate"
                                style="@style/CustomTextStylePoppinsBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/three"
                                android:text="jasjdknsdjnkj"></TextView>
                        </LinearLayout>

                    </RelativeLayout>
                </RelativeLayout>

                <RelativeLayout
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="0.35"
                    android:gravity="center|end"
                    android:visibility="gone">

                    <RelativeLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:background="@drawable/rect_black_stoke_bg"
                        android:paddingHorizontal="@dimen/five"
                        android:paddingVertical="@dimen/five">

                        <ImageView
                            android:id="@+id/imgTimeDown"
                            android:layout_width="@dimen/twenty"
                            android:layout_height="@dimen/twenty"
                            android:layout_centerVertical="true"
                            android:src="@drawable/clock" />

                        <TextView
                            android:id="@+id/lblTimePick"
                            style="@style/CustomTextStylePoppinsMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/five"
                            android:layout_toEndOf="@+id/imgTimeDown"
                            android:text=""
                            android:textColor="@color/black"
                            android:textSize="@dimen/thirteen_sp" />

                    </RelativeLayout>
                </RelativeLayout>

            </LinearLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/rytStart1"
                android:layout_marginTop="@dimen/five">

                <TextView
                    android:id="@+id/lblAddPhoto"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/twenty"
                    android:layout_marginTop="@dimen/ten"
                    android:text="@string/add_attachment"
                    android:textColor="@color/black">

                </TextView>

                <TextView
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/eight"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_toEndOf="@+id/lblAddPhoto"
                    android:text="@string/Optional"
                    android:textColor="@color/mild_grey1"
                    android:textSize="@dimen/thirteen_sp">

                </TextView>

                <ImageView
                    android:layout_width="@dimen/twenty_five"
                    android:layout_height="@dimen/twenty_five"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/twenty"
                    android:src="@drawable/ic_attach_file"
                    android:visibility="invisible">

                </ImageView>

                <RelativeLayout
                    android:id="@+id/rytRecyclewview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lblAddPhoto">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rcyImages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ten"
                        android:orientation="vertical">

                    </androidx.recyclerview.widget.RecyclerView>
                </RelativeLayout>


                <TextView
                    android:id="@+id/btnChooseRecipient"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/rytRecyclewview"
                    android:layout_marginStart="@dimen/twenty_five"
                    android:layout_marginTop="@dimen/fifty"
                    android:layout_marginEnd="@dimen/twenty_five"
                    android:layout_marginBottom="@dimen/thirty"
                    android:background="@drawable/rect_btn_orange"
                    android:gravity="center"
                    android:padding="@dimen/ten"
                    android:text="@string/ChooseRecipients"
                    android:textColor="@color/white"
                    android:textSize="@dimen/thirteen_sp">

                </TextView>
            </RelativeLayout>

        </RelativeLayout>
    </ScrollView>

</androidx.constraintlayout.widget.ConstraintLayout>