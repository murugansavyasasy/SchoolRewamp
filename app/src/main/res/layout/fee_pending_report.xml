<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent">

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar" />


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/relative_layout8"
        android:layout_below="@+id/toolbarLayout"
        android:weightSum="2"
        android:gravity="center_vertical"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:layout_marginTop="15dp"
        android:background="@drawable/bg_light_blue">


        <TextView
            android:id="@+id/category_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/white_radious"
            android:layout_weight="1"
            android:gravity="center"
            android:text="CATEGORY WISE"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_marginStart="2dp"
            android:padding="@dimen/eight"
            style="@style/CustomTextStylePoppinsBold">
        </TextView>

        <TextView
            android:id="@+id/class_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="CLASS WISE"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:layout_weight="1"
            android:layout_marginTop="2dp"
            android:layout_marginBottom="2dp"
            android:layout_marginStart="2dp"
            android:layout_marginEnd="2dp"
            android:padding="@dimen/eight"
            android:gravity="center"
            style="@style/CustomTextStylePoppinsBold">
        </TextView>

    </LinearLayout>

    <LinearLayout
            android:id="@+id/AcademicYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
        android:layout_below="@+id/relative_layout8"
            android:orientation="horizontal"
        android:layout_marginStart="@dimen/fifteen"
        android:layout_marginTop="@dimen/fifteen"
        android:layout_marginEnd="@dimen/fifteen"
        android:background="@drawable/gray_bg_radius"
        android:weightSum="1">

            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fifteen"
                android:layout_weight="0.5"
                android:text="@string/academic_year"
                android:textSize="@dimen/thirteen_sp">

            </TextView>

        <RelativeLayout
            android:id="@+id/rytAcademicYearDropDown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fifteen"
            android:layout_marginEnd="@dimen/fifteen"
            android:layout_weight="0.5"
            android:gravity="center">

            <Spinner
                android:id="@+id/isSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/custom_spinner_background" />

        </RelativeLayout>
        </LinearLayout>

    <RelativeLayout
        android:id="@+id/relative_layout5"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/AcademicYear"
        android:layout_centerInParent="true"
        android:layout_marginTop="8dp">

        <TextView
            android:id="@+id/totalcollectionlabel"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerHorizontal="true"
            android:gravity="center"
            android:text="Total Pending"
            android:textColor="@color/grey"
            android:textSize="13sp" />

        <TextView
            android:id="@+id/total_collection"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/totalcollectionlabel"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="8dp"
            android:gravity="center"
            android:text="88,000.00"
            android:textColor="@color/black"
            android:textSize="25sp" />
    </RelativeLayout>

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/paymenthistorylabel"
        android:text="Payment history"
        android:textColor="@color/light_gray"
        style="@style/CustomTextStylePoppinsMedium"
        android:textSize="13sp"
        android:layout_marginStart="5dp"
        android:layout_below="@+id/relative_layout5"
        android:layout_alignStart="@+id/lytList"
        android:layout_marginTop="8dp"/>



    <LinearLayout
        android:id="@+id/lytList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/paymenthistorylabel"
        android:layout_marginStart="7dp"
        android:layout_marginEnd="7dp"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/totalsummary1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/relative_layout8"
            android:layout_marginTop="@dimen/ten">
        </androidx.recyclerview.widget.RecyclerView>

        <ImageView
            android:id="@+id/nomessage"
            android:layout_width="@dimen/two_fifty"
            android:layout_height="@dimen/two_fifty"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/twenty"
            android:src="@drawable/nomessages"
            android:textColor="@color/black"
            android:textSize="@dimen/fifteen_sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtNoData"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/twenty"
            android:text="@string/no_list_found"
            android:textColor="@color/black"
            android:textSize="18sp"
            android:gravity="center"
            android:visibility="gone" />

    </LinearLayout>



</RelativeLayout>