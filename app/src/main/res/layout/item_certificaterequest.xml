<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:fitsSystemWindows="true"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/relative_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginBottom="@dimen/ten"
        android:background="@drawable/rect_shadow_white"
        android:gravity="center_vertical"
        android:padding="@dimen/twenty">

        <RelativeLayout
            android:id="@+id/rytStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_leave_approved"
            android:padding="@dimen/five">

            <ImageView
                android:id="@+id/icon"
                android:layout_width="12dp"
                android:layout_height="12dp"
                android:src="@drawable/checkimage"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>

            <TextView
                android:id="@+id/lblStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/approved"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/icon"
                android:layout_marginStart="@dimen/ten"
                android:textColor="@color/white"
                android:textSize="@dimen/thirteen_sp"
                android:textStyle="normal"/>
        </RelativeLayout>



        <LinearLayout
            android:id="@+id/linear_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rytStatus"
            android:layout_marginTop="@dimen/ten"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/certificatetype"
                android:layout_width="@dimen/zero"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/certificate_type"
                android:textColor="@color/black"
                style="@style/CustomTextStylePoppinsBold"
                android:textSize="@dimen/thirteen_sp"
                />

            <TextView
                android:id="@+id/certificate_value"
                android:layout_width="@dimen/zero"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text=": Attendance Type"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp"
                android:gravity="start"
                android:maxLines="3"
                android:ellipsize="end" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/linear_layout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/linear_layout"
            android:layout_marginTop="@dimen/thirteen"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/lblReason"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/reason"
                android:textColor="@color/black"
                style="@style/CustomTextStylePoppinsBold"
                android:textSize="@dimen/thirteen_sp" />

            <TextView
                android:id="@+id/reason_value"
                android:layout_width="@dimen/zero"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text=": I need this  to apply for the education loan for my studies"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp"
                android:gravity="start"
                android:ellipsize="end" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear_layout2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/linear_layout1"
            android:layout_marginTop="@dimen/thirteen"
            android:orientation="horizontal">

            <TextView
                android:id="@+id/created_on"
                android:layout_width="@dimen/zero"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/created_on"
                android:textColor="@color/black"
                style="@style/CustomTextStylePoppinsBold"
                android:textSize="@dimen/thirteen_sp" />

            <TextView
                android:id="@+id/created_value"
                android:layout_width="@dimen/zero"
                android:layout_height="wrap_content"
                android:layout_weight="2"
                android:text=": 21 Jan 2024"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp"
                android:gravity="start"
                android:maxLines="100"
                android:ellipsize="end" />
        </LinearLayout>


        <RelativeLayout
            android:id="@+id/linear_layout8"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_below="@id/linear_layout2"
            android:padding="@dimen/ten">

            <ImageView
                android:id="@+id/icon3"
                android:layout_width="@dimen/seventeen"
                android:layout_height="@dimen/seventeen"
                android:src="@drawable/downloadicon"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"/>

            <TextView
                android:id="@+id/certificate_value7"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/download"
                android:layout_centerVertical="true"
                android:layout_toEndOf="@id/icon3"
                android:layout_marginStart="@dimen/five"
                android:textColor="@color/sky_blue0"
                android:textSize="@dimen/fifteen_sp"
                android:textStyle="bold"/>
        </RelativeLayout>


    </RelativeLayout>
</RelativeLayout>