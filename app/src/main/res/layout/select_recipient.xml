<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:background="@color/mild_grey5"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/rlaTitle"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/five">

        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="@dimen/thirty_five"
            android:layout_height="@dimen/thirty_five"
            android:layout_centerVertical="true"
            android:src="@drawable/left_arrow_blue">
        </ImageView>

        <TextView
            android:id="@+id/lblSchoolName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_toEndOf="@+id/imgBack"
            android:text="@string/select_recipient"
            android:textColor="@color/navi_blue2"
            android:textStyle="bold">

        </TextView>

        <TextView
            android:id="@+id/lblSchoolRegionalName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/imgBack"
            android:layout_marginEnd="@dimen/ten"
            android:layout_below="@+id/lblSchoolName"
            android:visibility="gone"
            android:layout_marginStart="@dimen/twele"
            android:text=""
            android:textColor="@color/black"
            style="@style/CustomTextStylePoppinsMedium"
            android:textSize="@dimen/thirteen_sp">

        </TextView>

    </RelativeLayout>

    <TextView
        android:id="@+id/sendlabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rlaTitle"
        android:layout_marginStart="@dimen/ten"
        android:text="@string/send_to"
        android:textColor="@color/black"
        android:textSize="@dimen/fifteen_sp"
        android:visibility="gone"
        android:textStyle="normal" />

    <LinearLayout
        android:id="@+id/linearlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/sendlabel"
        android:layout_marginStart="@dimen/fifteen"
        android:layout_marginTop="@dimen/five"
        android:layout_marginEnd="@dimen/fifteen"
        android:visibility="visible"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvAcademicYearLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose academic year:"
            android:textColor="@color/light_gray"
            android:textSize="@dimen/thirteen_sp"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_marginEnd="@dimen/ten"/>

        <RelativeLayout
            android:id="@+id/rlaAcademicYear"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@drawable/rect_white_light_radious"
            android:padding="@dimen/ten"
            android:visibility="visible">

            <TextView
                android:id="@+id/lblAcademicYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:fontFamily="@font/poppins_bold"
                android:text=""
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgAcademicYear"
                android:layout_width="@dimen/fifteen"
                android:layout_height="@dimen/twenty"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/ten"
                android:src="@drawable/downarrow" />

        </RelativeLayout>
    </LinearLayout>


    <com.google.android.material.tabs.TabLayout
        android:id="@+id/tabLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@id/linearlayout"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:background="@drawable/rect_light_gray"
        app:tabBackground="@drawable/tab_selector"
        app:tabIndicatorHeight="0dp"
        app:tabMode="fixed"
        app:tabRippleColor="@color/mild_grey1"
        app:tabTextAppearance="@style/TabTextStyle" />


    <TextView
        android:id="@+id/grouplabel"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tabLayout"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_marginTop="@dimen/twenty"
        android:text="Group"
        android:layout_marginStart="@dimen/twenty"
        android:textColor="@color/black"
        android:textSize="@dimen/fifteen_sp"
        android:visibility="gone" />

    <RelativeLayout
        android:id="@+id/rlaStandard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/grouplabel"
        android:layout_marginStart="@dimen/fifteen"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginEnd="@dimen/fifteen"
        android:background="@drawable/rect_white_light_radious"
        android:padding="@dimen/ten"
        android:visibility="gone">


        <ImageView
            android:id="@+id/imgStandard"
            android:layout_width="@dimen/fifteen"
            android:layout_height="@dimen/twenty"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/ten"
            android:src="@drawable/downarrow">

        </ImageView>

        <TextView
            android:id="@+id/lblStandard"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/fifteen"
            android:fontFamily="@font/poppins_bold"
            android:text=""
            android:textColor="@color/black"
            android:textSize="@dimen/thirteen_sp"
            android:textStyle="bold">

        </TextView>
    </RelativeLayout>

    <CheckBox
        android:id="@+id/chAllSelect"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rlaStandard"
        android:layout_marginTop="@dimen/ten"
        android:visibility="gone"
        style="@style/CustomCheckBox"
        android:layout_marginStart="@dimen/fifteen"
        android:text="Select all"
        android:textColor="@color/black"
        android:textSize="@dimen/fifteen_sp"
        android:textStyle="bold">

    </CheckBox>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/chAllSelect"
        android:layout_marginStart="@dimen/twenty"
        android:layout_marginTop="@dimen/ten"
        android:layout_above="@+id/bottomLayout"
        android:layout_marginEnd="@dimen/twenty"
        android:layout_marginBottom="@dimen/ten"
        android:background="@drawable/rect_white"
        android:visibility="gone">

    </androidx.recyclerview.widget.RecyclerView>

    <RelativeLayout
        android:id="@+id/rlaSubject"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/recyclerView"
        android:layout_marginStart="@dimen/fifteen"
        android:layout_marginTop="-40dp"
        android:layout_marginEnd="@dimen/fifteen"
        android:background="@drawable/bg_stroke_rect_black"
        android:padding="@dimen/ten"
        android:visibility="gone">


        <ImageView
            android:id="@+id/imgSubject"
            android:layout_width="@dimen/twenty_five"
            android:layout_height="@dimen/twenty_five"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:layout_marginEnd="@dimen/ten"
            android:src="@drawable/ic_down_arrow">

        </ImageView>

        <TextView
            android:id="@+id/lblSuibject"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/fifteen"
            android:fontFamily="@font/poppins_bold"
            android:text="Select Subject"
            android:textColor="@color/black"
            android:textSize="@dimen/thirteen_sp"
            android:textStyle="bold">

        </TextView>
    </RelativeLayout>


    <TextView
        android:id="@+id/textdesc"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/tabLayout"
        style="@style/CustomTextStylePoppinsBold"
        android:gravity="center"
        android:padding="16dp"
        android:text="@string/click_the_send_button_to_send_an_important_announcement_from_entier_school"
        android:textColor="@color/black"
        android:textSize="@dimen/fifteen_sp"
        android:visibility="gone" />

    <LinearLayout
        android:id="@+id/bottomLayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginBottom="@dimen/five"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/five">


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/twenty"
            android:layout_marginEnd="@dimen/twenty"
            android:gravity="center"
            android:orientation="horizontal"
            android:weightSum="1">

            <Button
                android:id="@+id/btnSpecificStudent"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_weight="0.5"
                android:background="@drawable/bg_gray"
                android:gravity="center"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginEnd="@dimen/twenty"
                android:enabled="false"
                android:text="@string/specific_student"
                android:textColor="@color/white"
                android:textSize="@dimen/thirteen_sp"
                android:textStyle="bold"
                android:visibility="gone" />

            <Button
                android:id="@+id/btnSend"
                android:layout_width="match_parent"
                android:layout_height="40dp"
                android:layout_marginStart="@dimen/twenty_five"
                android:layout_marginEnd="@dimen/twenty_five"
                android:layout_weight="0.5"
                android:background="@drawable/bg_orange"
                android:gravity="center"
                android:text="@string/send"
                android:textColor="@color/white"
                android:textSize="@dimen/thirteen_sp"
                android:textStyle="bold" />


        </LinearLayout>

    </LinearLayout>

    <TextView
        android:id="@+id/lblNoRecord"
        android:layout_width="match_parent"
        android:textColor="@color/black"
        android:visibility="gone"
        android:textSize="@dimen/fifteen_sp"
        style="@style/CustomTextStylePoppinsBold"
        android:gravity="center"
        android:layout_centerInParent="true"
        android:layout_height="wrap_content">

    </TextView>

</RelativeLayout>
