<layer-list xmlns:android="http://schemas.android.com/apk/res/android">

    <!-- Shadow/background layer -->
    <item
        android:left="2dp"
        android:top="2dp">
        <shape>
            <solid android:color="#ffefd9" /> <!-- Simulated shadow -->
            <corners android:radius="8dp" />
        </shape>
    </item>

    <!-- Actual button layer -->
    <item>
        <shape>
            <solid android:color="#ffefd9" />
            <corners android:radius="8dp" />
            <stroke
                android:width="1dp"
                android:color="#ffefd9" /> <!-- Slight border for depth -->
        </shape>
    </item>

</layer-list>
