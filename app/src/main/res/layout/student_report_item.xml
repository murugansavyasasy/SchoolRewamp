<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/five"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginEnd="@dimen/five"
        android:background="@drawable/rect_shadow_white">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_student_report">

            <View
                android:layout_width="@dimen/fifty"
                android:layout_height="@dimen/twenty"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/ten"
                android:background="@drawable/bg_oval_shape"></View>

            <RelativeLayout
                android:id="@+id/rlaBioData"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/five"
                android:layout_marginTop="@dimen/fifteen"
                android:layout_marginEnd="@dimen/ten">

                <ImageView
                    android:id="@+id/imgStudent"
                    android:layout_width="@dimen/hundred"
                    android:layout_height="@dimen/one_ten"
                    android:background="@drawable/rect_shadow_white"></ImageView>

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/imgStudent">

                    <LinearLayout
                        android:id="@+id/lnrAdmission"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ten"
                        android:orientation="horizontal"
                        android:weightSum="1">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ten"
                            android:layout_weight="0.5"
                            style="@style/CustomTextStylePoppinsMedium1"
                            android:text="@string/Admissionno"
                            android:textColor="@color/black"
                           >

                        </TextView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" : "
                            android:textColor="@color/black"
                            style="@style/CustomTextStylePoppinsMedium1"
                            >

                        </TextView>

                        <TextView
                            android:id="@+id/lblAdmisionNumber"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ten"
                            android:layout_marginEnd="@dimen/five"
                            android:layout_weight="0.5"
                            style="@style/CustomTextStylePoppinsMedium1"
                            android:text="1785278272"
                            android:textColor="@color/black"
                            >

                        </TextView>
                    </LinearLayout>

                    <LinearLayout
                        android:id="@+id/lnrAge"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/lnrAdmission"
                        android:layout_marginTop="@dimen/five"
                        android:orientation="horizontal"
                        android:weightSum="1">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ten"
                            android:layout_weight="0.5"
                            style="@style/CustomTextStylePoppinsMedium1"
                            android:text="@string/Gender"
                            android:textColor="@color/black"
                            >

                        </TextView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" : "
                            android:textColor="@color/black"
                            style="@style/CustomTextStylePoppinsMedium1"
                            >

                        </TextView>

                        <TextView
                            android:id="@+id/lblGender"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ten"
                            android:layout_marginEnd="@dimen/five"
                            android:layout_weight="0.5"
                            style="@style/CustomTextStylePoppinsMedium1"
                            android:text="Male"
                            android:textColor="@color/black"
                            >

                        </TextView>
                    </LinearLayout>


                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/lnrAge"
                        android:layout_marginTop="@dimen/five"
                        android:orientation="horizontal"
                        android:weightSum="1">

                        <TextView
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ten"
                            android:layout_weight="0.5"
                            style="@style/CustomTextStylePoppinsMedium1"
                            android:text="@string/Dateofbirth"
                            android:textColor="@color/black"
                            >

                        </TextView>

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" : "
                            android:textColor="@color/black"
                            style="@style/CustomTextStylePoppinsMedium1"
                            >

                        </TextView>

                        <TextView
                            android:id="@+id/lblDOB"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ten"
                            android:layout_marginEnd="@dimen/five"
                            android:layout_weight="0.5"
                            style="@style/CustomTextStylePoppinsMedium1"
                            android:text="Apr 1 , 2021"
                            android:textColor="@color/black"
                            >

                        </TextView>
                    </LinearLayout>
                </RelativeLayout>
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rlaNames"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rlaBioData"
                android:layout_marginTop="@dimen/five">


                <TextView
                    android:id="@+id/lblStudentName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginEnd="@dimen/ten"
                    android:gravity="center"
                    style="@style/CustomTextStylePoppinsBold"
                    android:text="Sathish"
                    android:textColor="@color/black"
                    >

                </TextView>

                <TextView
                    android:id="@+id/lblStandardAndSection"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_below="@+id/lblStudentName"
                    android:layout_marginEnd="@dimen/ten"
                    android:gravity="center"
                    style="@style/CustomTextStylePoppinsBold"
                    android:text="II-A"
                    android:textColor="@color/black"
                    >

                </TextView>



                <LinearLayout
                    android:id="@+id/lnrFatherName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lblStandardAndSection"
                    android:layout_marginTop="@dimen/five"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_weight="0.6"
                        style="@style/CustomTextStylePoppinsMedium1"
                        android:text="@string/Fathername"
                        android:textColor="@color/black"
                        >

                    </TextView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" : "
                        style="@style/CustomTextStylePoppinsMedium1"
                        android:textColor="@color/black"
                        >

                    </TextView>

                    <TextView
                        android:id="@+id/lblFatherName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_marginEnd="@dimen/ten"
                        android:layout_weight="0.4"
                        style="@style/CustomTextStylePoppinsMedium1"
                        android:text="Ganesan"
                        android:textColor="@color/black"
                        >

                    </TextView>
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/lnrRollNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lnrTeacherName"
                    android:layout_marginTop="@dimen/five"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_weight="0.6"
                        style="@style/CustomTextStylePoppinsMedium1"
                        android:text="@string/roll_no"
                        android:textColor="@color/black"
                        >

                    </TextView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" : "
                        style="@style/CustomTextStylePoppinsMedium1"
                        android:textColor="@color/black"
                        >

                    </TextView>

                    <TextView
                        android:id="@+id/lblRollNo"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_marginEnd="@dimen/ten"
                        android:layout_weight="0.4"
                        style="@style/CustomTextStylePoppinsMedium1"
                        android:text="21"
                        android:textColor="@color/black"
                        >

                    </TextView>
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/lnrTeacherName"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lnrFatherName"
                    android:layout_marginTop="@dimen/five"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_weight="0.6"
                        style="@style/CustomTextStylePoppinsMedium1"
                        android:text="@string/class_teacher_2"
                        android:textColor="@color/black"
                        >

                    </TextView>

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" : "
                        style="@style/CustomTextStylePoppinsMedium1"
                        android:textColor="@color/black"
                      >

                    </TextView>

                    <TextView
                        android:id="@+id/lblTeacherName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_marginEnd="@dimen/ten"
                        android:layout_weight="0.4"
                        style="@style/CustomTextStylePoppinsMedium1"
                        android:text="Abi"
                        android:textColor="@color/black"
                        >

                    </TextView>
                </LinearLayout>


            </RelativeLayout>

            <RelativeLayout
                android:layout_centerInParent="true"
                android:layout_marginEnd="@dimen/five"
                android:layout_marginStart="@dimen/five"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/fifteen"
                android:layout_marginBottom="@dimen/five"
                android:layout_below="@+id/rlaNames"
                >


                <LinearLayout
                    android:id="@+id/lnrMobileNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center">

                    <ImageView
                        android:layout_width="@dimen/twenty_five"
                        android:layout_height="@dimen/twenty_five"
                        android:src="@drawable/phone_call_icon">

                    </ImageView>

                    <TextView
                        android:layout_marginStart="@dimen/five"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawablePadding="@dimen/three"
                        android:text="@string/call"
                        android:textColor="@color/navi_blue2">

                    </TextView>
                </LinearLayout>
                <LinearLayout
                    android:layout_marginStart="@dimen/thirty"
                    android:id="@+id/lnrSMS"
                    android:gravity="center"
                    android:layout_toEndOf="@+id/lnrMobileNumber"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="@dimen/twenty_five"
                        android:src="@drawable/message_icon"
                        android:layout_height="@dimen/twenty_five">
                    </ImageView>
                    <TextView
                        android:layout_marginStart="@dimen/five"
                        android:drawablePadding="@dimen/three"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/sms"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:textColor="@color/navi_blue2"
                        >
                    </TextView>
                </LinearLayout>
                <LinearLayout
                    android:gravity="center"
                    android:layout_marginStart="@dimen/thirty"
                    android:id="@+id/lnrEmail"
                    android:layout_toEndOf="@+id/lnrSMS"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">
                    <ImageView
                        android:layout_width="@dimen/twenty_five"
                        android:src="@drawable/mail_send_icon"
                        android:layout_height="@dimen/twenty_five">

                    </ImageView>

                    <TextView
                        android:layout_marginStart="@dimen/five"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:text="@string/mail"
                        android:textColor="@color/navi_blue2"
                        >

                    </TextView>
                </LinearLayout>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
</RelativeLayout>
