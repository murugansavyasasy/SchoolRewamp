<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="8dp"
    android:background="@drawable/bg_test_form_inner"
    android:orientation="vertical"
    android:padding="10dp">


    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="14dp"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <androidx.cardview.widget.CardView
            android:layout_width="28dp"
            android:layout_height="28dp"
            app:cardBackgroundColor="@color/PrimaryColor"
            app:cardCornerRadius="14dp"
            app:cardElevation="0dp">

            <TextView
                android:id="@+id/txtTestNumber"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:text="1"
                android:textColor="@color/white"
                android:textSize="12sp" />
        </androidx.cardview.widget.CardView>

        <TextView
            android:id="@+id/testlabel"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="8dp"
            android:layout_weight="1"
            android:text=""
            android:textColor="@color/PrimaryColor"
            android:textSize="14sp" />

        <ImageView
            android:id="@+id/imgDeleteTest"
            android:layout_width="20dp"
            android:layout_height="20dp"
            android:src="@drawable/delete_bin_12"
            android:visibility="gone" />

        <TextView
            android:id="@+id/removetext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:textColor="@color/red"
            android:text="Remove"
            android:visibility="gone"
            style="@style/CustomTextStylePoppinsMedium"/>


    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@drawable/ic_document"
            android:tint="#9E9E9E" />

        <TextView
            style="@style/FieldLabel"
            android:layout_marginStart="4dp"
            android:text="ACTIVITY NAME" />
    </LinearLayout>

    <EditText
        android:id="@+id/etExamName"
        style="@style/FieldInput"
        android:layout_marginBottom="12dp"
        android:inputType="textCapSentences" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/ic_calendar"
                    android:tint="#9E9E9E" />

                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginStart="4dp"
                    android:text="ACTIVITY DATE" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvTestDate"
                android:layout_width="match_parent"
                android:layout_height="41dp"
                android:layout_marginTop="4dp"
                android:background="@drawable/input_field_bg"
                android:gravity="center_vertical"
                android:hint="Select date"
                android:paddingStart="12dp"
                android:paddingEnd="12dp"
                android:textColor="#1A1A2E"
                android:textColorHint="#BDBDBD"
                android:textSize="13sp" />
        </LinearLayout>

        <!-- Session column -->
        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="13dp"
                    android:layout_height="13dp"
                    android:src="@drawable/clock_icon"
                    android:tint="#9E9E9E" />

                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginStart="4dp"
                    android:text="SESSION" />
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="41dp"
                android:layout_marginTop="4dp"
                android:orientation="horizontal">

                <TextView
                    android:id="@+id/btnSessionFN"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/session_toggle_bg"
                    android:gravity="center"
                    android:text="FN"
                    android:textColor="@color/black"
                    android:textSize="11sp" />

                <View
                    android:layout_width="10dp"
                    android:layout_height="wrap_content" />

                <TextView
                    android:id="@+id/btnSessionAN"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="0dp"
                    android:layout_height="match_parent"
                    android:layout_weight="1"
                    android:background="@drawable/session_toggle_bg"
                    android:gravity="center"
                    android:text="AN"
                    android:textColor="@color/clr_grey_dark"
                    android:textSize="11sp" />
            </LinearLayout>
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginBottom="12dp"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="8dp"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp" />

                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginStart="4dp"
                    android:text="MAX MARKS" />
            </LinearLayout>

            <EditText
                android:id="@+id/etMaxMarks"
                style="@style/FieldInput"
                android:layout_marginTop="4dp"
                android:inputType="numberDecimal"
                android:text="100" />
        </LinearLayout>

        <LinearLayout
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center_vertical"
                android:orientation="horizontal">

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="#"
                    android:textColor="#9E9E9E"
                    android:textSize="12sp" />

                <TextView
                    style="@style/FieldLabel"
                    android:layout_marginStart="4dp"
                    android:text="MIN MARKS" />
            </LinearLayout>

            <EditText
                android:id="@+id/etMinMarks"
                style="@style/FieldInput"
                android:layout_marginTop="4dp"
                android:inputType="numberDecimal"
                android:text="35" />
        </LinearLayout>
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="13dp"
            android:layout_height="13dp"
            android:src="@drawable/book__2_"
            android:tint="#9E9E9E"/>

        <TextView
            style="@style/FieldLabel"
            android:layout_marginStart="4dp"
            android:text="SYLLABUS" />
    </LinearLayout>

    <EditText
        android:id="@+id/etSyllabus"
        android:layout_width="match_parent"
        android:layout_height="60dp"
        android:layout_marginTop="4dp"
        android:background="@drawable/input_field_bg"
        android:gravity="top|start"
        android:inputType="textMultiLine|textCapSentences"
        android:paddingStart="12dp"
        android:paddingTop="8dp"
        android:paddingEnd="12dp"
        android:textSize="13sp" />


</LinearLayout>