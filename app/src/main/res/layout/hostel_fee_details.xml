<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/five"
    >

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/cardMain"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:background="@drawable/outline_gray_card"
        android:padding="@dimen/ten"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            style="@style/CustomTextStylePoppinsBold1"
            android:textSize="@dimen/fifteen_sp"
            android:textColor="#000"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toStartOf="@id/txtStatus"
            app:layout_constraintTop_toTopOf="parent"/>

        <TextView
            android:id="@+id/txtStatus"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="@dimen/thirteen_sp"
            android:textColor="@color/orange"
            android:paddingHorizontal="@dimen/five"
            android:paddingVertical="@dimen/three"
            android:background="@drawable/bg_outline_orange"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/txtTitle"/>

        <TextView
            android:id="@+id/txtSubtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Monthly Fees"
            android:visibility="gone"
            style="@style/CustomTextStylePoppinsMedium1"
            android:textColor="#666"
            android:textSize="@dimen/fifteen_sp"
            app:layout_constraintTop_toBottomOf="@id/txtTitle"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/five"/>

        <TextView
            android:id="@+id/txtInfo"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text=""
            android:padding="@dimen/seven"
            android:textColor="#333"
            style="@style/CustomTextStylePoppinsMedium1"
            app:layout_constraintTop_toBottomOf="@id/txtSubtitle"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/ten"/>

        <View
            android:id="@+id/viewLine"
            android:layout_width="0dp"
            android:layout_height="@dimen/one"
            android:background="#DDDDDD"
            app:layout_constraintTop_toBottomOf="@id/txtInfo"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/five"/>

        <TextView
            android:id="@+id/txtTotalLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Amount"
            android:textSize="@dimen/fifteen"
            android:textColor="#555"
            style="@style/CustomTextStylePoppinsMedium1"
            app:layout_constraintTop_toBottomOf="@id/viewLine"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/ten"/>

        <TextView
            android:id="@+id/txtTotalValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            style="@style/CustomTextStylePoppinsBold1"
            android:textStyle="bold"
            android:textSize="@dimen/fifteen"
            android:textColor="#000"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/txtTotalLabel"/>


        <TextView
            android:id="@+id/txtPaidLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Paid Amount"
            style="@style/CustomTextStylePoppinsMedium1"
            android:textSize="@dimen/fifteen_sp"
            android:textColor="#555"
            app:layout_constraintTop_toBottomOf="@id/txtTotalLabel"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/ten"/>

        <TextView
            android:id="@+id/txtPaidValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            style="@style/CustomTextStylePoppinsBold1"
            android:textStyle="bold"
            android:textSize="@dimen/fifteen_sp"
            android:textColor="#2E7D32"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/txtPaidLabel"/>

        <View
            android:layout_width="0dp"
            android:layout_height="@dimen/one"
            android:background="#DDDDDD"
            app:layout_constraintTop_toBottomOf="@id/txtPaidLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginTop="@dimen/eight"/>

        <TextView
            android:id="@+id/txtPendingLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Pending Amount"
            style="@style/CustomTextStylePoppinsBold1"
            android:textSize="@dimen/fifteen_sp"
            android:textColor="#000"
            app:layout_constraintTop_toBottomOf="@id/txtPaidLabel"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginTop="@dimen/fifteen_sp"/>

        <TextView
            android:id="@+id/txtPendingValue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            style="@style/CustomTextStylePoppinsBold1"
            android:textStyle="bold"
            android:textSize="@dimen/fifteen_sp"
            android:textColor="#D32F2F"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="@id/txtPendingLabel"/>

        <com.google.android.material.button.MaterialButton
            android:id="@+id/btnPay"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:text="Pay ₹8,500 Now"
            android:textAllCaps="false"
            style="@style/CustomTextStylePoppinsBold1"
            android:textColor="@android:color/white"
            android:layout_marginTop="@dimen/ten"
            app:icon="@android:drawable/ic_menu_send"
            app:iconGravity="textStart"
            app:iconPadding="@dimen/eight"
            app:layout_constraintTop_toBottomOf="@id/txtPendingLabel"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"/>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.constraintlayout.widget.ConstraintLayout>