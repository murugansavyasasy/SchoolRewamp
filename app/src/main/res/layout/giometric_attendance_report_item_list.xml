<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/ten"
    android:layout_marginVertical="@dimen/five">


    <LinearLayout
        android:id="@+id/lnrParentCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/rect_white"
        android:orientation="vertical"
        app:layout_constraintTop_toTopOf="parent">


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/ten">

            <LinearLayout
                android:id="@+id/lnrDate"
                android:layout_width="@dimen/sixty"
                android:layout_height="@dimen/sixty"
                android:background="@drawable/circle_bg_violet"
                android:orientation="vertical"
                android:padding="@dimen/five">

                <TextView
                    android:id="@+id/lblDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="03"
                    android:textColor="@color/white"
                    android:textSize="@dimen/fifteen_sp" />

                <TextView
                    android:id="@+id/lblDay"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:text="Wed"
                    android:textColor="@color/white"
                    android:textSize="@dimen/thirteen_sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginHorizontal="@dimen/five"
                android:layout_toStartOf="@+id/lnrAttendanceStatus"
                android:layout_toEndOf="@+id/lnrDate"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblName"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ARAVINTH A"
                    android:textColor="@color/black"
                    android:textSize="@dimen/fifteen_sp" />

                <TextView
                    android:id="@+id/lblRole"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/three"
                    android:text="Teaching Staff"
                    android:textColor="@color/mild_grey_dark"
                    android:textSize="@dimen/thirteen_sp" />

            </LinearLayout>


            <LinearLayout
                android:id="@+id/lnrAttendanceStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:orientation="vertical">


                <LinearLayout
                    android:id="@+id/lnrAbsent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rect_bg_light_red_absent"
                    android:orientation="horizontal"
                    android:padding="@dimen/five">

                    <TextView
                        android:id="@+id/lblAbsentKey"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FD"
                        android:textColor="@color/red"
                        android:textSize="@dimen/thirteen_sp" />

                    <View
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="@dimen/five"
                        android:background="@color/red" />

                    <TextView
                        android:id="@+id/lblAbsentValue"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Absent"
                        android:textColor="@color/red"
                        android:textSize="@dimen/thirteen_sp" />

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/lnrPresent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@drawable/rect_bg_light_green_present"
                    android:orientation="horizontal"
                    android:padding="@dimen/five"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/lblPresentKey"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="FD"
                        android:textColor="@color/green"
                        android:textSize="@dimen/thirteen_sp" />

                    <View
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="1dp"
                        android:layout_height="match_parent"
                        android:layout_marginHorizontal="@dimen/five"
                        android:background="@color/green" />

                    <TextView
                        android:id="@+id/lblPresentValue"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Present"
                        android:textColor="@color/green"
                        android:textSize="@dimen/thirteen_sp" />

                </LinearLayout>

            </LinearLayout>


        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="0.5dp"
            android:layout_marginHorizontal="@dimen/fifteen"
            android:background="@color/grey" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/ten">


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/ten"
                android:orientation="vertical"
                android:padding="@dimen/ten">

                <TextView
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/check_in"
                    android:textColor="@color/mild_grey_dark"
                    android:textSize="@dimen/thirteen_sp" />

                <TextView
                    android:id="@+id/lblCheckInTime"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/five"
                    android:text="Not yet in"
                    android:textColor="@color/clr_violet"
                    android:textSize="@dimen/thirteen_sp" />

            </LinearLayout>


            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="@dimen/ten"
                android:orientation="vertical"
                android:padding="@dimen/ten">

                <TextView
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/check_out"
                    android:textColor="@color/mild_grey_dark"
                    android:textSize="@dimen/thirteen_sp" />

                <TextView
                    android:id="@+id/lblCheckOutTime"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/five"
                    android:text="Not yet in"
                    android:textColor="@color/clr_violet"
                    android:textSize="@dimen/thirteen_sp" />

            </LinearLayout>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginStart="@dimen/ten"
                android:orientation="vertical"
                android:padding="@dimen/ten">

                <TextView
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/hours"
                    android:textColor="@color/mild_grey_dark"
                    android:textSize="@dimen/thirteen_sp" />

                <TextView
                    android:id="@+id/lblHours"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/five"
                    android:text="0 min"
                    android:textColor="@color/green"
                    android:textSize="@dimen/thirteen_sp" />

            </LinearLayout>


        </RelativeLayout>


    </LinearLayout>


