<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/tvOptionBullet"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="@dimen/thirty_two"
        android:layout_height="@dimen/thirty_two"
        android:background="@drawable/bg_circle_dark_gray"
        android:gravity="center"
        android:text="c"
        android:textColor="@color/white"
        android:textSize="@dimen/fourteen_sp"
        app:layout_constraintBottom_toBottomOf="@id/cardRight"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@id/cardRight" />

    <androidx.cardview.widget.CardView
        android:id="@+id/cardRight"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/twele"
        android:background="@drawable/bg_option_normal"
        android:minHeight="@dimen/sixty"
        app:cardCornerRadius="@dimen/ten"
        app:cardElevation="3dp"
        app:cardUseCompatPadding="true"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@id/tvOptionBullet"
        app:layout_constraintTop_toTopOf="parent">


        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/optionContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:minHeight="@dimen/sixty"
            android:padding="@dimen/five">

            <TextView
                android:id="@+id/tvOptionText"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ten"
                android:text="Graph 3 shows a characteristic exponential rise."
                android:textColor="@color/black"
                android:textSize="@dimen/fourteen_sp"
                android:layout_marginStart="@dimen/eight"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toStartOf="@id/ivCheckmark"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <ImageView
                android:id="@+id/ivCheckmark"
                android:layout_width="@dimen/fourty"
                android:layout_height="@dimen/fourty"
                android:layout_marginEnd="@dimen/ten"
                android:background="@drawable/bg_light_blue_circle"
                android:padding="@dimen/six"
                android:src="@drawable/tick_circle_icon"
                android:visibility="visible"
                app:layout_constraintBottom_toBottomOf="@+id/tvOptionText"
                app:layout_constraintEnd_toStartOf="@id/tvAttachment"
                app:layout_constraintTop_toTopOf="@+id/tvOptionText" />

            <TextView
                android:id="@+id/tvAttachment"
                style="@style/CustomTextStylePoppinsRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Attachment D"
                android:textSize="@dimen/ten_sp"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <LinearLayout
                android:id="@+id/layoutGraph"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toBottomOf="@id/tvAttachment">

                <ImageView
                    android:id="@+id/ivGraph"
                    android:layout_width="@dimen/sixty_four"
                    android:layout_height="@dimen/fourty"
                    android:scaleType="fitCenter"
                    android:src="@drawable/default_image_icon" />

                <TextView
                    android:id="@+id/tvGraphLabel"
                    style="@style/CustomTextStylePoppinsRegular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_horizontal"
                    android:text="Graph 1 (B)"
                    android:textSize="@dimen/nine" />

            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>