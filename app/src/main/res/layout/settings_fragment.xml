<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mild4">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <RelativeLayout
            android:id="@+id/rlaLblSettings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/one_fifty"
            android:background="@color/PrimaryColor"
            android:paddingBottom="@dimen/thirty">

            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="@dimen/thirty"
                android:layout_height="@dimen/thirty"
                android:layout_marginStart="@dimen/thirty"
                android:layout_marginTop="@dimen/thirty"
                android:src="@drawable/arrow_back_black"
                android:visibility="gone">
            </ImageView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/imgBack"
                android:layout_marginStart="@dimen/thirty"
                android:layout_marginTop="@dimen/fifty"
                android:text="@string/permission_settings"
                android:textColor="@color/white"
                android:textSize="@dimen/twenty_sp"
                android:textStyle="bold">

            </TextView>
        </RelativeLayout>

        <TextView
            android:id="@+id/lblGeneral"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rlaLblSettings"
            android:layout_marginStart="@dimen/twenty"
            android:layout_marginTop="@dimen/twenty"
            android:text="@string/account_securityl"
            style="@style/CustomTextStylePoppinsBold"
            android:textSize="@dimen/fifteen_sp">

        </TextView>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/lblGeneral"
            android:layout_marginTop="@dimen/ten">

            <RelativeLayout
                android:id="@+id/rytGeneral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/fifteen"
                android:background="@drawable/rect_white">


                <LinearLayout
                    android:id="@+id/lnrChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/ic_change_password">

                    </ImageView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:text="@string/change_password"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>
                </LinearLayout>


                <View
                    android:id="@+id/isViewChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/point_one"
                    android:layout_below="@+id/lnrChangePassword"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/thirty"
                    android:background="@color/grey"/>


                <LinearLayout
                    android:id="@+id/lnrEnableFingerPrint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/isViewChangePassword"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginBottom="@dimen/fifteen"
                    android:layout_marginEnd="@dimen/thirty"
                    android:gravity="center"
                    android:visibility="gone"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/ic_fingerprint">

                    </ImageView>

                    <RelativeLayout
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textSize="@dimen/thirteen_sp"
                            android:textColor="@color/black"
                            android:text="Enable Fingerprint Login" />

                        <Switch
                            android:layout_weight="0.8"
                            android:id="@+id/switchFingerprint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"/>

                    </RelativeLayout>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:visibility="gone"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>
                </LinearLayout>

            </RelativeLayout>


            <TextView
                android:id="@+id/lblFeedBack"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rytGeneral"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/twenty"
                style="@style/CustomTextStylePoppinsBold"
                android:text="Preferences"
                android:textSize="@dimen/fifteen_sp">

            </TextView>

            <RelativeLayout
                android:id="@+id/rytPref"
                android:layout_marginTop="@dimen/ten"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblFeedBack"
                android:layout_marginBottom="@dimen/fifteen"
                android:layout_marginHorizontal="@dimen/fifteen"
                android:background="@drawable/rect_white">
                <LinearLayout
                    android:id="@+id/lnrNotification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/notification_icon_gray">
                    </ImageView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:text="@string/lblNotifications"
                        style="@style/CustomTextStylePoppinsRegular"
                        >

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>
                </LinearLayout>


                <View
                    android:id="@+id/isViewNotifi"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/point_one"
                    android:layout_below="@+id/lnrNotification"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/thirty"
                    android:background="@color/grey"></View>


                <LinearLayout
                    android:layout_marginBottom="@dimen/ten"
                    android:id="@+id/lnrLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/isViewNotifi"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/ic_language">
                    </ImageView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:text="@string/lblChangeLanguage"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>


                </LinearLayout>

            </RelativeLayout>


            <TextView
                android:id="@+id/lblSupportInformation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rytPref"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                style="@style/CustomTextStylePoppinsBold"
                android:text="@string/support_information"
                android:textSize="@dimen/fifteen_sp">

            </TextView>

            <RelativeLayout
                android:id="@+id/rytSupportInfo"
                android:layout_marginTop="@dimen/ten"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblSupportInformation"
                android:layout_marginBottom="@dimen/fifteen"
                android:layout_marginHorizontal="@dimen/fifteen"
                android:background="@drawable/rect_white">

                <LinearLayout
                    android:id="@+id/lnrFaq"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/faq_icon"></ImageView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:text="@string/lblFAQ"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>
                </LinearLayout>

                <View
                    android:id="@+id/isViewFaq"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/point_one"
                    android:layout_below="@+id/lnrFaq"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/thirty"
                    android:background="@color/grey"></View>


                <LinearLayout
                    android:id="@+id/lnrContactUs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/isViewFaq"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/contact_us_icon">
                    </ImageView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:text="@string/lblContact"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>
                </LinearLayout>

                <View
                    android:id="@+id/isViewContact"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/point_one"
                    android:layout_below="@+id/lnrContactUs"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/thirty"
                    android:background="@color/grey"></View>


                <LinearLayout
                    android:id="@+id/lnrTermsConditions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/isViewContact"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/terms_conditions_icon">
                    </ImageView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:text="@string/lblTermsCondition"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>
                </LinearLayout>

                <View
                    android:id="@+id/isViewTerms"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/point_one"
                    android:layout_below="@+id/lnrTermsConditions"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/thirty"
                    android:background="@color/grey"></View>

                <LinearLayout
                    android:layout_marginBottom="@dimen/ten"
                    android:id="@+id/lnrwhatsnew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/isViewTerms"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/whats_new">

                    </ImageView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:text="@string/what_s_new"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>
                </LinearLayout>

            </RelativeLayout>


            <TextView
                android:id="@+id/lblFeedBacks"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rytSupportInfo"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                style="@style/CustomTextStylePoppinsBold"
                android:text="Feedback"
                android:textSize="@dimen/fifteen_sp">

            </TextView>


            <RelativeLayout
                android:layout_marginTop="@dimen/ten"
                android:layout_below="@+id/lblFeedBacks"
                android:id="@+id/rytFeedBack"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/fifteen"
                android:background="@drawable/rect_white">

                <LinearLayout
                    android:id="@+id/lnrFeedBack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/send_feedback_icon"></ImageView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:text="@string/lblRateus"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>
                </LinearLayout>

                <View
                    android:id="@+id/isViewRateUs"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/point_one"
                    android:layout_below="@+id/lnrFeedBack"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/thirty"
                    android:background="@color/grey"/>

                <LinearLayout
                    android:layout_below="@+id/isViewRateUs"
                    android:id="@+id/lnrReportBug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/report_bug_icon"></ImageView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:text="@string/lblReportbug"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>
                </LinearLayout>


                <View
                    android:id="@+id/isViewReportBug"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/point_one"
                    android:layout_below="@+id/lnrReportBug"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/thirty"
                    android:background="@color/grey"/>


                <LinearLayout
                    android:id="@+id/lnrLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/isViewReportBug"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:layout_marginBottom="@dimen/ten"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/logout">
                    </ImageView>

                    <TextView
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:text="@string/lblLogout"
                        android:textColor="@color/red"
                        android:textSize="@dimen/thirteen_sp"
                        android:textStyle="bold">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five"
                        android:layout_height="@dimen/twenty_five"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>
                </LinearLayout>


            </RelativeLayout>




        </RelativeLayout>

    </RelativeLayout>

</androidx.core.widget.NestedScrollView>