<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/gray_white">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/parent_side_tool_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground" />

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarLayout">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/white_bg_radius"
            android:orientation="vertical"
            android:paddingStart="@dimen/ten"
            android:paddingEnd="@dimen/ten"
            android:paddingBottom="@dimen/ten">

            <ImageView
                android:id="@+id/imgMoreOptions"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="end"
                android:layout_marginTop="@dimen/five"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:padding="@dimen/five"
                android:src="@drawable/ic_more_vert"
                android:visibility="gone" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/ten">

                <WebView
                    android:id="@+id/wvCertificatePdf"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/two_hundred"
                    android:visibility="gone" />

                <ProgressBar
                    android:id="@+id/loadingBar"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:indeterminateDrawable="@drawable/progress_bar_white"
                    android:indeterminateOnly="true"
                    android:visibility="gone">

                </ProgressBar>

                <RelativeLayout

                    android:id="@+id/rytWaitingProcess"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ten"
                    android:gravity="center">

                    <ImageView
                        android:id="@+id/imgTimimg"
                        android:layout_width="@dimen/fourty"
                        android:layout_height="@dimen/fourty"
                        android:layout_centerHorizontal="true"
                        android:src="@drawable/waiting_for_approval"></ImageView>

                    <TextView
                        android:id="@+id/lblWaitingMessage"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/imgTimimg"
                        android:layout_marginTop="@dimen/ten"
                        android:gravity="center"
                        android:text=""
                        android:textColor="@color/dark_orange"
                        android:textSize="@dimen/sixteen_sp">

                    </TextView>
                </RelativeLayout>
            </RelativeLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ten">

                    <ImageView
                        android:id="@+id/imgRequeston"
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_centerVertical="true"
                        android:src="@drawable/calendar_icon_4"></ImageView>

                    <TextView
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_marginEnd="@dimen/five"
                        android:layout_toEndOf="@+id/imgRequeston"
                        android:text="@string/requested_on"
                        android:textSize="@dimen/fifteen_sp"></TextView>
                </RelativeLayout>

                <TextView
                    android:textAlignment="viewStart"
                    android:id="@+id/lblRequestedOnDate"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fourty"
                    android:layout_marginEnd="@dimen/five"
                    android:textSize="@dimen/fifteen_sp"></TextView>


                <RelativeLayout
                    android:id="@+id/rytCertificate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ten">

                    <ImageView
                        android:id="@+id/imgCertificate"
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_centerVertical="true"
                        android:src="@drawable/calendar_icon_3"></ImageView>

                    <TextView
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_marginEnd="@dimen/five"
                        android:layout_toEndOf="@+id/imgCertificate"
                        android:text="@string/certificated_date"
                        android:textSize="@dimen/fifteen_sp"></TextView>
                </RelativeLayout>

                <TextView
                    android:textAlignment="viewStart"
                    android:id="@+id/lblCertificateDate"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fourty"
                    android:layout_marginEnd="@dimen/five"
                    android:textSize="@dimen/fifteen_sp"></TextView>


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ten">

                    <ImageView
                        android:id="@+id/imgCertificateType"
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_centerVertical="true"
                        android:src="@drawable/pin_icon_2"></ImageView>

                    <TextView
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_marginEnd="@dimen/five"
                        android:layout_toEndOf="@+id/imgCertificateType"
                        android:text="@string/certificate_type"
                        android:textSize="@dimen/fifteen_sp"></TextView>
                </RelativeLayout>

                <TextView
                    android:textAlignment="viewStart"
                    android:id="@+id/lblCerticateTypeValue"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fourty"
                    android:layout_marginEnd="@dimen/five"
                    android:textSize="@dimen/fifteen_sp"></TextView>


                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ten">

                    <ImageView
                        android:id="@+id/imgReason"
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_centerVertical="true"
                        android:src="@drawable/edit_icon_3"></ImageView>

                    <TextView
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_marginEnd="@dimen/five"
                        android:layout_toEndOf="@+id/imgReason"
                        android:text="@string/reason"
                        android:textSize="@dimen/fifteen_sp"></TextView>
                </RelativeLayout>

                <TextView
                    android:textAlignment="viewStart"
                    android:id="@+id/lblReasonValue"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fourty"
                    android:layout_marginEnd="@dimen/five"
                    android:textSize="@dimen/fifteen_sp"></TextView>

            </LinearLayout>
        </LinearLayout>
    </ScrollView>

    <LinearLayout
        android:id="@+id/lnrDownloadStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginEnd="@dimen/twenty_five"
        android:background="@color/light_gray_8"
        android:elevation="@dimen/ten"
        android:gravity="center"
        android:orientation="horizontal"
        android:padding="@dimen/twele"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarLayout">

        <ProgressBar
            android:id="@+id/progressBar"
            style="?android:attr/progressBarStyle"
            android:layout_width="@dimen/thirty_two"
            android:layout_height="@dimen/thirty_two"
            android:layout_marginEnd="@dimen/eight"
            android:indeterminate="true"
            android:visibility="visible" />

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/downloading"
            android:textColor="@color/white"
            android:textSize="@dimen/sixteen_sp"
            android:visibility="visible" />
    </LinearLayout>


</androidx.constraintlayout.widget.ConstraintLayout>