<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/white">

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar" />


    <ScrollView
        android:id="@+id/eventCreate"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginHorizontal="@dimen/ten"
        android:scrollbars="none"
        android:visibility="visible"
        app:layout_constraintTop_toBottomOf="@+id/toolbarLayout"
        android:layout_below="@+id/toolbarLayout">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten"
            android:padding="@dimen/ten">


            <TextView
                android:id="@+id/lblLocation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Venue"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp"
                android:layout_marginStart="15dp"
                android:layout_marginTop="5dp"
               style="@style/CustomTextStylePoppinsBold"/>



            <EditText
                android:id="@+id/txtLocation"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblLocation"
                android:layout_marginTop="@dimen/fifteen"
                android:background="@drawable/bg_edittext_view_line"
                android:hint="@string/eg_chennai"
                android:paddingBottom="@dimen/ten"
                android:inputType="text"
                android:textColor="@color/black"
                android:layout_alignStart="@+id/lblLocation"
                android:layout_marginEnd="10dp"
                android:textSize="@dimen/thirteen_sp"
                style="@style/CustomTextStylePoppinsRegular"/>

            <ImageView
                android:layout_width="@dimen/twenty"
                android:layout_height="@dimen/twenty"
                android:layout_below="@+id/lblLocation"
                android:layout_alignParentEnd="true"
                android:src="@drawable/ic_location" />


            <TextView
                android:id="@+id/lblEventTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtLocation"
                android:layout_marginTop="@dimen/fifteen"
                android:text="@string/Title"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp"
                android:layout_alignStart="@+id/txtLocation"
                style="@style/CustomTextStylePoppinsBold"
                />

            <EditText
                android:id="@+id/txtTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblEventTitle"
                android:layout_marginTop="@dimen/fifteen"
                android:background="@drawable/bg_edittext_view_line"
                android:hint="@string/eg_yoga_event"
                android:paddingBottom="@dimen/ten"
                android:inputType="text"
                android:textColor="@color/black"
                style="@style/CustomTextStylePoppinsRegular"
                android:layout_alignStart="@+id/lblEventTitle"
                android:layout_alignEnd="@+id/txtLocation"
                android:textSize="@dimen/thirteen_sp" />

            <TextView
                android:id="@+id/lblEventDesc"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/txtTitle"
                android:layout_marginTop="@dimen/fifteen"
                android:text="@string/Description"
                android:textColor="@color/black"
                style="@style/CustomTextStylePoppinsBold"
                android:textSize="@dimen/thirteen_sp"
                android:layout_alignStart="@+id/txtTitle"
               />


            <RelativeLayout
                android:id="@+id/rytDesc"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblEventDesc"
                android:layout_marginTop="@dimen/fifteen"
                android:background="@drawable/bg_stroke_rect_black"
                android:paddingHorizontal="@dimen/ten"
                android:layout_alignStart="@+id/lblEventDesc"
                android:layout_alignEnd="@+id/txtTitle"
                android:paddingVertical="@dimen/twenty">

                <EditText
                    android:id="@+id/txtDesc"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@android:color/transparent"
                    android:hint="@string/Description"
                    android:textColor="@color/black"
                    style="@style/CustomTextStylePoppinsRegular"
                    android:textSize="@dimen/thirteen_sp" />

                <TextView
                    android:id="@+id/lbTextCount"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/txtDesc"
                    android:layout_alignParentEnd="true"
                    android:text="@string/_0_of_500"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp"
                    style="@style/CustomTextStylePoppinsMedium" />

            </RelativeLayout>


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rytDesc"
                android:layout_alignStart="@+id/rytDesc"
                android:layout_marginTop="@dimen/fifteen">

                <TextView
                    android:id="@+id/lblAddPhoto"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:fontFamily="@font/poppins_bold"
                    android:text="Upload Image/Document"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/lblOptional"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_toEndOf="@+id/lblAddPhoto"
                    android:text="@string/Optional"
                    android:textColor="@color/grey"
                    android:fontFamily="@font/poppins_regular"
                    android:textSize="@dimen/thirteen_sp"
                    android:textStyle="normal" />

                <ImageView
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="@dimen/ten"
                    android:src="@drawable/ic_photo" />


                <RelativeLayout
                    android:id="@+id/rytADD"
                    android:layout_width="@dimen/seventy"
                    android:layout_height="@dimen/seventy"
                    android:layout_below="@+id/lblAddPhoto"
                    android:layout_marginTop="@dimen/fifteen"
                    android:background="@drawable/rect_light_blue">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_centerHorizontal="true"
                        android:layout_centerVertical="true"
                        android:src="@drawable/ic_plus" />

                </RelativeLayout>






                <RelativeLayout
                    android:id="@+id/rytEventDateTime"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rytADD"
                    android:layout_marginTop="@dimen/fifteen">


                    <TextView
                        android:id="@+id/lblStart"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ten"
                        android:text="Starts on"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp"
                        style="@style/CustomTextStylePoppinsBold" />


                    <RelativeLayout
                        android:id="@+id/rytStart"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_below="@+id/lblStart"
                        android:layout_marginEnd="10dp"
                        android:layout_marginTop="@dimen/ten">

                        <RelativeLayout
                            android:id="@+id/rytStartDate"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">


                            <androidx.cardview.widget.CardView
                                android:id="@+id/cardStart"
                                android:layout_width="@dimen/sixty"
                                android:layout_height="@dimen/sixty"
                                app:cardCornerRadius="@dimen/ten">

                                <LinearLayout
                                    android:id="@+id/lnrStartCalendar"
                                    android:layout_width="match_parent"
                                    android:layout_height="match_parent"
                                    android:background="@drawable/bg_stroke_rect_black"
                                    android:orientation="vertical">

                                    <TextView
                                        android:id="@+id/lblDay"
                                        android:layout_width="wrap_content"
                                        android:layout_height="wrap_content"
                                        android:layout_gravity="center_horizontal"
                                        android:layout_marginTop="@dimen/five"
                                        android:text="Fri"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/fifteen_sp"
                                       style="@style/CustomTextStylePoppinsBold"/>

                                    <TextView
                                        android:id="@+id/lblDate"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:background="@color/primary_light"
                                        android:gravity="center"
                                        android:text="12"
                                        android:textColor="@color/black"
                                        android:textSize="@dimen/fifteen_sp"
                                        style="@style/CustomTextStylePoppinsBold" />

                                </LinearLayout>
                            </androidx.cardview.widget.CardView>


                            <ImageView
                                android:id="@+id/imgDateDown"
                                android:layout_width="@dimen/twenty"
                                android:layout_height="@dimen/twenty"
                                android:layout_centerVertical="true"
                                android:layout_toEndOf="@+id/cardStart"
                                android:src="@drawable/ic_down_arrow" />


                            <TextView
                                android:id="@+id/txtStartDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_centerVertical="true"
                                android:layout_marginStart="@dimen/five"
                                android:layout_marginTop="@dimen/ten"
                                android:layout_toEndOf="@+id/imgDateDown"
                                android:text="2024 Dec, 04"
                               style="@style/CustomTextStylePoppinsRegular"
                                android:textColor="@color/black"
                                android:textSize="@dimen/thirteen_sp" />

                        </RelativeLayout>


                        <RelativeLayout
                            android:id="@+id/rytStartTime"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_centerVertical="true">

                            <ImageView
                                android:id="@+id/imgTimeDown"
                                android:layout_width="@dimen/twenty"
                                android:layout_height="@dimen/twenty"
                                android:layout_centerVertical="true"
                                android:layout_toStartOf="@+id/txtStartTime"
                                android:src="@drawable/ic_down_arrow" />

                            <TextView
                                android:id="@+id/txtStartTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_alignParentEnd="true"
                                android:text="12:11 AM"
                                android:textColor="@color/black"
                                style="@style/CustomTextStylePoppinsMedium"
                                android:textSize="@dimen/thirteen_sp" />

                        </RelativeLayout>


                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/one"
                            android:layout_alignParentBottom="true"
                            android:layout_marginStart="@dimen/sixty"
                            android:background="@color/grey" />

                    </RelativeLayout>




                    <TextView
                        android:id="@+id/btnNext"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/fourty"
                        android:layout_below="@+id/rytStart"
                        android:layout_marginTop="@dimen/thirty"
                        android:background="@drawable/rect_btn_orange"
                        android:gravity="center"
                        android:text="@string/NEXT"
                        android:textColor="@color/white"
                        android:textSize="@dimen/thirteen_sp"
                        android:layout_marginBottom="20dp"
                        android:layout_marginEnd="10dp"
                       style="@style/CustomTextStylePoppinsBold" />


                </RelativeLayout>


            </RelativeLayout>


        </RelativeLayout>

    </ScrollView>

</RelativeLayout>