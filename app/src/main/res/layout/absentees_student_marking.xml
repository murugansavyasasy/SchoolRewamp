<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <RelativeLayout
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <!-- Main content container (above send button) -->
    <RelativeLayout
        android:id="@+id/relativeContainer"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@id/rytSend"
        android:layout_alignParentTop="true"
        android:layout_marginBottom="@dimen/eight">

        <include
            android:id="@+id/toolbarLayout"
            layout="@layout/absentees_mark_common" />



        <RelativeLayout
            android:id="@+id/rlaSortSearch"
            android:layout_width="match_parent"
            android:layout_below="@+id/toolbarLayout"
            android:layout_height="@dimen/thirty_five"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:layout_marginTop="@dimen/five"
            android:background="@drawable/rect_grey"
            android:visibility="gone">


            <ImageView
                android:id="@+id/imgSearch"
                android:layout_width="@dimen/thirty"
                android:layout_height="@dimen/thirty"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/ten"
                android:alpha="0.34"
                android:src="@drawable/ic_search" />

            <EditText
                android:layout_marginStart="@dimen/five"
                android:id="@+id/txtSearchMenu"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:inputType="textCapSentences"
                android:imeOptions="actionDone"
                android:singleLine="true"
                android:scrollHorizontally="true"
                android:layout_toEndOf="@+id/imgSearch"
                style="@style/CustomTextStylePoppinsMedium"
                android:background="@android:color/transparent"
                android:hint="@string/lblSearch"
                />

        </RelativeLayout>


        <RelativeLayout
            android:layout_marginTop="@dimen/five"
            android:weightSum="1"
            android:id="@+id/rytSearchBar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:layout_below="@+id/rlaSortSearch"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:layout_toStartOf="@+id/cbSelect"
                android:id="@+id/rlaSort"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/five"
                android:layout_marginEnd="@dimen/five"
                android:padding="@dimen/ten">

                <ImageView
                    android:id="@+id/imgSort"
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/five"
                    android:src="@drawable/filter_icon">

                </ImageView>

                <Spinner
                    android:id="@+id/isSpinnerSort"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@+id/imgSort"
                    android:background="@null" />
            </RelativeLayout>
            <CheckBox
                android:layout_alignParentEnd="true"
                android:id="@+id/cbSelect"
                android:layout_centerVertical="true"
                android:layout_width="wrap_content"
                android:layout_marginEnd="@dimen/fifteen"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/five"
                android:button="@drawable/ch_square"
                android:text="@string/mark_all_as_absent"
                android:visibility="visible" />
        </RelativeLayout>



        <!-- Header row -->
        <LinearLayout
            android:id="@+id/lnrHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/rytSearchBar"
            android:layout_marginTop="@dimen/ten"
            android:weightSum="1"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:background="@drawable/rect_light_blue"
            android:orientation="horizontal">

            <TextView
                android:layout_marginStart="@dimen/five"
                android:id="@+id/lblName"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="@dimen/zero"
                android:layout_height="wrap_content"
                android:layout_weight="0.6"
                android:padding="@dimen/ten"
                android:text="@string/name"
                android:textColor="@color/light_purple1" />


            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="@dimen/zero"
                android:layout_height="wrap_content"
                android:layout_weight="0.4"
                android:gravity="center"
                android:text="@string/status"
                android:textColor="@color/light_purple1" />
        </LinearLayout>

        <androidx.core.widget.NestedScrollView
            android:layout_below="@id/lnrHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <!-- RecyclerView for students -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/recycleStudents"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:clipToPadding="true"
                    android:nestedScrollingEnabled="false"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginEnd="@dimen/ten"
                    tools:listitem="@layout/attendance_student_list" />

                <LinearLayout
                    android:id="@+id/lytNoDataFound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="vertical"
                    android:visibility="gone">

                    <ImageView
                        android:layout_width="@dimen/two_hundred"
                        android:layout_height="@dimen/two_hundred"
                        android:layout_marginTop="@dimen/twenty_five"
                        android:src="@drawable/no_takeattendence_message">

                    </ImageView>

                    <TextView
                        android:id="@+id/noDataFound"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:layout_marginTop="@dimen/five"
                        android:textSize="@dimen/fifteen_sp"
                        android:text="">

                    </TextView>

                </LinearLayout>
            </LinearLayout>
        </androidx.core.widget.NestedScrollView>
    </RelativeLayout>

    <!-- Send Button -->
    <RelativeLayout
        android:id="@+id/rytSend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/twenty_five"
        android:layout_marginEnd="@dimen/twenty_five"
        android:layout_marginBottom="@dimen/sixteen"
        android:background="@drawable/bg_btn_blue"
        android:gravity="center"
        android:padding="@dimen/ten">

        <TextView
            android:id="@+id/lblSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center_horizontal"
            android:textColor="@color/white"
            android:textSize="@dimen/fifteen_sp"
            android:textStyle="normal" />

        <ImageView
            android:id="@+id/imgSend1"
            android:layout_width="@dimen/twenty"
            android:layout_height="@dimen/twenty"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/five"
            android:layout_marginEnd="@dimen/five"
            android:visibility="gone"
            android:layout_toEndOf="@+id/lblSend"
            android:src="@drawable/send_icon_white" />
    </RelativeLayout>

</RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>