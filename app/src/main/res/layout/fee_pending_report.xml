<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent">

    <RelativeLayout
        android:id="@+id/rlaLbCommunication"
        android:layout_width="match_parent"
        android:layout_height="@dimen/eighty"
        android:background="@color/primary_light"
        android:paddingBottom="@dimen/thirty">
        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:layout_marginStart="@dimen/twenty"
            android:layout_marginTop="@dimen/twenty"
            android:src="@drawable/left_arrow">

        </ImageView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/sixty"
            android:layout_marginTop="@dimen/twenty"
            android:text="Fee Pending"
            android:textColor="@color/black"
            android:textSize="@dimen/twenty_sp"
            android:textStyle="bold">

        </TextView>
    </RelativeLayout>





    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="@dimen/fifty"
        android:id="@+id/relative_layout8"
        android:layout_below="@+id/rlaLbCommunication"
        android:weightSum="2"
        android:gravity="center_vertical"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginTop="@dimen/ten"
        android:background="@drawable/rect_light_gray">


        <TextView
            android:id="@+id/category_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:background="@drawable/white_radious"
            android:layout_weight="1"
            android:gravity="center"
            android:text="CATEGORY WISE"
            android:textColor="@color/black"
            android:textSize="@dimen/fifteen_sp"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:layout_marginStart="3dp"
            style="@style/CustomTextStylePoppinsMedium">
        </TextView>

        <TextView
            android:id="@+id/class_name"
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:text="CLASS WISE"
            android:textColor="@color/black"
            android:textSize="@dimen/fifteen_sp"
            android:layout_weight="1"
            android:layout_marginTop="3dp"
            android:layout_marginBottom="3dp"
            android:layout_marginStart="3dp"
            android:layout_marginEnd="@dimen/three"
            android:gravity="center"
            style="@style/CustomTextStylePoppinsMedium">
        </TextView>

    </LinearLayout>

    <LinearLayout
        android:id="@+id/AcademicYear"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/gray_bg_radius"
        android:orientation="horizontal"
        android:layout_below="@+id/relative_layout8"
        android:padding="@dimen/ten"
        android:layout_marginTop="10dp"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="10dp"
        android:weightSum="1">

        <TextView
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0.4"
            android:text="@string/academic_year"
            android:textSize="@dimen/thirteen_sp">


        </TextView>

        <TextView
            android:id="@id/lblAcademicYear"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="0.6"
            android:drawableEnd="@drawable/down_arrow"
            android:paddingEnd="@dimen/fifteen"
            android:text="2024-2025"
            android:textSize="@dimen/ten_sp">
        </TextView>
    </LinearLayout>

    <RelativeLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/relative_layout5"
        android:layout_marginTop="5dp"
        android:layout_below="@+id/AcademicYear"
        >
        <TextView
            android:id="@+id/total_collection"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Total Collection"
            android:layout_alignParentEnd="true"
            android:textColor="@color/orange"
            android:layout_marginEnd="15dp"
            style="@style/CustomTextStylePoppinsBold"
            android:textSize="13sp"/>


    </RelativeLayout>


    <LinearLayout
        android:id="@+id/lytList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/relative_layout5"
        android:orientation="vertical">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/totalsummary1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/relative_layout8"
            android:layout_marginTop="@dimen/ten">
        </androidx.recyclerview.widget.RecyclerView>

        <ImageView
            android:id="@+id/nomessage"
            android:layout_width="@dimen/two_fifty"
            android:layout_height="@dimen/two_fifty"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/twenty"
            android:src="@drawable/nomessages"
            android:textColor="@color/black"
            android:textSize="@dimen/eighteen"
            android:visibility="gone" />

        <TextView
            android:id="@+id/txtNoData"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/twenty"
            android:text="@string/no_list_found"
            android:textColor="@color/black"
            android:textSize="@dimen/eighteen"
            android:visibility="gone" />

    </LinearLayout>



</RelativeLayout>