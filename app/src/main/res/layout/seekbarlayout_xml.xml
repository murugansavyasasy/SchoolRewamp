<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
android:id="@+id/rlaSeekBarAndTitle"
android:layout_width="match_parent" xmlns:android="http://schemas.android.com/apk/res/android"
android:layout_height="wrap_content"
android:layout_marginTop="@dimen/ten"
android:visibility="visible">

<RelativeLayout
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginStart="@dimen/fifteen"
    android:layout_marginEnd="@dimen/fifteen"
    android:background="@drawable/rect_shadow_white">

    <ImageView
        android:id="@+id/imgVoicePlay"
        android:layout_width="@dimen/fourty"
        android:layout_height="@dimen/fourty"
        android:layout_marginStart="@dimen/five"
        android:layout_marginTop="@dimen/thirteen"
        android:src="@drawable/play_icon_voice">

    </ImageView>

    <SeekBar
        android:id="@+id/waveformSeekBar"
        android:layout_width="match_parent"
        android:layout_height="@dimen/thirty"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginTop="@dimen/eighteen"
        android:layout_marginEnd="@dimen/ten"
        android:layout_toEndOf="@+id/imgVoicePlay" />

    <TextView
        android:id="@+id/lblStartDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/imgVoicePlay"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginBottom="@dimen/five"
        android:layout_toEndOf="@+id/imgVoicePlay"
        android:text="00:00"
        android:textColor="@color/black"
        android:textSize="@dimen/thirteen_sp">
    </TextView>

    <TextView
        android:id="@+id/lblEndDuration"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/imgVoicePlay"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:layout_toEndOf="@+id/lblStartDuration"
        android:text="00:00"
        android:textColor="@color/black"
        android:textSize="@dimen/thirteen_sp">
    </TextView>

    <TextView
        android:id="@+id/lblTime"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/imgVoicePlay"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:text="00:00"
        android:textColor="@color/black"
        android:textSize="@dimen/thirteen_sp">
    </TextView>

</RelativeLayout>
</RelativeLayout>