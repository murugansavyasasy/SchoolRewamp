<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/two"
    android:id="@+id/lnrHeader"
    android:background="@drawable/outline_gray"
    android:orientation="vertical"
    android:fitsSystemWindows="true"
    android:padding="@dimen/five">

    <TextView
        android:id="@+id/tvSlotTime"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:text="10:00 am - 10:10 am"
        android:textColor="@android:color/black"
        android:textSize="@dimen/eight"
        android:textStyle="bold" />

    <TextView
        android:id="@+id/tvSlotStatus"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/five"
        android:gravity="center_horizontal"
        android:text="Available"
        android:textColor="@color/green"
        android:textSize="@dimen/ten_sp" />

</LinearLayout>