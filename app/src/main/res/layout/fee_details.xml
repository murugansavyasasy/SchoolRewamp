<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:tools="http://schemas.android.com/tools"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true">

    <RelativeLayout
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/rytHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/PrimaryColor"
            android:paddingVertical="@dimen/fifteen">

            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="@dimen/thirty_five"
                android:layout_height="@dimen/thirty_five"
                android:layout_centerVertical="true"
                android:src="@drawable/arrow_left_white" />

            <TextView
                android:id="@+id/lblParentToolBar"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textColor="@color/white"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/rlaStudentName"
                android:layout_toEndOf="@+id/imgBack"
                android:text=""
                android:textSize="@dimen/fifteen_sp" />

            <LinearLayout
                android:id="@+id/rlaStudentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ten"
                android:layout_toEndOf="@+id/imgBack"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblStudentName"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="@dimen/thirteen_sp" />

                <TextView
                    android:id="@+id/lblStudentSection"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="@dimen/thirteen_sp" />
            </LinearLayout>
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/headerview"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rytHeader"
            android:layout_marginStart="@dimen/twenty"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/twenty"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/lblHeaderTitle"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:text="@string/fee_details"
                android:textColor="@color/black"
                android:textSize="@dimen/twenty_sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/lnrParent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/headerview"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="@dimen/ten"
            android:layout_marginStart="@dimen/fifteen"
            android:layout_marginTop="@dimen/fifteen"
            android:layout_marginEnd="@dimen/fifteen"
            android:weightSum="2"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/lnrPayment"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/btnPayment"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="@dimen/eight"
                    android:text="@string/payment"
                    android:textColor="@color/dark_blue"
                    android:textSize="@dimen/fifteen_sp" />

                <View
                    android:id="@+id/linePayment"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/three"
                    android:background="@color/PrimaryColor" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/lnrReceipt"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/btnReceipt"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:padding="@dimen/eight"
                    android:text="@string/receipt"
                    android:textColor="@color/black"
                    android:textSize="@dimen/fifteen_sp" />

                <View
                    android:id="@+id/lineReceipt"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/three"
                    android:background="@color/athens_gray" />
            </LinearLayout>

        </LinearLayout>

        <FrameLayout
            android:layout_below="@+id/lnrParent"
            android:id="@+id/webview_container"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <WebView
                android:layout_marginTop="@dimen/ten"
                android:id="@+id/payWebview"
                android:visibility="visible"
                android:layout_width="match_parent"
                android:layout_height="match_parent" />
        </FrameLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_marginTop="@dimen/ten"
            android:visibility="gone"
            android:layout_below="@+id/lnrParent"
            android:id="@+id/rvReceipts"
            tools:listitem="@layout/fee_receipt_list_items"
            android:layout_width="match_parent"
            android:layout_height="match_parent" />

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
