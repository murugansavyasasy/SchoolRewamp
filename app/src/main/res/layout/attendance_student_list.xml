<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/ten"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:id="@+id/lnrHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <TextView
            android:id="@+id/lblName"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="@dimen/zero"
            android:layout_height="wrap_content"
            android:layout_gravity="start"
            android:layout_weight="1"
            android:layout_marginStart="@dimen/eight"
            android:padding="@dimen/ten"
            android:text="Murugan"
            android:textColor="@color/black"
             />

        <LinearLayout
            android:id="@+id/lnrRollNo"
            android:layout_width="@dimen/zero"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/five"
            android:layout_weight="1"
            android:orientation="horizontal"
            android:padding="@dimen/five">

            <TextView
                android:id="@+id/lblRollNo"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="111"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="@dimen/twele_sp" />
        </LinearLayout>
        <LinearLayout
            android:id="@+id/lnrRightColumn"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_weight="1"
            android:gravity="center_horizontal">

            <!-- Present -->
            <LinearLayout
                android:id="@+id/lnrPresent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/five"
                android:layout_marginBottom="@dimen/five"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/ten"
                android:paddingVertical="@dimen/five"
                android:background="@drawable/rect_green_stroke"
                android:gravity="center_vertical">

                <View
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:background="@drawable/circle_bg_green" />
                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/present"
                    android:layout_marginStart="@dimen/five"
                    android:textColor="@color/green"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:textSize="@dimen/twele_sp" />

            </LinearLayout>

            <!-- Absent (Initially hidden) -->
            <LinearLayout
                android:id="@+id/lnrAbsent"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/five"
                android:orientation="horizontal"
                android:paddingHorizontal="@dimen/ten"
                android:paddingVertical="@dimen/five"
                android:background="@drawable/rect_red_stroke"
                android:gravity="center_vertical"
                android:visibility="gone">

                <TextView
                    android:id="@+id/lblAbsent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/absent"
                    android:textColor="@color/red"
                    android:textSize="@dimen/twele_sp"
                    style="@style/CustomTextStylePoppinsMedium" />

                <View
                    android:id="@+id/imgAbsent"
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:layout_marginStart="@dimen/five"
                    android:background="@drawable/circle_bg_red" />
            </LinearLayout>

            <!-- Admission Info -->
            <LinearLayout
                android:id="@+id/linearlayout"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:layout_marginTop="@dimen/five"
                android:gravity="center_horizontal">

                <TextView
                    android:id="@+id/lblAdmissionNoTitle"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:text="@string/admis_no"
                    android:textColor="@color/light_gray" />

                <TextView
                    style="@style/CustomTextStylePoppinsMedium"
                    android:id="@+id/lblAdmissionNoValue"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="123456"
                    android:textColor="@color/light_gray"
                    android:textStyle="bold" />
            </LinearLayout>
        </LinearLayout>


    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/point_five"
        android:layout_below="@id/lnrHeader"
        android:layout_marginHorizontal="@dimen/ten"
        android:layout_marginTop="@dimen/ten"
        android:background="@color/grey" />
</RelativeLayout>
