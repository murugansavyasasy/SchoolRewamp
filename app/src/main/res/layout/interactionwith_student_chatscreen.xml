<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/AthensGray">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RelativeLayout
        android:id="@+id/rytHeader"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:background="@color/white"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground">

        <RelativeLayout
            android:id="@+id/toolbarlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@drawable/bg_header_rounded"
            android:paddingVertical="@dimen/fifteen">

            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="@dimen/thirty_five"
                android:layout_height="@dimen/thirty_five"
                android:layout_centerVertical="true"
                android:src="@drawable/arrow_left_white" />

            <com.google.android.material.imageview.ShapeableImageView
                android:id="@+id/profileImage"
                android:layout_width="@dimen/fourty"
                android:layout_height="@dimen/fourty"
                android:layout_marginTop="@dimen/three"
                android:layout_toEndOf="@id/imgBack"
                android:scaleType="centerCrop"
                android:src="@drawable/default_profile"
                android:visibility="gone"
                app:shapeAppearanceOverlay="@style/CircleImageShape" />

            <LinearLayout
                android:id="@+id/rlaStudentName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/five"
                android:layout_marginTop="@dimen/five"
                android:layout_marginEnd="@dimen/ten"
                android:layout_toEndOf="@id/profileImage"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblStudentName"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="SARAN"
                    android:textColor="@color/white" />

                <TextView
                    android:id="@+id/lblStudentSection"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="ENGLISH"
                    android:textColor="@color/white" />
            </LinearLayout>
        </RelativeLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcystaffQuestionchatdata"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@id/bottomChatInput"
            android:layout_below="@id/toolbarlayout"
            android:nestedScrollingEnabled="false" />


        <!-- Bottom Input Section -->
        <LinearLayout
            android:id="@+id/bottomChatInput"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_alignParentBottom="true"
            android:background="@color/white"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/ten">

            <ImageView
                android:id="@+id/btnAdd"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="bottom"
                android:layout_marginEnd="@dimen/ten"
                android:layout_marginBottom="@dimen/ten"
                android:src="@drawable/ic_plus"
                android:visibility="gone" />

            <LinearLayout
                android:id="@+id/reply_linearlayout"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ten"
                android:layout_weight="1"
                android:visibility="gone"
                android:orientation="vertical">


                <!-- Reply preview container -->
                <LinearLayout

                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginBottom="@dimen/five"
                    android:background="@drawable/bg_message_input"
                    android:orientation="vertical"
                    >

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/five"
                        android:gravity="center_vertical"
                        android:orientation="horizontal">

                        <TextView
                            android:id="@+id/txtReplyingTo"
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="0dp"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:text="Replying "
                            android:textColor="@color/black"
                            android:textSize="@dimen/twele_sp" />

                        <ImageView
                            android:id="@+id/imgCloseReply"
                            android:layout_width="@dimen/twenty"
                            android:layout_height="@dimen/twenty"
                            android:layout_marginEnd="@dimen/eight"
                            android:src="@drawable/close_red_color" />
                    </LinearLayout>

                    <TextView
                        android:id="@+id/txtquestion"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/five"
                        android:text="Hi How are you"
                        android:textSize="@dimen/twele_sp" />
                </LinearLayout>


                <!-- Message Input -->
                <EditText
                    android:id="@+id/edtMessage"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fourty"
                    android:background="@drawable/bg_message_input"
                    android:gravity="center_vertical"
                    android:hint="@string/type_your_message_here"
                    android:inputType="textMultiLine|textCapSentences"
                    android:paddingHorizontal="@dimen/twele"
                    android:textColor="@color/black"
                    android:visibility="gone"
                    android:textSize="@dimen/fourteen_sp" />


                <!-- Reply + Reply All BELOW EditText -->
                <LinearLayout
                    android:id="@+id/replyall_linearlayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/five"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:weightSum="2">

                    <TextView
                        android:id="@+id/replytext"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:padding="5dp"
                        android:layout_marginEnd="5dp"
                        android:background="@drawable/rect_gray_radius"
                        android:text="@string/reply"
                        android:textColor="@color/iconBlue"
                        android:textSize="@dimen/fifteen_sp" />

                    <TextView
                        android:id="@+id/replyalltext"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:padding="5dp"
                        android:gravity="center"
                        android:background="@drawable/rect_gray_radius"
                        android:text="@string/reply_all"
                        android:textColor="@color/iconBlue"
                        android:textSize="@dimen/fifteen_sp" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>


        <!-- No Data Layout -->
        <LinearLayout
            android:id="@+id/lytList"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nomessage"
                android:layout_width="@dimen/two_fifty"
                android:layout_height="@dimen/two_fifty"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/twenty"
                android:src="@drawable/no_notification_message"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtNoData"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/twenty"
                android:gravity="center"
                android:text="@string/no_list_found"
                android:textSize="@dimen/fifteen_sp"
                android:visibility="gone" />
        </LinearLayout>

    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>