<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@android:color/transparent"
    android:padding="@dimen/ten">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@drawable/white_bg_radius"
        android:orientation="vertical">

        <LinearLayout
            android:id="@+id/lnrHeader"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_above="@+id/LnrCancelOk"
            android:layout_margin="@dimen/ten"
            android:orientation="vertical">

            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/rect_black_stoke_bg"
                android:padding="@dimen/ten"
                android:text="@string/note_the_following_students_are_marked_as_absent_their_parents_will_receive_an_automatic_call_please_double_check_before_confirming_attendance"
                android:textColor="@color/mild_red">

            </TextView>


            <TextView
                android:id="@+id/lblAbsenteesListCount"
                android:layout_marginTop="@dimen/ten"
                android:layout_width="match_parent"
                android:text="@string/absentees_students_list"
                android:textSize="@dimen/fifteen_sp"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_height="wrap_content">
            </TextView>


            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rcFinalList"
                android:layout_marginTop="@dimen/ten"
                android:layout_width="match_parent"
                android:layout_height="match_parent">

            </androidx.recyclerview.widget.RecyclerView>

            <LinearLayout
                android:id="@+id/lytNoDataFound"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/two_fifty"
                    android:layout_height="@dimen/two_fifty"
                    android:layout_marginTop="@dimen/twenty_five"
                    android:src="@drawable/no_mark_attendance_2">

                </ImageView>

                <TextView
                    android:id="@+id/noDataFound"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_marginHorizontal="@dimen/ten"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/twenty"
                    android:textSize="@dimen/fifteen_sp"
                    android:text="">

                </TextView>

            </LinearLayout>

        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:id="@+id/LnrCancelOk"
            android:layout_alignParentBottom="true"
            android:layout_height="wrap_content">
            <View
                android:layout_marginTop="@dimen/five"
                android:layout_width="match_parent"
                android:background="@color/gray"
                android:layout_marginHorizontal="@dimen/ten"
                android:layout_height="@dimen/one">
            </View>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:weightSum="1">

                <TextView
                    android:id="@+id/lblClose"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/ten"
                    android:layout_weight="0.5"
                    android:gravity="center"
                    android:padding="@dimen/five"
                    android:text="@string/Cancel"
                    android:textColor="@color/red">

                </TextView>

                <TextView
                    android:id="@+id/lblMarkAsAbsent"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/ten"
                    android:layout_weight="0.5"
                    android:gravity="center"
                    android:padding="@dimen/five"
                    android:text="@string/confirm"
                    android:textColor="@color/PrimaryColor">

                </TextView>


            </LinearLayout>
        </RelativeLayout>
    </RelativeLayout>


</LinearLayout>