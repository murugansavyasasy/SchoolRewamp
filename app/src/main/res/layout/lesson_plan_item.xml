<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    >


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/five"
        android:background="@drawable/rect_shadow_white">

        <RelativeLayout
            android:layout_marginStart="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:layout_marginTop="@dimen/ten"

            android:id="@+id/rytHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/imgBook"
                android:background="@drawable/pink_radius_bg"
                android:layout_width="@dimen/fifty"
                android:layout_alignParentStart="true"
                android:src="@drawable/book_icon_2"
                android:padding="@dimen/eight"
                android:layout_height="@dimen/fifty">
            </ImageView>
            <LinearLayout
                android:layout_toStartOf="@+id/status_text1label"
                android:layout_marginStart="@dimen/ten"
                android:layout_toEndOf="@+id/imgBook"
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/lblSubjectId"
                    android:layout_marginTop="@dimen/five"
                    android:layout_width="match_parent"
                    android:text="Tamil"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_height="wrap_content">
                </TextView>
                <TextView
                    android:layout_marginTop="@dimen/five"
                    android:layout_width="match_parent"
                    android:text="Chapter"
                    android:id="@+id/lblTeaching"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_height="wrap_content">
                </TextView>
                <LinearLayout
                    android:layout_width="match_parent"
                    android:weightSum="1"
                    android:layout_marginTop="@dimen/five"
                    android:layout_height="wrap_content">
                    <RelativeLayout
                        android:layout_weight="0.5"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <TextView
                            android:layout_centerVertical="true"
                            android:id="@+id/lblLevel"
                            android:layout_width="@dimen/thirty"
                            android:text="1"
                            android:layout_alignParentStart="true"
                            android:gravity="center"
                            style="@style/CustomTextStylePoppinsBold"
                            android:textColor="@color/PrimaryColor"
                            android:background="@drawable/bg_circle_gray"
                            android:layout_height="@dimen/thirty">
                        </TextView>
                        <TextView
                            android:layout_marginStart="@dimen/five"
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@+id/lblLevel"
                            style="@style/CustomTextStylePoppinsMedium"
                            android:layout_width="wrap_content"
                            android:text="@string/level"
                            android:layout_height="wrap_content">
                        </TextView>

                    </RelativeLayout>
                    <TextView
                        android:layout_weight="0.5"
                        android:drawableStart="@drawable/red_circle_icon"
                        android:text="@string/admin"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:drawablePadding="@dimen/five"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                    </TextView>

                </LinearLayout>

            </LinearLayout>
            <ImageView
                android:layout_alignParentEnd="true"
                android:layout_width="@dimen/twenty"
                android:src="@drawable/ic_more_vert"
                android:id="@+id/edit_icon"
                android:layout_height="@dimen/twenty">
            </ImageView>
            <ImageView
                android:layout_alignParentEnd="true"
                android:layout_width="@dimen/twenty"
                android:src="@drawable/completed_green"
                android:id="@+id/status_text1label"
                android:layout_marginTop="5dp"
                android:layout_below="@+id/edit_icon"
                android:layout_height="@dimen/twenty">
            </ImageView>
        </RelativeLayout>
        <View
            android:layout_below="@+id/rytHeader"
            android:id="@+id/divder1"
            android:layout_marginTop="@dimen/ten"
            android:layout_width="match_parent"
            android:background="@color/gray4"
            android:layout_height="@dimen/one">

        </View>




        <androidx.recyclerview.widget.RecyclerView
            android:layout_below="@+id/divder1"
            android:layout_marginTop="@dimen/ten"
            android:id="@+id/detailsRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ten"
            android:nestedScrollingEnabled="false"
            android:paddingStart="@dimen/thirteen"
            android:paddingEnd="@dimen/thirteen" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:visibility="gone"
            android:layout_below="@+id/detailsRecyclerView"
            android:layout_marginBottom="@dimen/eight"
            android:padding="@dimen/two">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/eight"
                android:gravity="end"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/eight"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:paddingStart="@dimen/twele_sp"
                    android:paddingTop="@dimen/six"
                    android:paddingEnd="@dimen/twele"
                    android:paddingBottom="@dimen/six">

                    <ImageView
                        android:layout_width="@dimen/twenty"
                        android:layout_height="@dimen/twenty"
                        android:contentDescription="Edit Icon"
                        android:src="@drawable/edit_icon_2" />

                    <TextView
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/eight"
                        android:text="@string/edit"
                        android:textSize="@dimen/fourteen_sp"
                        />
                </LinearLayout>

                <LinearLayout
                    android:id="@+id/btnDeleteContainer"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/eight"
                    android:background="@drawable/bg_red_radoius_10dp"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:paddingStart="@dimen/twele"
                    android:paddingTop="@dimen/six"
                    android:paddingEnd="@dimen/twele"
                    android:paddingBottom="@dimen/six">

                    <ImageView
                        android:layout_width="@dimen/sixteen"
                        android:layout_height="@dimen/sixteen"
                        android:contentDescription="Delete Icon"
                        android:src="@drawable/delete_bin" />


                    <TextView
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="8dp"
                        android:text="@string/delete"
                        android:textColor="@color/black" />

                </LinearLayout>
            </LinearLayout>
        </RelativeLayout>


    </RelativeLayout>
</RelativeLayout>
