<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mild4">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:id="@+id/rlaLblSettings"
            android:layout_width="match_parent"
            android:layout_height="@dimen/one_fifty"
            android:background="@color/PrimaryColor"
            android:paddingBottom="@dimen/thirty">

            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="@dimen/thirty"
                android:layout_height="@dimen/thirty"
                android:layout_marginStart="@dimen/thirty"
                android:layout_marginTop="@dimen/thirty"
                android:src="@drawable/arrow_back_black"
                android:visibility="gone">

            </ImageView>

            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/imgBack"
                android:layout_marginStart="@dimen/thirty"
                android:layout_marginTop="@dimen/fifty"
                android:text="@string/permission_settings"
                android:textColor="@color/white"
                android:textSize="@dimen/twenty_sp"
                android:textStyle="bold">

            </TextView>
        </RelativeLayout>

        <TextView
            android:id="@+id/lblGeneral"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rlaLblSettings"
            android:layout_marginStart="@dimen/twenty"
            android:layout_marginTop="@dimen/twenty"
            android:text="@string/account_securityl"
            android:textColor="@color/black1"
            android:textSize="@dimen/fifteen_sp">

        </TextView>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/lblGeneral"
            android:layout_marginTop="@dimen/ten">

            <RelativeLayout
                android:id="@+id/rytGeneral"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/fifteen"
                android:background="@drawable/rect_white">


                <LinearLayout
                    android:id="@+id/lnrChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/lock_rotation">

                    </ImageView>

                    <TextView
                        style="@style/CustomTextStylePoppinsRegular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:text="@string/change_password"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>
                </LinearLayout>


                <View
                    android:id="@+id/isViewChangePassword"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/point_one"
                    android:layout_below="@+id/lnrChangePassword"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/thirty"
                    android:background="@color/grey" />


                <LinearLayout
                    android:id="@+id/lnrEnableFingerPrint"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/isViewChangePassword"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:layout_marginBottom="@dimen/fifteen"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:visibility="gone"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/ic_fingerprint">

                    </ImageView>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8">

                        <TextView
                            style="@style/CustomTextStylePoppinsRegular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/enable_fingerprint_login"
                            android:textColor="@color/black"
                            android:textSize="@dimen/thirteen_sp" />

                        <Switch
                            android:id="@+id/switchFingerprint"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="0.8" />

                    </RelativeLayout>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray"
                        android:visibility="gone">

                    </ImageView>
                </LinearLayout>

            </RelativeLayout>


            <TextView
                android:id="@+id/lblFeedBack"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rytGeneral"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/twenty"
                android:text="@string/preferences"
                android:textColor="@color/black1"
                android:textSize="@dimen/fifteen_sp">

            </TextView>

            <RelativeLayout
                android:id="@+id/rytPref"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblFeedBack"
                android:layout_marginHorizontal="@dimen/fifteen"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginBottom="@dimen/fifteen"
                android:background="@drawable/rect_white">

                <LinearLayout
                    android:id="@+id/lnrNotification"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/notification_icon_gray"></ImageView>

                    <TextView
                        style="@style/CustomTextStylePoppinsRegular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:textSize="@dimen/thirteen_sp"
                        android:text="@string/lblNotifications">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>
                </LinearLayout>


                <View
                    android:id="@+id/isViewNotifi"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/point_one"
                    android:layout_below="@+id/lnrNotification"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/thirty"
                    android:background="@color/grey"></View>


                <LinearLayout
                    android:id="@+id/lnrLanguage"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/isViewNotifi"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:layout_marginBottom="@dimen/ten"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/ic_language"></ImageView>

                    <TextView
                        style="@style/CustomTextStylePoppinsRegular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:text="@string/lblChangeLanguage"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>


                </LinearLayout>

            </RelativeLayout>


            <TextView
                android:id="@+id/lblSupportInformation"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rytPref"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:text="@string/support_information"
                android:textColor="@color/black1"
                android:textSize="@dimen/fifteen_sp">

            </TextView>

            <RelativeLayout
                android:id="@+id/rytSupportInfo"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblSupportInformation"
                android:layout_marginHorizontal="@dimen/fifteen"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginBottom="@dimen/fifteen"
                android:background="@drawable/rect_white">

                <LinearLayout
                    android:id="@+id/lnrFaq"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/faq_icon"></ImageView>

                    <TextView
                        style="@style/CustomTextStylePoppinsRegular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:text="@string/lblFAQ"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>
                </LinearLayout>

                <View
                    android:id="@+id/isViewFaq"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/point_one"
                    android:layout_below="@+id/lnrFaq"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/thirty"
                    android:background="@color/grey"></View>


                <LinearLayout
                    android:id="@+id/lnrContactUs"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/isViewFaq"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/contact_us"></ImageView>

                    <TextView
                        style="@style/CustomTextStylePoppinsRegular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:text="@string/lblContact"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>
                </LinearLayout>

                <View
                    android:id="@+id/isViewContact"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/point_one"
                    android:layout_below="@+id/lnrContactUs"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/thirty"
                    android:background="@color/grey"></View>


                <LinearLayout
                    android:id="@+id/lnrTermsConditions"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/isViewContact"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/terms_and_conditions"></ImageView>

                    <TextView
                        style="@style/CustomTextStylePoppinsRegular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:text="@string/lblTermsCondition"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>
                </LinearLayout>

                <View
                    android:id="@+id/isViewTerms"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/point_one"
                    android:layout_below="@+id/lnrTermsConditions"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/thirty"
                    android:background="@color/grey"></View>


                <LinearLayout
                    android:id="@+id/lnrPrivacyPolicy"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/isViewTerms"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/privacy_policy"></ImageView>

                    <TextView
                        style="@style/CustomTextStylePoppinsRegular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:text="@string/privacy_policy"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>
                </LinearLayout>


                <View
                    android:id="@+id/isViewPrivacy"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/point_one"
                    android:layout_below="@+id/lnrPrivacyPolicy"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/thirty"
                    android:background="@color/grey"></View>


                <LinearLayout
                    android:id="@+id/lnrAboutTheApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/isViewPrivacy"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/info_circle_fill"></ImageView>

                    <TextView
                        style="@style/CustomTextStylePoppinsRegular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:text="@string/about_the_app"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>
                </LinearLayout>

                <View
                    android:id="@+id/isViewAboutApp"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/point_one"
                    android:layout_below="@+id/lnrAboutTheApp"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/thirty"
                    android:background="@color/grey"></View>


                <LinearLayout
                    android:id="@+id/lnrHowToUseApp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/isViewAboutApp"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/questionmark_circle"></ImageView>

                    <TextView
                        style="@style/CustomTextStylePoppinsRegular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:text="@string/how_to_use_2"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>
                </LinearLayout>


                <View
                    android:id="@+id/isViewHowToUse"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/point_one"
                    android:layout_below="@+id/lnrHowToUseApp"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/thirty"
                    android:background="@color/grey"></View>


                <LinearLayout
                    android:id="@+id/lnrwhatsnew"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/isViewHowToUse"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:layout_marginBottom="@dimen/ten"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/ic_features">

                    </ImageView>

                    <TextView
                        style="@style/CustomTextStylePoppinsRegular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:text="@string/what_s_new"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>
                </LinearLayout>

            </RelativeLayout>


            <TextView
                android:id="@+id/lblFeedBacks"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rytSupportInfo"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:text="@string/Feedback_2"
                android:textColor="@color/black1"
                android:textSize="@dimen/fifteen_sp">

            </TextView>


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblFeedBacks"
                android:layout_marginHorizontal="@dimen/fifteen"
                android:layout_marginTop="@dimen/ten"
                android:background="@drawable/rect_white">

                <LinearLayout
                    android:id="@+id/lnrFeedBack"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/send_feedback_icon"></ImageView>

                    <TextView
                        style="@style/CustomTextStylePoppinsRegular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:text="@string/lblRateus"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>
                </LinearLayout>

                <View
                    android:id="@+id/isViewRateUs"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/point_one"
                    android:layout_below="@+id/lnrFeedBack"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/thirty"
                    android:background="@color/grey" />

                <LinearLayout
                    android:id="@+id/lnrReportBug"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/isViewRateUs"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
