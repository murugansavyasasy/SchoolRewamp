<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/meetingCard"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/ten"
    android:layout_marginVertical="@dimen/five"
    android:background="@drawable/bg_gradient"
    android:orientation="vertical"
    android:padding="@dimen/ten">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvPurpose"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/report_card_meeting"
                android:textSize="@dimen/thirteen_sp"
                android:textStyle="bold" />

            <TextView
                android:id="@+id/tvStaff"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/two"
                android:text="with Nicholas"
                android:textSize="@dimen/twele_sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/tvStatus"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_orange"
            android:paddingHorizontal="@dimen/fifteen"
            android:paddingVertical="@dimen/five"
            android:text="@string/upcoming"
            android:textColor="@color/white"
            android:textSize="@dimen/thirteen_sp" />

    </RelativeLayout>

    <TextView
        android:id="@+id/tvSubject"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/twele"
        android:background="@drawable/bg_orange"
        android:backgroundTint="@color/violet_color"
        android:paddingHorizontal="@dimen/fifteen"
        android:paddingVertical="@dimen/five"
        android:text="ENGLISH"
        android:textColor="@android:color/white"
        android:textSize="@dimen/twele_sp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/sixteen"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="@dimen/zero"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:id="@+id/imgMeetingMode"
                android:layout_width="@dimen/twenty"
                android:layout_height="@dimen/twenty"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="@dimen/eight"
                 />

            <TextView
                android:id="@+id/tvMode"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="@string/phone_call"
                android:textSize="@dimen/thirteen_sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/zero"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/twenty"
                android:layout_height="@dimen/twenty"
                android:layout_gravity="center_vertical"
                android:layout_marginEnd="@dimen/eight"
                android:src="@drawable/stopwatch_gray" />

            <TextView
                android:id="@+id/tvDuration"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center_vertical"
                android:text="15 min"
                android:textSize="@dimen/thirteen_sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/twele"
        android:orientation="horizontal">

        <LinearLayout
            android:layout_width="@dimen/zero"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/eight"
                    android:src="@drawable/calendar_circle_fill_gray" />

                <TextView
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/date"
                    android:textSize="@dimen/thirteen_sp" />
            </LinearLayout>

            <TextView
                android:id="@+id/tvDate"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/twenty_five"
                android:layout_marginTop="@dimen/four"
                android:text="02 Sep 2025"
                android:textSize="@dimen/thirteen_sp" />

        </LinearLayout>

        <LinearLayout
            android:layout_width="@dimen/zero"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <ImageView
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:layout_gravity="center_vertical"
                    android:layout_marginEnd="@dimen/eight"
                    android:src="@drawable/clock_circle_fill_gray" />

                <TextView
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center_vertical"
                    android:text="@string/time"
                    android:textSize="@dimen/thirteen_sp" />

            </LinearLayout>

            <TextView
                android:id="@+id/tvTime"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/twenty_five"
                android:layout_marginTop="@dimen/four"
                android:text="04:15 PM - 04:30 PM"
                android:textSize="@dimen/thirteen_sp" />

        </LinearLayout>

    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/twenty"
        android:orientation="horizontal"
        android:padding="@dimen/five">

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/cancelButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/eight"
            android:background="@drawable/bg_red"
            android:drawableStart="@drawable/close_icon"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/six"
            android:paddingVertical="@dimen/eight"
            android:text="@string/cancel"
            android:textColor="@color/white"
            android:textSize="@dimen/ten_sp"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />


        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/callButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/eight"
            android:background="@drawable/bg_orange"
            android:drawableStart="@drawable/phone_icon_bg"
            android:drawablePadding="@dimen/five"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/fifteen"
            android:paddingVertical="@dimen/ten"
            android:text="Call"
            android:textColor="@color/white"
            android:textSize="@dimen/ten_sp"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />

        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/joinButton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/eight"
            android:background="@drawable/bg_orange"
            android:drawableStart="@drawable/network"
            android:drawablePadding="@dimen/five"
            android:gravity="center_vertical"
            android:paddingHorizontal="@dimen/fifteen"
            android:paddingVertical="@dimen/ten"
            android:text="Join"
            android:textColor="@color/white"
            android:textSize="@dimen/ten_sp"
            app:iconGravity="textStart"
            app:iconTint="@color/white" />

    </LinearLayout>

</LinearLayout>
