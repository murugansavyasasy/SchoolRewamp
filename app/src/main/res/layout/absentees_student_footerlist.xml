<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:fitsSystemWindows="true">


    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:layout_marginBottom="@dimen/ten"
        android:padding="@dimen/twele"
        app:cardCornerRadius="@dimen/seven"
        app:cardElevation="@dimen/four">

        <LinearLayout
            android:id="@+id/linear_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/Image_value"
                android:layout_width="@dimen/seventy_five"
                android:layout_height="match_parent"
                android:src="@drawable/schoolboy"
                >
            </ImageView>


            <LinearLayout
                android:id="@+id/relative_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fifteen"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/student_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/twenty"
                    android:text="Saran"
                    android:textSize="@dimen/seventeen_sp"
                    style="@style/CustomTextStylePoppinsBold"
                    >
                </TextView>

                <TextView
                    android:id="@+id/section_value"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/fifteen"
                    android:text="I-A"
                    android:textSize="@dimen/sixteen_sp"
                    style="@style/CustomTextStylePoppinsMedium"
                   >
                </TextView>

                <TextView
                    android:id="@+id/register_number"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/five"
                    android:layout_marginBottom="@dimen/ten"
                    android:text="Admission Number : VS1 -19661530"
                    android:textSize="@dimen/sixteen_sp"
                    style="@style/CustomTextStylePoppinsMedium">
                </TextView>
                <LinearLayout
                    android:id="@+id/linearlayout"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginBottom="@dimen/five"
                    android:gravity="center_vertical">

                    <ImageView
                        android:id="@+id/phone_icon"
                        android:layout_width="@dimen/twenty"
                        android:layout_height="@dimen/twenty"
                        android:layout_marginEnd="@dimen/six"
                        android:src="@drawable/phone_call_icon" />

                    <TextView
                        android:id="@+id/mobile_number"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="8610487261"
                        android:textColor="@color/navi_blue2"
                        android:textSize="@dimen/fifteen_sp"
                        style="@style/CustomTextStylePoppinsMedium" />
                </LinearLayout>

            </LinearLayout>
        </LinearLayout>
    </androidx.cardview.widget.CardView>
</RelativeLayout>