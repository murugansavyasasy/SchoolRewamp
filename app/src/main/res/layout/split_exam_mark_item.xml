<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:layout_marginTop="@dimen/five"
    >

    <LinearLayout
        android:weightSum="1"
        android:orientation="horizontal"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:id="@+id/lblSplitSubjectName"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="@dimen/zero"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/five"
            android:layout_marginEnd="@dimen/five"
            android:layout_weight="0.8"
            android:text="@string/subject_name"
            android:textSize="@dimen/twele_sp">

        </TextView>

        <TextView
            android:id="@+id/lblSplitmarkoutof100"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="0.2"
            android:gravity="end"
            android:text=""
            android:textSize="@dimen/twele_sp">

        </TextView>
    </LinearLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcRubrics"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginHorizontal="@dimen/ten"
        android:nestedScrollingEnabled="false"
        >
    </androidx.recyclerview.widget.RecyclerView>
</LinearLayout>