<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/one_thirty"
    android:layout_marginTop="@dimen/five"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/date_badge_count"
        android:layout_width="@dimen/twenty_four"
        android:layout_height="@dimen/twenty_four"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="@dimen/five"
        android:background="@drawable/bg_red_circle"
        android:elevation="@dimen/ten"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center"
        android:text="1"
        android:textColor="@color/white"
        android:textSize="@dimen/twele_sp"
        android:textStyle="normal" />

    <androidx.cardview.widget.CardView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/eight"
        app:cardCornerRadius="@dimen/four"
        app:cardElevation="@dimen/four">
        <LinearLayout
            android:layout_width="@dimen/one_twenty"
            android:layout_height="wrap_content"
            android:orientation="vertical">

            <LinearLayout
                android:layout_width="@dimen/one_twenty"
                android:layout_height="wrap_content"
                android:background="@android:color/holo_blue_light"
                android:paddingVertical="@dimen/ten"
                >

                <TextView
                    android:id="@+id/titleTextView"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="January"
                    android:layout_marginEnd="@dimen/twenty"
                    android:textSize="@dimen/seventeen"
                    android:textStyle="normal"
                    android:fontFamily="@font/futura_regular"
                    android:textColor="@android:color/white"
                    android:paddingHorizontal="@dimen/ten"/>
            </LinearLayout>

            <LinearLayout
                android:id="@+id/linear_layout1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@color/white"
                android:paddingVertical="@dimen/eight"
                android:orientation="vertical"
                android:gravity="center">

                <TextView
                    android:id="@+id/descriptionTextView"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="30"
                    android:textSize="@dimen/twenty_five_sp"
                    android:textStyle="bold"
                    android:fontFamily="@font/futura_bold"
                    android:textColor="@color/grey"/>

                <TextView
                    android:id="@+id/description_view"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Monday"
                    android:layout_marginTop="@dimen/two"
                    android:textSize="@dimen/seventeen_sp"
                    android:textStyle="normal"
                    android:fontFamily="@font/futura_regular"
                    android:textColor="@color/grey"/>
            </LinearLayout>

        </LinearLayout>

    </androidx.cardview.widget.CardView>


</RelativeLayout>


