<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/five"
    android:fitsSystemWindows="true"
    android:layout_marginTop="@dimen/thirteen" >

    <TextView
        android:id="@+id/badge_count"
        android:layout_width="26dp"
        android:layout_height="26dp"
        android:layout_alignParentEnd="true"
        android:layout_marginEnd="@dimen/eight"
        android:background="@drawable/circle_background"
        android:elevation="@dimen/ten"
       style="@style/CustomTextStylePoppinsBold"
        android:gravity="center"
        android:text=""
        android:textColor="@color/black"
        android:textSize="@dimen/twele_sp"
        />

    <androidx.cardview.widget.CardView
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:padding="@dimen/twele"
        android:layout_marginBottom="@dimen/ten"
        app:cardCornerRadius="@dimen/seven"
        app:cardElevation="@dimen/four">

        <RelativeLayout
            android:id="@+id/relative_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ten">

            <LinearLayout
                android:id="@+id/content_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/grade_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginTop="@dimen/five"
                    android:layout_marginEnd="@dimen/thirty"
                 style="@style/CustomTextStylePoppinsBold"
                    android:gravity="center"
                    android:text="10 th Grade"
                    android:textColor="@color/black"
                    android:textSize="@dimen/seventeen_sp"
                   />

                <TextView
                    android:id="@+id/date_view"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginTop="@dimen/five"
                    android:layout_marginEnd="@dimen/thirty"
                   style="@style/CustomTextStylePoppinsBold"
                    android:gravity="center"
                    android:text="21 Jan 2025"
                    android:textColor="@color/black"
                    android:textSize="@dimen/seventeen_sp"
                    />
            </LinearLayout>


            <ImageView
                android:id="@+id/arrow_icon"
                android:layout_width="@dimen/thirty"
                android:layout_height="@dimen/thirty"
                android:layout_alignParentEnd="true"
                android:layout_centerInParent="true"
                android:layout_marginTop="@dimen/fourty"
                android:src="@drawable/rightarrrow" />

        </RelativeLayout>

    </androidx.cardview.widget.CardView>
</RelativeLayout>


