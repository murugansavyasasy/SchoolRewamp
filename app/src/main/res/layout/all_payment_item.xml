<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/five"
    android:background="#EDEDED">

    <androidx.cardview.widget.CardView
        android:id="@+id/cardPayment"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/five"
        app:cardCornerRadius="@dimen/ten"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="#FFFFFF">

            <View
                android:id="@+id/topBg"
                android:layout_width="0dp"
                android:layout_height="@dimen/eighty"
                android:background="#E0F0FF"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <ImageView
                android:id="@+id/imgRefresh"
                android:layout_width="@dimen/thirty"
                android:layout_height="@dimen/thirty"
                android:layout_marginEnd="@dimen/twenty"
                android:background="@drawable/bg_light_blue1"
                android:padding="@dimen/five"
                android:visibility="gone"
                android:src="@drawable/refresh"
                app:layout_constraintBottom_toBottomOf="@id/topBg"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="@id/topBg" />

            <TextView
                android:id="@+id/txtPaidAmountLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/fifteen"
                android:text="Paid Amount"
                android:textColor="#0088FF"
                android:textSize="@dimen/thirteen_sp"
                android:textStyle="normal"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="@id/topBg" />

            <TextView
                android:id="@+id/txtAmount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="10dp"
                android:text=""
                android:textColor="#0088FF"
                android:textSize="@dimen/twenty_sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="@id/txtPaidAmountLabel"
                app:layout_constraintTop_toBottomOf="@id/txtPaidAmountLabel" />


            <TextView
                android:id="@+id/txtPaymentStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/fifteen"
                android:text="Payment Status"
                android:textColor="#555555"
                android:textSize="@dimen/fifteen_sp"
                android:textStyle="bold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/topBg" />

            <LinearLayout
                android:id="@+id/layoutSuccess"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:paddingHorizontal="@dimen/eight"
                android:background="@drawable/rect_bg_light_green_radius"
                android:paddingVertical="@dimen/five"
                android:layout_marginEnd="@dimen/fifteen"
                app:layout_constraintTop_toTopOf="@id/txtPaymentStatus"
                app:layout_constraintBottom_toBottomOf="@id/txtPaymentStatus"
                app:layout_constraintEnd_toEndOf="parent">

                <ImageView
                    android:id="@+id/imgSuccess"
                    android:layout_width="@dimen/sixteen"
                    android:layout_height="@dimen/sixteen"
                    android:src="@drawable/checked_green" />

                <TextView
                    android:id="@+id/txtSuccess"
                    style="@style/CustomTextStylePoppinsRegular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/five"
                    android:text=""
                    android:textColor="@color/green"
                    android:textSize="@dimen/thirteen_sp" />

            </LinearLayout>


            <View
                android:id="@+id/divider1"
                android:layout_width="0dp"
                android:layout_height="@dimen/one"
                android:layout_marginTop="@dimen/ten"
                android:background="#DDDDDD"
                app:layout_constraintTop_toBottomOf="@id/layoutSuccess"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <TextView
                android:id="@+id/txtOrderLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:text="Transation ID"
                android:textColor="@color/gnt_gray"
                android:textSize="@dimen/fifteen_sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider1" />

            <TextView
                android:id="@+id/txtOrderValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:text=""
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp"
                app:layout_constraintBaseline_toBaselineOf="@id/txtOrderLabel"
                app:layout_constraintEnd_toEndOf="parent" />


            <TextView
                android:id="@+id/txtStudentLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:text="Create On"
                android:textColor="@color/gnt_gray"
                android:textSize="@dimen/fifteen_sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtOrderLabel" />

            <TextView
                android:id="@+id/txtStudentValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/twenty"
                android:text=""
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp"
                android:layout_marginTop="@dimen/ten"
                app:layout_constraintBaseline_toBaselineOf="@id/txtStudentLabel"
                app:layout_constraintEnd_toEndOf="parent" />


            <TextView
                android:id="@+id/txtCreatedLabel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:paddingBottom="@dimen/ten"
                android:text="Last Update On"
                android:textColor="@color/gnt_gray"
                android:textSize="@dimen/fifteen_sp"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/txtStudentLabel" />

            <TextView
                android:id="@+id/txtCreatedValue"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/twenty"
                android:text=""
                android:paddingBottom="@dimen/ten"
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp"
                app:layout_constraintBaseline_toBaselineOf="@id/txtCreatedLabel"
                app:layout_constraintEnd_toEndOf="parent" />


            <View
                android:id="@+id/divider2"
                android:layout_width="0dp"
                android:layout_height="@dimen/one"
                android:layout_marginTop="@dimen/ten"
                android:background="#DDDDDD"
                app:layout_constraintTop_toBottomOf="@id/txtCreatedLabel"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />


            <LinearLayout
                android:id="@+id/layoutCompleted"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginBottom="10dp"
                android:gravity="center"
                android:orientation="horizontal"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/divider2">

                <ImageView
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:src="@drawable/tick_icon_5"
                    />

                <TextView
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ten"
                    android:text="Payment Completed"
                    android:textColor="@color/green"
                    android:textSize="@dimen/eighteen_sp"
                    android:textStyle="bold" />
            </LinearLayout>

        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.cardview.widget.CardView>

</androidx.constraintlayout.widget.ConstraintLayout>