<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_gray_9">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground" />


    <LinearLayout
        android:id="@+id/lytHeaderBlock"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="@dimen/five"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginEnd="@dimen/five"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/toolbarLayout">

        <RelativeLayout
            android:id="@+id/rytSearch1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/thirty_five"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:background="@drawable/rect_grey"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgSearch1"
                android:layout_width="@dimen/thirty"
                android:layout_height="@dimen/thirty"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/ten"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/txtSearch1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toEndOf="@id/imgSearch1"
                android:background="@android:color/transparent"
                android:hint="@string/lblSearch"
                android:textDirection="locale"
                android:layoutDirection="locale"
                android:textAlignment="viewStart"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <TextView
                android:id="@+id/lblReviewDetail"
                style="@style/CustomTextStylePoppinsRegular"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:layout_marginHorizontal="@dimen/ten"
                android:visibility="visible"
                android:text="@string/review_and_edit_marks"
                android:textColor="@color/dark_orange_2"
                android:textSize="@dimen/twenty_sp"
                android:textAlignment="viewStart"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgFilterStudentList"
                android:layout_width="@dimen/thirty_five"
                android:layout_height="@dimen/thirty_five"
                android:layout_marginEnd="@dimen/ten"
                android:contentDescription="Filter"
                android:padding="4dp"
                android:src="@drawable/filter_icon" />
        </LinearLayout>

        <TextView
            android:id="@+id/lblSampleDesc"
            style="@style/CustomTextStylePoppinsRegular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:visibility="visible"
            android:textAlignment="viewStart"
            android:text="@string/verify_the_data_and_make_any_necessary_corrections"
            android:textSize="@dimen/fifteen_sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblIssueFound"
            style="@style/CustomTextStylePoppinsRegular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:text=""
            android:textColor="@color/light_gray_4"
            android:textSize="@dimen/thirteen_sp"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lblDisclaimerForAI"
            style="@style/CustomTextStylePoppinsRegular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:visibility="visible"
            android:textAlignment="viewStart"
            android:text="@string/ai_can_make_mistakes_please_check_properly_before_submitting"
            android:textColor="@color/light_gray_4"
            android:textSize="@dimen/thirteen_sp" />

        <TextView
            android:id="@+id/lblNAABNote"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/five"
            android:layout_marginHorizontal="@dimen/ten"
            android:visibility="visible"
            android:textAlignment="viewStart"
            android:text="@string/ab_na_note"
            android:textSize="@dimen/ten_sp" />

        <View
            android:id="@+id/View2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/three"
            android:layout_marginTop="@dimen/fifteen"
            android:layout_marginBottom="@dimen/five"
            android:visibility="visible"
            android:background="@color/AthensGray" />

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/lytSearch"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/five"
            android:layout_marginEnd="@dimen/five"
            android:layout_marginBottom="@dimen/five"
            android:background="@drawable/rect_grey"
            android:padding="@dimen/five"
            android:visibility="gone">

            <ImageView
                android:id="@+id/iconSearch"
                android:layout_width="@dimen/twenty_five"
                android:layout_height="@dimen/twenty_five"
                android:layout_marginStart="@dimen/ten"
                android:src="@drawable/ic_search"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ten"
                android:background="@android:color/transparent"
                android:hint="@string/lblSearch"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:textAlignment="viewStart"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toEndOf="@id/iconSearch"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <include layout="@layout/layout_marks_header" />

    </LinearLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rvMarks"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:scrollbars="none"
        app:layout_constraintBottom_toTopOf="@id/LnrContainer2"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/lytHeaderBlock" />

    <LinearLayout
        android:id="@+id/lytEmptyState"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:orientation="vertical"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="@id/rvMarks"
        app:layout_constraintEnd_toEndOf="@id/rvMarks"
        app:layout_constraintStart_toStartOf="@id/rvMarks"
        app:layout_constraintTop_toTopOf="@id/rvMarks">

        <ImageView
            android:id="@+id/imgEmpty"
            android:layout_width="120dp"
            android:layout_height="120dp"
            android:layout_marginBottom="@dimen/ten"
            android:contentDescription="No students"
            android:src="@drawable/no_student_report_message" />

        <TextView
            android:id="@+id/txtEmptyTitle"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="No students found"
            android:textColor="@color/black"
            android:textSize="@dimen/sixteen_sp" />
    </LinearLayout>


    <LinearLayout
        android:id="@+id/LnrContainer2"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginBottom="@dimen/five"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent">

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/two"
            android:layout_marginHorizontal="@dimen/ten"
            android:background="@color/AthensGray" />

        <LinearLayout
            android:id="@+id/lnrSaveAllMarks2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginHorizontal="@dimen/ten"
            android:layout_marginTop="@dimen/five"
            android:background="@drawable/rect_orange_bg"
            android:gravity="center"
            android:paddingVertical="@dimen/eight">

            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/save_icon"
                android:drawablePadding="@dimen/eight"
                android:gravity="center"
                android:text="@string/save_all_marks"
                android:textColor="@color/white"
                android:textSize="@dimen/fifteen_sp" />
        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>