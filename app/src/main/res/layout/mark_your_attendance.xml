<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/gray_white">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <RelativeLayout
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar" />

    <LinearLayout
        android:id="@+id/lnrParent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbarLayout"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="@dimen/ten"
        android:layout_marginStart="@dimen/fifteen"
        android:layout_marginTop="@dimen/fifteen"
        android:layout_marginEnd="@dimen/fifteen"
        android:background="@drawable/gray_bg_radius"
        android:padding="@dimen/one">

        <TextView
            android:id="@+id/btnCreate"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/bg_primary"
            android:gravity="center"
            android:text="@string/punch_in"
            android:textColor="@color/white"
            android:textSize="@dimen/thirteen_sp" />

        <TextView
            android:id="@+id/btnHistory"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="@dimen/eight"
            android:text="@string/Reports"
            android:textColor="@color/black"
            android:textSize="@dimen/thirteen_sp" />

    </LinearLayout>


    <RelativeLayout
        android:id="@+id/rytProgressBar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:visibility="gone">

        <ProgressBar
            android:id="@+id/custom_progress_bar"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/five"
            android:indeterminate="true"
            android:indeterminateTint="@color/yellow"
            android:indeterminateTintMode="src_atop"
            android:max="100" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/custom_progress_bar"
            android:layout_centerInParent="true"
            android:layout_margin="@dimen/five"
            android:gravity="center"
            android:text="@string/fetching_location"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:textSize="@dimen/fifteen_sp"
            android:textStyle="bold" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rytMarkAttendanceSceen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/rytAddLocation"
        android:visibility="visible"
        android:layout_below="@+id/lnrParent">

        <RelativeLayout
            android:id="@+id/rytGPSRedirect"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="@dimen/fifteen"
            android:background="@drawable/bg_rect_location"
            android:padding="@dimen/twenty"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgLocationIllustrate"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/one_fifty"
                android:src="@drawable/boy_doing_biometric_finger_scanning" />


            <TextView
                android:id="@+id/lblTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/imgLocationIllustrate"
                android:layout_marginTop="@dimen/ten"
                android:text="@string/allow_location_access_to_mark_your_attendance"
                android:textColor="@color/black"
                android:textSize="@dimen/twenty_sp"
                android:textStyle="bold" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblTitle"
                android:layout_marginTop="@dimen/twenty">

                <ImageView
                    android:id="@+id/imgLocation"
                    android:layout_width="@dimen/thirty"
                    android:layout_height="@dimen/thirty"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_location" />

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/twenty"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_toEndOf="@+id/imgLocation"
                    android:text="@string/to_enhance_your_experience_and_provide_accurate_location_based_features_please_enable_gps"
                    android:textColor="@color/black"
                    android:textSize="@dimen/fifteen_sp" />


            </RelativeLayout>


            <TextView
                android:id="@+id/btnEnableLocation"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fifty"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="@dimen/twenty"
                android:background="@drawable/rect_btn_blue"
                android:gravity="center"
                android:text="@string/enable_location"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="@dimen/fifteen_sp"
                android:textStyle="bold" />

        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rytNoLocationList"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgLocationNeeded"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/two_hundred"
                android:paddingHorizontal="@dimen/twenty"
                android:src="@drawable/need_location_access" />

            <TextView
                android:id="@+id/lblNoLocation"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/imgLocationNeeded"
                android:gravity="center"
                android:padding="@dimen/twenty"
                android:text=""
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp" />

        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/rytPresentlayout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/hundred"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgMarkAttendance"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/two_hundred"
                android:paddingHorizontal="@dimen/twenty"
                android:src="@drawable/boy_doing_biometric_finger_scanning" />

            <TextView
                android:id="@+id/lblInstruction"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/imgMarkAttendance"
                android:gravity="center"
                android:padding="@dimen/twenty"
                android:text="@string/mark_attendance_instruction"
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp" />


            <TextView
                android:id="@+id/btnPresent"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblInstruction"
                android:layout_centerHorizontal="true"
                android:layout_marginHorizontal="@dimen/hundred"
                android:layout_marginTop="@dimen/twenty"
                android:background="@drawable/btn_green"
                android:padding="@dimen/seven"
                android:text="@string/punch"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:visibility="visible" />

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/btnPresent"
                android:layout_marginTop="@dimen/ten"
                android:visibility="gone">


                <Switch
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:text="@string/fingerprint" />

            </RelativeLayout>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rytErrorMessage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_marginHorizontal="@dimen/ten"
            android:background="@drawable/rect_btn_red"
            android:visibility="gone">


            <ImageView
                android:id="@+id/imgNotInDistance"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/two_hundred"
                android:paddingHorizontal="@dimen/twenty"
                android:src="@drawable/need_location_access" />

            <TextView
                android:id="@+id/lblErrorMessage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/imgNotInDistance"
                android:padding="20dp"
                android:text="@string/outside_of_the_location"
                android:textAlignment="center"
                android:textColor="@color/white"
                android:textSize="@dimen/fifteen"
                android:textStyle="bold" />

        </RelativeLayout>


    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rytAttendanceHistorySceen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/lnrParent"
        android:layout_marginTop="@dimen/fifteen"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/lnrSpinners"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <RelativeLayout
                android:layout_width="@dimen/one_fifty"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/thirty"
                android:background="@drawable/bg_white_light_radious"
                android:gravity="center">

                <Spinner
                    android:layout_marginStart="@dimen/three"
                    android:id="@+id/spinnerYears"
                    android:layout_centerVertical="true"
                    android:layout_width="wrap_content"
                    android:background="@null"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/spinnerYearsimg"
                    android:drawSelectorOnTop="true"
                    android:layout_height="wrap_content"
                    />
                <ImageView
                    android:id="@+id/spinnerYearsimg"
                    android:layout_centerVertical="true"
                    android:layout_width="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_drop_down"
                    android:layout_marginEnd="@dimen/three"
                    android:tint="@color/black"
                    android:layout_height="wrap_content">

                </ImageView>

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="@dimen/one_fifty"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/five"
                android:layout_marginEnd="@dimen/thirty"
                android:background="@drawable/bg_white_light_radious"
                android:gravity="center">

                <Spinner
                    android:layout_marginStart="@dimen/three"
                    android:id="@+id/spinnerMonths"
                    android:layout_centerVertical="true"
                    android:layout_width="wrap_content"
                    android:background="@null"
                    android:layout_alignParentStart="true"
                    android:layout_toStartOf="@+id/spinnerMonthsimg"
                    android:drawSelectorOnTop="true"
                    android:layout_height="wrap_content"
                    />
                <ImageView
                    android:id="@+id/spinnerMonthsimg"
                    android:layout_centerVertical="true"
                    android:layout_width="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:src="@drawable/ic_drop_down"
                    android:layout_marginEnd="@dimen/three"
                    android:tint="@color/black"
                    android:layout_height="wrap_content">

                </ImageView>

            </RelativeLayout>

        </LinearLayout>



        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:id="@+id/linearagendalayout"
            android:layout_below="@+id/lnrSpinners"
            android:layout_marginTop="@dimen/five"
            android:layout_marginBottom="@dimen/five"
            android:layout_marginStart="@dimen/eighteen"
            android:orientation="vertical">

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fd_full_day"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp"
                style="@style/CustomTextStylePoppinsBold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/fh_first_half_morning_session"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp"
                android:layout_marginTop="@dimen/five"
                style="@style/CustomTextStylePoppinsBold" />
            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/sh_second_half_afternoon_session"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp"
                android:layout_marginTop="@dimen/five"
                style="@style/CustomTextStylePoppinsBold" />
        </LinearLayout>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/linearagendalayout">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycleAttendanceReports"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="visible"
                tools:listitem="@layout/giometric_attendance_report_item_list" />


            <ImageView
                android:id="@+id/imgNorecord"
                android:layout_width="match_parent"
                android:layout_height="@dimen/two_hundred"
                android:layout_centerInParent="true"
                android:src="@drawable/man_doing_fingerprint_research"
                android:visibility="gone">

            </ImageView>

            <TextView
                android:id="@+id/lblNoRecords"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/imgNorecord"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/twenty_five"
                android:layout_marginEnd="@dimen/twenty_five"
                android:gravity="center"
                android:text=""
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp"
                android:visibility="gone" />

        </RelativeLayout>


    </RelativeLayout>

    <LinearLayout
        android:id="@+id/rytAddLocation"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_alignParentBottom="true"
        android:layout_marginEnd="@dimen/ten"
        android:layout_marginBottom="@dimen/twenty"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:layout_gravity="center"
            android:src="@drawable/plus_circle">

        </ImageView>

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/five"
            android:text="@string/add_location"
            style="@style/CustomTextStylePoppinsBold"
            android:textColor="@color/navi_blue3"
            android:textSize="@dimen/thirteen_sp">

        </TextView>


    </LinearLayout>

</RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>
