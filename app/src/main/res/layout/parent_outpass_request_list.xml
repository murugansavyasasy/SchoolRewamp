<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardHeader"
    android:layout_marginBottom="@dimen/ten"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:strokeWidth="0.5dp"
    app:cardBackgroundColor="@color/white"
    app:strokeColor="@color/light_gray_11">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/twenty">
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:id="@+id/consReasonAndStatus"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintBottom_toTopOf="@+id/lblDestination"
            android:layout_height="wrap_content">
            <TextView
                app:layout_constraintHorizontal_chainStyle="spread"
                app:layout_constraintHorizontal_weight="1"
                android:id="@+id/lblReason"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="Leave Application"
                app:layout_constraintEnd_toStartOf="@+id/lblStatus"
                android:textSize="@dimen/fifteen_sp"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"></TextView>

            <TextView
                android:id="@+id/lblStatus"
                android:paddingVertical="@dimen/three"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                android:layout_width="0dp"
                android:gravity="center"
                app:layout_constraintHorizontal_weight="0.5"
                app:layout_constraintStart_toEndOf="@+id/lblReason"
                android:layout_height="wrap_content">

            </TextView>

        </androidx.constraintlayout.widget.ConstraintLayout>

        <TextView
            android:layout_marginTop="@dimen/five"
            android:id="@+id/lblLeaveDurationDays"
            app:layout_constraintBottom_toTopOf="@+id/view1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/CustomTextStylePoppinsMedium"
            android:textColor="@color/light_gray"
            android:textSize="@dimen/fourteen_sp"
            android:text="00 Feb 0000 - 00 Feb 0000"
            app:layout_constraintTop_toBottomOf="@+id/consReasonAndStatus"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

        </TextView>
        <View
            android:layout_width="0dp"
            android:layout_marginHorizontal="@dimen/fifteen"
            android:id="@+id/view1"
            android:layout_marginTop="@dimen/ten"
            app:layout_constraintBottom_toTopOf="@+id/lblRequestOn"
            app:layout_constraintTop_toBottomOf="@+id/lblLeaveDurationDays"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:background="@color/light_gray_11"
            android:layout_height="1dp">
        </View>


        <TextView
            android:layout_marginTop="@dimen/ten"
            android:id="@+id/lblRequestOn"
            app:layout_constraintBottom_toBottomOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            style="@style/CustomTextStylePoppinsMedium"
            android:textColor="@color/light_gray"
            android:textSize="@dimen/fourteen_sp"
            android:text="Requested :00 Feb 0000"
            app:layout_constraintTop_toBottomOf="@+id/view1"
            android:layout_width="0dp"
            android:layout_height="wrap_content">

        </TextView>




    </androidx.constraintlayout.widget.ConstraintLayout>
</com.google.android.material.card.MaterialCardView>