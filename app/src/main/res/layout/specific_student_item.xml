<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    app:cardBackgroundColor="@android:color/white">

    <LinearLayout
        android:id="@+id/lytName"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:padding="@dimen/ten">

        <!-- Circular Initial Avatar -->
        <RelativeLayout
            android:id="@+id/fytFirstLetter"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:layout_marginEnd="@dimen/ten"
            android:gravity="center">

            <TextView
                android:id="@+id/lblFirstLetter"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:text="S" />
        </RelativeLayout>

        <!-- Name and Details Section -->
        <LinearLayout
            android:id="@+id/lnrDetails"
            android:layout_width="@dimen/zero"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lblName"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="sathish             " />

            <TextView
                android:id="@+id/lblRegNo"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Ajith"
                android:textColor="@color/light_gray" />

        </LinearLayout>

        <!-- Down Arrow Animation -->
        <ImageView
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/fourty"
            android:layout_marginEnd="@dimen/thirty"
            android:padding="@dimen/five"
            android:src="@drawable/ic_down_round"
            android:visibility="gone" />

        <CheckBox
            android:id="@+id/cbSelect"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="@dimen/point_five"
        android:layout_below="@+id/lytName"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginTop="@dimen/five"
        android:layout_marginEnd="@dimen/ten"
        android:background="@color/grey_mild">

    </View>
</RelativeLayout>
