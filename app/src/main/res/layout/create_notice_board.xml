<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/light_white">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <RelativeLayout
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <include
            android:id="@+id/toolbarLayout"
            layout="@layout/school_side_tool_bar" />

        <ScrollView
            android:id="@+id/noticeboardCreate"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/toolbarLayout"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:scrollbars="none"
            android:visibility="visible">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/ten">


                <RelativeLayout
                    android:id="@+id/rytTitle"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/lblEventTitle"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/fifteen"
                        android:layout_marginTop="@dimen/twenty"
                        android:text="@string/Title" />

                    <TextView
                        android:id="@+id/lblStar"
                        android:layout_centerVertical="true"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/two"
                        android:layout_marginTop="@dimen/eighteen"
                        android:layout_toEndOf="@id/lblEventTitle"
                        android:text="@string/mandatory"
                        android:textColor="@color/red"
                        />

                    <RelativeLayout
                        android:id="@+id/rytHistory"
                        android:layout_centerVertical="true"
                        android:layout_alignParentEnd="true"
                        android:layout_marginStart="@dimen/twenty"
                        android:layout_marginTop="@dimen/twenty"
                        android:layout_marginEnd="@dimen/fifteen"
                        android:paddingHorizontal="@dimen/ten"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:layout_centerVertical="true"
                            android:id="@+id/imgHistory"
                            android:layout_width="@dimen/twenty"
                            android:layout_height="@dimen/twenty"
                            android:layout_marginTop="@dimen/ten"
                            android:backgroundTint="@color/PrimaryColor"
                            android:layout_marginEnd="@dimen/five"
                            android:src="@drawable/ic_history">

                        </ImageView>

                        <TextView
                            android:layout_centerVertical="true"
                            android:layout_toEndOf="@+id/imgHistory"
                            android:id="@+id/btnNoticeBoardReport"
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="History >>"
                            android:textColor="@color/PrimaryColor" />

                    </RelativeLayout>


                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/lnrTitle"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/fourty_five"
                    android:layout_below="@+id/rytTitle"
                    android:layout_marginStart="@dimen/fifteen"
                    android:layout_marginEnd="@dimen/ten"
                    android:background="@drawable/field_background"
                    android:gravity="center_vertical"
                    android:orientation="horizontal">

                    <EditText
                        android:id="@+id/txtTitle"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/lblEventTitle"
                        android:layout_alignStart="@+id/lblEventTitle"
                        android:background="@android:color/transparent"
                        android:inputType="text"
                        android:paddingHorizontal="@dimen/ten"
                        android:paddingBottom="@dimen/ten" />

                </LinearLayout>

                <TextView
                    android:id="@+id/lbtitleTextCount"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lnrTitle"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/fifteen"
                    android:text="0 / 50"
                    android:visibility="gone"
                    android:textSize="@dimen/thirteen_sp" />

                <TextView
                    android:id="@+id/lblEventDesc"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lbtitleTextCount"
                    android:layout_alignStart="@+id/lnrTitle"
                    android:layout_marginTop="@dimen/ten"
                    android:text="@string/Description"
                    />

                <TextView
                    android:id="@+id/lblStar2"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lbtitleTextCount"
                    android:layout_marginStart="@dimen/two"
                    android:layout_marginTop="@dimen/eight"
                    android:layout_toEndOf="@id/lblEventDesc"
                    android:text="@string/mandatory"
                    android:textColor="@color/red"
                    android:textSize="@dimen/thirteen_sp" />

                <RelativeLayout
                    android:id="@+id/rytDesc"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/one_twenty"
                    android:layout_below="@+id/lblEventDesc"
                    android:layout_alignStart="@+id/lblEventDesc"
                    android:layout_alignEnd="@+id/lnrTitle"
                    android:layout_marginTop="@dimen/fifteen"
                    android:background="@drawable/field_background"
                    android:paddingHorizontal="@dimen/ten"
                    android:paddingVertical="@dimen/ten">

                    <EditText
                        android:id="@+id/txtDesc"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:background="@android:color/transparent"
                        android:gravity="top"
                        android:hint="@string/Description" />
                </RelativeLayout>

                <TextView
                    android:id="@+id/lbTextCount"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rytDesc"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/fifteen"
                    android:visibility="gone"
                    android:text="0 / 500" />

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lbTextCount"
                    android:layout_alignStart="@+id/rytDesc"
                    android:layout_alignEnd="@+id/rytDesc"
                    android:layout_marginTop="@dimen/ten">

                    <RelativeLayout
                        android:id="@+id/rytEventDateTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/lblStart"
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ten"
                            android:text="@string/notice_active_period"
                            />

                        <TextView
                            android:id="@+id/lblStar3"
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/two"
                            android:layout_marginTop="@dimen/eight"
                            android:layout_toEndOf="@id/lblStart"
                            android:text="@string/mandatory"
                            android:textColor="@color/red" />

                        <LinearLayout
                            android:id="@+id/rytStart"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_below="@+id/lblStart"
                            android:layout_marginTop="@dimen/ten"
                            android:gravity="center"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <RelativeLayout
                                android:id="@+id/rytStartDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center">
                                <TextView
                                    android:id="@+id/lblFrom"
                                    android:layout_width="wrap_content"
                                    style="@style/CustomTextStylePoppinsBold"
                                    android:text="@string/from"
                                    android:layout_height="wrap_content">
                                </TextView>

                                <RelativeLayout
                                    android:layout_marginTop="@dimen/five"
                                    android:layout_below="@+id/lblFrom"
                                    android:id="@+id/lnrStartCalendar"
                                    android:paddingHorizontal="@dimen/five"
                                    android:paddingVertical="@dimen/three"
                                    android:background="@drawable/black_stroke_bg_radius"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">
                                    <ImageView
                                        android:layout_centerVertical="true"
                                        android:id="@+id/imgCalendar"
                                        android:layout_alignParentStart="true"
                                        android:layout_width="@dimen/twenty_five"
                                        android:src="@drawable/calender_icon2"
                                        android:layout_height="@dimen/twenty_five">

                                    </ImageView>
                                    <LinearLayout
                                        android:layout_toEndOf="@+id/imgCalendar"
                                        android:id="@+id/lnrDateDetails"
                                        android:layout_centerVertical="true"
                                        android:layout_width="wrap_content"
                                        android:layout_marginEnd="@dimen/five"
                                        android:orientation="vertical"
                                        android:layout_marginStart="@dimen/five"
                                        android:layout_height="wrap_content">
                                        <TextView
                                            android:id="@+id/lblDay"
                                            android:layout_width="wrap_content"
                                            android:text=""
                                            style="@style/CustomTextStylePoppinsRegular"
                                            android:textSize="@dimen/eleven_sp"
                                            android:textColor="@color/mild_grey_dark"
                                            android:layout_height="wrap_content">
                                        </TextView>
                                        <TextView
                                            android:id="@+id/txtStartDate"
                                            android:layout_width="wrap_content"
                                            android:text=""
                                            style="@style/CustomTextStylePoppinsBold"
                                            android:layout_height="wrap_content">
                                        </TextView>
                                    </LinearLayout>

                                </RelativeLayout>


                            </RelativeLayout>

                            <ImageView
                                android:id="@+id/imagearrow_view"
                                android:layout_width="@dimen/eighteen"
                                android:layout_height="@dimen/eighteen"
                                android:layout_weight="1"
                                android:src="@drawable/exchangearrow">
                            </ImageView>

                            <RelativeLayout
                                android:id="@+id/rytEndDate"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center">

                                <TextView
                                    android:id="@+id/lblTo"
                                    android:layout_width="wrap_content"
                                    style="@style/CustomTextStylePoppinsBold"
                                    android:text="@string/to"
                                    android:layout_height="wrap_content">
                                </TextView>
                                <RelativeLayout
                                    android:layout_below="@+id/lblTo"
                                    android:layout_marginTop="@dimen/five"
                                    android:paddingHorizontal="@dimen/five"
                                    android:paddingVertical="@dimen/three"
                                    android:background="@drawable/black_stroke_bg_radius"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content">
                                    <ImageView
                                        android:layout_centerVertical="true"
                                        android:id="@+id/lnrEndCalendar"
                                        android:layout_alignParentStart="true"
                                        android:layout_width="@dimen/twenty_five"
                                        android:src="@drawable/calender_icon2"
                                        android:layout_height="@dimen/twenty_five">

                                    </ImageView>
                                    <LinearLayout
                                        android:layout_marginEnd="@dimen/five"
                                        android:layout_toEndOf="@+id/lnrEndCalendar"
                                        android:id="@+id/bottomdaylinear1"
                                        android:layout_centerVertical="true"
                                        android:layout_width="wrap_content"
                                        android:orientation="vertical"
                                        android:layout_marginStart="@dimen/five"
                                        android:layout_height="wrap_content">
                                        <TextView
                                            android:id="@+id/lblEndDay"
                                            android:layout_width="wrap_content"
                                            android:text=""
                                            style="@style/CustomTextStylePoppinsRegular"
                                            android:textSize="@dimen/eleven_sp"
                                            android:textColor="@color/mild_grey_dark"
                                            android:layout_height="wrap_content">
                                        </TextView>
                                        <TextView
                                            android:id="@+id/txtEndDate"
                                            android:layout_width="wrap_content"
                                            android:text=""
                                            style="@style/CustomTextStylePoppinsBold"
                                            android:layout_height="wrap_content">
                                        </TextView>
                                    </LinearLayout>

                                </RelativeLayout>

                            </RelativeLayout>
                        </LinearLayout>

                        <RelativeLayout
                            android:id="@+id/rlaFilePicking"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_below="@+id/rytStart"
                            android:layout_marginTop="@dimen/five">

                            <TextView
                                android:id="@+id/lblAddPhoto"
                                style="@style/CustomTextStylePoppinsBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginTop="@dimen/ten"
                                android:text="@string/add_attachment">
                            </TextView>

                            <TextView
                                android:id="@+id/lblOptional"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_marginStart="@dimen/eight"
                                android:layout_marginTop="@dimen/ten"
                                android:layout_toEndOf="@+id/lblAddPhoto"
                                android:text="@string/Optional"
                                style="@style/CustomTextStylePoppinsBold"
                                android:textColor="@color/mild_grey1"
                                android:textSize="@dimen/thirteen_sp">
                            </TextView>

                            <ImageView
                                android:layout_width="@dimen/twenty_five"
                                android:layout_height="@dimen/twenty_five"
                                android:layout_alignParentEnd="true"
                                android:layout_marginTop="@dimen/ten"
                                android:layout_marginEnd="@dimen/twenty"
                                android:src="@drawable/ic_attach_file">

                            </ImageView>

                            <RelativeLayout
                                android:id="@+id/rytRecyclewview"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/lblAddPhoto">

                                <androidx.recyclerview.widget.RecyclerView
                                    android:id="@+id/rcyImages"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ten"
                                    android:orientation="vertical">
                                </androidx.recyclerview.widget.RecyclerView>

                            </RelativeLayout>

                            <TextView
                                android:id="@+id/btnNext"
                                style="@style/CustomTextStylePoppinsBold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_below="@id/rytRecyclewview"
                                android:layout_marginStart="@dimen/twenty_five"
                                android:layout_marginTop="@dimen/thirty"
                                android:layout_marginEnd="@dimen/twenty_five"
                                android:layout_marginBottom="@dimen/thirty"
                                android:background="@drawable/rect_btn_orange"
                                android:gravity="center"
                                android:padding="@dimen/ten"
                                android:text="@string/NEXT"
                                android:textColor="@color/white">
                            </TextView>
                        </RelativeLayout>
                    </RelativeLayout>
                </RelativeLayout>
            </RelativeLayout>
        </ScrollView>


