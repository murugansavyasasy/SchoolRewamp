<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dual_color_background">


    <TextView
        android:id="@+id/lblNoRecord"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:gravity="center"
        android:text="@string/no_records_found"
        android:textColor="@color/black"
        android:textSize="@dimen/fifteen_sp"
        android:textStyle="bold"
        android:visibility="gone">

    </TextView>


    <RelativeLayout
        android:id="@+id/relative_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginBottom="10dp">

        <ImageView
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/eight"
            android:layout_marginTop="@dimen/twenty"
            android:src="@drawable/left_arrow" />

        <TextView
            android:id="@+id/backtext"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/back"
            android:layout_marginStart="@dimen/eight"
            android:layout_toEndOf="@id/back"
            android:text="@string/my_coupons"
            android:textColor="@color/black"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgSearchToolBar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/twenty"
            android:layout_marginEnd="@dimen/twenty"
            android:src="@drawable/search_icon_white" />


    </RelativeLayout>


    <LinearLayout
        android:id="@+id/linearlayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/thirty_five"
        android:layout_below="@+id/relative_layout"
        android:layout_margin="@dimen/sixteen"
        android:background="@drawable/bg_search"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingHorizontal="@dimen/twele"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgSearch"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:src="@drawable/search_icon" />

        <EditText
            android:id="@+id/editSearch"
            android:layout_width="@dimen/zero"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:layout_weight="1"
            android:background="@null"
            android:hint="@string/search"
            android:textColor="@color/black"
            android:textColorHint="@color/light_gray_7"
            android:textSize="@dimen/sixteen_sp"
            android:visibility="visible" />
    </LinearLayout>


    <include
        android:id="@+id/coupontablayout"
        layout="@layout/coupon_tablayout" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/coupontablayout"
        android:layout_marginStart="10dp"
        android:layout_marginTop="10dp"
        android:layout_marginEnd="10dp"
        android:layout_marginBottom="@dimen/five"
        android:clipToPadding="false"
        android:scrollIndicators="none"
        android:scrollbars="vertical" />


    <ProgressBar
        android:id="@+id/isProgressBar"
        android:layout_width="@dimen/fifty"
        android:layout_height="@dimen/fifty"
        android:layout_below="@+id/coupontablayout"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/fourty"
        android:visibility="visible">

    </ProgressBar>

    <ImageView
        android:id="@+id/nomessage"
        android:layout_width="@dimen/two_fifty"
        android:layout_height="@dimen/two_fifty"
        android:layout_centerInParent="true"
        android:layout_gravity="center"
        android:src="@drawable/no_search_message"
        android:textColor="@color/black"
        android:textSize="@dimen/eighteen_sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtNoData"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/nomessage"
        android:layout_centerInParent="true"
        android:layout_gravity="center"
        android:gravity="center"
        android:text="@string/no_list_found"
        android:textSize="@dimen/eighteen_sp"
        android:visibility="gone" />


</RelativeLayout>