<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_marginEnd="@dimen/six"
    android:orientation="vertical">

    <LinearLayout
        android:id="@+id/itemRoot"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_item_root_selector"
        android:gravity="center"
        android:orientation="vertical"
        android:padding="@dimen/five">

        <TextView
            android:id="@+id/tvMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginBottom="6dp"
            android:text="Sep"
            android:textColor="#000000"
            android:textSize="@dimen/thirteen_sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/tvDay"
            android:layout_width="@dimen/fourty"
            android:layout_height="@dimen/fourty"
            android:layout_marginTop="@dimen/ten"
            android:background="@drawable/bg_day_selector"
            android:gravity="center"
            android:text="11"
            android:textColor="#000000"
            android:textSize="@dimen/fifteen_sp"
            android:textStyle="bold" />
    </LinearLayout>

    <TextView
        android:id="@+id/lblSlotCount"
        style="@style/CustomTextStylePoppinsMedium"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/ten"
        android:text=""
        android:textColor="@color/red"
        android:textSize="@dimen/ten"></TextView>

</LinearLayout>
