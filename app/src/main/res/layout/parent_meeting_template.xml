<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_marginBottom="@dimen/ten"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_marginStart="@dimen/ten"
    app:cardCornerRadius="@dimen/ten"
    android:layout_marginEnd="@dimen/ten"
    android:layout_height="wrap_content">
    <LinearLayout
        android:layout_marginBottom="@dimen/five"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="wrap_content">
        <TextView
            android:layout_marginTop="@dimen/ten"
            android:id="@+id/title"
            android:layout_width="match_parent"
            android:text="@string/parent_meeting"
            android:textStyle="bold"
            android:textSize="@dimen/sixteen_sp"
            android:layout_height="wrap_content">
        </TextView>
        <TextView
            android:id="@+id/staffandsubjectdetails"
            android:layout_marginTop="@dimen/ten"
            android:layout_width="match_parent"
            android:text="@string/staff_and_subject_details"
            android:textStyle="bold"
            android:textSize="@dimen/fourteen_sp"
            android:layout_height="wrap_content">
        </TextView>
        <TextView
            android:layout_marginTop="@dimen/ten"
            android:layout_width="match_parent"
            android:text="@string/phone_call"
            android:drawableStart="@drawable/phone_call"
            android:textColor="@color/azure_radiance"
            android:textStyle="bold"
            android:drawablePadding="@dimen/ten"
            android:layout_height="wrap_content">
        </TextView>
        <TextView
            android:layout_marginTop="@dimen/ten"
            android:layout_width="match_parent"
            android:text="@string/available_slots"
            android:drawableStart="@drawable/available_slots"
            android:textStyle="bold"
            android:drawablePadding="@dimen/ten"
            android:layout_height="wrap_content">
        </TextView>

        <androidx.recyclerview.widget.RecyclerView
            android:layout_marginTop="@dimen/ten"
            android:background="@drawable/ptm_time_slot_black_outline"
            android:id="@+id/time_slot"
            android:padding="@dimen/ten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">
        </androidx.recyclerview.widget.RecyclerView>
    </LinearLayout>

</androidx.cardview.widget.CardView>