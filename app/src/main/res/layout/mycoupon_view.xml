<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fillViewport="true"
   >


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/twenty">

        <ImageView
            android:id="@+id/outer2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/back"
            android:layout_marginTop="16dp"
            android:adjustViewBounds="true"
            android:scaleType="fitCenter"
            app:srcCompat="@drawable/subtract1" />

        <ImageView
            android:id="@+id/back"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/five"
            android:layout_marginTop="@dimen/two"
            android:src="@drawable/left_arrow" />

        <ImageView
            android:id="@+id/outer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:adjustViewBounds="true"
            android:layout_below="@+id/back"
            android:layout_marginTop="16dp"
            android:scaleType="fitCenter"
            android:src="@drawable/subtract1" />


        <RelativeLayout
            android:id="@+id/relative"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/eighty">

            <ImageView
                android:id="@+id/logo"
                android:layout_width="match_parent"
                android:layout_height="@dimen/hundred"
                android:src="@drawable/dizzeworldlogo" />


            <ImageView
                android:id="@+id/vector"
                android:layout_width="match_parent"
                android:layout_height="@dimen/thirty"
                android:layout_below="@id/logo"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/sixty"
                android:layout_marginEnd="@dimen/twenty"
                android:src="@drawable/vectorimage" />
        </RelativeLayout>

        <LinearLayout
            android:id="@+id/linear"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/relative"
            android:layout_marginTop="@dimen/eighty"
            android:gravity="center"
            android:orientation="vertical">

            <TextView
                android:id="@+id/header"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="McDonald's"
                android:textSize="@dimen/twenty_four_sp" />

            <TextView
                android:id="@+id/offer"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="40% Off"
                android:textColor="@color/clr_red"
                android:textSize="@dimen/twenty_four_sp" />

            <TextView
                android:id="@+id/description"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:gravity="center"
                android:text="Just show the Coupon Codeat the point of payment after you feast at Carl's Kitchen Store"
                android:textSize="@dimen/fourteen_sp" />


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="@dimen/seventy"
                    android:background="@drawable/dashed_bordercouponview"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="@dimen/twele">

                    <TextView
                        android:id="@+id/couponCode"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="@dimen/zero"
                        android:layout_height="wrap_content"
                        android:layout_weight="1"
                        android:gravity="center"
                        android:text="jhav-bvbu-vffno"
                        android:textColor="@color/black"
                        android:textSize="@dimen/sixteen_sp" />

                    <ImageView
                        android:id="@+id/copyIcon"
                        android:layout_width="@dimen/twenty_four"
                        android:layout_height="@dimen/twenty_four"
                        android:layout_marginStart="@dimen/eight"
                        android:contentDescription="Copy"
                        android:src="@drawable/copy1" />
                </LinearLayout>


            </RelativeLayout>


        </LinearLayout>

        <LinearLayout
            android:id="@+id/linearlayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/outer"
            android:layout_marginStart="@dimen/five"
            android:layout_marginTop="@dimen/twenty"
            android:layout_marginEnd="@dimen/five"
            android:background="@drawable/rounded_grey_background"
            android:gravity="center_horizontal"
            android:orientation="vertical"
            android:padding="@dimen/sixteen">

            <!-- Title -->
            <TextView
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/twele"
                android:text="@string/appointment_booking_details"
                android:textColor="@color/black"
                android:textSize="@dimen/eighteen_sp"
                android:textStyle="bold" />

            <!-- Date, Time, Venue section -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="horizontal"
                android:weightSum="3">

                <!-- Date -->
                <LinearLayout
                    android:layout_width="@dimen/zero"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/date"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fourteen_sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="15/04/2025"
                        android:textColor="@color/gnt_gray"
                        android:textSize="@dimen/fourteen_sp"
                        android:textStyle="normal" />
                </LinearLayout>

                <!-- Time -->
                <LinearLayout
                    android:layout_width="@dimen/zero"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/time"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fourteen_sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="09:10 AM"
                        android:textColor="@color/gnt_gray"
                        android:textSize="@dimen/fourteen_sp"
                        android:textStyle="normal" />
                </LinearLayout>

                <!-- Venue -->
                <LinearLayout
                    android:layout_width="@dimen/zero"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:gravity="center_horizontal"
                    android:orientation="vertical">

                    <TextView
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Venue"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fourteen_sp"
                        android:textStyle="bold" />

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="T.Nagar"
                        android:textColor="@color/gnt_gray"
                        android:textSize="@dimen/fourteen_sp"
                        android:textStyle="normal" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/linear2"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/linearlayout"
            android:layout_alignStart="@+id/linearlayout"
            android:layout_marginTop="@dimen/eight"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lblLocationName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Carl's Kitchen"
                android:textColor="@color/black"
                android:textSize="@dimen/sixteen_sp"
                android:textStyle="bold" />


            <TextView
                android:id="@+id/lblValidUnit"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Valid Until 01/05/2025"
                android:textColor="@color/black"
                android:textSize="@dimen/sixteen_sp"
                android:textStyle="normal" />

            <TextView
                android:id="@+id/lblAddress"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:drawableStart="@drawable/location_icon"
                android:drawablePadding="@dimen/two"
                android:text="Marina Mall"
                android:textColor="@color/black"
                android:textSize="@dimen/sixteen_sp"
                android:textStyle="normal" />


        </LinearLayout>

    </RelativeLayout>
</ScrollView>