<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:paddingBottom="14dp">

    <TextView
        android:id="@+id/txtMergeSubjectName"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="MATHS"
        android:textColor="#1A1A2E"
        android:textSize="14sp"
        android:textStyle="bold"
        android:layout_marginBottom="8dp" />

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="46dp"
        android:orientation="horizontal"
        android:background="@drawable/toggle_group_bg">

        <Button
            android:id="@+id/btnMergeOption"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Merge"
            android:textSize="13sp"
            android:background="@color/white"
            android:textColor="@color/PrimaryColor" />

        <View
            android:layout_width="1dp"
            android:layout_height="match_parent"
            android:background="#E0E0E0" />

        <Button
            android:id="@+id/btnIndividualOption"
            android:layout_width="0dp"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:text="Individual"
            android:textSize="13sp"
            android:background="@color/white"
            android:textColor="@color/PrimaryColor" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginTop="4dp">

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="One shared test\nfor all sections"
            android:textColor="#9E9E9E"
            android:textSize="11sp" />

        <TextView
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:gravity="center"
            android:text="Separate test\nper section"
            android:textColor="#9E9E9E"
            android:textSize="11sp" />
    </LinearLayout>
</LinearLayout>