<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:layout_height="wrap_content">

    <com.facebook.shimmer.ShimmerFrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/twenty"
        android:id="@+id/shimmer_view_container"
        tools:ignore="MissingConstraints">

        <LinearLayout
            android:orientation="vertical"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

        <View
            android:id="@+id/shimmerDate"
            android:layout_width="@dimen/three_hundred"
            android:layout_height="16dp"
            android:background="@android:color/darker_gray"
            android:layout_marginBottom="@dimen/eight"/>

        <View
            android:id="@+id/shimmerTitle"
            android:layout_width="@dimen/two_hundred"
            android:layout_height="@dimen/sixteen"
            android:background="@android:color/darker_gray"
            android:layout_marginBottom="4dp"/>

        <View
            android:id="@+id/name"
            android:layout_width="@dimen/hundred"
            android:layout_height="@dimen/sixteen"
            android:background="@android:color/darker_gray"
            android:layout_marginBottom="@dimen/eight"/>

        <LinearLayout
            android:orientation="horizontal"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/twenty_four">

            <View
                android:layout_width="28dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/four"
                android:background="@android:color/darker_gray" />

            <View
                android:layout_width="24dp"
                android:layout_height="match_parent"
                android:layout_marginEnd="@dimen/four"
                android:background="@android:color/darker_gray" />
            <View
                android:layout_width="@dimen/twenty_four"
                android:layout_height="@dimen/twenty_four"
                android:background="@android:color/darker_gray"/>
        </LinearLayout>

        </LinearLayout>
    </com.facebook.shimmer.ShimmerFrameLayout>

</androidx.constraintlayout.widget.ConstraintLayout>
