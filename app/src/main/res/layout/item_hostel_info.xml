<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_marginBottom="@dimen/ten"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <TextView
        android:paddingVertical="@dimen/five"
        style="@style/CustomTextStylePoppinsMedium"
        android:textColor="@color/light_gray"
        app:layout_constraintHorizontal_chainStyle="spread"
        app:layout_constraintHorizontal_weight="0.7"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="0dp"
        android:layout_marginHorizontal="@dimen/five"
        app:layout_constraintEnd_toStartOf="@+id/lblValue"
        app:layout_constraintBottom_toBottomOf="@+id/br"
        android:id="@+id/lblKey"
        android:layout_height="wrap_content">

    </TextView>

    <TextView
        android:paddingVertical="@dimen/five"
        android:layout_marginHorizontal="@dimen/five"
        style="@style/CustomTextStylePoppinsMedium"
        app:layout_constraintHorizontal_weight="1"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toEndOf="@+id/lblKey"
        app:layout_constraintBottom_toTopOf="@+id/br"
        android:layout_width="0dp"
        android:gravity="end"
        android:id="@+id/lblValue"
        android:textColor="@color/black"
        android:layout_height="wrap_content">

    </TextView>
    <androidx.constraintlayout.widget.Barrier
        android:layout_width="wrap_content"
        app:barrierDirection="bottom"
        android:id="@+id/br"
        app:constraint_referenced_ids="lblKey,lblValue"
        android:layout_height="wrap_content">

    </androidx.constraintlayout.widget.Barrier>

    <View
        android:layout_marginTop="@dimen/five"
        app:layout_constraintBottom_toBottomOf="parent"
        android:background="@color/light_gray_11"
        app:layout_constraintTop_toBottomOf="@+id/br"
        android:id="@+id/view"
        android:layout_marginHorizontal="@dimen/five"
        android:layout_width="0dp"
        android:layout_height="1dp">

    </View>


</androidx.constraintlayout.widget.ConstraintLayout>