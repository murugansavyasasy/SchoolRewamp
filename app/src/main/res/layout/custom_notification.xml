<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:elevation="4dp"
    android:layout_marginStart="5dp"
    android:layout_marginEnd="5dp">

    <TextView
        android:id="@+id/notification_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:textSize="16sp"
        android:text="Coupon Features"
        style="@style/CustomTextStylePoppinsBold"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/notification_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:textSize="14sp"
        style="@style/CustomTextStylePoppinsMedium"
        android:layout_marginTop="8dp"
        android:text="Coupon Features Has Been Enabled on your device kindly check and engoy the feature"
        android:maxLines="3"
        android:ellipsize="end" />


    <ImageView
        android:id="@+id/notification_imageview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:layout_marginTop="8dp" />

</LinearLayout>
