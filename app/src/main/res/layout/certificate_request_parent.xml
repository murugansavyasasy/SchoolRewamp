<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/parent_side_tool_bar" />


    <RelativeLayout

        android:id="@+id/rytRequestTap"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbarLayout"

        android:layout_marginTop="@dimen/ten"
        android:background="@drawable/rect_shadow_white"
        android:visibility="visible">

        <TextView
            android:id="@+id/header_text"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_certificate"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/twenty"
            android:layout_marginStart="@dimen/ten"
            style="@style/CustomTextStylePoppinsBold"
            android:textSize="@dimen/thirteen_sp"/>

        <Spinner
            android:id="@+id/spinner_text"
            android:layout_width="match_parent"
            android:layout_height="@dimen/fourty"
            android:layout_below="@+id/header_text"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginStart="@dimen/ten"
            android:background="@drawable/spinner_bg"
            android:layout_marginEnd="@dimen/ten">
        </Spinner>

        <TextView
            android:id="@+id/header_text1"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/select_urgency_level"
            android:textColor="@color/black"
            android:textStyle="bold"
            android:layout_marginTop="@dimen/fifteen"
            android:layout_marginStart="@dimen/ten"
            android:layout_below="@+id/spinner_text"
            style="@style/CustomTextStylePoppinsBold"
            android:textSize="@dimen/thirteen_sp"/>

        <RadioGroup
            android:id="@+id/radioGroup"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/header_text1"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:orientation="horizontal">

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/radio_button_background"
                android:orientation="horizontal"
                android:layout_marginEnd="@dimen/five"
                android:padding="@dimen/five">

                <ImageView
                    android:id="@+id/ivradio"
                    android:layout_width="@dimen/twenty_four"
                    android:layout_height="@dimen/twenty_four"
                    android:layout_marginStart="@dimen/five"
                    android:src="@drawable/custom_radio_button"
                    android:layout_marginEnd="@dimen/five"/>

                <TextView
                    android:id="@+id/rb_not_urgent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/not_urgent"
                    android:layout_marginStart="@dimen/five"
                    android:textColor="@android:color/black"
                    android:textSize="@dimen/thirteen_sp"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_gravity="center_vertical"
                    android:button="@android:color/transparent"/>
            </LinearLayout>

            <LinearLayout
                android:layout_width="@dimen/zero"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:background="@drawable/radio_button_background"
                android:orientation="horizontal"
                android:layout_marginEnd="@dimen/five"
                android:padding="@dimen/five">

                <ImageView
                    android:id="@+id/ivradio1"
                    android:layout_width="@dimen/twenty_four"
                    android:layout_height="@dimen/twenty_four"
                    android:layout_marginStart="@dimen/five"
                    android:src="@drawable/custom_radio_button"
                    android:layout_marginEnd="@dimen/five"/>

                <TextView
                    android:id="@+id/rb_urgent"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:button="@android:color/transparent"
                    android:text="@string/urgent"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_marginStart="@dimen/five"
                    android:textSize="@dimen/thirteen_sp"
                    android:layout_gravity="center_vertical"
                    android:textColor="@android:color/black"/>
            </LinearLayout>

        </RadioGroup>


        <EditText
            android:id="@+id/txtReason"
            android:layout_width="match_parent"
            android:layout_height="@dimen/two_hundred"
            android:gravity="top"
            android:hint="Enter Reason"
            android:padding="@dimen/ten"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:layout_marginTop="@dimen/twenty"
            android:layout_below="@+id/radioGroup"
            android:fontFamily="@font/poppins_medium"
            android:textSize="@dimen/thirteen_sp"
            android:background="@drawable/text_bg"/>

        <Button
            android:id="@+id/btnSendCertificateRequest"
            android:layout_width="@dimen/two_fifty"
            android:layout_height="@dimen/fourty"
            android:text="@string/request_certificate"
            android:layout_below="@+id/txtReason"
            android:background="@drawable/bg_orange"
            android:textColor="@color/white"
            android:textSize="@dimen/eleven_sp"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_marginBottom="@dimen/twele"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/twenty_five"
            android:gravity="center"/>
    </RelativeLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/toolbarLayout"
        android:visibility="gone"
        android:layout_marginTop="@dimen/ten" />


    <LinearLayout
        android:id="@+id/lnrNoRecords"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical"
        android:visibility="gone">

        <ImageView
            android:id="@+id/nomessage"
            android:layout_width="@dimen/two_fifty"
            android:layout_height="@dimen/two_fifty"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/twenty"
            android:src="@drawable/nomessages"
            android:textColor="@color/black"
            android:textSize="@dimen/fifteen_sp" />

        <TextView
            android:id="@+id/txtNoData"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:layout_gravity="center"
            android:layout_marginTop="@dimen/twenty"
            android:text="@string/no_list_found"
            android:textColor="@color/black"
            android:textSize="@dimen/fifteen_sp" />
    </LinearLayout>


</RelativeLayout>
