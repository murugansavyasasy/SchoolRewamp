<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/rlaHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rect_shadow_white"
    android:clipChildren="false"
    android:clipToPadding="false"
    android:paddingStart="@dimen/five"
    android:paddingTop="@dimen/fifteen"
    android:paddingEnd="@dimen/five"
    android:paddingBottom="@dimen/five">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/ten"
        >
        <RelativeLayout
            android:paddingHorizontal="@dimen/ten"
            android:id="@+id/lnrDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten">

            <TextView
                android:id="@+id/lblLogo"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="@dimen/fourty"
                android:layout_height="@dimen/fourty"
                android:layout_centerVertical="true"
                android:background="@drawable/bg_light_blue_circle"
                android:backgroundTint="@color/PrimaryColor"
                android:gravity="center"
                android:text="SA"
                android:textColor="@color/white"
                android:textSize="@dimen/fourteen_sp" />

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/ten"
                android:layout_toEndOf="@+id/lblLogo"
                android:orientation="horizontal"
                android:weightSum="1"
                android:layout_height="wrap_content">
                <LinearLayout
                    android:layout_weight="0.5"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblName"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Dr. Senthana Abert"
                        android:textSize="@dimen/fourteen_sp" />

                    <TextView
                        android:id="@+id/lblRole"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text=" Vice Principal "
                        android:textColor="@color/light_gray"
                        android:textSize="@dimen/twele_sp" />
                </LinearLayout>

                <TextView
                    android:id="@+id/lblLeaveStatus"
                    android:layout_weight="0.45"
                    android:layout_width="0dp"
                    android:text="Causal"
                    android:layout_marginStart="@dimen/five"
                    android:layout_gravity="center"
                    android:paddingHorizontal="@dimen/three"
                    android:paddingVertical="@dimen/two"
                    android:gravity="center"
                    android:textColor="@color/white"
                    android:background="@drawable/bg_leave_approved"
                    android:layout_height="wrap_content">
                </TextView>
                <ImageView
                    android:layout_weight="0.05"
                    android:id="@+id/options"
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:layout_gravity="center"
                    android:contentDescription="Options"
                    android:src="@drawable/threedot" />

            </LinearLayout>
        </RelativeLayout>
        <LinearLayout
            android:paddingHorizontal="@dimen/ten"
            android:gravity="center"
            android:id="@+id/LnrCatoryDetails"
            android:layout_marginTop="@dimen/ten"
            android:layout_below="@+id/lnrDetails"
            android:layout_width="match_parent"
            android:orientation="horizontal"
            android:weightSum="4"
            android:layout_height="wrap_content">

            <LinearLayout
                android:layout_weight="1"
                android:layout_width="0dp"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_height="wrap_content">
                <ImageView
                    android:src="@drawable/hospital_icon"
                    android:layout_width="@dimen/twenty_five"
                    android:padding="@dimen/three"
                    android:layout_height="@dimen/twenty_five">
                </ImageView>
                <TextView
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:text="@string/type"
                    android:textAllCaps="true"
                    android:textColor="@color/light_gray"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:textSize="@dimen/twele_sp"
                    android:layout_height="wrap_content">
                </TextView>
                <TextView
                    android:gravity="center"
                    android:id="@+id/lblLeaveType"
                    android:text="Casual"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                </TextView>
            </LinearLayout>

            <LinearLayout
                android:layout_weight="1"
                android:layout_width="0dp"
                android:gravity="center"
                android:orientation="vertical"
                android:layout_height="wrap_content">

                <ImageView
                    android:src="@drawable/stopwatch_gray"
                    android:layout_width="@dimen/twenty_five"

                    android:layout_height="@dimen/twenty_five"></ImageView>
                <TextView
                    android:gravity="center"
                    android:id="@+id/lbltxtDays"
                    android:layout_width="match_parent"
                    android:text="@string/days"
                    android:textAllCaps="true"
                    android:textColor="@color/light_gray"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:textSize="@dimen/twele_sp"
                    android:layout_height="wrap_content">

                </TextView>
                <TextView
                    android:gravity="center"
                    android:id="@+id/lblDays"
                    android:text="3"
                    android:layout_width="match_parent"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_height="wrap_content">

                </TextView>
            </LinearLayout>

            <LinearLayout
                android:gravity="center"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:orientation="vertical"
                android:layout_height="wrap_content">
                <ImageView
                    android:src="@drawable/calendar_icon_5"
                    android:layout_width="@dimen/twenty_five"
                    android:layout_height="@dimen/twenty_five">
                </ImageView>
                <TextView
                    android:gravity="center"
                    android:layout_width="match_parent"
                    android:text="@string/Start"
                    android:textAllCaps="true"
                    android:textColor="@color/light_gray"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:textSize="@dimen/twele_sp"
                    android:layout_height="wrap_content">

                </TextView>
                <TextView
                    android:id="@+id/lblStartDate"
                    android:layout_width="match_parent"
                    android:text="Feb 16"
                    android:gravity="center"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_height="wrap_content">

                </TextView>
            </LinearLayout>

            <LinearLayout
                android:gravity="center"
                android:layout_weight="1"
                android:layout_width="0dp"
                android:orientation="vertical"
                android:layout_height="wrap_content">
                <ImageView
                    android:src="@drawable/calendar_icon_5"
                    android:layout_width="@dimen/twenty_five"
                    android:layout_height="@dimen/twenty_five">
                </ImageView>
                <TextView
                    android:layout_width="match_parent"
                    android:gravity="center"
                    android:text="@string/end"
                    android:textColor="@color/light_gray"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:textSize="@dimen/twele_sp"
                    android:layout_height="wrap_content">

                </TextView>
                <TextView
                    android:gravity="center"
                    android:id="@+id/lblEndDate"
                    android:text="Feb 29"
                    android:layout_width="match_parent"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_height="wrap_content">

                </TextView>
            </LinearLayout>



        </LinearLayout>

        <LinearLayout
            android:layout_marginHorizontal="@dimen/five"
            android:id="@+id/LnrReason"
            android:layout_marginTop="@dimen/ten"
            android:layout_below="@+id/LnrCatoryDetails"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:padding="@dimen/eight"
            android:background="@color/light_gray1"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/lblReason"
                android:layout_width="wrap_content"
                android:text="@string/reason_for_leave"
                style="@style/CustomTextStylePoppinsMedium"
                android:textColor="@color/light_gray"
                android:layout_height="wrap_content">
            </TextView>

            <TextView
                android:id="@+id/Reason"
                android:layout_width="wrap_content"
                android:text="I am having cold"
                android:layout_marginTop="@dimen/five"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_height="wrap_content">

            </TextView>

        </LinearLayout>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_below="@+id/LnrReason"
            android:layout_width="match_parent"
            android:id="@+id/ConsStatusButton"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten"
            android:paddingHorizontal="@dimen/ten">

            <TextView
                android:id="@+id/btnCancel"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/reject"
                android:gravity="center"
                android:layout_marginHorizontal="@dimen/ten"
                android:paddingVertical="@dimen/eight"
                android:textColor="@color/red"
                android:background="@drawable/red_stoke_rect_radius"
                style="@style/CustomTextStylePoppinsBold"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toStartOf="@id/btnApprove"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintHorizontal_weight="1" />

            <TextView
                android:id="@+id/btnApprove"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/approve"
                android:textColor="@color/white"
                android:gravity="center"
                android:layout_marginHorizontal="@dimen/ten"
                android:paddingVertical="@dimen/eight"
                style="@style/CustomTextStylePoppinsBold"
                android:background="@drawable/green_bg_radius"
                app:layout_constraintStart_toEndOf="@id/btnCancel"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintHorizontal_weight="1" />

        </androidx.constraintlayout.widget.ConstraintLayout>


    </RelativeLayout>

    <!-- Floating Menu -->
    <RelativeLayout
        android:id="@+id/relbuttons"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="top|end"
        android:layout_marginTop="@dimen/fourty"
        android:layout_marginEnd="@dimen/ten"
        android:background="@drawable/rect_shadow_white_2"
        android:elevation="@dimen/ten"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/deletebutton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/three"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/three">

            <ImageView
                android:layout_width="@dimen/sixteen"
                android:layout_height="@dimen/sixteen"
                android:layout_marginEnd="@dimen/six"
                android:src="@drawable/cross_delete_icon" />

            <TextView
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/Cancel"
                android:textColor="@color/red"
                android:textSize="@dimen/fifteen_sp" />
        </LinearLayout>

        <LinearLayout
            android:id="@+id/editbutton"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/deletebutton"
            android:layout_margin="@dimen/three"
            android:layout_marginBottom="@dimen/three"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:padding="@dimen/three">

            <ImageView
                android:layout_width="@dimen/sixteen"
                android:layout_height="@dimen/sixteen"
                android:layout_marginEnd="@dimen/six"
                android:src="@drawable/edit_icon_1" />

            <TextView
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/edit"
                android:textColor="@color/iconBlue"
                android:textSize="@dimen/fifteen_sp" />
        </LinearLayout>
    </RelativeLayout>

</FrameLayout>
