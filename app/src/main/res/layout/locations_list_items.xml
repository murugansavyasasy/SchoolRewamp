<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_marginBottom="@dimen/five"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/five"
    android:layout_marginVertical="@dimen/ten"
    android:clipChildren="true"
    android:clipToPadding="true"
    app:cardCornerRadius="@dimen/ten"
>
    <androidx.constraintlayout.widget.ConstraintLayout

        android:padding="@dimen/five"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            app:layout_constraintTop_toTopOf="parent">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <RelativeLayout
                    android:id="@+id/rytImgLocation"
                    android:layout_width="@dimen/fourty"
                    android:layout_height="@dimen/fourty"
                    android:layout_centerVertical="true"
                    android:background="@drawable/circle_bg_light_blue"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/twenty"
                        android:layout_height="@dimen/twenty"
                        android:layout_centerInParent="true"
                        android:src="@drawable/location_icon_2" />
                </RelativeLayout>


                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_toStartOf="@+id/rytImgEdit"
                    android:layout_toEndOf="@+id/rytImgLocation"
                    android:orientation="vertical">

                    <TextView
                        android:id="@+id/lblPlace"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Chennai"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fifteen_sp" />

                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/rytImgEdit"
                    android:layout_width="@dimen/fourty"
                    android:layout_height="@dimen/fourty"
                    android:layout_centerVertical="true"
                    android:layout_toStartOf="@+id/rytImgDelete"
                    android:background="@drawable/circle_bg_light_blue"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/fifteen"
                        android:layout_height="@dimen/fifteen"
                        android:layout_centerInParent="true"
                        android:src="@drawable/edit_icon_blue" />
                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rytImgDelete"
                    android:layout_width="@dimen/fourty"
                    android:layout_height="@dimen/fourty"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/ten"
                    android:background="@drawable/circle_bg_light_red"
                    android:orientation="vertical">

                    <ImageView
                        android:layout_width="@dimen/fifteen"
                        android:layout_height="@dimen/fifteen"
                        android:layout_centerInParent="true"
                        android:src="@drawable/delete_icon_blue"
                        android:tint="@color/PrimaryColor"
                        />
                </RelativeLayout>

            </RelativeLayout>



            <TextView
                android:id="@+id/lblAddress"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fourty"
                android:layout_marginTop="@dimen/five"
                android:background="@drawable/rect_bg_light_blue"
                android:paddingVertical="@dimen/five"
                android:paddingStart="@dimen/ten"
                android:paddingRight="@dimen/twenty"
                android:text="Work Place"
                android:textColor="@color/PrimaryColor"
                android:textSize="@dimen/thirteen_sp" />

            <RelativeLayout
                android:id="@+id/rytAddress"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/five"
                android:layout_marginTop="@dimen/fifteen"
                android:orientation="vertical">

                <ImageView
                    android:id="@+id/imgAddress"
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:layout_centerVertical="true"
                    android:src="@drawable/share_icon_2" />

                <TextView
                    android:id="@+id/lblLatLang"
                    style="@style/CustomTextStylePoppinsRegular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_toEndOf="@+id/imgAddress"
                    android:text="Chennai"
                    android:textColor="@color/mild_grey_dark"
                    android:textSize="@dimen/thirteen_sp" />

            </RelativeLayout>

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginTop="@dimen/fifteen"
                android:orientation="vertical">


                <RelativeLayout
                    android:layout_marginStart="@dimen/five"
                    android:layout_alignParentStart="true"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/lblDot"
                        android:layout_centerVertical="true"
                        android:layout_width="@dimen/ten"
                        android:layout_height="@dimen/ten"
                        android:background="@drawable/circle_bg_green" />

                    <TextView
                        android:id="@+id/lblDistance"
                        android:layout_centerVertical="true"
                        style="@style/CustomTextStylePoppinsRegular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/five"
                        android:layout_toEndOf="@+id/lblDot"
                        android:text="10 Meter"
                        android:textColor="@color/mild_grey_dark"
                        android:textSize="@dimen/thirteen_sp" />

                </RelativeLayout>

                <RelativeLayout
                    android:visibility="gone"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="@dimen/five"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:layout_centerVertical="true"
                        android:id="@+id/imgTime"
                        android:layout_width="@dimen/twenty"
                        android:layout_height="@dimen/twenty"
                        android:src="@drawable/time_icon"
                        android:tint="@color/mild_grey_dark"
                        />

                    <TextView
                        android:layout_centerVertical="true"
                        style="@style/CustomTextStylePoppinsRegular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/five"
                        android:layout_toEndOf="@+id/imgTime"
                        android:text="2 hours ago"
                        android:textColor="@color/mild_grey_dark"
                        android:textSize="@dimen/thirteen_sp" />

                </RelativeLayout>


            </RelativeLayout>


        </LinearLayout>

