<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:fitsSystemWindows="true"
    android:fillViewport="true"
    android:background="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/toolbarLayout"
            layout="@layout/school_side_tool_bar" />

        <RelativeLayout
            android:gravity="center"
            android:id="@+id/AcademicYear"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/toolbarLayout"
            android:orientation="horizontal"
            android:layout_marginStart="@dimen/five"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/ten">

            <TextView
                android:layout_centerVertical="true"
                android:id="@+id/lblAcademicYearPick"
                android:layout_width="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_height="wrap_content"
                android:text="@string/choose_academic_year"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp"
                style="@style/CustomTextStylePoppinsBold"></TextView>

            <RelativeLayout
                android:layout_toEndOf="@+id/lblAcademicYearPick"
                android:layout_alignParentEnd="true"
                android:id="@+id/rytAcademicYearDropDown"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/twenty"
                android:background="@drawable/bg_white_light_radious">

                <Spinner
                    android:id="@+id/isSpinner"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/custom_spinner_background" />

            </RelativeLayout>
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/rlaPieChartCount"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/AcademicYear"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:padding="@dimen/ten"
            android:background="@drawable/rect_shadow_white">



            <com.github.mikephil.charting.charts.PieChart
                android:id="@+id/customPieChart"
                android:layout_alignParentStart="true"
                android:layout_width="@dimen/one_seventy"
                android:layout_height="@dimen/one_seventy"
                android:layout_gravity="center_vertical"
               />

            <LinearLayout
                android:layout_toEndOf="@+id/customPieChart"
                android:layout_centerVertical="true"
                android:id="@+id/data_card"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/five"
                android:layout_gravity="center_vertical"
                android:orientation="vertical">

                <LinearLayout
                    android:layout_marginTop="@dimen/five"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">


                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/ten"
                        android:layout_height="@dimen/ten"
                        app:cardCornerRadius="@dimen/five"
                        app:cardBackgroundColor="@color/yellow"
                        android:layout_marginEnd="@dimen/eight"/>

                    <TextView
                        android:id="@+id/staffCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Staff"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        style="@style/CustomTextStylePoppinsBold"
                        android:textSize="@dimen/twele_sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_marginTop="@dimen/five"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/ten"
                        android:layout_height="@dimen/ten"
                        app:cardCornerRadius="@dimen/five"
                        android:visibility="gone"
                        app:cardBackgroundColor="@color/navi_blue2"
                        android:layout_marginEnd="@dimen/eight"/>

                    <TextView
                        android:id="@+id/totalStudentCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Total Students"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        style="@style/CustomTextStylePoppinsBold"
                        android:textSize="@dimen/twele_sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_marginTop="@dimen/five"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/ten"
                        android:layout_height="@dimen/ten"
                        app:cardCornerRadius="@dimen/five"
                        app:cardBackgroundColor="@color/pink"
                        android:layout_marginEnd="@dimen/eight"/>

                    <TextView
                        android:id="@+id/girlsCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Girls"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        style="@style/CustomTextStylePoppinsBold"
                        android:textSize="@dimen/twele_sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_marginTop="@dimen/five"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/ten"
                        android:layout_height="@dimen/ten"
                        app:cardCornerRadius="@dimen/five"
                        app:cardBackgroundColor="@color/teal"
                        android:layout_marginEnd="@dimen/eight"/>

                    <TextView
                        android:id="@+id/boysCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Boys"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        style="@style/CustomTextStylePoppinsBold"
                        android:textSize="@dimen/twele_sp"/>
                </LinearLayout>

                <LinearLayout
                    android:layout_marginTop="@dimen/five"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:gravity="center_vertical">

                    <androidx.cardview.widget.CardView
                        android:layout_width="@dimen/ten"
                        android:layout_height="@dimen/ten"
                        app:cardCornerRadius="@dimen/five"
                        app:cardBackgroundColor="@color/grey"
                        android:layout_marginEnd="@dimen/eight"/>

                    <TextView
                        android:id="@+id/othersCount"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Others"
                        android:textStyle="bold"
                        android:textColor="@color/black"
                        style="@style/CustomTextStylePoppinsBold"
                        android:textSize="@dimen/twele_sp"/>
                </LinearLayout>



            </LinearLayout>


        </RelativeLayout>



        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rlaabsenteesreport2"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rlaPieChartCount"
            android:layout_marginTop="10dp"
            android:layout_marginStart="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="10dp">
        </androidx.recyclerview.widget.RecyclerView>



    </RelativeLayout>
    <ImageView
        android:id="@+id/nomessage"
        android:layout_width="@dimen/two_fifty"
        android:layout_height="@dimen/two_fifty"
        android:layout_centerInParent="true"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/twenty"
        android:src="@drawable/nomessages"
        android:textColor="@color/black"
        android:textSize="@dimen/fifteen_sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtNoData"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/twenty"
        android:text="@string/no_list_found"
        android:textColor="@color/black"
        android:textSize="@dimen/fifteen_sp"
      android:layout_below="@+id/nomessage"
        android:visibility="gone" />
</RelativeLayout>