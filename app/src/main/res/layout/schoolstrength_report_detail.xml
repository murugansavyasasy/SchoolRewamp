<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:padding="@dimen/ten"
    android:layout_margin="@dimen/eight">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">


        <TextView
            android:id="@+id/sectionname"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Section A"
            android:textSize="14sp"
            style="@style/CustomTextStylePoppinsBold"
           />


        <TextView
            android:id="@+id/totalcount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:background="@drawable/bg_pill"
            android:text="0 Students"
            android:textSize="13sp"
            android:paddingHorizontal="@dimen/twele"
            android:paddingVertical="@dimen/four"
            style="@style/CustomTextStylePoppinsBold"/>
    </RelativeLayout>


    <com.google.android.flexbox.FlexboxLayout
        android:id="@+id/gender_linearlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ten"
        app:flexWrap="wrap"
        app:justifyContent="space_between">

        <!-- Boys -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/schoolstrengthmale"
                android:tint="@color/color_blue_primary"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/boyscount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Boys : 0"
                android:textSize="12sp"
                style="@style/CustomTextStylePoppinsMedium" />
        </LinearLayout>


        <!-- Girls -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginEnd="12dp"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:src="@drawable/schoolstrengthfemale"
                android:tint="@color/pinkcolorcustom"
                android:layout_marginEnd="6dp"/>

            <TextView
                android:id="@+id/girlscount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Girls : 0"
                android:textSize="12sp"
                style="@style/CustomTextStylePoppinsMedium" />
        </LinearLayout>


        <!-- Others -->
        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:layout_marginBottom="8dp">

            <ImageView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/otherscount"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Not specified : 0"
                android:textSize="12sp"
                style="@style/CustomTextStylePoppinsMedium" />
        </LinearLayout>

    </com.google.android.flexbox.FlexboxLayout>




</LinearLayout>
