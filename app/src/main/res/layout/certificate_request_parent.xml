<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:id="@+id/cltDateSelection"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hundred"
            android:background="@drawable/bottom_right_left_radious"
            app:layout_constraintTop_toTopOf="parent">
            
            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="@dimen/thirty_five"
                android:layout_height="@dimen/thirty_five"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/twenty_five"
                android:src="@drawable/arrow_left_white"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent">
            </ImageView>

            <TextView
                android:id="@+id/lblName"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/ten"
                android:text="Sathish"
                android:textColor="@color/white"
                android:textSize="@dimen/twenty"
                app:layout_constraintStart_toEndOf="@+id/imgBack"
                app:layout_constraintTop_toTopOf="parent">

            </TextView>

            <TextView
                android:id="@+id/lblSection"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ten"
                android:text="XII - A"
                android:textColor="@color/white"
                android:textSize="@dimen/thirteen_sp"
                app:layout_constraintStart_toEndOf="@+id/imgBack"
                app:layout_constraintTop_toBottomOf="@+id/lblName">

            </TextView>

            <ImageView
                android:id="@+id/imgSearch"
                android:layout_width="@dimen/thirty"
                android:layout_height="@dimen/thirty"
                android:layout_marginTop="@dimen/twenty"
                android:layout_marginEnd="@dimen/twenty"
                android:src="@drawable/ic_search_white_color"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent" />

        </androidx.constraintlayout.widget.ConstraintLayout>
        <RelativeLayout

            android:id="@+id/rlaSortSearch"
            android:layout_width="match_parent"
            android:layout_height="@dimen/thirty_five"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            app:layout_constraintTop_toBottomOf="@+id/header_text4"
            android:background="@drawable/rect_grey"
            android:visibility="gone">


            <ImageView
                android:id="@+id/imgSearch1"
                android:layout_width="@dimen/thirty"
                android:layout_height="@dimen/thirty"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/ten"
                android:alpha="0.34"
                android:src="@drawable/ic_search" />

            <EditText
                android:layout_marginStart="@dimen/five"
                android:id="@+id/txtSearchMenu"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:maxLines="1"
                android:layout_toEndOf="@+id/imgSearch1"
                style="@style/CustomTextStylePoppinsMedium"
                android:background="@android:color/transparent"
                android:hint="@string/lblSearch"
                />

        </RelativeLayout>

        <TextView
            android:id="@+id/header_text3"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/twenty"
            android:layout_marginTop="@dimen/twenty"
            android:text="@string/certificate_request"
            android:textSize="@dimen/eighteen_sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/cltDateSelection" />

        <RelativeLayout
            android:id="@+id/rytRequestTap"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fifteen"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/fifteen"
            android:background="@drawable/rect_shadow_white"
            android:visibility="visible"
            app:layout_constraintTop_toBottomOf="@+id/header_text3">

            <TextView
                android:id="@+id/header_text"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/twenty"
                android:text="@string/select_certificate"
                />

            <Spinner
                android:id="@+id/spinner_text"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fourty"
                android:layout_below="@+id/header_text"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/ten">
            </Spinner>

            <TextView
                android:id="@+id/header_text1"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/spinner_text"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/fifteen"
                android:text="@string/select_urgency_level"
                 />

            <RadioGroup
                android:id="@+id/radioGroup"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/header_text1"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/ten"
                android:orientation="horizontal">

                <LinearLayout
                    android:layout_width="@dimen/zero"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/five"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:padding="@dimen/five">

                    <ImageView
                        android:id="@+id/ivradio"
                        android:layout_width="@dimen/twenty_four"
                        android:layout_height="@dimen/twenty_four"
                        android:layout_marginStart="@dimen/five"
                        android:layout_marginEnd="@dimen/five"
                        android:src="@drawable/custom_radio_button" />

                    <TextView
                        android:id="@+id/rb_not_urgent"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/five"
                        android:button="@android:color/transparent"
                        android:text="@string/not_urgent"
                        android:textColor="@android:color/black"
                        android:textSize="@dimen/thirteen_sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="@dimen/zero"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/five"
                    android:layout_weight="1"
                    android:orientation="horizontal"
                    android:padding="@dimen/five">

                    <ImageView
                        android:id="@+id/ivradio1"
                        android:layout_width="@dimen/twenty_four"
                        android:layout_height="@dimen/twenty_four"
                        android:layout_marginStart="@dimen/five"
                        android:layout_marginEnd="@dimen/five"
                        android:src="@drawable/custom_radio_button" />

                    <TextView
                        android:id="@+id/rb_urgent"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center_vertical"
                        android:layout_marginStart="@dimen/five"
                        android:button="@android:color/transparent"
                        android:text="@string/urgent"
                        />
                </LinearLayout>

            </RadioGroup>

            <TextView
                android:id="@+id/header_text5"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/radioGroup"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/fifteen"
                android:text="@string/reason"
               />

            <EditText
                android:id="@+id/txtReason"
                android:layout_width="match_parent"
                android:layout_height="@dimen/fourty_five"
                android:layout_below="@+id/header_text5"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/ten"
                style="@style/CustomTextStylePoppinsMedium"
                android:background="@drawable/text_bg"
                android:gravity="top"
                android:hint="Enter your reason here...."
                android:padding="@dimen/ten"
                 />

            <Button
                android:id="@+id/btnSendCertificateRequest"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="@dimen/two_fifty"
                android:layout_height="@dimen/fourty"
                android:layout_below="@+id/txtReason"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/twenty_five"
                android:layout_marginBottom="@dimen/twele"
                android:background="@drawable/bg_orange"
                android:gravity="center"
                android:text="@string/request_certificate"
                android:textColor="@color/white"
                android:textSize="@dimen/eleven_sp" />
        </RelativeLayout>


        <TextView
            android:id="@+id/header_text4"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/twenty"
            android:layout_marginTop="@dimen/twenty"
            android:text="Certificate History"
            android:textColor="@color/black"
            android:textSize="@dimen/eighteen_sp"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/rytRequestTap" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/rlaSortSearch" />


        <LinearLayout
            android:id="@+id/lnrNoRecords"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@+id/header_text4">

            <ImageView
                android:id="@+id/nomessage"
                android:layout_width="@dimen/two_fifty"
                android:layout_height="@dimen/two_fifty"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/twenty"
                android:src="@drawable/nomessages"
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp" />

            <TextView
                android:id="@+id/txtNoData"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/twenty"
                android:text="@string/no_list_found"
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp" />
        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</androidx.core.widget.NestedScrollView>
