                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:text="@string/lblReportbug"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five_sp"
                        android:layout_height="@dimen/twenty_five_sp"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>
                </LinearLayout>


                <View
                    android:id="@+id/isViewReportBug"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/point_one"
                    android:layout_below="@+id/lnrReportBug"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/thirty"
                    android:background="@color/grey" />


                <LinearLayout
                    android:id="@+id/lnrLogout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/isViewReportBug"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:layout_marginBottom="@dimen/ten"
                    android:gravity="center"
                    android:orientation="horizontal"
                    android:weightSum="1">

                    <ImageView
                        android:layout_width="@dimen/thirty"
                        android:layout_height="@dimen/thirty"
                        android:layout_weight="0.1"
                        android:src="@drawable/logout"></ImageView>

                    <TextView
                        style="@style/CustomTextStylePoppinsRegular"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:layout_marginStart="@dimen/thirty"
                        android:layout_weight="0.8"
                        android:text="@string/lblLogout"
                        android:textColor="@color/red"
                        android:textSize="@dimen/thirteen_sp"
                        android:textStyle="bold">

                    </TextView>

                    <ImageView
                        android:layout_width="@dimen/twenty_five"
                        android:layout_height="@dimen/twenty_five"
                        android:layout_weight="0.1"
                        android:src="@drawable/arrow_right_gray">

                    </ImageView>
                </LinearLayout>

                <View
                    android:id="@+id/isViewLogout"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/point_one"
                    android:layout_below="@+id/lnrLogout"
                    android:layout_marginStart="@dimen/thirty"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/thirty"
                    android:background="@color/grey" />

                <TextView
                    android:id="@+id/lblAppVersion"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/isViewLogout"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/thirty"
                    android:layout_marginBottom="@dimen/ten"
                    android:text="App Version 1.0"
                    android:textColor="@color/grey"
                    android:textSize="@dimen/fourteen_sp" />


            </RelativeLayout>


        </RelativeLayout>

    </RelativeLayout>

</androidx.core.widget.NestedScrollView>