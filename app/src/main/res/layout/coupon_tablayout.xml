<LinearLayout
    android:id="@+id/lnrTab"
    android:layout_width="match_parent"
    android:layout_height="@dimen/fourty"
    android:layout_below="@+id/linearlayout"
    android:layout_marginTop="@dimen/five"
    android:background="@drawable/rect_btn_grey"
    android:orientation="horizontal"
    android:padding="@dimen/one"
    android:layout_marginStart="10dp"
    android:layout_marginEnd="10dp"
    android:weightSum="2"
    xmlns:android="http://schemas.android.com/apk/res/android">


    <TextView
        android:id="@+id/alltext"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_weight="0.5"
        android:background="@drawable/green_radious"
        style="@style/CustomTextStylePoppinsMedium"
        android:gravity="center"
        android:layout_marginTop="@dimen/one"
        android:layout_marginStart="@dimen/one"
        android:layout_marginEnd="@dimen/one"
        android:layout_marginBottom="@dimen/one"
        android:text="@string/all"
        android:textColor="@color/bpWhite"
       >

    </TextView>

    <TextView
        android:id="@+id/activetext"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_weight="0.5"
        android:gravity="center"
        android:text="@string/active"
        style="@style/CustomTextStylePoppinsMedium"
        android:textColor="@color/white"
        android:layout_marginTop="@dimen/one"
        android:layout_marginStart="@dimen/one"
        android:layout_marginEnd="@dimen/one"
        android:layout_marginBottom="@dimen/one"
        >
    </TextView>

    <TextView
        android:id="@+id/expiredtext"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_weight="0.5"
        android:gravity="center"
        android:text="@string/expired"
        android:textColor="@color/white"
        android:textSize="@dimen/thirteen_sp"
        android:layout_marginTop="@dimen/one"
        android:layout_marginStart="@dimen/one"
        android:layout_marginEnd="@dimen/one"
        android:layout_marginBottom="@dimen/one"
       >

    </TextView>

    <TextView
        android:id="@+id/redeemedtext"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:layout_weight="0.5"
        style="@style/CustomTextStylePoppinsMedium"
        android:gravity="center"
        android:text="@string/redeemed"
        android:textColor="@color/white"
        android:layout_marginTop="@dimen/one"
        android:layout_marginStart="@dimen/one"
        android:layout_marginEnd="@dimen/one"
        android:layout_marginBottom="@dimen/one"
       >

    </TextView>

</LinearLayout>