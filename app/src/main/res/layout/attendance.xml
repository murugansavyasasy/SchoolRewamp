<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/AthensGray">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:background="@color/light_gray4"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground">

        <include
            android:id="@+id/toolbarLayout"
            layout="@layout/parent_side_tool_bar_without_curve" />


        <RelativeLayout
            android:id="@+id/rytHead"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/toolbarLayout"
            android:background="@drawable/bg_header_rounded"
            android:paddingBottom="@dimen/fifty">

            <TextView
                android:id="@+id/lblHeaderTitle"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/twenty"
                android:text=""
                android:textColor="@color/white"
                android:textSize="@dimen/twenty">

            </TextView>

        </RelativeLayout>


        <androidx.cardview.widget.CardView
            android:id="@+id/cardCalendarDetails"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rytHead"
            android:layout_marginStart="@dimen/twenty"
            android:layout_marginTop="@dimen/minus_thirty"
            android:layout_marginEnd="@dimen/twenty"
            android:elevation="@dimen/six"
            app:cardCornerRadius="@dimen/ten">

            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:padding="@dimen/twenty">

                <LinearLayout
                    android:id="@+id/lnrCalendarDetails"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:gravity="center"
                    android:orientation="horizontal">

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content">

                        <LinearLayout
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content">

                            <TextView
                                android:id="@+id/lblDate"
                                style="@style/CustomTextStylePoppinsBold"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text="00"
                                android:textColor="@color/PrimaryColor"
                                android:textSize="@dimen/fourty_sp"></TextView>
                        </LinearLayout>

                        <TextView
                            android:id="@+id/lblDateSuffix"
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/two"
                            android:layout_marginTop="@dimen/five"
                            android:gravity="top"
                            android:maxLength="2"
                            android:text="th"
                            android:textColor="@color/PrimaryColor"
                            android:textSize="@dimen/twele_sp"></TextView>

                    </LinearLayout>

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/five"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/lblDay"
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="Wednesday"
                            android:textAlignment="viewStart"
                            android:textSize="@dimen/fifteen"></TextView>

                        <TextView
                            android:textAlignment="viewStart"
                            android:id="@+id/lblMonthYear"
                            style="@style/CustomTextStylePoppinsMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:gravity="center"
                            android:text="August 2025"
                            android:textColor="@color/light_gray"
                            android:textSize="@dimen/twele_sp"></TextView>
                    </LinearLayout>
                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/lblHeading"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lnrCalendarDetails"
                    android:layout_marginTop="@dimen/fifteen">

                    <TextView
                        android:id="@+id/lblHeadingWeek"
                        style="@style/CustomTextStylePoppinsRegular"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:textAlignment="viewStart"
                        android:text="@string/this_week_status"></TextView>

                    <ImageView
                        android:id="@+id/imgInfo"
                        android:layout_width="@dimen/fifteen"
                        android:layout_height="@dimen/fifteen"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/three"
                        android:layout_toEndOf="@+id/lblHeadingWeek"
                        android:src="@drawable/info_icon">

                    </ImageView>
                </RelativeLayout>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcWeekStatus"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lblHeading"
                    android:layout_marginTop="@dimen/ten"></androidx.recyclerview.widget.RecyclerView>

            </RelativeLayout>
        </androidx.cardview.widget.CardView>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/cardCalendarDetails"
            android:clipToPadding="false"
            android:paddingBottom="@dimen/sixteen">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/twenty"
                android:orientation="vertical"
                android:paddingBottom="@dimen/thirty">

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:elevation="@dimen/six"
                    app:cardCornerRadius="@dimen/ten">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical">

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:paddingStart="@dimen/twenty"
                            android:paddingTop="@dimen/twenty"
                            android:paddingEnd="@dimen/twenty"
                            android:weightSum="3">

                            <LinearLayout
                                android:layout_width="@dimen/zero"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="@dimen/fifteen">

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/ninety">

                                    <ProgressBar
                                        android:id="@+id/attendanceProgressBar"
                                        style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Horizontal"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:indeterminate="false"
                                        android:max="100"
                                        android:progress="0"
                                        android:progressDrawable="@drawable/progress_circle_drawable"
                                        android:rotation="270" />

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="center"
                                        android:gravity="center"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/lblAttendancePercentage"
                                            style="@style/CustomTextStylePoppinsBold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:maxLength="3"
                                            android:text="0"
                                            android:textColor="@color/PrimaryColor"
                                            android:textSize="@dimen/fifteen_sp" />

                                        <TextView
                                            style="@style/CustomTextStylePoppinsBold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/three"
                                            android:text="%"
                                            android:textColor="@color/PrimaryColor"
                                            android:textSize="@dimen/thirteen_sp" />
                                    </LinearLayout>
                                </FrameLayout>

                                <TextView
                                    style="@style/CustomTextStylePoppinsMedium"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ten"
                                    android:gravity="center"
                                    android:text="@string/attendance"
                                    android:textSize="@dimen/twele_sp">

                                </TextView>
                            </LinearLayout>

                            <View
                                android:layout_width="@dimen/one"
                                android:layout_height="match_parent"
                                android:background="@color/very_light_grey" />

                            <LinearLayout
                                android:layout_width="@dimen/zero"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="15dp">

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/ninety"
                                    android:layout_weight="1">

                                    <ProgressBar
                                        android:id="@+id/leaveTakenProgressBar"
                                        style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Horizontal"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:indeterminate="false"
                                        android:max="100"
                                        android:progress="0"
                                        android:progressDrawable="@drawable/progress_circle_drawable"
                                        android:rotation="270" />

                                    <TextView
                                        android:id="@+id/lblLeaveTakenPercentage"
                                        style="@style/CustomTextStylePoppinsBold"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:gravity="center"
                                        android:maxLength="3"
                                        android:text="0"
                                        android:textColor="@color/PrimaryColor"
                                        android:textSize="@dimen/fifteen_sp" />
                                </FrameLayout>

                                <TextView
                                    style="@style/CustomTextStylePoppinsMedium"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ten"
                                    android:gravity="center"
                                    android:text="@string/leave_taken"
                                    android:textSize="@dimen/twele_sp">

                                </TextView>
                            </LinearLayout>

                            <View
                                android:layout_width="@dimen/one"
                                android:layout_height="match_parent"
                                android:background="@color/very_light_grey" />

                            <LinearLayout
                                android:layout_width="@dimen/zero"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical"
                                android:padding="15dp">

                                <FrameLayout
                                    android:layout_width="match_parent"
                                    android:layout_height="@dimen/ninety">

                                    <ProgressBar
                                        android:id="@+id/ongoingDaysProgressBar"
                                        style="@android:style/Widget.DeviceDefault.Light.ProgressBar.Horizontal"
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:indeterminate="false"
                                        android:max="100"
                                        android:progress="0"
                                        android:progressDrawable="@drawable/progress_circle_drawable"
                                        android:rotation="270" />

                                    <LinearLayout
                                        android:layout_width="match_parent"
                                        android:layout_height="match_parent"
                                        android:layout_gravity="center"
                                        android:gravity="center"
                                        android:orientation="horizontal">

                                        <TextView
                                            android:id="@+id/lblOngoingDaysPercentage"
                                            style="@style/CustomTextStylePoppinsBold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:maxLength="3"
                                            android:text="0"
                                            android:textColor="@color/PrimaryColor"
                                            android:textSize="@dimen/fifteen_sp" />

                                        <TextView
                                            style="@style/CustomTextStylePoppinsBold"
                                            android:layout_width="wrap_content"
                                            android:layout_height="wrap_content"
                                            android:layout_marginTop="@dimen/three"
                                            android:text="%"
                                            android:textColor="@color/PrimaryColor"
                                            android:textSize="@dimen/thirteen_sp" />
                                    </LinearLayout>

                                </FrameLayout>

                                <TextView
                                    style="@style/CustomTextStylePoppinsMedium"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/ten"
                                    android:gravity="center"
                                    android:text="@string/ongoing_days"
                                    android:textSize="@dimen/twele_sp">

                                </TextView>
                            </LinearLayout>

                        </LinearLayout>

                        <TextView
                            android:id="@+id/lblErrorMessage"
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/twenty"
                            android:layout_marginTop="@dimen/five"
                            android:layout_marginEnd="@dimen/twenty"
                            android:layout_marginBottom="@dimen/ten"
                            android:gravity="center"
                            android:textColor="@color/red"
                            android:visibility="gone"></TextView>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

                <androidx.cardview.widget.CardView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginBottom="@dimen/ten"
                    android:elevation="@dimen/six"
                    app:cardCornerRadius="@dimen/ten">

                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="vertical"
                        android:padding="@dimen/two">


                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:id="@+id/lnrLeaveRequest"
                                android:layout_width="@dimen/zero"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="@dimen/twenty">

                                <ImageView
                                    android:layout_width="@dimen/thirty"
                                    android:layout_height="@dimen/thirty"
                                    android:src="@drawable/leave_request_icon_school"
                                    android:tint="@color/PrimaryColor"
                                    tools:ignore="UseAppTint"></ImageView>

                                <TextView
                                    style="@style/CustomTextStylePoppinsMedium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/five"
                                    android:gravity="center"
                                    android:text="@string/ask_leave"
                                    android:textSize="@dimen/twele_sp">

                                </TextView>
                            </LinearLayout>

                            <View
                                android:layout_width="@dimen/one"
                                android:layout_height="match_parent"
                                android:background="@color/very_light_grey" />

                            <LinearLayout
                                android:id="@+id/lnrLeaveHistory"
                                android:layout_width="@dimen/zero"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="@dimen/twenty">

                                <ImageView
                                    android:layout_width="@dimen/thirty"
                                    android:layout_height="@dimen/thirty"
                                    android:src="@drawable/leave_request_icon_2"
                                    android:tint="@color/PrimaryColor"
                                    tools:ignore="UseAppTint"></ImageView>

                                <TextView
                                    style="@style/CustomTextStylePoppinsMedium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/five"
                                    android:gravity="center"
                                    android:text="@string/leave_requests"
                                    android:textSize="@dimen/twele_sp">

                                </TextView>
                            </LinearLayout>

                            <View
                                android:layout_width="@dimen/one"
                                android:layout_height="match_parent"
                                android:background="@color/very_light_grey" />

                            <LinearLayout
                                android:id="@+id/lnrAttendanceReport"
                                android:layout_width="@dimen/zero"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="@dimen/twenty">

                                <ImageView
                                    android:layout_width="@dimen/thirty"
                                    android:layout_height="@dimen/thirty"
                                    android:src="@drawable/absentees_report_icon"
                                    android:tint="@color/PrimaryColor"
                                    tools:ignore="UseAppTint"></ImageView>

                                <TextView
                                    style="@style/CustomTextStylePoppinsMedium"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/five"
                                    android:gravity="center"
                                    android:text="@string/leave_history"
                                    android:textSize="@dimen/twele_sp">

                                </TextView>
                            </LinearLayout>

                        </LinearLayout>

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/one"
                            android:background="@color/very_light_grey" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal"
                            android:weightSum="3">

                            <LinearLayout

                                android:id="@+id/lnrHoliday"
                                android:layout_width="@dimen/zero"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:gravity="center"
                                android:orientation="vertical"
                                android:padding="@dimen/twenty">

                                <ImageView
                                    android:layout_width="@dimen/thirty"
                                    android:layout_height="@dimen/thirty"
                                    android:src="@drawable/holidays_icon"
                                    android:tint="@color/PrimaryColor"
                                    tools:ignore="UseAppTint"></ImageView>

                                <TextView
                                    style="@style/CustomTextStylePoppinsMedium"
                                    android:layout_width="match_parent"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/five"
                                    android:gravity="center"
                                    android:text="@string/HoliDay"
                                    android:textSize="@dimen/twele_sp">

                                </TextView>
                            </LinearLayout>

                            <View
                                android:layout_width="@dimen/one"
                                android:layout_height="match_parent"
                                android:background="@color/very_light_grey" />

                        </LinearLayout>
                    </LinearLayout>
                </androidx.cardview.widget.CardView>

            </LinearLayout>

        </ScrollView>

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>