<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:background="@color/bpTransparent_black"
    android:orientation="vertical"
    android:layout_margin="@dimen/ten"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_margin="@dimen/ten"
        android:background="@drawable/bg_rect_white"
        android:orientation="vertical">

        <ImageView
            android:id="@+id/imgClose"
            android:layout_margin="@dimen/ten"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:layout_gravity="end"
            android:src="@drawable/close_icon_red" />

        <TextView
            android:id="@+id/lblTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:padding="@dimen/ten"
            android:text="@string/fingerprint_authentication"
            android:textColor="@color/yellow"
            android:textSize="@dimen/twenty_sp"
            android:layout_gravity="center"
            android:visibility="visible" />

        <TextView
            android:id="@+id/lblHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/two"
            android:fontFamily="@font/poppins_regular"
            android:text=""
            android:textColor="@color/black"
            android:textSize="@dimen/fifteen_sp"
            android:visibility="visible" />

        <ImageView
            android:layout_width="wrap_content"
            android:layout_height="@dimen/two_hundred"
            android:layout_centerHorizontal="true"
            android:layout_centerVertical="true"
            android:src="@drawable/biometric_security" />


        <TextView
            android:id="@+id/lblAuthenticate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginHorizontal="@dimen/ten"
            android:gravity="center"
            android:padding="@dimen/ten"
            android:text="@string/please_allow_school_chimes_to_make_use_of_your_fingerprint_authentication_to_enable_seamless_attendance_registration"
            android:textColor="@color/black"
            android:fontFamily="@font/poppins_regular"

            android:background="@drawable/bg_light_grey"
            android:textSize="@dimen/fifteen_sp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/btnAllow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/imgMarkAttendance"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="@dimen/fifty"
            android:background="@drawable/bg_rect_location"
            android:layout_marginTop="@dimen/twenty"
            android:padding="@dimen/ten"
            android:text="@string/yes_enable_seamless_attendance"
            android:textAlignment="center"
            android:textColor="@color/white"
            android:visibility="visible" />

        <TextView
            android:layout_marginTop="@dimen/twenty"
            android:layout_marginBottom="@dimen/fourty"
            android:id="@+id/btnSkip"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/imgMarkAttendance"
            android:layout_centerHorizontal="true"
            android:layout_marginHorizontal="@dimen/fifty"
            android:background="@drawable/bg_rect_location"
            android:padding="@dimen/ten"
            android:text="@string/no_i_ll_continue_with_the_conventional_method"
            android:textAlignment="center"
            android:textColor="@color/black"
            android:visibility="visible" />


    </LinearLayout>
</RelativeLayout>

