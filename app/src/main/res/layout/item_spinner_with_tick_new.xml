<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <TextView
        android:id="@+id/textViewItem"
        style="@style/CustomTextStylePoppinsMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:drawablePadding="@dimen/ten"
        android:paddingHorizontal="@dimen/fifteen"
        android:paddingVertical="@dimen/eight"
        android:text=""
        android:textColor="@android:color/black"
        android:textSize="@dimen/thirteen_sp" />

    <View
        android:id="@+id/viewDiv"
        android:layout_width="match_parent"
        android:layout_height="@dimen/point_five"
        android:layout_below="@id/textViewItem"
        android:background="@color/grey_mild" />

</RelativeLayout>
