<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:background="@color/mild_grey5"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <RelativeLayout
        android:id="@+id/rytHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/blue_gradient_color"
        android:paddingVertical="@dimen/twenty"
        app:layout_constraintTop_toTopOf="parent">

        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/fifteen"
            android:src="@drawable/arrow_back_black" />

        <TextView
            android:id="@+id/lblTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fifteen"
            android:layout_toEndOf="@+id/imgBack"
            android:text="Recipient Selection"
            android:textColor="@color/white"
            android:textSize="@dimen/fifteen_sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblSchoolSelection"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lblTitle"
            android:layout_marginStart="@dimen/fifteen"
            android:layout_toEndOf="@+id/imgBack"
            android:text="@string/choose_your_preferred_school"
            android:textColor="@color/white"
            android:textSize="13sp"
            android:textStyle="normal" />

    </RelativeLayout>

    <LinearLayout
        android:id="@+id/linearlayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rytHeader"
        android:layout_marginStart="@dimen/fifteen"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginEnd="@dimen/fifteen"
        android:visibility="gone"
        android:gravity="center_vertical">

        <TextView
            android:id="@+id/tvAcademicYearLabel"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Choose academic year :"
            android:textColor="@color/black"
            android:textSize="14sp"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_marginEnd="@dimen/ten"/>

        <RelativeLayout
            android:id="@+id/rlaAcademicYear"
            android:layout_width="0dp"
            android:layout_weight="1"
            android:layout_height="wrap_content"
            android:background="@drawable/rect_white_light_radious"
            android:padding="@dimen/ten"
            android:visibility="visible">



            <ImageView
                android:id="@+id/imgAcademicYear"
                android:layout_width="@dimen/fifteen"
                android:layout_height="@dimen/twenty"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/ten"
                android:src="@drawable/downarrow">

            </ImageView>

            <TextView
                android:id="@+id/lblAcademicYear"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/fifteen"
                android:fontFamily="@font/poppins_bold"
                android:text=""
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp"
                android:textStyle="bold">

            </TextView>
        </RelativeLayout>
    </LinearLayout>


    <LinearLayout
        android:id="@+id/lnrTab"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fourty"
        android:layout_below="@+id/linearlayout"
        android:layout_marginStart="@dimen/five"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginEnd="@dimen/five"
        android:background="@drawable/rect_btn_grey"
        android:orientation="horizontal"
        android:padding="@dimen/one"
        android:weightSum="1">

        <TextView
            android:id="@+id/lblSelectReceipients"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_weight="0.5"
            android:background="@drawable/white_radious"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:text="@string/select_resipent"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="normal">

        </TextView>

        <TextView
            android:id="@+id/lblSendToMultipleSchool"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_gravity="center"
            android:layout_weight="0.5"
            android:fontFamily="@font/poppins_medium"
            android:gravity="center"
            android:text="@string/send_to_multiple_school"
            android:textColor="@color/black"
            android:textSize="13sp"
            android:textStyle="normal">

        </TextView>


    </LinearLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/recycleSchools"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/lblSend"
        android:layout_below="@+id/lnrTab"
        android:layout_marginBottom="@dimen/ten"
        android:padding="@dimen/ten"
        tools:listitem="@layout/schools_list_item" />

    <TextView
        android:id="@+id/lblSend"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/twenty"
        android:layout_marginEnd="@dimen/twenty"
        android:layout_marginBottom="@dimen/ten"
        android:background="@drawable/rect_btn_orange"
        android:fontFamily="@font/poppins_regular"
        android:gravity="center_horizontal"
        android:padding="@dimen/eight"
        android:visibility="gone"
        android:text="@string/Send"
        android:textColor="@color/white"
        android:textSize="@dimen/fifteen_sp"
        android:textStyle="normal">

    </TextView>


    <com.airbnb.lottie.LottieAnimationView
        android:id="@+id/lottie_loader"
        android:layout_width="150dp"
        android:layout_height="150dp"
        android:layout_centerInParent="true"
        android:visibility="gone"
        app:lottie_rawRes="@raw/loader"
        app:lottie_autoPlay="true"
        app:lottie_loop="true" />



</RelativeLayout>