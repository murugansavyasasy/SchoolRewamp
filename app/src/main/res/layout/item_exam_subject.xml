<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/eight"
    app:cardBackgroundColor="@color/light_blue2"
    app:strokeColor="@color/white"
    app:cardElevation="4dp"
    app:cardUseCompatPadding="true"
    app:cardPreventCornerOverlap="true"
    android:elevation="4dp"
    app:strokeWidth="@dimen/zero"
    app:cardCornerRadius="@dimen/five"
    android:layout_height="wrap_content"
    android:layout_width="match_parent">


    <LinearLayout
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <LinearLayout
            android:id="@+id/rootHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:elevation="@dimen/four"
            android:orientation="vertical"
            >

            <LinearLayout
                android:padding="@dimen/five"
                android:layout_width="match_parent"
                android:layout_centerVertical="true"
                android:layout_alignParentStart="true"
                android:orientation="vertical"
                android:layout_toStartOf="@+id/totalMarks"
                android:layout_height="wrap_content">
                <TextView
                    android:id="@+id/subjectname"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="TAMIL"
                    android:textColor="@color/PrimaryColor"
                    android:textSize="@dimen/thirteen_sp" />

                <TextView
                    android:id="@+id/totalMarks"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingVertical="@dimen/three"
                    android:text="Mark:"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:textColor="@android:color/black"
                    android:alpha="0.6"
                    android:textSize="@dimen/eleven_sp" />

            </LinearLayout>




        </LinearLayout>




        <TextView
            android:visibility="gone"
            android:id="@+id/syllabusvalue"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/five"
            android:text="Unit"
            android:textSize="@dimen/fifteen_sp"></TextView>

        <RelativeLayout
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/five">

            <ImageView
                android:id="@+id/imgCalendar"
                android:layout_width="@dimen/twenty"
                android:layout_height="@dimen/twenty"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:src="@drawable/calendar_icon" />

            <TextView

                android:id="@+id/datevalue"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/ten"
                android:layout_toStartOf="@+id/layoutAlarm"
                android:layout_toEndOf="@+id/imgCalendar"
                android:text="02-05-2002"></TextView>

            <LinearLayout
                android:id="@+id/layoutAlarm"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/fourty"
                    android:layout_height="@dimen/fourty"
                    android:src="@drawable/alarm_clock">

                </ImageView>

                <TextView
                    style="@style/CustomTextStylePoppinsRegular"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/set_remainder"></TextView>
            </LinearLayout>

        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/subjectRecyclerView"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/ten" />


        <LinearLayout
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/five"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <ImageView
                android:layout_width="@dimen/twenty"
                android:layout_height="@dimen/twenty"
                android:src="@drawable/clock_icon" />

            <TextView
                android:id="@+id/lblTime"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/ten"
                android:text="00:00 PM"
                android:textColor="@color/black"
                android:textSize="@dimen/fourteen_sp" />
        </LinearLayout>
    </LinearLayout>

</com.google.android.material.card.MaterialCardView>