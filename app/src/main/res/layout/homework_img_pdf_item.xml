<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/one_twenty"
    android:id="@+id/fileItem"
    android:layout_margin="@dimen/ten"
    android:layout_marginEnd="@dimen/ten"
    android:layout_height="@dimen/hundred"
    android:elevation="@dimen/five"
    android:fitsSystemWindows="true"
    android:padding="@dimen/five"
    app:cardCornerRadius="@dimen/fifteen">


    <WebView
        android:id="@+id/WVThumbnaildocument"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone">

    </WebView>

    <ProgressBar
        android:id="@+id/loadingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateDrawable="@drawable/progress_bar_white"
        android:indeterminateOnly="true"
        android:visibility="gone">

    </ProgressBar>

    <ImageView
        android:id="@+id/ImgPDF"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop">

    </ImageView>

    <ImageView
        android:id="@+id/imageOrDocumentType"
        android:layout_width="@dimen/thirty"
        android:layout_height="@dimen/thirty"
        android:layout_below="@+id/Rl_WV_Img"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="@dimen/two"
        android:elevation="@dimen/five">

    </ImageView>
</androidx.cardview.widget.CardView>
