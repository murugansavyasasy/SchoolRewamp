<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">


    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar" />


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcyLessonPlanEdit"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="5dp"
        android:layout_above="@+id/linear_layout"
        android:layout_below="@+id/toolbarLayout">
    </androidx.recyclerview.widget.RecyclerView>


    <LinearLayout
        android:id="@+id/linear_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="10dp"
        android:layout_alignParentBottom="true"
        android:orientation="horizontal"
        android:gravity="center"
        android:paddingTop="8dp"
        android:paddingBottom="8dp">

        <TextView
            android:id="@+id/cancel_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Cancel"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:padding="10dp"
            android:paddingStart="@dimen/eighteen_sp"
            android:paddingEnd="@dimen/eighteen_sp"
            android:layout_marginEnd="12dp"
            android:background="@drawable/bg_red_radious__all_side_same"
            style="@style/CustomTextStylePoppinsMedium" />

        <TextView
            android:id="@+id/update_button"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Update"
            android:textSize="13sp"
            android:textColor="@color/white"
            android:padding="10dp"
            android:paddingStart="@dimen/eighteen_sp"
            android:paddingEnd="@dimen/eighteen_sp"
            android:layout_marginStart="30dp"
            android:background="@drawable/bg_green_radious"
            style="@style/CustomTextStylePoppinsMedium" />
    </LinearLayout>


    <ImageView
        android:id="@+id/nomessage"
        android:layout_width="@dimen/two_fifty"
        android:layout_height="@dimen/two_fifty"
        android:layout_centerInParent="true"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/twenty"
        android:src="@drawable/nomessages"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:visibility="gone" />

    <TextView
        android:id="@+id/txtNoData"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_gravity="center"
        android:layout_marginTop="@dimen/twenty"
        android:text="@string/no_list_found"
        android:textColor="@color/black"
        android:textSize="18sp"
        android:layout_below="@+id/nomessage"
        android:visibility="gone" />

</RelativeLayout>