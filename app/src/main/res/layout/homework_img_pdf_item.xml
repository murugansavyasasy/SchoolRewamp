<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="@dimen/one_fifty"
    android:elevation="@dimen/five"
    android:layout_margin="@dimen/ten"
    android:layout_marginEnd="@dimen/ten"
    app:cardCornerRadius="@dimen/fifteen"
    android:layout_height="@dimen/one_twenty"
    android:padding="@dimen/five">

    <androidx.cardview.widget.CardView
        android:id="@+id/Rl_WV_Img"
        android:layout_margin="@dimen/seven"
        app:cardCornerRadius="@dimen/twenty"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        >
            <WebView
                android:id="@+id/WVThumbnaildocument"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"

                android:visibility="gone">

            </WebView>

            <ImageView
                android:id="@+id/ImgPDF"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:scaleType="fitXY"
                >
            </ImageView>


    </androidx.cardview.widget.CardView>
    <ImageView
        android:elevation="@dimen/five"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="@dimen/two"
        android:layout_below="@+id/Rl_WV_Img"
        android:id="@+id/imageOrDocumentType"
        android:layout_width="@dimen/thirty"
        android:layout_height="@dimen/thirty"
        >

    </ImageView>
</androidx.cardview.widget.CardView>
