<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="12dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="2dp">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="16dp">

        <!-- Header Row -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical">

            <ImageView
                android:layout_width="48dp"
                android:layout_height="48dp"
                android:src="@drawable/ic_graduation_cap"
                android:background="@drawable/bg_exam_icon"
                android:padding="12dp"
                app:tint="@android:color/white" />

            <LinearLayout
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical"
                android:layout_marginStart="12dp">

                <TextView
                    android:id="@+id/tvExamName"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Unit Test 1"
                    android:textColor="#1A1A2E"
                    android:textSize="18sp"
                    android:textStyle="bold" />

                <TextView
                    android:id="@+id/tvExamInfo"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="1 subject · 2 tests"
                    android:textColor="#888888"
                    android:textSize="13sp"
                    android:layout_marginTop="2dp" />
            </LinearLayout>

            <ImageView
                android:id="@+id/ivExpand"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:src="@drawable/ic_chevron_down"
                android:background="@drawable/bg_circle_light"
                android:padding="8dp"
                app:tint="#888888" />
        </LinearLayout>

        <!-- Subject Chips -->
        <com.google.android.flexbox.FlexboxLayout
            android:id="@+id/chipContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="12dp"
            app:flexWrap="wrap"
            app:alignItems="flex_start"
            app:justifyContent="flex_start" />

        <!-- View Marks Button -->
        <androidx.appcompat.widget.AppCompatButton
            android:id="@+id/btnViewMarks"
            android:layout_width="match_parent"
            android:layout_height="48dp"
            android:layout_marginTop="12dp"
            android:background="@drawable/bg_view_marks_button"
            android:text="View Marks"
            android:textAllCaps="false"
            android:textColor="@color/PrimaryColor"
            android:textSize="14sp"
            android:drawableStart="@drawable/ic_chart_bar"
            android:drawableTint="@color/PrimaryColor"
            android:paddingStart="16dp"
            android:gravity="center"
            android:drawablePadding="8dp" />

        <!-- Expandable Subjects Container -->
        <LinearLayout
            android:id="@+id/expandableContainer"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:visibility="gone"
            android:layout_marginTop="12dp">

            <View
                android:layout_width="match_parent"
                android:layout_height="1dp"
                android:background="#E8E8E8"
                android:layout_marginBottom="12dp" />

            <!-- Subject items will be added here dynamically -->
            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/rvSubjects"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:nestedScrollingEnabled="false" />

        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>