<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/five"
    tools:ignore="MissingDefaultResource">

    <RelativeLayout
        android:id="@+id/rlastudentlistrelativelayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:background="@drawable/rect_shadow_white">

        <RelativeLayout
            android:id="@+id/rlarelativelayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginBottom="@dimen/ten">

            <TextView
                android:id="@+id/lblStudentName"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/twenty_five"
                android:layout_marginTop="@dimen/fifteen"
                android:layout_marginEnd="@dimen/twenty_five"
                android:gravity="start"
                android:text="Sathish"
               >

            </TextView>

            <TextView
                android:id="@+id/sectionlabel"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblStudentName"
                android:layout_marginStart="@dimen/twenty_five"
                android:layout_marginTop="@dimen/ten"
                android:text="I"
               >

            </TextView>


            <TextView
                android:id="@+id/dotsymbol"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblStudentName"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/ten"
                android:layout_toEndOf="@+id/sectionlabel"
                android:text=" - "
                >

            </TextView>

            <TextView
                android:id="@+id/standardlabel"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblStudentName"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/ten"
                android:layout_toEndOf="@+id/dotsymbol"
                android:text="B"
               >

            </TextView>



            <TextView
                android:id="@+id/statuslabel"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/sectionlabel"
                android:layout_marginStart="@dimen/twenty_four"
                android:layout_marginTop="@dimen/ten"
                android:text="SUBMITTED"
                android:textColor="@color/clr_green"
                android:textSize="@dimen/thirteen_sp">

            </TextView>

        </RelativeLayout>
    </RelativeLayout>




</RelativeLayout>