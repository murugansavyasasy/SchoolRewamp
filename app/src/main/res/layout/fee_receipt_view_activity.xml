<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <RelativeLayout
        app:layout_constraintTop_toTopOf="parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <include
            android:id="@+id/toolbarLayout"
            layout="@layout/parent_side_tool_bar" />


        <ImageView
            android:layout_alignParentEnd="true"
            android:layout_margin="@dimen/ten"
            android:id="@+id/imgDownload"
            android:layout_below="@+id/toolbarLayout"
            android:layout_width="@dimen/twenty_five"
            android:layout_height="@dimen/twenty_five"
            android:src="@drawable/downloadicon"/>


        <WebView
            android:layout_below="@+id/imgDownload"
            android:id="@+id/feeReceiptWebview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>