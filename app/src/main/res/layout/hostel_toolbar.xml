<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/rytHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_rounded"
        android:paddingTop="@dimen/twenty"
        android:paddingBottom="@dimen/fifteen">

        <RelativeLayout
            android:id="@+id/rlaHeaderTab"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="@dimen/thirty_five"
                android:layout_height="@dimen/thirty_five"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:layout_marginTop="@dimen/fifteen"
                android:src="@drawable/arrow_left_white">

            </ImageView>

            <TextView
                android:layout_toEndOf="@+id/imgBack"
                android:layout_centerVertical="true"
                android:id="@+id/lblMenuName"
                android:layout_marginHorizontal="@dimen/five"
                android:text="Hostel Dashboard"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_alignParentEnd="true"
                android:textSize="@dimen/twenty_two_sp"
                android:textColor="@color/white"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

            </TextView>

    </RelativeLayout>
        <LinearLayout
            android:layout_marginHorizontal="@dimen/ten"
            android:background="@drawable/rect_white_radius_light"
            android:layout_below="@+id/rlaHeaderTab"
            android:paddingVertical="@dimen/ten"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/lblToday"
                style="@style/CustomTextStylePoppinsRegular"
                android:textColor="@color/white"
                android:textSize="@dimen/twele_sp"
                android:layout_marginHorizontal="@dimen/ten"
                android:text="TODAY"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

            </TextView>
            <TextView
                android:id="@+id/lblDate"
                style="@style/CustomTextStylePoppinsBold"
                android:textColor="@color/white"
                android:textSize="@dimen/fifteen_sp"
                android:layout_marginTop="@dimen/five"
                android:layout_marginHorizontal="@dimen/ten"
                android:text="Tuesday,March 03"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

            </TextView>

        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>