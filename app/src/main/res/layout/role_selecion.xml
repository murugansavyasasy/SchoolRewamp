<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">


    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="match_parent"
        android:layout_height="@dimen/ten"
        android:background="@color/white"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

<RelativeLayout
    android:id="@+id/toolbarLayout"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">


    <LinearLayout
        android:id="@+id/lytLogout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginTop="@dimen/twenty"
        android:layout_marginEnd="@dimen/twenty"
        android:gravity="center"
        android:orientation="vertical">

        <ImageView
            android:layout_width="@dimen/thirty_five"
            android:layout_height="@dimen/thirty_five"
            android:src="@drawable/logout">
        </ImageView>


        <TextView
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/lblLogout"
            android:textColor="@color/red"
            android:textSize="@dimen/fifteen_sp">

        </TextView>

    </LinearLayout>


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_above="@+id/btnGo"
        android:layout_below="@+id/lytLogout">

        <ImageView
            android:id="@+id/imgTeaching"
            android:layout_width="match_parent"
            android:layout_height="@dimen/one_eighty"
            android:src="@drawable/teaching">

        </ImageView>

        <TextView
            android:id="@+id/lblChooseRole"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/imgTeaching"
            android:gravity="center"
            android:text="@string/lblChooseyourrole"
            android:textSize="@dimen/fifteen_sp">

        </TextView>


        <TextView
            android:id="@+id/lblLoginTeacherOrParent"
            style="@style/CustomTextStylePoppinsRegular"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lblChooseRole"
            android:layout_marginTop="@dimen/ten"
            android:gravity="center"
            android:text="@string/lblLoginteacherparent"
            android:textColor="@color/black"
            android:textSize="@dimen/fifteen_sp">

        </TextView>


        <LinearLayout
            android:id="@+id/lnrParent"
            android:layout_width="@dimen/three_hundred"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lblLoginTeacherOrParent"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/fifteen"
            android:background="@drawable/bg_light_blue">

            <TextView
                android:id="@+id/lblTeacher"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:background="@drawable/bg_blue"
                android:gravity="center"
                android:padding="@dimen/ten"
                android:textColor="@color/white"
                android:textSize="@dimen/fifteen_sp" />

            <TextView
                android:id="@+id/lblParent"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_weight="1"
                android:gravity="center"
                android:padding="@dimen/ten"
                android:textColor="@color/dark_blue"
                android:textSize="@dimen/fifteen_sp" />

        </LinearLayout>

        <TextView
            android:id="@+id/proceedlabel"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lnrParent"
            android:layout_centerInParent="true"
            android:layout_marginTop="@dimen/ten"
            android:text="@string/click_proceed_to_continue"
            android:textColor="@color/black"
            android:textSize="@dimen/fifteen_sp"
            android:visibility="gone" />


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recyclerViews"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/proceedlabel"
            android:layout_marginTop="@dimen/five"
            android:layout_marginBottom="@dimen/five"
            tools:listitem="@layout/school_details_list_item" />

    </RelativeLayout>


    <TextView
        android:id="@+id/btnGo"
        style="@style/CustomTextStylePoppinsMedium"
        android:layout_width="@dimen/two_hundred"
        android:layout_height="wrap_content"
        android:layout_alignParentBottom="true"
        android:layout_centerInParent="true"
        android:layout_marginEnd="@dimen/twenty_five"
        android:layout_marginBottom="@dimen/thirty"
        android:background="@drawable/bg_blue"
        android:gravity="center"
        android:padding="@dimen/ten"
        android:text="@string/proceed"
        android:textColor="@color/white"
        android:textSize="@dimen/fifteen_sp" />


    <!-- OLD  -->

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/twenty"
        android:visibility="gone"
        app:layout_constraintTop_toTopOf="parent">

        <RelativeLayout
            android:id="@+id/rytHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/lblSelection"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:text="@string/lblChooseyourrole"
                android:textColor="@color/black"
                android:textSize="@dimen/twenty_sp"
                android:textStyle="bold" />

            <ImageView
                android:id="@+id/imgLogo"
                android:layout_width="@dimen/fifty"
                android:layout_height="@dimen/fifty"
                android:layout_below="@+id/lblSelection"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/fifteen"
                android:scaleType="centerCrop"
                android:src="@mipmap/school_chimes_logo" />


            <View
                android:id="@+id/vw"
                android:layout_width="match_parent"
                android:layout_height="@dimen/one"
                android:layout_below="@+id/imgLogo"
                android:layout_marginHorizontal="@dimen/thirty"
                android:layout_marginTop="@dimen/fifteen"
                android:background="@color/grey" />


            <RelativeLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/vw"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/twenty">


                <TextView
                    android:id="@+id/btnLoginAsSchool"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/rect_btn_orange"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/ten"
                    android:paddingVertical="@dimen/ten"
                    android:text="@string/lblLoginteacherparent"
                    android:textColor="@color/white"
                    android:textSize="@dimen/thirteen_sp" />

                <TextView
                    android:id="@+id/btnLoginAsChild"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_toEndOf="@+id/btnLoginAsSchool"
                    android:background="@drawable/rect_btn_orange"
                    android:gravity="center"
                    android:paddingHorizontal="@dimen/ten"
                    android:paddingVertical="@dimen/ten"
                    android:text="@string/login_as_parent"
                    android:textColor="@color/white"
                    android:textSize="@dimen/thirteen_sp" />

            </RelativeLayout>


        </RelativeLayout>


    </RelativeLayout>


</RelativeLayout>


</androidx.constraintlayout.widget.ConstraintLayout>