<androidx.cardview.widget.CardView
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/eight"
    app:cardCornerRadius="@dimen/four"
    app:cardElevation="@dimen/four">


    <LinearLayout
        android:layout_width="@dimen/one_twenty"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <LinearLayout
            android:layout_width="@dimen/one_twenty_five"
            android:layout_height="wrap_content"
            android:background="@android:color/holo_blue_light"
            android:paddingVertical="@dimen/ten"
            android:gravity="center">

            <TextView
                android:id="@+id/titleTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="@dimen/fifteen_sp"
                android:textStyle="normal"
                android:fontFamily="@font/poppins_regular"
                android:textColor="@android:color/white"
                android:paddingHorizontal="@dimen/ten"/>
        </LinearLayout>

        <LinearLayout
            android:id="@+id/linear_layout1"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:paddingVertical="@dimen/ten"
            android:orientation="vertical"
            android:gravity="center">

            <TextView
                android:id="@+id/descriptionTextView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="@dimen/twenty_five_sp"
                android:textStyle="bold"
                android:fontFamily="@font/poppins_bold"
                android:textColor="@color/grey"/>

            <TextView
                android:id="@+id/description_view"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="@dimen/fifteen_sp"
                android:textStyle="normal"
                android:layout_marginTop="@dimen/eight"
                android:fontFamily="@font/poppins_regular"
                android:layout_marginBottom="@dimen/four"
                android:textColor="@color/grey"/>
        </LinearLayout>

    </LinearLayout>

</androidx.cardview.widget.CardView>
