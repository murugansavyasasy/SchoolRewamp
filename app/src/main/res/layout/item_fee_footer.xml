<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="8dp"
    android:orientation="horizontal"
    android:background="@drawable/bg_fee_card_red"
    android:padding="12dp"
    android:elevation="2dp">

    <ImageView
        android:id="@+id/fee_icon"
        android:layout_width="24dp"
        android:layout_height="24dp"
        android:src="@drawable/collect"
        android:layout_gravity="center_vertical" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_weight="1"
        android:orientation="horizontal"
        android:gravity="center_vertical"
        android:layout_marginStart="12dp">

        <TextView
            android:id="@+id/fee_type"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:text="School Fee"
            android:textColor="@color/black"
            android:textSize="@dimen/fifteen_sp"
            style="@style/CustomTextStylePoppinsMedium" />

        <TextView
            android:id="@+id/fee_amount"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="₹25000.00"
            android:textColor="@color/light_red1"
            android:textSize="@dimen/fifteen_sp"
            style="@style/CustomTextStylePoppinsMedium" />
    </LinearLayout>
</LinearLayout>
