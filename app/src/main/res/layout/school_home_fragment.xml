<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">


    <RelativeLayout
        android:id="@+id/headerLayout"
        android:layout_width="match_parent"
        android:layout_height="@dimen/one_eighty"
        android:background="@color/PrimaryColor">

        <ImageView
            android:layout_width="@dimen/thirty_five"
            android:id="@+id/imgBurgerMenu"
            android:src="@drawable/burger_menu"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/twenty_five"
            android:layout_height="@dimen/thirty_five">
        </ImageView>


        <TextView
            android:id="@+id/username"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/imgBurgerMenu"
            android:layout_marginEnd="@dimen/ten"
            android:layout_toStartOf="@+id/imgNotification"
            android:layout_marginTop="@dimen/twenty_five"
            android:text="Madhuri Sharma"
            android:layout_marginStart="@dimen/ten"
            android:textColor="@android:color/white"
            android:textSize="@dimen/eighteen_sp"
            style="@style/CustomTextStylePoppinsBold" />

        <TextView
            android:id="@+id/lblSchoolName"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@+id/imgBurgerMenu"
            android:layout_below="@+id/username"
            android:layout_marginStart="@dimen/ten"
            android:layout_toStartOf="@+id/imgNotification"
            android:layout_marginTop="@dimen/ten"
            android:text="Madhuri Sharma"
            android:textColor="@android:color/white"
            android:textSize="@dimen/fifteen_sp" />


        <ImageView
            android:id="@+id/imgNotification"
            android:layout_width="@dimen/twenty_five"
            android:layout_height="@dimen/twenty_five"
            android:layout_alignParentTop="true"
            android:layout_marginTop="@dimen/fourty_five"
            android:layout_marginEnd="16dp"
            android:layout_toStartOf="@+id/profileImage"
            android:scaleType="centerCrop"
            android:src="@drawable/notification_icon" />

        <ImageView
            android:id="@+id/profileImage"
            android:layout_width="45dp"
            android:layout_height="45dp"
            android:layout_alignParentTop="true"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="32dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_circle_1"
            android:scaleType="centerCrop"
            android:src="@drawable/user_sample" />

        <com.vs.schoolmessenger.Utils.DashBoardWaveDesign
            android:id="@+id/waveView"
            android:layout_marginTop="@dimen/ten"
            android:layout_width="match_parent"
            android:layout_height="@dimen/hundred_fifty"
            android:layout_alignParentBottom="true"
            />
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/autoScrollRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="@dimen/hundred"
        android:layout_below="@id/headerLayout"
        android:layout_marginTop="@dimen/five"
        android:orientation="horizontal"
        tools:listitem="@layout/resent_using_app_item" />

    <LinearLayout
        android:id="@+id/dotsIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@id/autoScrollRecyclerView"
        android:layout_centerHorizontal="true"
        android:gravity="center"
        android:orientation="horizontal" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/gridRecyclerView"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_marginTop="@dimen/fifteen"
        android:paddingBottom="10dp"
        android:clipToPadding="false"
        android:layout_marginEnd="@dimen/five"
        android:layout_marginStart="@dimen/five"
        android:layout_below="@id/dotsIndicator"
        tools:listitem="@layout/dashboard_app_item" />
</RelativeLayout>


