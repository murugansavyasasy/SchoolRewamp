<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <LinearLayout
                android:id="@+id/rlaLbCommunication"
                android:layout_width="match_parent"
                android:layout_height="@dimen/eighty"
                android:background="@drawable/gradient_theme_school"
                android:paddingBottom="@dimen/thirty">

                <ImageView
                    android:id="@+id/imgBack"
                    android:layout_width="@dimen/thirty"
                    android:layout_height="@dimen/thirty"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginTop="@dimen/twenty"
                    android:src="@drawable/arrow_back_black">

                </ImageView>

                <TextView
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fifteen"
                    android:layout_marginTop="@dimen/twenty"
                    android:text="@string/Communication"
                    android:textColor="@color/black"
                    android:textSize="@dimen/twenty_sp">

                </TextView>
            </LinearLayout>

            <RelativeLayout
                android:id="@+id/rlaAcademicYear"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rlaLbCommunication"
                android:layout_marginStart="@dimen/fifteen"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/fifteen"
                android:background="@drawable/bg_stroke_rect_black"
                android:padding="@dimen/ten"
                android:visibility="gone">


                <ImageView
                    android:id="@+id/imgAcademicYear"
                    android:layout_width="@dimen/fifteen"
                    android:layout_height="@dimen/fifteen"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/ten"
                    android:src="@drawable/downarrow">

                </ImageView>

                <TextView
                    android:id="@+id/lblAcademicYear"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/fifteen"
                    android:text=""
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp">

                </TextView>
            </RelativeLayout>


            <LinearLayout
                android:id="@+id/lnrCommunicationIcon"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rlaAcademicYear"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/ten"
                android:orientation="horizontal">


                <RelativeLayout
                    android:id="@+id/rlaVoiceMessage"
                    android:layout_width="@dimen/zero"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:background="@drawable/rect_sky_blue_shadow">

                    <ImageView
                        android:id="@+id/imgVoiceMessage"
                        android:layout_width="@dimen/fifty"
                        android:layout_height="@dimen/fifty"
                        android:layout_centerHorizontal="true"
                        android:paddingTop="@dimen/ten"
                        android:src="@drawable/mic_icon">

                    </ImageView>

                    <TextView
                        android:id="@+id/lblVoiceMessage"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/imgVoiceMessage"
                        android:layout_marginTop="@dimen/five"
                        android:gravity="center"
                        android:paddingStart="@dimen/five"
                        android:paddingEnd="@dimen/five"
                        android:paddingBottom="@dimen/ten"
                        android:text="@string/instant_call"
                        android:textColor="@color/white"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rlaScheduleCall"
                    android:layout_width="@dimen/zero"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:visibility="visible">

                    <ImageView
                        android:id="@+id/imgScheduleCall"
                        android:layout_width="@dimen/fifty"
                        android:layout_height="@dimen/fifty"
                        android:layout_centerHorizontal="true"
                        android:paddingTop="@dimen/ten"
                        android:src="@drawable/call_schedule_icon_black">

                    </ImageView>

                    <TextView
                        android:id="@+id/lblScheduleCall"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/imgScheduleCall"
                        android:layout_marginTop="@dimen/five"
                        android:gravity="center"
                        android:paddingStart="@dimen/five"
                        android:paddingEnd="@dimen/five"
                        android:paddingBottom="@dimen/ten"
                        android:text="@string/schedule_call"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                </RelativeLayout>

                <RelativeLayout
                    android:id="@+id/rlaTextMessage"
                    android:layout_width="@dimen/zero"
                    android:layout_height="wrap_content"
                    android:layout_weight="1">

                    <ImageView
                        android:id="@+id/imgTextMessage"
                        android:layout_width="@dimen/fifty"
                        android:layout_height="@dimen/fifty"
                        android:layout_centerHorizontal="true"
                        android:paddingTop="@dimen/ten"
                        android:src="@drawable/text_icon_black">

                    </ImageView>

                    <TextView
                        android:id="@+id/lblTextMessage"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/imgTextMessage"
                        android:layout_marginTop="@dimen/five"
                        android:gravity="center"
                        android:paddingStart="@dimen/five"
                        android:paddingEnd="@dimen/five"
                        android:paddingBottom="@dimen/ten"
                        android:text="@string/text_message"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>
                </RelativeLayout>
            </LinearLayout>


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lnrCommunicationIcon"
                android:layout_marginTop="@dimen/five">

                <RelativeLayout
                    android:id="@+id/rlaScheduleCallPickDate"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:visibility="gone">


                    <LinearLayout
                        android:id="@+id/lnrScheduleCall"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:orientation="horizontal"
                        android:weightSum="1">


                        <TextView
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="@dimen/twenty"
                            android:layout_weight="0.4"
                            android:text="@string/schedule_date"
                            android:textColor="@color/black"
                            android:textSize="@dimen/thirteen_sp">

                        </TextView>

                        <TextView
                            android:layout_width="@dimen/twenty"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text=" :  "
                            android:textColor="@color/black"
                            android:textSize="@dimen/thirteen_sp"
                            android:textStyle="bold">

                        </TextView>

                        <ImageView
                            android:layout_width="match_parent"
                            android:layout_height="@dimen/twenty"
                            android:layout_gravity="end"
                            android:layout_weight="0.6"
                            android:src="@drawable/calender_icon"></ImageView>
                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/lnrFromTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/lnrScheduleCall"
                        android:layout_marginTop="@dimen/ten"
                        android:orientation="horizontal"
                        android:weightSum="1">

                        <TextView
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="@dimen/twenty"
                            android:layout_weight="0.4"
                            android:text="@string/from_time"
                            android:textColor="@color/black"
                            android:textSize="@dimen/thirteen_sp">

                        </TextView>

                        <TextView
                            android:layout_width="@dimen/twenty"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text=" :  "
                            android:textColor="@color/black"
                            android:textSize="@dimen/thirteen_sp"
                            android:textStyle="bold">

                        </TextView>

                        <RelativeLayout
                            android:id="@+id/rlaFromTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="0.6"
                            android:background="@drawable/rect_white_light_radious"
                            android:gravity="center"
                            android:padding="@dimen/five">

                            <TextView
                                android:id="@+id/lblStartTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="@color/black"
                                android:textSize="@dimen/thirteen_sp"></TextView>

                            <ImageView
                                android:layout_width="@dimen/twenty"
                                android:layout_height="@dimen/twenty"
                                android:layout_toEndOf="@+id/lblStartTime"
                                android:src="@drawable/ic_down_arrow">

                            </ImageView>
                        </RelativeLayout>
                    </LinearLayout>


                    <LinearLayout
                        android:id="@+id/lnrToTime"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/lnrFromTime"
                        android:layout_marginTop="@dimen/ten"
                        android:orientation="horizontal"
                        android:weightSum="1">

                        <TextView
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginStart="@dimen/twenty"
                            android:layout_weight="0.4"
                            android:text="@string/do_not_dial_beyond"
                            android:textColor="@color/black"
                            android:textSize="@dimen/thirteen_sp">

                        </TextView>

                        <TextView
                            android:layout_width="@dimen/twenty"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:text=" :  "
                            android:textColor="@color/black"
                            android:textSize="@dimen/thirteen_sp"
                            android:textStyle="bold">

                        </TextView>

                        <RelativeLayout
                            android:id="@+id/rlaToTime"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_weight="0.6"
                            android:background="@drawable/rect_white_light_radious"
                            android:gravity="center"
                            android:padding="@dimen/five">

                            <TextView
                                android:id="@+id/lblEndTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:text=""
                                android:textColor="@color/black"
                                android:textSize="@dimen/thirteen_sp">

                            </TextView>

                            <ImageView
                                android:layout_width="@dimen/twenty"
                                android:layout_height="@dimen/twenty"
                                android:layout_toEndOf="@+id/lblEndTime"
                                android:src="@drawable/ic_down_arrow">

                            </ImageView>
                        </RelativeLayout>
                    </LinearLayout>


                </RelativeLayout>

                <com.vs.schoolmessenger.Utils.ExpandableGridView
                    android:id="@+id/gridViewScheduleCall"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rlaBackRecord"
                    android:layout_marginTop="@dimen/ten"
                    android:numColumns="3"
                    android:visibility="gone"
                    tools:listitem="@layout/schedule_call_date_data">

                </com.vs.schoolmessenger.Utils.ExpandableGridView>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcyHistoryDataVoiceAndText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/gridViewScheduleCall"
                    android:layout_marginTop="@dimen/ten"
                    android:visibility="gone"
                    tools:listitem="@layout/history_from_text_message"></androidx.recyclerview.widget.RecyclerView>


                <LinearLayout
                    android:id="@+id/rytNORecordFound"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/hundred"
                    android:orientation="vertical"
                    android:visibility="gone">


                    <ImageView
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/two_hundred"
                        android:src="@drawable/no_data_found"></ImageView>

                    <TextView
                        android:id="@+id/lblNoRecordFound"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/fifty"
                        android:gravity="center">

                    </TextView>

                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/rlaBackRecord"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rlaScheduleCallPickDate"
                    android:layout_marginTop="@dimen/five"
                    android:visibility="gone">

                    <TextView
                        android:id="@+id/lblBackToVoiceMessage"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/five"
                        android:layout_marginTop="@dimen/twenty"
                        android:layout_marginEnd="@dimen/five"
                        android:layout_toEndOf="@+id/imgEndArrow1"
                        android:text="@string/back_to_compose"
                        android:textColor="@color/navi_blue2"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <ImageView
                        android:id="@+id/imgEndArrow1"

                        android:layout_width="@dimen/twenty"
                        android:layout_height="@dimen/twenty"
                        android:layout_marginStart="@dimen/fifteen"
                        android:layout_marginTop="@dimen/twenty"
                        android:src="@drawable/right_arrow_round"
                        android:visibility="gone">

                    </ImageView>

                </RelativeLayout>

                <LinearLayout
                    android:id="@+id/lnrHistoryList"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/gridViewScheduleCall"
                    android:layout_alignParentEnd="true"
                    android:layout_marginEnd="@dimen/five"
                    android:orientation="horizontal">

                    <TextView
                        android:id="@+id/lblHistoryList"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/select_from_history"
                        android:textColor="@color/navi_blue2"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <ImageView
                        android:id="@+id/imgEndArrow"
                        android:layout_width="@dimen/twenty"
                        android:layout_height="@dimen/twenty"
                        android:src="@drawable/arrowright">

                    </ImageView>

                </LinearLayout>

                <LinearLayout
                    android:id="@+id/rlaMessageFromText"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lnrHistoryList"
                    android:layout_marginTop="@dimen/twenty"
                    android:orientation="vertical"
                    android:visibility="gone">


                    <TextView

                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_marginTop="@dimen/ten"
                        android:text="@string/Title"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/lblCountOfTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/edtTitleTextMessage"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="@dimen/ten"
                            android:text="0/50"
                            android:textColor="@color/black"
                            android:textSize="@dimen/thirteen_sp">

                        </TextView>

                        <EditText
                            android:id="@+id/edtTitleTextMessage"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/ten"
                            android:layout_marginEnd="@dimen/ten"
                            android:maxLength="50"
                            android:textSize="@dimen/thirteen_sp">

                        </EditText>

                    </RelativeLayout>


                    <TextView

                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_marginTop="@dimen/ten"
                        android:text="@string/Description"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp">

                    </TextView>

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/two_hundred"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_marginTop="@dimen/ten"
                        android:layout_marginEnd="@dimen/ten">

                        <TextView
                            android:id="@+id/lblCountOfDescription"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_alignParentEnd="true"
                            android:layout_alignParentBottom="true"
                            android:padding="@dimen/ten"
                            android:text="0/500"
                            android:textColor="@color/black"
                            android:textSize="@dimen/thirteen_sp">

                        </TextView>

                        <EditText
                            android:id="@+id/edtContentTextMessage"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:background="@drawable/bg_outline_black"
                            android:gravity="start|top"
                            android:hint="@string/Description"
                            android:inputType="textMultiLine"
                            android:maxLength="500"
                            android:padding="@dimen/ten"
                            android:textSize="@dimen/thirteen_sp" />

                    </RelativeLayout>


                </LinearLayout>

                <RelativeLayout
                    android:id="@+id/rlaSendText"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/rlaMessageFromText"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="@dimen/eleven"
                    android:layout_marginEnd="@dimen/twele"
                    android:layout_marginBottom="@dimen/eight"
                    android:background="@drawable/rect_green_light_radious"
                    android:padding="@dimen/seven"
                    android:visibility="gone">


                    <TextView
                        android:id="@+id/lblNExt"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/five"
                        android:text="@string/NEXT"
                        android:textColor="@color/white"
                        android:textSize="@dimen/thirteen_sp" />

                    <ImageView
                        android:id="@+id/imgSend1"
                        android:layout_width="@dimen/fifteen"
                        android:layout_height="@dimen/fifteen"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/five"
                        android:layout_toEndOf="@+id/lblNExt"
                        android:src="@drawable/rightwhitearrow" />


                </RelativeLayout>


                <RelativeLayout
                    android:id="@+id/rlaRecordVoice"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lnrHistoryList"
                    android:visibility="visible">

                    <LinearLayout
                        android:id="@+id/llEmergencyContainer"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="@dimen/twenty"
                        android:orientation="horizontal">

                        <com.vs.schoolmessenger.Utils.CustomSwitch
                            android:id="@+id/SwitchEmergencyVoice"
                            android:layout_width="@dimen/twenty"
                            android:layout_height="@dimen/twenty"
                            android:layout_marginEnd="@dimen/eight" />

                        <TextView
                            android:id="@+id/lblEmergencyVoice"
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/emergency_call"
                            android:textColor="@color/black"
                            android:textSize="@dimen/thirteen_sp" />

                        <TextView
                            android:id="@+id/infosymbol"
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="10dp"
                            android:text="ℹ️"
                            android:textColor="@color/black"
                            android:textSize="@dimen/thirteen_sp" />


                    </LinearLayout>

                    <RelativeLayout
                        android:id="@+id/rytVoiceRecord"
                        android:layout_width="@dimen/hundred"
                        android:layout_height="@dimen/hundred"
                        android:layout_below="@+id/llEmergencyContainer"
                        android:layout_centerHorizontal="true">

                        <com.airbnb.lottie.LottieAnimationView
                            android:id="@+id/lottieAnimationView"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_centerInParent="true"
                            android:layout_marginTop="@dimen/twenty_five"
                            android:src="@drawable/record"
                            android:visibility="gone"
                            app:lottie_autoPlay="true"
                            app:lottie_loop="true"
                            app:lottie_rawRes="@raw/voice_record"></com.airbnb.lottie.LottieAnimationView>


                        <ImageView
                            android:id="@+id/imgVoiceRecord"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_centerInParent="true"
                            android:layout_marginTop="@dimen/twenty_five"
                            android:src="@drawable/record_voice_icon"></ImageView>

                    </RelativeLayout>


                    <TextView
                        android:id="@+id/lblDurationOfVoice"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/rytVoiceRecord"
                        android:layout_centerHorizontal="true"
                        android:layout_marginTop="@dimen/ten"
                        android:text="00:00 / 03:00"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp"></TextView>


                    <RelativeLayout
                        android:id="@+id/rlaAddLocalFile"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/lblDurationOfVoice"
                        android:layout_alignParentEnd="false"
                        android:layout_centerInParent="true"
                        android:layout_marginStart="@dimen/fifteen"
                        android:layout_marginTop="@dimen/ten"
                        android:layout_marginEnd="@dimen/twenty"
                        android:padding="@dimen/ten">

                        <TextView
                            style="@style/CustomTextStylePoppinsMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Choose pre recorded file"
                            android:textColor="@color/navi_blue1"
                            android:textSize="@dimen/thirteen_sp"></TextView>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rlaSeekBarAndTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/rlaAddLocalFile"
                        android:layout_marginTop="@dimen/ten"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/imgClose"
                            android:layout_width="@dimen/twenty_five"
                            android:layout_height="@dimen/twenty_five"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="@dimen/thirteen"
                            android:elevation="10dp"
                            android:src="@drawable/close_red_color"></ImageView>

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginStart="@dimen/fifteen"
                            android:layout_marginEnd="@dimen/fifteen"
                            android:background="@drawable/rect_shadow_white">

                            <ImageView
                                android:id="@+id/imgVoicePlay"
                                android:layout_width="@dimen/fourty"
                                android:layout_height="@dimen/fourty"
                                android:layout_marginStart="@dimen/five"
                                android:layout_marginTop="@dimen/thirteen"
                                android:src="@drawable/play_icon_voice">

                            </ImageView>

                            <com.vs.schoolmessenger.Utils.WaveformSeekBar
                                android:id="@+id/waveformSeekBar"
                                android:layout_width="match_parent"
                                android:layout_height="@dimen/thirty"
                                android:layout_marginStart="@dimen/ten"
                                android:layout_marginTop="@dimen/eighteen"
                                android:layout_marginEnd="@dimen/ten"
                                android:layout_toEndOf="@+id/imgVoicePlay" />

                            <TextView
                                android:id="@+id/lblStartDuration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/imgVoicePlay"
                                android:layout_marginStart="@dimen/ten"
                                android:layout_marginBottom="@dimen/five"
                                android:layout_toEndOf="@+id/imgVoicePlay"
                                android:text="00:00"
                                android:textColor="@color/black"
                                android:textSize="@dimen/thirteen_sp"></TextView>

                            <TextView
                                android:id="@+id/lblEndDuration"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/imgVoicePlay"
                                android:layout_marginStart="@dimen/ten"
                                android:layout_marginEnd="@dimen/ten"
                                android:layout_toEndOf="@+id/lblStartDuration"
                                android:text="00:00"
                                android:textColor="@color/black"
                                android:textSize="@dimen/thirteen_sp"></TextView>

                            <TextView
                                android:id="@+id/lblTime"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/imgVoicePlay"
                                android:layout_alignParentEnd="true"
                                android:layout_marginStart="@dimen/ten"
                                android:layout_marginEnd="@dimen/ten"
                                android:text="00:00"
                                android:textColor="@color/black"
                                android:textSize="@dimen/thirteen_sp"></TextView>

                        </RelativeLayout>
                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rlaTitle"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/rlaSeekBarAndTitle"
                        android:layout_marginStart="@dimen/twenty"
                        android:layout_marginTop="@dimen/twenty"
                        android:layout_marginEnd="@dimen/twenty"
                        android:visibility="gone">

                        <TextView
                            android:id="@+id/lblTitle"
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/Title"
                            android:textColor="@color/black"
                            android:textSize="@dimen/fifteen_sp"
                            android:visibility="visible">

                        </TextView>


                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/lblTitle">

                            <TextView
                                android:id="@+id/lblCountOfTitleVoice"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:layout_below="@+id/edtTitle"
                                android:layout_alignParentEnd="true"
                                android:layout_marginEnd="@dimen/ten"
                                android:text="0/50"
                                android:textColor="@color/black"
                                android:textSize="@dimen/thirteen_sp">

                            </TextView>

                            <EditText
                                android:id="@+id/edtTitle"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:maxLength="50"
                                android:textSize="@dimen/thirteen_sp"></EditText>
                        </RelativeLayout>


                    </RelativeLayout>

                    <RelativeLayout
                        android:id="@+id/rlaSendVoice"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_below="@+id/rlaTitle"
                        android:layout_alignParentEnd="true"
                        android:layout_marginTop="@dimen/ten"
                        android:layout_marginEnd="@dimen/twenty"
                        android:background="@drawable/rect_green_light_radious"
                        android:padding="@dimen/seven">


                        <TextView
                            android:id="@+id/lblSend"
                            style="@style/CustomTextStylePoppinsRegular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/five"
                            android:text="@string/NEXT"
                            android:textColor="@color/white"
                            android:textSize="14sp"></TextView>


                        <ImageView
                            android:id="@+id/imgSend"
                            android:layout_width="@dimen/twenty"
                            android:layout_height="@dimen/twenty"
                            android:layout_centerInParent="true"
                            android:layout_marginStart="10dp"
                            android:layout_toEndOf="@+id/lblSend"
                            android:src="@drawable/rightwhitearrow">

                        </ImageView>
                    </RelativeLayout>
                </RelativeLayout>
            </RelativeLayout>


        </RelativeLayout>
    </ScrollView>
</RelativeLayout>