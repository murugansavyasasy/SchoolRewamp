<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:id="@+id/relative_layout"
    android:padding="10dp"
    android:layout_marginTop="5dp"
    android:layout_height="wrap_content">

    <ImageView
        android:id="@+id/profileImage"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@drawable/profile_student"
        android:scaleType="centerCrop"
        android:layout_marginTop="3dp"
        android:layout_alignParentStart="true"
        android:background="@drawable/circle_image" />

    <TextView
        android:id="@+id/nameheader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="Saran Raj"
        android:textColor="@color/black"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_marginStart="10dp"
        android:layout_toEndOf="@id/profileImage" />

    <TextView
        android:id="@+id/subjectheader"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="TAMIL"
        android:textColor="@color/black"
        style="@style/CustomTextStylePoppinsMedium"
        android:layout_marginStart="10dp"
        android:layout_marginTop="8dp"
        android:layout_below="@id/nameheader"
        android:layout_toEndOf="@id/profileImage" />


    <TextView
        android:id="@+id/unreadcount"
        android:layout_width="20dp"
        android:layout_height="20dp"
        android:layout_marginTop="10dp"
        android:text="1"
        android:textColor="@color/white"
        android:scaleType="centerCrop"
        android:gravity="center"
        android:layout_marginEnd="10dp"
        android:layout_alignParentEnd="true"
        android:background="@drawable/circle_background_green" />

    <View
        android:id="@+id/viewline"
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_below="@id/subjectheader"
        android:background="#eae6e4"
        android:layout_marginTop="15dp"/>
</RelativeLayout>
