<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardStudent"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginVertical="@dimen/six"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/sixteen"
    app:cardElevation="@dimen/two"
    app:strokeWidth="0dp"
    app:strokeColor="@color/PrimaryColor">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/fourteen">

        <View
            android:id="@+id/fytFirstLetter"
            android:layout_width="@dimen/fourty_four"
            android:layout_height="@dimen/fourty_four"
            android:layout_centerVertical="true"
            android:background="@drawable/bg_circle_1" />

        <TextView
            android:id="@+id/lblFirstLetter"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="@dimen/fourty_four"
            android:layout_height="@dimen/fourty_four"
            android:layout_alignStart="@id/fytFirstLetter"
            android:layout_alignTop="@id/fytFirstLetter"
            android:gravity="center"
            android:text="A"
            android:textColor="@color/white"
            android:textSize="@dimen/sixteen_sp" />

        <CheckBox
            android:id="@+id/cbSelect"
            android:layout_width="@dimen/twenty_eight"
            android:layout_height="@dimen/twenty_eight"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@null"
            android:button="@drawable/selector_check_student" />

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/fourteen"
            android:layout_toStartOf="@id/cbSelect"
            android:layout_toEndOf="@id/fytFirstLetter"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lblName"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Student Name"
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp" />

            <TextView
                android:id="@+id/lblRegNo"
                style="@style/CustomTextStylePoppinsRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/two"
                android:text="Roll No: --"
                android:textColor="@color/grey"
                android:textSize="@dimen/twele_sp" />

        </LinearLayout>

    </RelativeLayout>

</com.google.android.material.card.MaterialCardView>