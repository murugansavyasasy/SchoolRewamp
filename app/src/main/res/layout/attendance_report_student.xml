<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/eight"
    card_view:cardCornerRadius="@dimen/sixteen"
    card_view:cardElevation="@dimen/four"
    android:padding="@dimen/fifteen"
    >

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:padding="@dimen/ten"
        android:background="@android:color/white">

        <RelativeLayout
            android:id="@+id/lnrDateCircle"
            android:layout_width="wrap_content"
            android:layout_marginBottom="@dimen/minus_twenty"
            android:background="@drawable/bg_calendar_header"
            android:layout_height="wrap_content">

<!--            <ImageView-->
<!--                android:id="@+id/imgBg"-->
<!--                android:layout_width="@dimen/fifty"-->
<!--                android:layout_height="@dimen/fifty"-->
<!--                android:layout_centerInParent="true"-->
<!--                android:scaleType="fitXY"-->
<!--                android:src="@drawable/bg_calendar_header" />-->

            <TextView
                android:id="@+id/tvMonth"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/fifteen"
                android:gravity="center_horizontal"
                android:text="Sep"
                android:textColor="@android:color/white"
                android:textSize="@dimen/eighteen_sp" />
        </RelativeLayout>


        <RelativeLayout
            android:layout_marginStart="@dimen/ten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center_vertical"
            android:orientation="horizontal">

            <TextView
                android:layout_centerVertical="true"
                android:id="@+id/tvDay"
                android:layout_alignParentStart="true"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="00"
                android:textColor="@android:color/black"
                android:textSize="@dimen/thirty_five_sp"  />

            <TextView
                android:layout_centerVertical="true"
                android:layout_alignParentEnd="true"
                android:id="@+id/tvStatus"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/bg_orange"
                android:backgroundTint="@color/red"
                android:fontFamily="@font/poppins_bold"
                android:gravity="center"
                android:paddingHorizontal="@dimen/twele"
                android:paddingVertical="@dimen/four"
                android:text="Absent"
                android:textColor="@android:color/white"
                android:textSize="@dimen/twele_sp" />
        </RelativeLayout>

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/four"
            android:layout_marginStart="@dimen/ten"
            android:orientation="vertical">

            <TextView
                android:id="@+id/tvFullDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:fontFamily="@font/poppins_regular"
                android:text="13 Sep 2025"
                android:layout_marginTop="@dimen/three"
                android:textColor="@color/light_gray_4"
                android:textSize="@dimen/thirteen_sp" />

            <TextView
                android:id="@+id/tvDayName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/three"
                android:layout_marginBottom="@dimen/five"
                android:fontFamily="@font/poppins_regular"
                android:text="Saturday"
                android:textColor="@color/teal_700"
                android:textSize="@dimen/thirteen_sp" />
        </LinearLayout>

    </LinearLayout>
</androidx.cardview.widget.CardView>
