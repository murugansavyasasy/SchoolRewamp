<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/AthensGray">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/white"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />
    <RelativeLayout
        android:id="@+id/ImageLayout"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/white"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        >
        <RelativeLayout
            android:id="@+id/rytHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/white"
            android:paddingVertical="@dimen/fifteen">

            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="@dimen/thirty_five"
                android:layout_height="@dimen/thirty_five"
                android:layout_centerVertical="true"
                android:src="@drawable/left_arrow">

            </ImageView>


            <LinearLayout
                android:layout_toEndOf="@+id/imgBack"
                android:id="@+id/rlaStudentName"
                android:layout_width="wrap_content"
                android:layout_centerVertical="true"
                android:layout_height="wrap_content"
                android:layout_marginEnd="@dimen/ten"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblStudentName"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="end"
                    android:text="SATISH KUMAR"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp">

                </TextView>

                <TextView
                    android:id="@+id/lblStudentSection"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lblStudentName"
                    android:text="I-B"
                    >

                </TextView>
            </LinearLayout>
        </RelativeLayout>

        <ScrollView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/rytHeader"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:layout_marginBottom="@dimen/twenty_five">


            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="@dimen/fifty"
                android:background="@color/white">

                <TextView
                    android:layout_marginStart="@dimen/ten"
                    android:id="@+id/lblexamTitle"
                    android:layout_marginTop="@dimen/ten"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Marks"
                    android:textColor="@color/black"
                    android:textSize="@dimen/fifteen_sp">
                </TextView>

                <FrameLayout
                    android:layout_below="@+id/lblexamTitle"
                    android:id="@+id/scoreCircleContainer"
                    android:layout_width="350dp"
                    android:layout_height="350dp"
                    android:layout_centerHorizontal="true"
                    android:layout_gravity="center">

                    <com.vs.schoolmessenger.Parent.ExamMarks.DotRingView
                        android:layout_width="match_parent"
                        android:layout_height="match_parent" />

                    <View
                        android:layout_width="140dp"
                        android:layout_height="140dp"
                        android:layout_gravity="center"
                        android:background="@drawable/center_circle" />

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity="center"
                        android:gravity="center"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/lblTotalObtainaed"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@android:color/white"
                            android:textSize="36sp"
                            android:textStyle="bold" />

                        <TextView
                            android:id="@+id/lblTotalMark"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@android:color/white"
                            android:textSize="16sp" />
                    </LinearLayout>
                </FrameLayout>

                <TextView
                    android:id="@+id/lblGrade"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/scoreCircleContainer"
                    android:layout_centerHorizontal="true"
                    android:gravity="center"
                    android:textSize="@dimen/twenty_sp"
                    android:text="@string/overall_grade_1"></TextView>

                <TextView
                    android:id="@+id/lblRemark"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lblGrade"
                    android:layout_centerHorizontal="true"
                    android:layout_marginTop="@dimen/fifteen"
                    android:layout_marginHorizontal="@dimen/twenty_five"
                    android:gravity="center"
                    android:text=""
                    android:textSize="@dimen/sixteen_sp"
                    android:textColor="@color/dark_blue_9"></TextView>

                <View
                    android:id="@+id/line1"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/one"
                    android:layout_below="@+id/lblRemark"
                    android:layout_marginTop="@dimen/fifteen"
                    android:background="@color/gray_color"></View>


                <TextView
                    android:id="@+id/examheading"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/line1"
                    android:layout_marginStart="@dimen/fifteen"
                    android:layout_marginTop="@dimen/ten"
                    android:text="@string/subject_marks"
                    android:textSize="@dimen/thirteen_sp">

                </TextView>

                <View
                    android:id="@+id/line2"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/one"
                    android:layout_below="@+id/examheading"
                    android:layout_marginTop="@dimen/ten"
                    android:background="@color/gray_color"></View>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/ExamMarkRV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/line2"
                    android:layout_margin="@dimen/ten"
                    android:layout_marginStart="@dimen/fifteen"
                    android:layout_marginEnd="@dimen/fifteen">

                </androidx.recyclerview.widget.RecyclerView>

                <TextView
                    android:id="@+id/groupheading"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/ExamMarkRV"
                    android:layout_marginStart="@dimen/fifteen"
                    android:layout_marginTop="@dimen/five"
                    android:text="@string/other_activities"
                    android:textColor="@color/black">

                </TextView>

                <View
                    android:id="@+id/line3"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/one"
                    android:layout_below="@+id/groupheading"
                    android:layout_marginTop="@dimen/five"
                    android:background="@color/gray_color"></View>

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/GroupCardRV"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/line3"
                    android:layout_margin="@dimen/ten"
                    android:layout_marginStart="@dimen/fifteen"
                    android:layout_marginEnd="@dimen/fifteen">

                </androidx.recyclerview.widget.RecyclerView>

                <LinearLayout
                    android:id="@+id/lytList"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerInParent="true"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/nomessage"
                        android:layout_width="@dimen/two_fifty"
                        android:layout_height="@dimen/two_fifty"
                        android:layout_centerInParent="true"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/twenty"
                        android:src="@drawable/exam_marks_error_msg"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fifteen_sp"
                        android:visibility="gone" />

                    <TextView
                        android:id="@+id/txtNoData"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/twenty"
                        android:gravity="center"
                        android:text="@string/no_list_found"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fifteen_sp"
                        android:visibility="gone" />


                </LinearLayout>

            </RelativeLayout>


        </ScrollView>
    </RelativeLayout>

</androidx.constraintlayout.widget.ConstraintLayout>