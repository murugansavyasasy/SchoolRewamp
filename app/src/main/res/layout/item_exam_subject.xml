<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/rootHeader"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/eight"
    android:background="@drawable/bg_exam_card_base"
    android:elevation="@dimen/four"
    android:orientation="vertical"
    android:padding="@dimen/eight">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        >

        <TextView
            android:id="@+id/subjectname"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:text="TAMIL"
            android:layout_alignParentStart="true"
            android:layout_toStartOf="@+id/lnrViewDetails"
            android:textColor="@color/black"
            android:textSize="@dimen/fourteen_sp" />


        <LinearLayout
            android:id="@+id/lnrViewDetails"
            android:orientation="vertical"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content">
            <TextView
                android:id="@+id/maxmarkvalue"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:background="@drawable/light_green_radius"
                android:paddingHorizontal="@dimen/ten"
                android:paddingVertical="@dimen/four"
                android:text=""
                android:textColor="@android:color/white"
                android:textSize="@dimen/twele_sp" />

            <TextView
                android:layout_marginTop="@dimen/six"
                android:id="@+id/viewDetails"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:backgroundTint="@color/PrimaryColor"
                android:background="@drawable/light_green_radius"
                android:paddingHorizontal="@dimen/ten"
                android:paddingVertical="@dimen/four"
                android:text="@string/view_details"
                android:textColor="@android:color/white"
                android:textSize="@dimen/twele_sp" />


        </LinearLayout>

    </RelativeLayout>

    <TextView
        android:visibility="gone"
        android:id="@+id/syllabusvalue"
        style="@style/CustomTextStylePoppinsMedium"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/five"
        android:text="Unit"
        android:textSize="@dimen/fifteen_sp"></TextView>

    <RelativeLayout
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/five">

        <ImageView
            android:id="@+id/imgCalendar"
            android:layout_width="@dimen/twenty"
            android:layout_height="@dimen/twenty"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:src="@drawable/calendar_icon" />

        <TextView

            android:id="@+id/datevalue"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/ten"
            android:layout_toStartOf="@+id/layoutAlarm"
            android:layout_toEndOf="@+id/imgCalendar"
            android:text="02-05-2002"></TextView>

        <LinearLayout
            android:id="@+id/layoutAlarm"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/fourty"
                android:layout_height="@dimen/fourty"
                android:src="@drawable/alarm_clock">

            </ImageView>

            <TextView
                style="@style/CustomTextStylePoppinsRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/set_remainder"></TextView>
        </LinearLayout>

    </RelativeLayout>


    <LinearLayout
        android:visibility="gone"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/five"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:layout_width="@dimen/twenty"
            android:layout_height="@dimen/twenty"
            android:src="@drawable/clock_icon" />

        <TextView
            android:id="@+id/lblTime"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:text="00:00 PM"
            android:textColor="@color/black"
            android:textSize="@dimen/fourteen_sp" />
    </LinearLayout>

</LinearLayout>
