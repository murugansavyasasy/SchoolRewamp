<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground" />

    <HorizontalScrollView
        android:id="@+id/tabLayout1"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbarLayout"
        android:layout_marginTop="@dimen/five"
        android:layout_marginEnd="@dimen/fifteen"
        android:layout_marginBottom="@dimen/five"
        android:background="@color/white"
        android:fillViewport="true"
        android:padding="@dimen/two"
        android:scrollbars="none"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarLayout">

        <LinearLayout
            android:layout_width="wrap_content"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/ten"
            android:orientation="horizontal">

            <LinearLayout
                android:id="@+id/allbutton1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:padding="@dimen/ten"
                android:paddingStart="@dimen/thirty"
                android:paddingEnd="@dimen/thirty">

                <ImageView
                    android:id="@+id/imgAll"
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:src="@drawable/all_icon_2"
                    android:visibility="gone"
                    app:tint="@color/black" />

                <TextView
                    android:id="@+id/allbutton"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/five"
                    android:text="@string/all"
                    android:textColor="@color/black"
                    android:textSize="@dimen/twele_sp" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/ytsbutton1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="@dimen/fifteen"
                android:layout_marginEnd="@dimen/five"
                android:paddingStart="@dimen/eighteen_sp"
                android:paddingEnd="@dimen/eighteen_sp"
                android:paddingTop="@dimen/ten"
                android:paddingBottom="@dimen/ten">

                <ImageView
                    android:id="@+id/imgYet"
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:src="@drawable/waiting_for_approval"
                    app:tint="@color/dark_orange" />

                <TextView
                    android:id="@+id/ytsbutton"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/five"
                    android:gravity="center"
                    android:text="@string/yet_to_start"
                    android:textSize="@dimen/twele_sp" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/inprogressbutton1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="@dimen/five"
                android:paddingStart="@dimen/eighteen_sp"
                android:paddingEnd="@dimen/eighteen_sp"
                android:paddingTop="@dimen/ten"
                android:paddingBottom="@dimen/ten">

                <ImageView
                    android:id="@+id/imgProgress"
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:src="@drawable/progress_icon_2" />

                <TextView
                    android:id="@+id/inprogressbutton"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/five"
                    android:text="@string/in_progress"
                    android:textSize="@dimen/twele_sp" />
            </LinearLayout>


            <LinearLayout
                android:id="@+id/completedbutton1"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center_vertical"
                android:layout_marginStart="@dimen/fifteen"
                android:layout_marginEnd="@dimen/ten"
                android:paddingStart="@dimen/eighteen_sp"
                android:paddingEnd="@dimen/eighteen_sp"
                android:paddingTop="@dimen/ten"
                android:paddingBottom="@dimen/ten">

                <ImageView
                    android:id="@+id/imgComplete"
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:src="@drawable/completed_icon_3" />

                <TextView
                    android:id="@+id/completedbutton"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/five"
                    android:text="@string/completed"
                    android:textSize="@dimen/twele_sp" />
            </LinearLayout>


        </LinearLayout>
    </HorizontalScrollView>

    <RelativeLayout
        android:id="@+id/rytSearch1"
        android:layout_width="match_parent"
        android:layout_height="@dimen/thirty_five"
        android:layout_below="@+id/tabLayout1"
        android:layout_margin="@dimen/ten"
        android:layout_marginStart="@dimen/ten"
        android:background="@drawable/rect_grey"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/tabLayout1">


        <ImageView
            android:id="@+id/imgSearch"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/ten"
            android:src="@drawable/ic_search" />

        <EditText
            android:id="@+id/txtSearchMenu1"
            style="@style/CustomTextStylePoppinsRegular"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toEndOf="@+id/imgSearch"
            android:background="@android:color/transparent"
            android:hint="@string/lblSearch"
            android:textAlignment="viewStart"
            android:imeOptions="actionDone"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:textSize="@dimen/thirteen_sp" />

    </RelativeLayout>


    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcyLessonViewPlan"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:clipToPadding="false"
        android:paddingBottom="@dimen/sixteen"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/rytSearch1" />

    <ImageView
        android:id="@+id/nomessage"
        android:layout_width="@dimen/two_fifty"
        android:layout_height="@dimen/two_fifty"
        android:src="@drawable/no_lessonplan_message"
        android:visibility="gone"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="@+id/tabLayout1" />

    <TextView
        android:id="@+id/txtNoData"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:text="@string/no_list_found"
        android:textColor="@color/black"
        android:textSize="@dimen/eighteen_sp"
        android:visibility="gone"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/nomessage" />


    <ImageView
        android:id="@+id/createlp"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_margin="@dimen/sixteen"
        android:contentDescription="@string/add"
        android:padding="@dimen/ten"
        android:src="@drawable/addiconsvgformat"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


</androidx.constraintlayout.widget.ConstraintLayout>