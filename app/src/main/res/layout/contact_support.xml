<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/mild4">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground">


        <include
            android:id="@+id/toolbarLayout"
            layout="@layout/school_side_tool_bar" />

        <RelativeLayout
            android:id="@+id/rytPhone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/toolbarLayout"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/twenty_five"
            android:layout_marginEnd="@dimen/twenty"
            android:background="@drawable/rect_shadow_white"
            android:paddingVertical="@dimen/twenty_five">


            <ImageView
                android:id="@+id/imgPhoneCall"
                android:layout_width="@dimen/twenty_two"
                android:layout_height="@dimen/twenty_two"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/ten"
                android:src="@drawable/telephoneicon">

            </ImageView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/imgPhoneCall"
                android:gravity="center"
                android:orientation="vertical">


                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginEnd="@dimen/ten"
                    android:text="@string/lblOurCustomerService"
                    android:textColor="@color/black"
                    android:textSize="@dimen/fifteen_sp">

                </TextView>

                <TextView
                    android:id="@+id/lblContactNo"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginTop="@dimen/five"
                    android:layout_marginEnd="@dimen/ten"
                    android:text="+918939894902"
                    android:textColor="@color/navi_blue2"
                    android:textSize="@dimen/fifteen_sp"
                    android:textStyle="bold">

                </TextView>
            </LinearLayout>
        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/rytMail"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rytPhone"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/twenty"
            android:background="@drawable/rect_shadow_white"
            android:paddingVertical="@dimen/twenty_five">

            <ImageView
                android:id="@+id/imgMail"
                android:layout_width="@dimen/twenty_two"
                android:layout_height="@dimen/twenty_two"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/ten"
                android:src="@drawable/mailimage">

            </ImageView>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_toEndOf="@+id/imgMail"
                android:gravity="center"
                android:orientation="vertical">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginEnd="@dimen/ten"
                    android:text="@string/lblWriteus"
                    android:textColor="@color/black"
                    android:textSize="@dimen/fifteen_sp">

                </TextView>

                <TextView
                    android:id="@+id/lblContacttMail"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginTop="@dimen/five"
                    android:layout_marginEnd="@dimen/ten"
                    android:text="support@savyasasy.com"
                    android:textColor="@color/navi_blue2"
                    android:textSize="@dimen/fifteen_sp"
                    android:textStyle="bold">

                </TextView>

                <TextView
                    android:id="@+id/lblContacttMail2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/ten"
                    android:text="schoolchimes@savyasasy.com"
                    android:textColor="@color/navi_blue2"
                    android:textSize="@dimen/fifteen_sp"
                    android:textStyle="bold">

                </TextView>

            </LinearLayout>
        </RelativeLayout>

        <ImageView
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/rytMail"
            android:layout_alignParentBottom="true"
            android:layout_marginBottom="@dimen/minus_twenty"
            android:alpha="0.6"
            android:scaleType="centerCrop"
            android:src="@drawable/contact_us_bg" />


    </RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>