<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/lnrEntireQuestion"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/rect_shadow_white"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/five"
        android:layout_marginBottom="@dimen/five">

        <CheckBox
            android:id="@+id/cbQuestion"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/two"
            android:button="@drawable/ch_square"
            android:visibility="gone" />

        <ImageView
            android:id="@+id/lblremove"
            android:layout_width="@dimen/twenty"
            android:layout_height="@dimen/twenty"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/close_red_color"></ImageView>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/lnrEntireCard"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:layout_marginBottom="@dimen/ten"
        android:orientation="vertical">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_toStartOf="@+id/lblremove">

            <TextView
                android:id="@+id/lblChapter"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/chapter" />

            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/three"
                android:layout_toEndOf="@+id/lblChapter"
                android:text="*"
                android:textColor="@color/red">

            </TextView>
        </RelativeLayout>

        <EditText
            android:id="@+id/edtChapterName"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/five"
            android:background="@drawable/rect_gray_radius"
            android:hint="Enter Chapter here"
            android:padding="@dimen/eight"
            tools:ignore="LabelFor" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten">

            <TextView
                android:id="@+id/lblQuestion"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/question" />

            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/three"
                android:layout_toEndOf="@+id/lblQuestion"
                android:text="*"
                android:textColor="@color/red">

            </TextView>
        </RelativeLayout>

        <EditText
            android:id="@+id/edtQuestion"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/five"
            android:background="@drawable/rect_gray_radius"
            android:hint="@string/enter_question_here"
            android:padding="@dimen/eight" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten">

            <TextView
                android:id="@+id/lblOptionA"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_a"
                android:textSize="@dimen/fourteen_sp" />

            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/three"
                android:layout_toEndOf="@+id/lblOptionA"
                android:text="*"
                android:textColor="@color/red">

            </TextView>
        </RelativeLayout>

        <EditText
            android:id="@+id/edtOptionA"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/five"
            android:background="@drawable/rect_gray_radius"
            android:hint="@string/enter_option_a"
            android:padding="@dimen/eight" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten">

            <TextView
                android:id="@+id/lblOptionB"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_b"
                android:textSize="@dimen/fourteen_sp" />

            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/three"
                android:layout_toEndOf="@+id/lblOptionB"
                android:text="*"
                android:textColor="@color/red">

            </TextView>
        </RelativeLayout>

        <EditText
            android:id="@+id/edtOptionB"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/five"
            android:background="@drawable/rect_gray_radius"
            android:hint="@string/enter_option_b"
            android:padding="@dimen/eight" />

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten">

            <TextView
                android:id="@+id/lblOptionC"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_c"
                android:textSize="@dimen/fourteen_sp" />

            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/three"
                android:layout_toEndOf="@+id/lblOptionC"
                android:text="*"
                android:textColor="@color/red">

            </TextView>
        </RelativeLayout>

        <EditText
            android:id="@+id/edtOptionC"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/five"
            android:background="@drawable/rect_gray_radius"
            android:hint="@string/enter_option_c"
            android:padding="@dimen/eight" />


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten">

            <TextView
                android:id="@+id/lblOptionD"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="@string/option_d"
                android:textSize="@dimen/fourteen_sp" />

            <TextView
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/three"
                android:layout_toEndOf="@+id/lblOptionD"
                android:text="*"
                android:textColor="@color/red">

            </TextView>
        </RelativeLayout>

        <EditText
            android:id="@+id/edtOptionD"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/five"
            android:background="@drawable/rect_gray_radius"
            android:hint="@string/enter_option_d"
            android:padding="@dimen/eight" />


        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/five"
            android:orientation="horizontal"
            android:weightSum="2">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_weight="1"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/lblCorrectAns"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/correct_ans"
                        android:textSize="@dimen/fourteen_sp" />

                    <TextView
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/three"
                        android:layout_toEndOf="@+id/lblCorrectAns"
                        android:text="*"
                        android:textColor="@color/red">

                    </TextView>
                </RelativeLayout>

                <EditText
                    android:id="@+id/edtCorrectAns"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/five"
                    android:background="@drawable/rect_gray_radius"
                    android:ellipsize="none"
                    android:hint="@string/enter_correct_answer_here"
                    android:padding="@dimen/eight"
                    android:scrollHorizontally="true"
                    android:singleLine="true" />

                <RelativeLayout
                    android:id="@+id/rytSpinnerHeader"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/five"
                    android:background="@drawable/rect_gray_radius"
                    android:gravity="center"
                    android:visibility="gone">

                    <Spinner
                        android:id="@+id/spinnerCorrectAnswer"
                        android:layout_centerVertical="true"
                        android:layout_width="wrap_content"
                        android:paddingVertical="@dimen/five"
                        android:background="@null"
                        android:layout_alignParentStart="true"
                        android:layout_toStartOf="@+id/spinnerCorrectAnswerimg"
                        android:drawSelectorOnTop="true"
                        android:layout_height="wrap_content"
                        />
                    <ImageView
                        android:id="@+id/spinnerCorrectAnswerimg"
                        android:layout_centerVertical="true"
                        android:layout_width="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:src="@drawable/ic_drop_down"
                        android:layout_marginEnd="@dimen/three"
                        android:tint="@color/black"
                        android:layout_height="wrap_content">

                    </ImageView>

                </RelativeLayout>
            </LinearLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/five"
                android:layout_weight="1"
                android:orientation="vertical">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/lblMark"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/mark"
                        android:textSize="@dimen/fourteen_sp" />

                    <TextView
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/three"
                        android:layout_toEndOf="@+id/lblMark"
                        android:text="*"
                        android:textColor="@color/red">

                    </TextView>
                </RelativeLayout>

                <EditText
                    android:id="@+id/edtMark"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/five"
                    android:background="@drawable/rect_gray_radius"
                    android:ellipsize="none"
                    android:maxLength="4"
                    android:hint="@string/drop_your_mark_here"
                    android:inputType="number"
                    android:padding="@dimen/eight"
                    android:scrollHorizontally="true"
                    android:singleLine="true" />
            </LinearLayout>

        </LinearLayout>

        <LinearLayout
            android:visibility="gone"
            android:id="@+id/lnrAttachment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/five"
            android:gravity="end">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:paddingTop="@dimen/ten">

                <LinearLayout
                    android:id="@+id/lnrAttachmentPick"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:background="@drawable/black_rect_bg"
                    android:gravity="center"
                    android:padding="@dimen/eight">

                    <TextView
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/attachments"
                        android:textColor="@color/white"></TextView>

                    <TextView
                        android:id="@+id/lblAttachmentCount"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/five"
                        android:drawableStart="@drawable/add_icon"
                        android:text=""
                        android:textColor="@color/white">

                    </TextView>
                </LinearLayout>
            </LinearLayout>

            <ImageView
                android:id="@+id/lblRemoveAttachment"
                android:layout_width="@dimen/twenty"
                android:layout_height="@dimen/twenty"
                android:layout_gravity="end"
                android:src="@drawable/close_red_color"
                android:visibility="gone"></ImageView>

        </LinearLayout>
    </LinearLayout>
</LinearLayout>