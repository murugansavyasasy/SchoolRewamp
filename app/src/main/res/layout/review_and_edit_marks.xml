<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_gray_9">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground" />


    <ScrollView
        android:id="@+id/svOverallCreateQE"
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarLayout">

        <RelativeLayout
            android:id="@+id/rlaQuizExamReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/five"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/five">

            <RelativeLayout
                android:id="@+id/rytSearch1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/thirty_five"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/ten"
                android:background="@drawable/rect_grey"
                android:visibility="gone">

                <ImageView
                    android:id="@+id/imgSearch1"
                    android:layout_width="@dimen/thirty"
                    android:layout_height="@dimen/thirty"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/ten"
                    android:src="@drawable/ic_search" />

                <EditText
                    android:id="@+id/txtSearch1"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/imgSearch1"
                    android:background="@android:color/transparent"
                    android:hint="@string/lblSearch"
                    android:imeOptions="actionDone"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    android:singleLine="true"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp" />
            </RelativeLayout>

            <TextView
                android:id="@+id/lblReviewDetail"
                style="@style/CustomTextStylePoppinsRegular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rytSearch1"
                android:layout_marginHorizontal="@dimen/ten"
                android:text="@string/review_and_edit_marks"
                android:textColor="@color/dark_orange_2"
                android:textSize="@dimen/twenty_sp"
                android:textStyle="bold"></TextView>

            <TextView
                android:id="@+id/lblSampleDesc"
                style="@style/CustomTextStylePoppinsRegular"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblReviewDetail"
                android:layout_marginHorizontal="@dimen/ten"
                android:layout_marginTop="@dimen/ten"
                android:text="@string/verify_the_data_and_make_any_necessary_corrections"
                android:textSize="@dimen/fifteen_sp"
                android:textStyle="bold">

            </TextView>


            <View
                android:id="@+id/View2"
                android:layout_width="match_parent"
                android:layout_height="@dimen/three"
                android:layout_below="@+id/lblSampleDesc"
                android:layout_marginTop="@dimen/fifteen"
                android:layout_marginBottom="@dimen/five"
                android:background="@color/AthensGray">

            </View>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_above="@+id/LnrContainer2"
                android:layout_below="@+id/View2"
                android:orientation="vertical">

                <!-- HEADER -->
                <include
                    android:id="@+id/marksHeader"
                    layout="@layout/layout_marks_header" />

                <!-- STUDENT LIST -->
                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rvMarks"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scrollbars="none" />
            </LinearLayout>

            <LinearLayout
                android:id="@+id/LnrContainer2"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="@dimen/five"
                android:orientation="vertical">

                <View
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/two"
                    android:layout_marginHorizontal="@dimen/ten"
                    android:background="@color/AthensGray">

                </View>

                <LinearLayout
                    android:id="@+id/lnrSaveAllMarks2"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginHorizontal="@dimen/ten"
                    android:layout_marginTop="@dimen/five"
                    android:background="@drawable/rect_orange_bg"
                    android:gravity="center"
                    android:paddingVertical="@dimen/eight">

                    <TextView
                        android:id="@+id/lblUpload"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:drawableStart="@drawable/save_icon"
                        android:drawablePadding="@dimen/eight"
                        android:gravity="center"
                        android:text="@string/save_all_marks"
                        android:textColor="@color/white"
                        android:textSize="@dimen/fifteen_sp"></TextView>
                </LinearLayout>

            </LinearLayout>
        </RelativeLayout>


    </ScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>