<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_top_radius_2"
    android:fitsSystemWindows="true"
    android:orientation="vertical"
    android:padding="@dimen/five">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <TextView
            android:id="@+id/lblChooseFileType"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/fifteen"
            android:gravity="center"
            android:text="Pick your file type "
            android:textColor="@color/black"
            android:textSize="@dimen/fifteen_sp"
            style="@style/CustomTextStylePoppinsBold"
            ></TextView>


        <LinearLayout
            android:id="@+id/lnrFilePick"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lblChooseFileType"
            android:layout_marginTop="@dimen/fifteen"
            android:orientation="horizontal"
            android:weightSum="3">


            <RelativeLayout
                android:id="@+id/rlaGallery"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/ten"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/imgGallery"
                    android:layout_width="@dimen/sixty"
                    android:padding="@dimen/fifteen"
                    android:background="@drawable/curve_gray_radius"
                    android:layout_height="@dimen/sixty"
                    android:layout_centerHorizontal="true"
                    android:src="@drawable/gallery_icon2"></ImageView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/imgGallery"
                    android:layout_marginTop="@dimen/ten"
                    android:gravity="center"
                    android:paddingBottom="@dimen/ten"
                    android:text="Gallery"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp"
                    style="@style/CustomTextStylePoppinsBold"
                   >

                </TextView>

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rlaCamera"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/ten"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/imgCamera"
                    android:layout_width="@dimen/sixty"
                    android:layout_height="@dimen/sixty"
                    android:padding="@dimen/fifteen"
                    android:layout_centerHorizontal="true"
                    android:background="@drawable/curve_gray_radius"
                    android:src="@drawable/camera_icon2"></ImageView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/imgCamera"
                    android:layout_marginTop="@dimen/ten"
                    android:gravity="center"
                    android:paddingBottom="@dimen/ten"
                    android:text="Camera"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp"
                    style="@style/CustomTextStylePoppinsBold"
                    >

                </TextView>

            </RelativeLayout>


            <RelativeLayout
                android:id="@+id/rlaVideo"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/ten"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/imgDocument"
                    android:layout_width="@dimen/sixty"
                    android:layout_height="@dimen/sixty"
                    android:padding="@dimen/fifteen"
                    android:background="@drawable/curve_gray_radius"
                    android:layout_centerHorizontal="true"
                    android:src="@drawable/document_icon2"></ImageView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/imgDocument"
                    android:layout_marginTop="@dimen/ten"
                    android:gravity="center"
                    android:paddingBottom="@dimen/ten"
                    android:text="Document"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp"
                    style="@style/CustomTextStylePoppinsBold"
                    >

                </TextView>
            </RelativeLayout>
        </LinearLayout>


        <LinearLayout
            android:id="@+id/lnrSecond"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lnrFilePick"
            android:layout_marginTop="@dimen/fifteen"
            android:orientation="horizontal"
            android:weightSum="2">


            <RelativeLayout
                android:id="@+id/rlaVoice"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/ten"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/imgVoice"
                    android:padding="@dimen/fifteen"
                    android:background="@drawable/curve_gray_radius"
                    android:layout_width="@dimen/sixty"
                    android:layout_height="@dimen/sixty"
                    android:layout_centerHorizontal="true"
                    android:src="@drawable/audio_icon2"></ImageView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/imgVoice"
                    android:layout_marginTop="@dimen/ten"
                    android:gravity="center"
                    android:paddingBottom="@dimen/ten"
                    android:text="Voice"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp"
                    style="@style/CustomTextStylePoppinsBold"
                    >

                </TextView>

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rlaVideoPick"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_marginTop="@dimen/ten"
                android:layout_weight="1">

                <ImageView
                    android:id="@+id/imgVideopick"
                    android:layout_width="@dimen/sixty"
                    android:padding="@dimen/fifteen"
                    android:background="@drawable/curve_gray_radius"
                    android:layout_height="@dimen/sixty"
                    android:layout_centerHorizontal="true"
                    android:src="@drawable/video_icon2"></ImageView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/imgVideopick"
                    android:layout_marginTop="@dimen/ten"
                    android:gravity="center"
                    android:paddingBottom="@dimen/ten"
                    android:text="Video"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp"
                    style="@style/CustomTextStylePoppinsBold"
                    >

                </TextView>

            </RelativeLayout>
        </LinearLayout>
    </RelativeLayout>
</RelativeLayout>