<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:id="@+id/rootHeader"
    android:layout_height="wrap_content"
    android:padding="@dimen/fourteen"
    android:background="@drawable/bg_exam_card_base"
    android:orientation="vertical"
    android:elevation="@dimen/four"
    android:layout_margin="@dimen/eight">


    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_marginTop="@dimen/five"
        android:layout_height="wrap_content">

            <TextView
                android:id="@+id/subjectname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:text="TAMIL"
                style="@style/CustomTextStylePoppinsBold"
                android:textSize="@dimen/sixteen_sp"
                android:textColor="@color/black" />

        <TextView
            android:id="@+id/maxmarkvalue"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text=""
            android:textSize="@dimen/thirteen_sp"
            android:textColor="@android:color/white"
            android:background="@drawable/light_green_radius"
            android:paddingHorizontal="@dimen/ten"
            android:paddingVertical="@dimen/four"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            style="@style/CustomTextStylePoppinsBold"/>
    </RelativeLayout>
    <TextView
        android:id="@+id/syllabusvalue"
        android:layout_marginTop="@dimen/five"
        android:layout_width="match_parent"
        style="@style/CustomTextStylePoppinsMedium"
        android:text="Unit"
        android:textSize="@dimen/fifteen_sp"
        android:layout_height="wrap_content">
    </TextView>

    <RelativeLayout
        android:layout_marginTop="@dimen/five"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_centerVertical="true"
            android:layout_alignParentStart="true"
            android:id="@+id/imgCalendar"
            android:layout_width="@dimen/twenty"
            android:layout_height="@dimen/twenty"
            android:src="@drawable/calendar_icon"
            />
        <TextView

            android:id="@+id/datevalue"
            android:layout_toStartOf="@+id/layoutAlarm"
            android:layout_toEndOf="@+id/imgCalendar"
            android:layout_marginStart="@dimen/ten"
            android:layout_width="wrap_content"
            android:layout_centerVertical="true"
            android:text="02-05-2002"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_height="wrap_content">
        </TextView>
        <LinearLayout
            android:visibility="gone"
            android:id="@+id/layoutAlarm"
            android:layout_centerVertical="true"
            android:layout_alignParentEnd="true"
            android:layout_width="wrap_content"
            android:gravity="center"
            android:orientation="vertical"
            android:layout_height="wrap_content">
            <ImageView
                android:layout_width="@dimen/fourty"
                android:src="@drawable/alarm_clock"
                android:layout_height="@dimen/fourty">

            </ImageView>
            <TextView
                android:layout_width="wrap_content"
                style="@style/CustomTextStylePoppinsRegular"
                android:text="@string/set_remainder"
                android:layout_height="wrap_content">
            </TextView>
        </LinearLayout>

    </RelativeLayout>





    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/five"
        android:orientation="horizontal"
        android:gravity="center_vertical">

        <ImageView
            android:layout_width="@dimen/twenty"
            android:layout_height="@dimen/twenty"
            android:src="@drawable/clock_icon"
            />

        <TextView
            android:id="@+id/lblTime"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="00:00 PM"
            android:textSize="@dimen/fourteen_sp"
            android:layout_marginStart="@dimen/ten"
            style="@style/CustomTextStylePoppinsMedium"
            android:textColor="@color/black"/>
    </LinearLayout>

</LinearLayout>
