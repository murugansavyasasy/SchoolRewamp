<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:padding="2dp">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/eight">

        <ImageView
            android:id="@+id/btnPrevMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="center_vertical|start"
            android:layout_marginStart="@dimen/ten"
            android:contentDescription="Previous Month"
            android:gravity="start"
            android:src="@drawable/left_arrow_blue" />

        <TextView
            android:id="@+id/tvMonthYear"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/twenty"
            android:layout_toEndOf="@+id/btnPrevMonth"
            android:gravity="center"
            android:text="December 2026"
            android:textColor="@color/navi_blue2"
            android:textSize="@dimen/eighteen"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/btnNextMonth"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_marginEnd="@dimen/twenty"
            android:contentDescription="Next Month"
            android:src="@drawable/arrow_right_blue" />
    </RelativeLayout>

    <GridView
        android:id="@+id/gridWeekdays"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center"
        android:horizontalSpacing="0dp"
        android:numColumns="7"
        android:stretchMode="columnWidth"
        android:verticalSpacing="0dp" />


    <GridView
        android:id="@+id/gridCalendar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:horizontalSpacing="0dp"
        android:numColumns="7"
        android:stretchMode="columnWidth"
        android:verticalSpacing="0dp" />


    <LinearLayout
        android:id="@+id/linear_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/twele"
        android:layout_marginEnd="8dp"
        android:gravity="end"
        android:orientation="horizontal">

        <Button
            android:id="@+id/btnCancelCalendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/eight"
            android:backgroundTint="#4285F4"
            android:paddingHorizontal="@dimen/twenty"
            android:paddingVertical="@dimen/eight"
            android:text="Cancel"
            android:textColor="@color/white" />

        <Button
            android:id="@+id/btnSaveCalendar"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:backgroundTint="#4285F4"
            android:paddingHorizontal="@dimen/twenty"
            android:paddingVertical="@dimen/eight"
            android:text="@string/done"
            android:textColor="@color/white" />
    </LinearLayout>

</LinearLayout>
