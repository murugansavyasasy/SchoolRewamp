<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/dual_gradient_backgroundcolor"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:id="@+id/rytHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@color/white"
        android:paddingVertical="@dimen/fifteen">

        <ImageView
            android:id="@+id/imgBack"
            android:layout_width="@dimen/thirty_five"
            android:layout_height="@dimen/thirty_five"
            android:layout_centerVertical="true"
            android:src="@drawable/left_arrow" />

        <TextView
            android:id="@+id/lblParentToolBar"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_toStartOf="@+id/rlaStudentName"
            android:layout_toEndOf="@+id/imgBack"
            android:text=""
            android:textColor="@color/black"
            android:textSize="@dimen/fifteen_sp" />

        <LinearLayout
            android:id="@+id/rlaStudentName"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/ten"
            android:layout_toEndOf="@+id/imgBack"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lblStudentName"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />

            <TextView
                android:id="@+id/lblStudentSection"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />
        </LinearLayout>
    </RelativeLayout>

    <ScrollView
        android:id="@+id/scroll_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@id/rytHeader"
        android:fillViewport="true">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:paddingBottom="16dp">

            <TextView
                android:id="@+id/headerview"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="Events"
                android:textColor="@color/black"
                android:textSize="25sp" />


            <RelativeLayout
                android:id="@+id/rytSearch"
                android:layout_width="wrap_content"
                android:layout_height="@dimen/thirty_five"
                android:layout_alignTop="@id/headerview"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="20dp"
                android:visibility="visible">


                <ImageView
                    android:id="@+id/imgSearch"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_search" />

            </RelativeLayout>



            <RelativeLayout
                android:id="@+id/rytSearch1"
                android:layout_width="match_parent"
                android:layout_height="@dimen/thirty_five"
                android:layout_below="@id/headerview"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginStart="15dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/rect_white_search"
                android:visibility="gone">



                <ImageView
                    android:id="@+id/imgSearch1"
                    android:layout_width="@dimen/thirty"
                    android:layout_height="@dimen/thirty"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/ten"
                    android:src="@drawable/ic_search_grey" />

                <EditText
                    android:id="@+id/txtVideoMenu"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:layout_toEndOf="@id/imgSearch1"
                    android:background="@android:color/transparent"
                    android:hint="@string/lblSearch"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp" />
            </RelativeLayout>



            <LinearLayout
                android:id="@+id/linear_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/rytSearch1"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/dark_pink_background"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp">


                <TextView
                    android:id="@+id/event_header"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Christmas Day Celebration"
                    android:textColor="@color/white"
                    android:textSize="25sp" />

                <TextView
                    android:id="@+id/event_description"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:text="Everyone are welcome to the celebration . Kindly wear the color dress for the celebration"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <TextView
                    android:id="@+id/event_time_description"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:text="Event Started At : 12.27 AM , 21 Jul 2025"
                    android:textColor="@color/white"
                    android:textSize="15sp" />

                <LinearLayout
                    android:id="@+id/linear_layout10"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/goingg"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_image_background_white_coupon"
                        android:src="@drawable/profile"
                        app:shapeAppearanceOverlay="@style/RoundedSquare" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/goinggwewe"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_image_background_white_coupon"
                        android:src="@drawable/profile"
                        app:shapeAppearanceOverlay="@style/RoundedSquare" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/goinggwe"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_image_background_white_coupon"
                        android:src="@drawable/profile"
                        app:shapeAppearanceOverlay="@style/RoundedSquare" />

                    <TextView
                        android:id="@+id/goingewrwe"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="9dp"
                        android:layout_marginBottom="9dp"
                        android:background="@drawable/bg_image_background_white_coupon"
                        android:gravity="center"
                        android:text="+9"
                        android:textColor="@color/black"
                        android:textSize="15sp" />


                </LinearLayout>


                <TextView
                    android:id="@+id/going"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"

                    android:layout_marginBottom="10dp"
                    android:background="@drawable/bg_background_white_coupon"
                    android:paddingStart="20dp"
                    android:paddingTop="10dp"
                    android:paddingEnd="20dp"
                    android:paddingBottom="10dp"
                    android:text="On Going"
                    android:textColor="@color/black"
                    android:textSize="15sp" />

            </LinearLayout>


            <ImageView
                android:id="@+id/dotindicator"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/linear_layout"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="20dp"
                android:src="@drawable/dotindicator" />


            <TextView
                android:id="@+id/category_headerview"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/dotindicator"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="Events Categories"
                android:textColor="@color/black"
                android:textSize="20sp" />


            <LinearLayout
                android:id="@+id/categorylinear_layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/category_headerview"
                android:orientation="horizontal">

                <LinearLayout
                    android:id="@+id/linear_layout_categorychild"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="20dp"
                    android:background="@drawable/category_white_box"
                    android:orientation="vertical">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/category_image"
                        android:layout_width="50dp"
                        android:layout_height="50dp"
                        android:layout_gravity="center"
                        android:layout_marginTop="10dp"
                        android:src="@drawable/ic_account"
                        app:shapeAppearanceOverlay="@style/RoundedSquare" />

                    <TextView
                        android:id="@+id/category_name"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="25dp"
                        android:paddingStart="20dp"
                        android:paddingTop="10dp"
                        android:paddingEnd="20dp"
                        android:paddingBottom="25dp"
                        android:gravity="center"
                        android:text="Annual Day"
                        android:maxLines="1"
                        android:ellipsize="end"
                        android:textColor="@color/black"
                        android:textSize="15sp"
                        android:maxWidth="130dp" />



                </LinearLayout>


            </LinearLayout>


            <TextView
                android:id="@+id/upcomingevent_headerview"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/categorylinear_layout"
                android:layout_marginStart="20dp"
                android:layout_marginTop="20dp"
                android:text="Upcoming Events"
                android:textColor="@color/black"
                android:textSize="20sp" />


            <LinearLayout
                android:id="@+id/linear_layout5"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/upcomingevent_headerview"
                android:layout_marginStart="15dp"
                android:layout_marginTop="15dp"
                android:layout_marginEnd="15dp"
                android:background="@drawable/black_background"
                android:orientation="vertical"
                android:paddingStart="20dp"
                android:paddingTop="20dp">


                <TextView
                    android:id="@+id/event_header1"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Annual Day"
                    android:textColor="@color/white"
                    android:textSize="21sp" />

                <TextView
                    android:id="@+id/event_description1"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:text="Event Starts At 10.00am , 22 Jul 2025"
                    android:textColor="@color/gray"
                    android:textSize="15sp" />


                <TextView
                    android:id="@+id/event_description2"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:paddingTop="10dp"
                    android:text="Everyone children need to attend the function with thier parents"
                    android:textColor="@color/gray"
                    android:textSize="15sp" />


                <LinearLayout
                    android:id="@+id/linear_layout9"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="8dp"
                    android:orientation="horizontal">

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/goinggwsdde"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_image_background_white_coupon"
                        android:src="@drawable/profile"
                        app:shapeAppearanceOverlay="@style/RoundedSquare" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/goinggwdskdde"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_image_background_white_coupon"
                        android:src="@drawable/profile"
                        app:shapeAppearanceOverlay="@style/RoundedSquare" />

                    <com.google.android.material.imageview.ShapeableImageView
                        android:id="@+id/goinggsdsadwe"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_image_background_white_coupon"
                        android:src="@drawable/profile"
                        app:shapeAppearanceOverlay="@style/RoundedSquare" />

                    <TextView
                        android:id="@+id/going6"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="40dp"
                        android:layout_height="40dp"
                        android:layout_marginTop="10dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/bg_image_background_white_coupon"

                        android:gravity="center"
                        android:text="+9"
                        android:textColor="@color/black"
                        android:textSize="15sp" />

                    <View
                        android:layout_width="0dp"
                        android:layout_height="0dp"
                        android:layout_weight="1" />


                    <ImageView
                        android:id="@+id/going9"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:layout_marginEnd="20dp"
                        android:layout_marginBottom="10dp"
                        android:background="@drawable/dark_pink_background"
                        android:paddingStart="10dp"
                        android:paddingTop="8dp"
                        android:paddingEnd="10dp"
                        android:paddingBottom="8dp"
                        android:src="@drawable/arrow_right_white" />

                </LinearLayout>

            </LinearLayout>


        </RelativeLayout>
    </ScrollView>
</RelativeLayout>