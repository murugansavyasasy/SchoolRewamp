<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar" />

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcySpecificStudent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_above="@+id/rytSend"
        android:layout_below="@+id/toolbarLayout"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginEnd="@dimen/ten">

    </androidx.recyclerview.widget.RecyclerView>

    <TextView
        android:id="@+id/lblNoRecordsFound"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:text="@string/no_student_found"
        android:visibility="gone">

    </TextView>

    <RelativeLayout
        android:id="@+id/rytSend"
        android:layout_width="match_parent"
        android:layout_height="@dimen/fourty"
        android:layout_alignParentBottom="true"
        android:layout_marginStart="@dimen/fifty"
        android:layout_marginEnd="@dimen/fifty"
        android:layout_marginBottom="@dimen/ten"
        android:layout_weight="0.5"
        android:background="@drawable/bg_orange"
        android:gravity="center"
        android:padding="@dimen/eight"
        android:visibility="visible">


        <TextView
            android:id="@+id/lblSend"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:fontFamily="@font/poppins_regular"
            android:gravity="center_horizontal"
            android:text="@string/Send"
            android:textColor="@color/white"
            android:textSize="@dimen/fifteen_sp"
            android:textStyle="normal"
            android:visibility="visible">

        </TextView>


        <ImageView
            android:id="@+id/imgSend1"
            android:layout_width="@dimen/twenty"
            android:layout_height="@dimen/twenty"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/five"
            android:layout_marginEnd="@dimen/five"
            android:layout_toEndOf="@+id/lblSend"
            android:src="@drawable/send_icon_white" />


    </RelativeLayout>


</RelativeLayout>