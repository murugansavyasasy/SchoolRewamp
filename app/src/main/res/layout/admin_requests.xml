<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto">

    <androidx.constraintlayout.widget.ConstraintLayout
        app:layout_constraintTop_toTopOf="parent"
        android:id="@+id/consHeader"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="0dp"
        android:background="@color/white"
        android:paddingVertical="@dimen/twenty"
        android:layout_height="wrap_content">
        <TextView
            android:layout_width="0dp"
            android:layout_marginEnd="@dimen/five"
            app:layout_constraintEnd_toStartOf="@+id/imgClose"
            android:id="@+id/lblAdminRequest"
            app:layout_constraintBottom_toTopOf="@+id/lblPendingRequest"
            app:layout_constraintStart_toStartOf="parent"
            android:layout_marginStart="@dimen/ten"
            app:layout_constraintTop_toTopOf="parent"
            android:textSize="@dimen/twenty_four_sp"
            style="@style/CustomTextStylePoppinsBold"
            android:text="@string/admin_requests"
            android:layout_height="wrap_content">

        </TextView>
        <ImageView
            android:layout_marginEnd="@dimen/ten"
            android:id="@+id/imgClose"
            app:layout_constraintStart_toEndOf="@+id/lblAdminRequest"
            android:src="@drawable/close_icon"
            android:padding="@dimen/five"
            android:background="@drawable/bg_circle_gray"
            android:tint="@color/black"
            app:layout_constraintBottom_toTopOf="@+id/lblPendingRequest"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            android:layout_width="@dimen/fourty"
            android:layout_height="@dimen/fourty">

        </ImageView>

        <TextView
            android:layout_width="0dp"
            app:layout_constraintTop_toBottomOf="@+id/lblAdminRequest"
            android:id="@+id/lblPendingRequest"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:layout_marginStart="@dimen/ten"
            android:textSize="@dimen/thirteen_sp"
            android:textColor="@color/light_gray"
            android:layout_marginTop="@dimen/eight"
            style="@style/CustomTextStylePoppinsBold"
            android:text="2 pending request"
            app:layout_constraintBottom_toBottomOf="parent"
            android:layout_height="wrap_content">

        </TextView>

    </androidx.constraintlayout.widget.ConstraintLayout>
    <androidx.core.widget.NestedScrollView
        android:layout_width="match_parent"
        android:layout_height="0dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/consHeader"
        >
        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <com.google.android.material.button.MaterialButton
                android:id="@+id/lblNewRequest"
                android:minHeight="0dp"
                android:paddingVertical="@dimen/ten"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_marginTop="@dimen/five"
                app:layout_constrainedHeight="true"
                android:textSize="@dimen/thirteen_sp"
                app:layout_constrainedWidth="true"
                android:layout_marginBottom="@dimen/ten"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_width="0dp"
                android:layout_marginHorizontal="@dimen/fifteen"
                android:textColor="@color/white"
                app:layout_constraintEnd_toEndOf="parent"
                android:background="@drawable/primary_rect_radius"
                app:icon="@drawable/ic_plus"
                app:iconTint="@color/white"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:layout_constraintBottom_toTopOf="@+id/viewSubmitNewRequestBG"
                app:layout_constraintTop_toTopOf="parent"
                android:text="@string/new_request"
                android:layout_height="wrap_content">

            </com.google.android.material.button.MaterialButton>

            <View
                android:layout_marginHorizontal="@dimen/fifteen"
                android:id="@+id/viewSubmitNewRequestBG"
                app:layout_constraintTop_toBottomOf="@+id/lblNewRequest"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent"
                android:layout_width="0dp"
                android:background="@drawable/rect_radius_light_blue"
                app:layout_constraintBottom_toBottomOf="@id/brSubmitRequestCancel"
                android:layout_height="0dp">

            </View>

            <TextView
                android:layout_marginTop="@dimen/ten"
                app:layout_constraintTop_toTopOf="@+id/viewSubmitNewRequestBG"
                android:layout_width="0dp"
                android:textSize="@dimen/eighteen_sp"
                style="@style/CustomTextStylePoppinsBold"
                android:textColor="@color/very_dark_blue_10"
                android:layout_marginHorizontal="@dimen/fifteen"
                android:id="@+id/lblSubmitNewRequest"
                app:layout_constraintEnd_toEndOf="@+id/viewSubmitNewRequestBG"
                app:layout_constraintStart_toStartOf="@+id/viewSubmitNewRequestBG"
                android:text="@string/submit_new_request"
                android:layout_height="wrap_content">

            </TextView>
            <EditText
                android:layout_marginTop="@dimen/five"
                android:id="@+id/lblRoomNo"
                android:layout_width="0dp"
                android:textSize="@dimen/thirteen_sp"
                android:hint="Room Number(e.g.,101)"
                android:paddingHorizontal="@dimen/ten"
                android:paddingVertical="@dimen/ten"
                android:textColor="@color/light_gray_10"
                android:background="@drawable/rect_stoke_bg_radius"
                android:layout_marginHorizontal="@dimen/fifteen"
                app:layout_constraintStart_toStartOf="@+id/viewSubmitNewRequestBG"
                app:layout_constraintEnd_toEndOf="@+id/viewSubmitNewRequestBG"
                app:layout_constraintTop_toBottomOf="@+id/lblSubmitNewRequest"
                android:layout_height="wrap_content">
            </EditText>

            <EditText
                android:layout_marginTop="@dimen/five"
                android:paddingVertical="@dimen/fifteen"
                android:id="@+id/EdtIssue"
                android:layout_marginHorizontal="@dimen/fifteen"
                android:layout_width="0dp"
                android:layout_marginBottom="@dimen/ten"
                android:background="@drawable/rect_white_gray_stoke_radius"
                app:layout_constraintTop_toBottomOf="@+id/lblRoomNo"
                app:layout_constraintStart_toStartOf="@+id/viewSubmitNewRequestBG"
                app:layout_constraintEnd_toEndOf="@+id/viewSubmitNewRequestBG"
                android:layout_height="wrap_content">
            </EditText>


            <com.google.android.material.button.MaterialButton
                app:layout_constraintHorizontal_chainStyle="spread"
                android:id="@+id/lblSubmitRequest"
                android:minHeight="0dp"
                android:paddingVertical="@dimen/ten"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_marginTop="@dimen/ten"
                app:layout_constrainedHeight="true"
                android:textSize="@dimen/thirteen_sp"
                app:layout_constrainedWidth="true"
                android:layout_marginBottom="@dimen/ten"
                app:layout_constraintHorizontal_weight="1"
                app:layout_constraintStart_toStartOf="@+id/viewSubmitNewRequestBG"
                android:layout_width="0dp"
                android:layout_marginHorizontal="@dimen/fifteen"
                android:textColor="@color/white"
                android:background="@drawable/primary_rect_radius"
                app:icon="@drawable/send_icon"
                app:iconGravity="textStart"
                app:iconPadding="4dp"
                app:layout_constraintBottom_toBottomOf="@+id/viewSubmitNewRequestBG"
                app:layout_constraintEnd_toStartOf="@+id/lblCancel"
                app:layout_constraintTop_toBottomOf="@+id/EdtIssue"
                android:text="@string/submit_request"
                android:layout_height="wrap_content">

            </com.google.android.material.button.MaterialButton>

            <TextView
                app:layout_constrainedHeight="true"
                app:layout_constrainedWidth="true"
                android:layout_marginHorizontal="@dimen/fifteen"
                android:gravity="center"
                android:textSize="@dimen/thirteen_sp"
                style="@style/CustomTextStylePoppinsMedium"
                android:paddingVertical="@dimen/ten"
                app:layout_constraintHorizontal_weight="0.4"
                android:id="@+id/lblCancel"
                android:background="@drawable/rect_white_gray_stoke_radius"
                app:layout_constraintStart_toEndOf="@+id/lblSubmitRequest"
                app:layout_constraintEnd_toEndOf="@+id/viewSubmitNewRequestBG"
                android:layout_width="0dp"
                app:layout_constraintBottom_toBottomOf="@+id/viewSubmitNewRequestBG"
                app:layout_constraintTop_toBottomOf="@+id/EdtIssue"
                android:text="@string/cancel"
                android:layout_height="wrap_content">
            </TextView>

            <androidx.constraintlayout.widget.Barrier
                app:barrierDirection="bottom"
                android:id="@+id/brSubmitRequestCancel"
                app:constraint_referenced_ids="lblSubmitRequest,lblCancel"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content">

            </androidx.constraintlayout.widget.Barrier>

            <androidx.constraintlayout.widget.Group
                android:layout_width="wrap_content"
                app:constraint_referenced_ids="viewSubmitNewRequestBG,lblSubmitNewRequest,EdtIssue,lblRoomNo,EdtIssue,lblSubmitRequest,lblCancel"
                android:id="@+id/groupEntireAdminRequest"
                android:visibility="gone"
                android:layout_height="wrap_content">

            </androidx.constraintlayout.widget.Group>

            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="0dp"
                app:layout_constraintTop_toBottomOf="@+id/viewSubmitNewRequestBG"
                android:layout_marginHorizontal="@dimen/fifteen"
                android:id="@+id/rcAdminRequest"
                android:layout_marginTop="@dimen/ten"
                app:layout_constraintEnd_toEndOf="parent"
                android:nestedScrollingEnabled="false"
                android:overScrollMode="never"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_height="wrap_content">

            </androidx.recyclerview.widget.RecyclerView>
            <ImageView
                android:visibility="gone"
                android:layout_marginTop="@dimen/ten"
                app:layout_constraintTop_toBottomOf="@+id/rcAdminRequest"
                android:layout_width="@dimen/two_hundred"
                android:id="@+id/imgNoDataFound"
                android:src="@drawable/no_data_found"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:layout_height="@dimen/two_hundred">
            </ImageView>
            <TextView
                android:visibility="gone"
                android:layout_width="0dp"
                android:id="@+id/lblErrorMessage"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                android:gravity="center"
                android:text="nod"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_marginHorizontal="@dimen/twenty"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@+id/imgNoDataFound"
                android:layout_height="wrap_content">

            </TextView>
        </androidx.constraintlayout.widget.ConstraintLayout>

    </androidx.core.widget.NestedScrollView>


</androidx.constraintlayout.widget.ConstraintLayout>
