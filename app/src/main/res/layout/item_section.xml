<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/cardSection"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/ten"
    android:layout_marginVertical="@dimen/six"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/sixteen"
    app:cardElevation="@dimen/two">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/fourteen">

        <View
            android:id="@+id/viewAvatar"
            android:layout_width="@dimen/fourty_four"
            android:layout_height="@dimen/fourty_four"
            android:layout_centerVertical="true"
            android:background="@drawable/circle_light_purple" />

        <TextView
            android:id="@+id/lblAvatarLetter"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="@dimen/fourty_four"
            android:layout_height="@dimen/fourty_four"
            android:layout_centerVertical="true"
            android:gravity="center"
            android:text="A"
            android:textColor="@color/PrimaryColor"
            android:textSize="@dimen/eighteen_sp" />

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/fifty_five"
            android:layout_marginEnd="@dimen/thirty"
            android:orientation="vertical">

            <TextView
                android:id="@+id/lblSectionName"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Section A"
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp" />

            <TextView
                android:id="@+id/lblSectionDetail"
                style="@style/CustomTextStylePoppinsRegular"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/two"
                android:text="Standard I — A"
                android:textColor="@color/grey"
                android:textSize="@dimen/twele_sp" />

        </LinearLayout>

        <ImageView
            android:id="@+id/imgSectionCheck"
            android:layout_width="@dimen/twenty_four"
            android:layout_height="@dimen/twenty_four"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:src="@drawable/checked_icon_white"
            android:visibility="gone" />

    </RelativeLayout>

</androidx.cardview.widget.CardView>
