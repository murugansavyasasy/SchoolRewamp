<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:padding="@dimen/eight">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/five"
        android:background="@drawable/rect_shadow_white">

        <View
            android:id="@+id/pinHole"
            android:layout_width="@dimen/twele"
            android:layout_height="@dimen/twele"
            android:layout_centerHorizontal="true"
            android:layout_marginTop="@dimen/three"
            android:background="@drawable/circle_bg_black" />


        <ImageView
            android:id="@+id/imgNewImage"
            android:layout_width="@dimen/eighty"
            android:layout_height="@dimen/eighty"
            android:layout_alignParentEnd="true"
            android:layout_marginTop="@dimen/minus_eighteen"
            android:elevation="@dimen/ten"
            android:src="@drawable/new_icon"
            android:visibility="gone">

        </ImageView>

        <TextView
            android:id="@+id/lblTitleImage"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/pinHole"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/five"
            android:text="Annual Day celebrations"
            />


        <RelativeLayout
            android:id="@+id/rlaImageReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lblTitleImage"
            android:layout_marginTop="@dimen/ten"
            android:visibility="visible">


            <TextView
                android:id="@+id/LblHWSubjectName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/fifteen"
                android:fontFamily="@font/poppins_bold"
                android:text="Annual Day celebrations"
                android:textSize="@dimen/eighteen_sp"
                android:visibility="gone" />


            <TextView
                android:id="@+id/lblDateImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblContentImage"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/ten"
                style="@style/CustomTextStylePoppinsRegular"
                android:text="15 Nov 2024"
                android:textSize="@dimen/thirteen_sp"
                />

            <LinearLayout
                android:id="@+id/lytRecyclerwview"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/LblHWSubjectName"
                android:layout_marginTop="@dimen/ten"
                android:orientation="vertical">

                <androidx.recyclerview.widget.RecyclerView
                    android:id="@+id/rcyImgPDF"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:visibility="gone" />

                <me.relex.circleindicator.CircleIndicator2
                    android:id="@+id/indicator"
                    style="@style/IndicatorStyle"
                    android:layout_width="wrap_content"
                    android:layout_height="@dimen/thirty"
                    android:layout_below="@+id/lytRecyclerwview"
                    android:layout_centerInParent="true"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/five"
                    android:elevation="@dimen/four"
                    android:visibility="visible" />


            </LinearLayout>


            <TextView
                android:id="@+id/lblContentImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lytRecyclerwview"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/five"
                android:maxLines="3"
                android:text="If you're working in a collaborative environment, stashing and pulling is often the safest option, as it allows you to integrate your work with the latest changes without losing progress."
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp"
                android:textStyle="normal" />


            <TextView
                android:id="@+id/tvSeeMoreImage"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblContentImage"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginBottom="@dimen/ten"
                android:text="@string/SeeMore"
                android:textColor="@android:color/holo_blue_dark"
                android:visibility="gone" />
        </RelativeLayout>
    </RelativeLayout>


    <ImageView
        android:id="@+id/imgPin"
        android:layout_width="@dimen/twenty_four"
        android:layout_height="@dimen/twenty_four"
        android:layout_gravity="top|center_horizontal"
        android:contentDescription="Pin icon"
        android:src="@drawable/pin"
        android:layout_marginStart="@dimen/ten"
        android:translationY="@dimen/minus_one" />
</FrameLayout>