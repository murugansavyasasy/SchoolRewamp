<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    >
    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:padding="8dp"
        android:gravity="center"
        android:background="@drawable/rounded_border_background"
        >
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_weight="1"
            android:orientation="vertical"
            android:padding="@dimen/eight">

            <TextView
                android:id="@+id/lblName"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                style="@style/CustomTextStylePoppinsBold"
                android:textSize="@dimen/sixteen_sp"
                />
            <TextView
                android:id="@+id/lblRegNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:textSize="@dimen/fourteen_sp"
                android:text=""
                android:textColor="@color/mild_grey_dark"
                style="@style/CustomTextStylePoppinsMedium"
                />
            <TextView
                android:id="@+id/lblAdmissionNo"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                style="@style/CustomTextStylePoppinsMedium"
                android:textSize="@dimen/fourteen_sp"
                android:textColor="@color/mild_grey_dark"
                />
        </LinearLayout>

        <TextView
            android:gravity="center"
            android:id="@+id/btnRemove"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="@string/remove"
            android:paddingVertical="@dimen/ten"
            android:paddingHorizontal="@dimen/twenty"
            android:background="@drawable/rect_shadow_red"
            android:backgroundTint="@color/red"
            style="@style/CustomTextStylePoppinsBold"
            android:textColor="@color/white"
            />
    </LinearLayout>
    <View
        android:layout_marginTop="@dimen/five"
        android:layout_width="match_parent"
        android:layout_marginBottom="@dimen/five"
        android:background="@color/gray"
        android:layout_height="@dimen/one">
    </View>
</LinearLayout>