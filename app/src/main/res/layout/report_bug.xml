<?xml version="1.0" encoding="utf-8"?>
<androidx.core.widget.NestedScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/light_white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <RelativeLayout
            android:id="@+id/rlaLblReportBug"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/PrimaryColor"
            android:padding="@dimen/ten">

            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="@dimen/thirty"
                android:layout_height="@dimen/thirty"
                android:layout_marginStart="@dimen/ten"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/ten"
                android:layout_marginBottom="@dimen/ten"
                android:src="@drawable/arrow_left_white"></ImageView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fifteen"
                android:layout_marginTop="@dimen/ten"
                android:layout_toEndOf="@+id/imgBack"
                android:text="@string/lblReportbug"
                android:textColor="@color/white"
                android:textSize="@dimen/twenty_sp"
                android:textStyle="bold">

            </TextView>

            <RelativeLayout
                android:id="@+id/lblSendBug"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginTop="@dimen/five"
                android:layout_marginEnd="@dimen/twenty"
                android:gravity="center"
                android:padding="@dimen/thirteen">

                <TextView
                    android:id="@+id/lblSend"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Send"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp"
                    android:textStyle="bold"
                    android:visibility="gone">

                </TextView>

                <ImageView
                    android:visibility="gone"
                    android:layout_width="@dimen/twenty"
                    android:layout_height="@dimen/twenty"
                    android:layout_toEndOf="@+id/lblSend"
                    android:src="@drawable/send_feedback_icon_white">

                </ImageView>

            </RelativeLayout>
        </RelativeLayout>


        <Spinner
            android:id="@+id/isMenuSpinner"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rlaLblReportBug"
            android:layout_margin="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:background="@drawable/field_background"></Spinner>



        <LinearLayout
            android:id="@+id/lnrDesc"
            android:layout_width="match_parent"
            android:layout_height="@dimen/two_hundred"
            android:layout_below="@+id/isMenuSpinner"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:background="@drawable/field_background"
            android:gravity="center_vertical"
            android:orientation="horizontal">

        <EditText
            android:id="@+id/edtReportBug"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/isMenuSpinner"
            android:background="@android:color/transparent"
            android:gravity="top"
            android:hint="@string/lblEntertheBug"
            android:padding="@dimen/ten"
            android:textSize="@dimen/thirteen_sp">

        </EditText>

        </LinearLayout>

        <RelativeLayout
            android:id="@+id/rlaPickImage"
            android:layout_width="match_parent"
            android:layout_height="@dimen/sixty"
            android:layout_below="@+id/lnrDesc"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:background="@drawable/field_background"
            android:gravity="center">

            <ImageView
                android:id="@+id/imgUpload"
                android:layout_width="@dimen/thirty"
                android:layout_height="@dimen/thirty"
                android:layout_centerVertical="true"
                android:src="@drawable/upload"></ImageView>

            <TextView
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/ten"
                android:layout_toEndOf="@+id/imgUpload"
                android:text="@string/lblAttachment"
                android:textSize="@dimen/thirteen_sp"
                android:textStyle="bold">

            </TextView>

        </RelativeLayout>

        <GridView
            android:id="@+id/imgPreview"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/rlaPickImage"
            android:layout_marginTop="@dimen/ten"
            android:numColumns="2"
            android:padding="@dimen/ten"
            android:stretchMode="columnWidth">

        </GridView>

        <TextView
            android:id="@+id/btnReportBug"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/imgPreview"
            android:layout_marginStart="@dimen/twenty_five"
            android:layout_marginEnd="@dimen/twenty_five"
            android:layout_marginBottom="@dimen/twenty"
            android:layout_marginTop="@dimen/twenty"
            android:layout_centerInParent="true"
            android:background="@drawable/background_radius_button"
            android:gravity="center"
            android:padding="@dimen/ten"
            android:text="Report a bug"
            android:textColor="@color/white"
            android:textSize="@dimen/fifteen_sp" />
    </RelativeLayout>
</androidx.core.widget.NestedScrollView>

