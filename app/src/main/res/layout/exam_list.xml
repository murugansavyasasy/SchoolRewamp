<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/dark_gray_9">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />


    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground" />



    <LinearLayout
        android:fillViewport="true"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarLayout"
        android:layout_width="match_parent"
        android:orientation="vertical"
        android:layout_height="0dp">
        <RelativeLayout
            android:id="@+id/rytSearch1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/thirty_five"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/ten"
            android:background="@drawable/rect_grey"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgSearch1"
                android:layout_width="@dimen/thirty"
                android:layout_height="@dimen/thirty"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/ten"
                android:src="@drawable/ic_search" />

            <EditText
                android:id="@+id/txtSearch1"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_toEndOf="@id/imgSearch1"
                android:background="@android:color/transparent"
                android:hint="@string/lblSearch"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />
        </RelativeLayout>
        <ScrollView
            android:fillViewport="true"
            android:id="@+id/svOverallCreateQE"
            android:layout_width="match_parent"
            android:layout_height="match_parent">

            <RelativeLayout
                android:id="@+id/rlaQuizExamReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/five"
                android:layout_marginTop="@dimen/ten"
                android:layout_marginEnd="@dimen/five"
                >

                <TextView
                    android:layout_marginHorizontal="@dimen/ten"
                    android:id="@+id/lblClassSectionDetail"
                    android:layout_width="match_parent"
                    style="@style/CustomTextStylePoppinsRegular"
                    android:textColor="@color/dark_orange_2"
                    android:textSize="@dimen/twenty_sp"
                    android:text="Grade 0 - Section"
                    android:layout_height="wrap_content">
                </TextView>

                <TextView
                    android:layout_marginHorizontal="@dimen/ten"
                    android:id="@+id/lblClassContinue0"
                    android:layout_below="@+id/lblClassSectionDetail"
                    android:layout_width="match_parent"
                    style="@style/CustomTextStylePoppinsRegular"
                    android:textSize="@dimen/fifteen_sp"
                    android:layout_marginTop="@dimen/ten"
                    android:text="@string/select_an_exam_to_continue"
                    android:layout_height="wrap_content">

                </TextView>
                <LinearLayout
                    android:layout_marginBottom="@dimen/five"
                    android:layout_below="@+id/lblClassContinue0"
                    android:id="@+id/lnrContainer"
                    android:orientation="vertical"
                    android:layout_above="@+id/LnrContainer2"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent">
                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rcExamList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_marginTop="@dimen/ten">
                    </androidx.recyclerview.widget.RecyclerView>


                    <LinearLayout
                        android:id="@+id/lytList"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:layout_centerInParent="true"
                        android:gravity="center"
                        android:orientation="vertical"
                        android:visibility="gone">

                        <ImageView
                            android:id="@+id/noDataImage"
                            android:layout_width="@dimen/two_hundred"
                            android:layout_height="@dimen/two_hundred"
                            android:layout_marginTop="@dimen/twenty_five"
                            android:src="@drawable/no_data_found">
                        </ImageView>

                        <TextView
                            android:id="@+id/txtNoData"
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_gravity="center"
                            android:layout_marginTop="@dimen/twenty"
                            android:text="@string/no_data_found"
                            android:textSize="@dimen/fifteen_sp">

                        </TextView>
                    </LinearLayout>
                </LinearLayout>

                <LinearLayout
                    android:layout_marginBottom="@dimen/five"
                    android:id="@+id/LnrContainer2"
                    android:layout_alignParentBottom="true"
                    android:orientation="vertical"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                    <View
                        android:layout_marginHorizontal="@dimen/ten"
                        android:layout_width="match_parent"
                        android:background="@color/AthensGray"
                        android:layout_height="@dimen/two">

                    </View>

                    <LinearLayout
                        android:layout_marginTop="@dimen/five"
                        android:layout_marginHorizontal="@dimen/ten"
                        android:id="@+id/lnrUpload"
                        android:layout_width="match_parent"
                        android:gravity="center"
                        android:paddingVertical="@dimen/twele"
                        android:background="@drawable/rect_orange_bg"
                        android:layout_height="wrap_content">
                        <TextView
                            android:id="@+id/lblUpload"
                            style="@style/CustomTextStylePoppinsBold"
                            android:textSize="@dimen/fifteen_sp"
                            android:layout_width="wrap_content"
                            android:textColor="@color/white"
                            android:gravity="center"
                            android:drawablePadding="@dimen/twele"
                            android:drawableEnd="@drawable/right_arrow_ic"
                            android:text="@string/continue_to_upload"
                            android:layout_height="wrap_content">
                        </TextView>
                    </LinearLayout>

                    <TextView
                        android:gravity="center"
                        android:layout_marginHorizontal="@dimen/ten"
                        android:id="@+id/lblClassContinue"
                        style="@style/CustomTextStylePoppinsRegular"
                        android:layout_width="match_parent"
                        android:textSize="@dimen/fifteen_sp"
                        android:layout_marginTop="@dimen/five"
                        android:text="@string/please_select_an_exam_to_continue"
                        android:layout_height="wrap_content">

                    </TextView>

                </LinearLayout>
            </RelativeLayout>



        </ScrollView>


    </LinearLayout>



</androidx.constraintlayout.widget.ConstraintLayout>