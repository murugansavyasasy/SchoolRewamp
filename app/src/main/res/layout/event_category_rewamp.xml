<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="wrap_content"
    android:layout_height="wrap_content"
    android:fitsSystemWindows="true">


    <LinearLayout
        android:id="@+id/categorylinear_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="horizontal">

        <LinearLayout
            android:id="@+id/linear_layout_categorychild"
            android:layout_width="@dimen/hundred"
            android:layout_height="@dimen/one_thirty"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/ten"
            android:background="@drawable/category_white_box"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/category_image"
                android:layout_width="@dimen/fifty"
                android:layout_height="@dimen/fifty"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/ten"
                android:src="@drawable/allimage" />

            <TextView
                android:id="@+id/category_name"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/thirty"
                android:gravity="center"
                android:maxWidth="@dimen/one_thirty"
                android:text="All"
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp"
                android:layout_gravity="center"
                android:layout_marginBottom="@dimen/twenty_sp"
                android:maxLines="5"
                android:ellipsize="end" />


        </LinearLayout>


    </LinearLayout>


</RelativeLayout>