<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:padding="@dimen/ten"
    android:layout_height="wrap_content">

    <TextView
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:id="@+id/headerlabel"
        android:text="Month "
        android:textColor="@color/black"
        android:layout_marginStart="@dimen/fifteen"
        android:textSize="@dimen/fifteen_sp"
        style="@style/CustomTextStylePoppinsBold"/>

    <EditText
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:id="@+id/headerlabe1l"
        android:layout_below="@+id/headerlabel"
        android:text="Value"
        android:textColor="@color/black"
        android:background="@drawable/field_background"
        android:padding="@dimen/ten"
        android:visibility="visible"
        android:gravity="start"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:textSize="@dimen/fifteen_sp"
        android:layout_marginTop="@dimen/ten"
        style="@style/CustomTextStylePoppinsMedium"/>

    <TextView
        android:id="@+id/headerdatelabe1l"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/headerlabe1l"
        android:text=""
        android:background="@drawable/field_background"
        android:padding="@dimen/ten"
        android:visibility="gone"
        android:gravity="start|center_vertical"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:textSize="@dimen/fifteen_sp"
        android:layout_marginTop="@dimen/ten"
        android:drawableEnd="@drawable/ic_date_time_primary"
    android:drawablePadding="8dp"
    style="@style/CustomTextStylePoppinsMedium" />



    <LinearLayout
        android:id="@+id/SpinnerItem"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/headerdatelabe1l"
        android:background="@drawable/field_background"
        android:orientation="horizontal"
        android:layout_marginTop="@dimen/ten"
        android:visibility="visible"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:weightSum="1">

        <RelativeLayout
            android:id="@+id/spinnerdropdown"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="@dimen/eight"
            android:layout_weight="0.5"
            android:gravity="center">

            <Spinner
                android:id="@+id/isSpinner"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:background="@drawable/custom_spinner_background" />

        </RelativeLayout>
    </LinearLayout>

</RelativeLayout>