<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">


        <RelativeLayout
            android:id="@+id/rytGPSRedirect"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="15dp"
            android:background="@drawable/bg_rect_location"
            android:padding="20dp"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgLocationIllustrate"
                android:layout_width="wrap_content"
                android:layout_height="150dp"
                android:src="@drawable/password_illustrate" />


            <TextView
                android:id="@+id/lblTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/imgLocationIllustrate"
                android:layout_marginTop="10dp"
                android:text="@string/allow_location_access_to_mark_your_attendance"
                android:textColor="@color/black"
                android:textSize="20dp"
                android:textStyle="bold" />

            <RelativeLayout
                android:id="@+id/rytContetnt"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/lblTitle"
                android:layout_marginTop="20dp">

                <ImageView
                    android:id="@+id/imgLocation"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_centerVertical="true"
                    android:src="@drawable/ic_location" />

                <TextView
                    android:id="@+id/lbl"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="20dp"
                    android:layout_marginTop="10dp"
                    android:layout_toEndOf="@+id/imgLocation"
                    android:text="@string/to_enhance_your_experience_and_provide_accurate_location_based_features_please_enable_gps"
                    android:textColor="@color/grey"
                    android:textSize="15dp" />

            </RelativeLayout>


            <TextView
                android:id="@+id/btnEnableLocation"
                android:layout_width="match_parent"
                android:layout_height="50dp"
                android:layout_alignParentBottom="true"
                android:layout_marginBottom="20dp"
                android:background="@drawable/bg_rect_location"
                android:gravity="center"
                android:text="@string/enable_location"
                android:textAlignment="center"
                android:textColor="@color/black"
                android:textSize="15dp"
                android:textStyle="bold" />

        </RelativeLayout>


        <FrameLayout
            android:id="@+id/frmAddLocationLayout"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_margin="15dp"
            android:visibility="visible">

            <ImageView
                android:id="@+id/gifImageView"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerInParent="true"
                android:alpha="0.1" />


            <RelativeLayout
                android:id="@+id/rytProgressBar"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:visibility="gone">

                <ProgressBar
                    android:id="@+id/custom_progress_bar"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_margin="5dp"
                    android:indeterminate="true"
                    android:indeterminateTint="@color/yellow"
                    android:indeterminateTintMode="src_atop"
                    android:max="100" />

                <TextView
                    android:id="@+id/idTVHeading"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/custom_progress_bar"
                    android:layout_centerInParent="true"
                    android:layout_margin="5dp"
                    android:gravity="center"
                    android:text="@string/fetching_location"
                    android:textAlignment="center"
                    android:textColor="@color/black"
                    android:textSize="15sp"
                    android:textStyle="bold" />

            </RelativeLayout>


            <ScrollView
                android:layout_width="match_parent"
                android:layout_height="match_parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:orientation="vertical"
                    android:padding="10dp">

                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">

                        <ImageView
                            android:id="@+id/imgBack"
                            android:layout_width="@dimen/twenty"
                            android:layout_height="@dimen/twenty"
                            android:src="@drawable/arrow_back_black">

                        </ImageView>

                        <TextView
                            android:id="@+id/lblNote"
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_toEndOf="@+id/imgBack"
                            android:gravity="center"
                            android:text="Important"
                            android:textColor="@color/red"
                            android:textSize="15dp" />

                        <RelativeLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_below="@+id/lblNote"
                            android:layout_marginTop="@dimen/ten"
                            android:background="@drawable/outline_gray">

                            <View
                                android:id="@+id/stripe"
                                android:layout_width="@dimen/eight"
                                android:layout_height="match_parent"
                                android:layout_alignTop="@id/instructionText"
                                android:layout_alignBottom="@id/instructionText"
                                android:layout_alignParentStart="true"
                                android:background="@drawable/bg_start_side_radious" />

                            <TextView
                                android:id="@+id/instructionText"
                                style="@style/CustomTextStylePoppinsBold"
                                android:layout_width="match_parent"
                                android:layout_height="wrap_content"
                                android:layout_toEndOf="@id/stripe"
                                android:gravity="start"
                                android:padding="@dimen/five"
                                android:text="@string/location_add_instructions_attendance"
                                android:textColor="@color/black"
                                android:textSize="@dimen/thirteen_sp" />
                        </RelativeLayout>


                        <!--                        <TextView-->
                        <!--                            style="@style/CustomTextStylePoppinsMedium"-->
                        <!--                            android:layout_width="match_parent"-->
                        <!--                            android:layout_height="wrap_content"-->
                        <!--                            android:layout_below="@+id/lblNote"-->
                        <!--                            android:background="@drawable/outline_gray"-->
                        <!--                            android:layout_marginTop="@dimen/ten"-->
                        <!--                            android:padding="@dimen/five"-->
                        <!--                            android:gravity="start"-->
                        <!--                            android:text="@string/location_add_instructions_attendance"-->
                        <!--                            android:textColor="@color/black"-->
                        <!--                            android:textSize="@dimen/thirteen_sp" />-->

                    </RelativeLayout>

                    <TextView
                        android:id="@+id/lblLocationTitle"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="15dp"
                        android:text="@string/enter_location_name"
                        android:textColor="@color/black"
                        android:textSize="15dp" />

                    <EditText
                        android:id="@+id/txtLocationName"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/five"
                        android:layout_marginTop="@dimen/ten"
                        android:background="@drawable/outline_gray"
                        android:hint="Pin your location name"
                        android:inputType="text"
                        android:padding="@dimen/eight"
                        android:textColorHint="@color/jumbo"
                        android:textSize="15dp" />

                    <TextView
                        android:id="@+id/lblDistanceTitle"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="10dp"
                        android:text="Distance *"
                        android:textColor="@color/black"
                        android:textSize="15dp" />


                    <RelativeLayout
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/fourty"
                        android:layout_marginStart="@dimen/five"
                        android:layout_marginTop="@dimen/five"
                        android:background="@drawable/outline_gray">


                        <RelativeLayout
                            android:id="@+id/rytSpinnertMetres"
                            android:layout_width="@dimen/hundred"
                            android:layout_height="@dimen/thirty_five"
                            android:layout_centerVertical="true"
                            android:layout_marginStart="@dimen/two"
                            android:background="@color/gray">

                            <Spinner
                                android:id="@+id/spinnerMetres"
                                android:layout_width="match_parent"
                                android:layout_height="match_parent"
                                android:layout_centerVertical="true"
                                android:layout_gravity="center"
                                android:layout_toStartOf="@+id/imgDropCountry"
                                android:background="@android:color/transparent"
                                android:gravity="left"
                                android:paddingLeft="10dp"
                                android:spinnerMode="dropdown" />

                            <ImageView
                                android:id="@+id/imgDropCountry"
                                android:layout_width="30dp"
                                android:layout_height="30dp"
                                android:layout_alignParentEnd="true"
                                android:layout_centerVertical="true"
                                android:layout_gravity="center"
                                android:src="@drawable/ic_drop_down" />

                        </RelativeLayout>

                        <EditText
                            android:id="@+id/txtMeters"
                            android:layout_width="match_parent"
                            android:layout_height="match_parent"
                            android:layout_marginStart="5dp"
                            android:layout_toStartOf="@+id/lblMeter"
                            android:layout_toEndOf="@+id/rytSpinnertMetres"
                            android:background="@null"
                            android:gravity="center"
                            android:hint="Drop your location"
                            android:inputType="number"
                            android:textColor="@color/black"
                            android:textSize="@dimen/thirteen_sp" />


                        <TextView
                            android:id="@+id/lblMeter"
                            style="@style/CustomTextStylePoppinsMedium"
                            android:layout_width="wrap_content"
                            android:layout_height="match_parent"
                            android:layout_alignParentEnd="true"
                            android:layout_marginEnd="@dimen/ten"
                            android:gravity="center"
                            android:text="Meter(s)"
                            android:textColor="@color/black"
                            android:textSize="@dimen/thirteen_sp">

                        </TextView>

                    </RelativeLayout>


                    <TextView
                        android:id="@+id/lblGetLocation"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="30dp"
                        android:text="@string/get_your_location"
                        android:textColor="@color/black"
                        android:textSize="@dimen/thirteen_sp"
                        android:visibility="visible" />

                    <ImageView
                        android:id="@+id/webViewMap"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/one_fifty"
                        android:src="@drawable/map">

                    </ImageView>

                    <TextView

                        android:id="@+id/btnViewLocations"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/fourty"
                        android:layout_marginTop="@dimen/ten"
                        android:background="@drawable/rect_skyblue"
                        android:gravity="center"
                        android:text="@string/tap_to_view_your_existing_punch_locations"
                        android:textColor="@color/white"
                        android:textSize="@dimen/fifteen_sp"
                        android:visibility="visible" />

                    <TextView
                        android:id="@+id/btnPickLocation"
                        android:layout_width="match_parent"
                        android:layout_height="40dp"
                        android:layout_marginTop="30dp"
                        android:gravity="center"
                        android:text="@string/pick_your_location"
                        android:textColor="@color/white"
                        android:textSize="15dp"
                        android:visibility="gone" />


                    <LinearLayout
                        android:id="@+id/lnrAddressLayout"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ten"
                        android:background="@drawable/gray_bg_radius"
                        android:orientation="vertical"
                        android:visibility="visible">

                        <TextView
                            android:id="@+id/lblAddressTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="10dp"
                            android:text="@string/your_address"
                            android:textColor="@color/black"
                            android:textSize="15dp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/lblAddress"
                            style="@style/CustomTextStylePoppinsMedium"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ten"
                            android:text=""
                            android:layout_marginStart="@dimen/ten"
                            android:textColor="@color/black"
                            android:textSize="@dimen/thirteen_sp"
                            android:textStyle="normal" />

                        <TextView
                            android:id="@+id/lblLateLongTitle"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="20dp"
                            android:text="@string/current_latitude_and_longitude_is"
                            android:textColor="@color/black"
                            android:textSize="15dp"
                            android:textStyle="bold"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/lbllatLong"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ten"
                            android:text=""
                            android:layout_marginStart="@dimen/ten"
                            android:textColor="@color/grey"
                            android:textSize="@dimen/thirteen_sp"
                            android:textStyle="normal"
                            android:visibility="visible" />

                    </LinearLayout>


                    <TextView
                        android:id="@+id/btnAddLocation"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/fourty"
                        android:layout_marginHorizontal="@dimen/sixty"
                        android:layout_marginTop="@dimen/twenty"
                        android:background="@drawable/rect_brown"
                        android:gravity="center"
                        android:text="Submit"
                        android:textColor="@color/white"
                        android:textSize="@dimen/fifteen_sp"
                        android:visibility="visible" />


                </LinearLayout>

            </ScrollView>

        </FrameLayout>
    </RelativeLayout>


</ScrollView>