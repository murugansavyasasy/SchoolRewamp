<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:padding="@dimen/twenty"
    android:background="@android:color/transparent"
    android:layout_height="match_parent">
    <RelativeLayout
        android:paddingBottom="@dimen/ten"
        android:orientation="vertical"
        android:background="@drawable/white_bg_radius"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <ImageView
            android:layout_alignParentEnd="true"
            android:layout_width="@dimen/thirty"
            android:src="@drawable/close_icon_red"
            android:id="@+id/imgBack"
            android:layout_marginTop="@dimen/three"
            android:layout_marginStart="@dimen/three"
            android:layout_height="@dimen/thirty">

        </ImageView>
        
            <androidx.recyclerview.widget.RecyclerView
                android:layout_width="match_parent"
                android:layout_below="@+id/imgBack"
                android:id="@+id/rcAttachement"
                android:layout_margin="@dimen/eight"
                android:layout_height="@dimen/two_hundred">
            </androidx.recyclerview.widget.RecyclerView>


        <me.relex.circleindicator.CircleIndicator2
            android:id="@+id/indicator"
            style="@style/IndicatorStyle"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/twenty"
            android:layout_below="@+id/rcAttachement"
            android:layout_centerInParent="true"
            android:elevation="@dimen/four"
            android:visibility="gone" />

        <RelativeLayout
            android:layout_below="@+id/indicator"
            android:layout_width="match_parent"
            android:id="@+id/rlaAudioDetails"
            android:layout_height="wrap_content">
            <ImageView
                android:id="@+id/voiceImg"
                android:layout_alignParentStart="true"
                android:layout_width="@dimen/one_fifty"
                android:src="@drawable/voice_illustrate"
                android:layout_height="@dimen/one_fifty">
            </ImageView>
            <LinearLayout
                android:layout_toEndOf="@+id/voiceImg"
                android:layout_width="match_parent"
                android:orientation="vertical"
                android:layout_alignParentEnd="true"
                android:layout_height="wrap_content">
                <TextView
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:text="Audio"
                    android:textSize="@dimen/sixteen_sp"
                    android:layout_height="wrap_content">

                </TextView>

                <RelativeLayout
                    android:id="@+id/recentSeekbarlayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/twenty"
                    android:layout_marginEnd="@dimen/ten"
                    android:background="@drawable/bg_emergency_voice_white"
                    android:backgroundTint="@color/grey_screen_clr"
                   >

                    <RelativeLayout
                        android:layout_marginTop="@dimen/ten"

                        android:id="@+id/rlaAudioImgBar"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <ImageView
                            android:id="@+id/imgRecentEmgplaypause"
                            android:layout_width="@dimen/twenty_five"
                            android:layout_height="@dimen/twenty_five"
                            android:layout_alignParentStart="true"
                            android:layout_alignParentLeft="true"
                            android:layout_centerInParent="true"
                            android:layout_marginStart="@dimen/eight"
                            android:src="@drawable/play_icon_voice"
                            android:tint="@color/PrimaryColor"
                            />

                        <SeekBar
                            android:id="@+id/recentseekbar"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_centerInParent="true"
                            android:layout_toEndOf="@+id/imgRecentEmgplaypause"
                            android:indeterminate="false"
                            android:progressTint="@color/PrimaryColor"
                            android:thumbTint="@color/PrimaryColor" />

                    </RelativeLayout>
                    <LinearLayout
                        android:layout_below="@+id/rlaAudioImgBar"
                        android:id="@+id/lnrRecentSeconds"
                        android:layout_marginTop="@dimen/three"
                        android:layout_marginStart="@dimen/twenty"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginBottom="@dimen/ten">

                        <TextView
                            android:id="@+id/lblEmgRecentduration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textColor="@color/black"
                            android:textSize="10dp"
                            android:textStyle="normal" />

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=" / "
                            android:textColor="@color/black"
                            android:textSize="10dp" />

                        <TextView
                            android:id="@+id/lblRecentTotalDuration"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="00:00"
                            android:textColor="@color/black"
                            android:textSize="10dp" />
                    </LinearLayout>
                </RelativeLayout>


            </LinearLayout>

        </RelativeLayout>

        <LinearLayout

            android:layout_margin="@dimen/ten"
            android:layout_below="@+id/rlaAudioDetails"
            android:layout_marginTop="@dimen/ten"
            android:layout_width="match_parent"
            android:orientation="vertical"
            android:layout_height="wrap_content">

            <RelativeLayout
                android:layout_marginTop="@dimen/ten"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView

                    android:layout_centerVertical="true"
                    android:id="@+id/imgLblTitle"
                    android:src="@drawable/pin_icon_2"
                    android:tint="@color/PrimaryColor"
                    android:layout_width="@dimen/thirty"
                    android:layout_height="@dimen/thirty">
                </ImageView>
                <TextView
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginEnd="@dimen/five"
                    android:layout_toEndOf="@+id/imgLblTitle"
                    style="@style/CustomTextStylePoppinsBold"
                    android:id="@+id/lblTitle"
                    android:text="@string/Title"
                    android:textSize="@dimen/fifteen_sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                </TextView>
            </RelativeLayout>
            <TextView
                android:layout_marginStart="@dimen/fourty"
                android:layout_marginEnd="@dimen/five"
                style="@style/CustomTextStylePoppinsMedium"
                android:id="@+id/tvTitle"
                android:text="Sample Testing"
                android:textSize="@dimen/fifteen_sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
            </TextView>


            <RelativeLayout
                android:id="@+id/rytCertificate"
                android:layout_marginTop="@dimen/ten"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_centerVertical="true"
                    android:id="@+id/imgDescription"
                    android:tint="@color/PrimaryColor"
                    android:src="@drawable/edit_icon_2"
                    android:layout_width="@dimen/thirty"
                    android:layout_height="@dimen/thirty">
                </ImageView>
                <TextView
                    android:text="@string/Description"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginEnd="@dimen/five"
                    android:layout_toEndOf="@+id/imgDescription"
                    style="@style/CustomTextStylePoppinsBold"
                    android:id="@+id/lblDescription"
                    android:textSize="@dimen/fifteen_sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                </TextView>
            </RelativeLayout>
            <TextView
                android:layout_marginStart="@dimen/fourty"
                android:layout_marginEnd="@dimen/five"
                style="@style/CustomTextStylePoppinsMedium"
                android:id="@+id/tvDescription"
                android:text="Hello this is testing Messsge Please Ignore this!"
                android:textSize="@dimen/fifteen_sp"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
            </TextView>

            <RelativeLayout
                android:id="@+id/SentBy"
                android:layout_marginTop="@dimen/ten"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_centerVertical="true"
                    android:id="@+id/imgSendBy"
                    android:src="@drawable/person_circle"
                    android:layout_width="@dimen/thirty"
                    android:layout_height="@dimen/thirty">
                </ImageView>
                <TextView
                    android:text="Sent by Saranraj"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginEnd="@dimen/five"
                    android:layout_toEndOf="@+id/imgSendBy"
                    style="@style/CustomTextStylePoppinsBold"
                    android:id="@+id/lblSendBy"
                    android:textSize="@dimen/fifteen_sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                </TextView>
            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rlaTime"
                android:layout_marginTop="@dimen/ten"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">
                <ImageView
                    android:layout_centerVertical="true"
                    android:id="@+id/imgTime"
                    android:src="@drawable/time_icon"
                    android:layout_width="@dimen/thirty"
                    android:layout_height="@dimen/thirty">
                </ImageView>
                <TextView
                    android:text="Sent at"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/ten"
                    android:layout_marginEnd="@dimen/five"
                    android:layout_toEndOf="@+id/imgTime"
                    style="@style/CustomTextStylePoppinsBold"
                    android:id="@+id/lblSentTime"
                    android:textSize="@dimen/fifteen_sp"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content">
                </TextView>
            </RelativeLayout>
        </LinearLayout>
        
    </RelativeLayout>




</LinearLayout>