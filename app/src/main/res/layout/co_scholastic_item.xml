<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:orientation="vertical"
    android:layout_height="wrap_content">

    <LinearLayout
        android:layout_width="match_parent"
        android:id="@+id/subHeader"
        android:layout_marginHorizontal="@dimen/sixteen"
        android:gravity="center_vertical"
        android:orientation="horizontal"
        android:paddingVertical="@dimen/ten"
        android:layout_height="wrap_content">

        <ImageView
            android:id="@+id/subArrow"
            android:layout_width="10dp"
            android:layout_height="10dp"
            android:src="@drawable/circle_bg"
            app:tint="@color/dark_orange_2" />

        <TextView
            android:id="@+id/co_scholastic_name"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/ten"
            android:text=""
            android:textColor="@color/black"
            android:textSize="17sp" >

        </TextView>
    </LinearLayout>
    <View
        android:id="@+id/viewDiv"
        android:layout_width="match_parent"
        android:layout_height="@dimen/one"
        android:background="@color/AthensGray">
    </View>
</LinearLayout>