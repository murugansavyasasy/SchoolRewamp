<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/light_white">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="0dp"
        android:layout_marginStart="@dimen/fifteen"
        android:layout_marginTop="@dimen/twenty"
        android:layout_marginEnd="@dimen/fifteen"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarLayout">

        <LinearLayout
            android:id="@+id/rytStart"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/five"
            android:background="@drawable/field_background"
            android:orientation="horizontal"
            android:paddingHorizontal="@dimen/ten"
            android:paddingVertical="@dimen/eight"
            android:weightSum="1">

            <RelativeLayout
                android:id="@+id/rlaStartDate"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_weight="0.6">

                <RelativeLayout
                    android:id="@+id/rytStartDate"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content">

                    <ImageView
                        android:id="@+id/imgCalendar"
                        android:layout_width="@dimen/fourty"
                        android:layout_height="@dimen/fourty"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:background="@drawable/rect_purple_rounded"
                        android:padding="@dimen/ten"
                        android:src="@drawable/white_calendar_icon">

                    </ImageView>

                    <LinearLayout
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/five"
                        android:layout_toEndOf="@+id/imgCalendar"
                        android:orientation="vertical">

                        <TextView
                            android:id="@+id/lblDay"
                            style="@style/CustomTextStylePoppinsRegular"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text=""
                            android:textColor="@color/mild_grey_dark"></TextView>

                        <TextView
                            android:id="@+id/txtStartDate"
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/three"
                            android:text=""></TextView>
                    </LinearLayout>

                </RelativeLayout>
            </RelativeLayout>

            <RelativeLayout
                android:layout_width="0dp"
                android:layout_height="match_parent"
                android:layout_weight="0.4"
                android:gravity="center"
                android:visibility="gone">

                <RelativeLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/black_stroke_bg_radius">

                    <Spinner
                        android:id="@+id/isSpinner"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentStart="true"
                        android:layout_centerVertical="true"
                        android:layout_marginStart="@dimen/three"
                        android:layout_toStartOf="@+id/isSpinnerimg"
                        android:background="@null"
                        android:drawSelectorOnTop="true"
                        android:paddingVertical="@dimen/five" />

                    <ImageView
                        android:id="@+id/isSpinnerimg"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_alignParentEnd="true"
                        android:layout_centerVertical="true"
                        android:layout_marginEnd="@dimen/three"
                        android:src="@drawable/ic_drop_down"
                        app:tint="@color/black"></ImageView>
                </RelativeLayout>
            </RelativeLayout>

        </LinearLayout>


        <LinearLayout
            android:id="@+id/lnrClasses"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rytStart"
            android:layout_marginTop="@dimen/fifteen"
            android:gravity="center"
            android:weightSum="1">

            <RelativeLayout
                android:id="@+id/rytStandardDropDown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fifteen"
                android:layout_marginEnd="@dimen/fifteen"
                android:layout_weight="0.5"
                android:background="@drawable/bg_white_light_radious"
                android:gravity="center">

                <Spinner
                    android:id="@+id/isSpinnerStandard"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/three"
                    android:layout_toStartOf="@+id/isSpinnerStandardimg"
                    android:background="@null"
                    android:drawSelectorOnTop="true"
                    android:paddingVertical="@dimen/five" />

                <ImageView
                    android:id="@+id/isSpinnerStandardimg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/three"
                    android:src="@drawable/ic_drop_down"
                    app:tint="@color/black">

                </ImageView>

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rytSectionDropDown"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/fifteen"
                android:layout_marginEnd="@dimen/fifteen"
                android:layout_weight="0.5"
                android:background="@drawable/bg_white_light_radious"
                android:gravity="center">

                <Spinner
                    android:id="@+id/isSpinnerSection"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentStart="true"
                    android:layout_centerVertical="true"
                    android:layout_marginStart="@dimen/three"
                    android:layout_toStartOf="@+id/isSpinnerSectionimg"
                    android:background="@null"
                    android:drawSelectorOnTop="true"
                    android:paddingVertical="@dimen/five" />

                <ImageView
                    android:id="@+id/isSpinnerSectionimg"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:layout_marginEnd="@dimen/three"
                    android:src="@drawable/ic_drop_down"
                    app:tint="@color/black">

                </ImageView>

            </RelativeLayout>
        </LinearLayout>

        <View
            android:id="@+id/line1"
            android:layout_width="match_parent"
            android:layout_height="@dimen/one"
            android:layout_below="@+id/lnrClasses"
            android:layout_marginTop="@dimen/ten"
            android:background="@color/gray">

        </View>

        <LinearLayout
            android:id="@+id/search"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/line1"
            android:layout_margin="@dimen/ten"
            android:layout_marginTop="@dimen/five"
            android:background="@drawable/gray_bg_radius"
            android:gravity="center"
            android:padding="@dimen/five"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/twenty_five"
                android:layout_height="@dimen/twenty_five"
                android:alpha="0.4"
                android:src="@drawable/search_icon"></ImageView>

            <EditText
                android:id="@+id/edtSearch"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/five"
                android:background="@null"
                android:hint="@string/search"
                android:imeOptions="actionDone"
                android:maxLines="1"
                android:scrollHorizontally="true"
                android:singleLine="true"
                android:text=""
                android:textSize="@dimen/fifteen_sp">

            </EditText>


        </LinearLayout>

        <View
            android:id="@+id/line2"
            android:layout_width="match_parent"
            android:layout_height="@dimen/one"
            android:layout_below="@+id/search"
            android:background="@color/gray">

        </View>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcyHomeWorkReport"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/line2"></androidx.recyclerview.widget.RecyclerView>


        <LinearLayout
            android:id="@+id/lytNoDataFound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/search"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:layout_width="@dimen/two_hundred"
                android:layout_height="@dimen/two_hundred"
                android:layout_marginTop="@dimen/twenty_five"
                android:src="@drawable/no_homework_message"></ImageView>

            <TextView
                android:id="@+id/noDataFound"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/twenty"
                android:text=""
                android:textSize="@dimen/fifteen_sp">

            </TextView>
        </LinearLayout>
    </RelativeLayout>


</androidx.constraintlayout.widget.ConstraintLayout>