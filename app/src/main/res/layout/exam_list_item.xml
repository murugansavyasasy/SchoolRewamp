<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/tools"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="@dimen/ten"
    app:ignore="NamespaceTypo"
    card_view:cardCornerRadius="@dimen/sixteen"
    card_view:cardElevation="@dimen/four"
    card_view:cardUseCompatPadding="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:orientation="vertical">

        <RelativeLayout
            android:id="@+id/Header"
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <View
                android:id="@+id/leftRibbon"
                android:layout_width="6dp"
                android:layout_height="@dimen/one_twenty"
                android:layout_alignStart="@+id/lnrDetail"
                android:layout_alignParentStart="true"
                android:background="@color/dark_orange_2" />


            <LinearLayout
                android:id="@+id/lnrDetail"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/ten"
                android:orientation="vertical">

                <!-- Exam Header -->
                <LinearLayout
                    android:id="@+id/header"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:gravity="center_vertical"
                    android:orientation="horizontal"
                    android:padding="16dp">

                    <!-- Radio Indicator -->
                    <ImageView
                        android:id="@+id/imgCheck"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:src="@drawable/circle_icon" />

                    <LinearLayout
                        android:layout_width="0dp"
                        android:layout_height="wrap_content"
                        android:layout_marginEnd="@dimen/eight"
                        android:layout_weight="1"
                        android:orientation="vertical"
                        android:paddingStart="12dp">

                        <TextView
                            android:textAlignment="viewStart"
                            android:id="@+id/examTitle"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="Mid-Term Examination"
                            android:textColor="@color/black"
                            android:textSize="18sp" />

                        <TextView
                            android:textAlignment="viewStart"
                            android:id="@+id/examMonth"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ten"
                            android:alpha="0.6"
                            android:text="October 2024"
                            android:textColor="@color/black"
                            android:textSize="14sp" />
                    </LinearLayout>

                    <ImageView
                        android:id="@+id/arrow"
                        android:layout_width="@dimen/fifteen"
                        android:layout_height="@dimen/fifteen"
                        android:src="@drawable/down_arrow_3"
                        app:tint="@color/gnt_gray" />
                </LinearLayout>
            </LinearLayout>

        </RelativeLayout>

        <View
            android:id="@+id/viewDiv"
            android:layout_width="match_parent"
            android:layout_height="@dimen/one"
            android:background="@color/AthensGray"></View>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcSubject"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/very_light_gray_13"
            android:visibility="gone" />

        <TextView
            android:id="@+id/lblNoDataFound"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:text="@string/no_data_found"
            android:visibility="gone">

        </TextView>
    </LinearLayout>

</androidx.cardview.widget.CardView>
