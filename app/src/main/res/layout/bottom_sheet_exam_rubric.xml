<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bottom_sheet_background"
    android:orientation="vertical"
    android:paddingBottom="24dp">

    <View
        android:layout_width="40dp"
        android:layout_height="4dp"
        android:layout_gravity="center"
        android:layout_marginTop="10dp"
        android:background="@drawable/bg_drag" />

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="20dp">

        <TextView
            android:id="@+id/txtTitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Botiba Setup"
            android:textColor="#111827"
            android:textSize="22sp"
            android:textStyle="bold" />

        <ImageView
            android:id="@+id/imgClose"
            android:layout_width="24dp"
            android:layout_height="24dp"
            android:layout_alignParentEnd="true"
            android:src="@drawable/close_icon_3" />

    </RelativeLayout>

    <LinearLayout
        android:paddingHorizontal="@dimen/twenty"
        android:id="@+id/lnrScheduleDetails"
        android:orientation="vertical"
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <RelativeLayout
            android:layout_marginTop="@dimen/ten"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <ImageView
                android:id="@+id/imgDate"
                android:layout_width="@dimen/fourty"
                android:layout_height="@dimen/fourty"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/rect_bg_light_blue"
                android:backgroundTint="@color/light_blue_22"
                android:padding="@dimen/ten"
                android:src="@drawable/calenderstylesvg"
                android:tint="@color/dark_blue_22">

            </ImageView>

            <LinearLayout
                android:id="@+id/lnrDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginHorizontal="@dimen/eight"
                android:layout_toEndOf="@id/imgDate"
                android:orientation="vertical">


                <TextView
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/date"
                    android:textAlignment="viewStart"
                    android:textAllCaps="true"
                    android:textColor="@color/black"
                    android:textSize="@dimen/twele_sp"></TextView>

                <TextView
                    android:id="@+id/lblDate"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="00 ABC 0000"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/twele_sp"></TextView>

            </LinearLayout>


        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/one"
            android:layout_marginVertical="@dimen/eight"
            android:background="@color/very_light_gray_12"></View>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <ImageView
                android:id="@+id/imgClock"
                android:layout_width="@dimen/fourty"
                android:layout_height="@dimen/fourty"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/rect_bg_light_blue"
                android:backgroundTint="@color/light_voliet_22"
                android:padding="@dimen/ten"
                android:src="@drawable/clock"
                android:tint="@color/dark_voliet_22">

            </ImageView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginHorizontal="@dimen/eight"
                android:layout_toEndOf="@id/imgClock"
                android:orientation="vertical">


                <TextView
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/time"
                    android:textAlignment="viewStart"
                    android:textAllCaps="true"
                    android:textColor="@color/black"
                    android:textSize="@dimen/twele_sp"></TextView>

                <TextView
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:id="@+id/lblTime"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/twele_sp"></TextView>

            </LinearLayout>


        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/one"
            android:layout_marginVertical="@dimen/eight"
            android:background="@color/very_light_gray_12"></View>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <ImageView
                android:id="@+id/imgSession"
                android:layout_width="@dimen/fourty"
                android:layout_height="@dimen/fourty"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/rect_bg_light_blue"
                android:backgroundTint="@color/light_green_22"
                android:padding="@dimen/ten"
                android:src="@drawable/sun_icon"
                android:tint="@color/dark_green_22">

            </ImageView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginHorizontal="@dimen/eight"
                android:layout_toEndOf="@id/imgSession"
                android:orientation="vertical">


                <TextView
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/session"
                    android:textAlignment="viewStart"
                    android:textAllCaps="true"
                    android:textColor="@color/black"
                    android:textSize="@dimen/twele_sp"></TextView>

                <TextView
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:id="@+id/lblSession"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/twele_sp"></TextView>

            </LinearLayout>


        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/one"
            android:layout_marginVertical="@dimen/eight"
            android:background="@color/very_light_gray_12"></View>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <ImageView
                android:id="@+id/imgVenue"
                android:layout_width="@dimen/fourty"
                android:layout_height="@dimen/fourty"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/rect_bg_light_blue"
                android:backgroundTint="@color/light_orange_22"
                android:padding="@dimen/ten"
                android:src="@drawable/map_icon_5"
                android:tint="@color/dark_orange_22">

            </ImageView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginHorizontal="@dimen/eight"
                android:layout_toEndOf="@id/imgVenue"
                android:orientation="vertical">


                <TextView
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/Venue"
                    android:textAlignment="viewStart"
                    android:textAllCaps="true"
                    android:textColor="@color/black"
                    android:textSize="@dimen/twele_sp"></TextView>

                <TextView
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:id="@+id/lblVenue"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/twele_sp"></TextView>

            </LinearLayout>


        </RelativeLayout>

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/one"
            android:layout_marginVertical="@dimen/eight"
            android:background="@color/very_light_gray_12"></View>

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            >

            <ImageView
                android:id="@+id/imgSyllabus"
                android:layout_width="@dimen/fourty"
                android:layout_height="@dimen/fourty"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                android:background="@drawable/rect_bg_light_blue"
                android:backgroundTint="@color/light_green_23"
                android:padding="@dimen/ten"
                android:src="@drawable/book__2_"
                android:tint="@color/dark_green_23">

            </ImageView>

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginHorizontal="@dimen/eight"
                android:layout_toEndOf="@id/imgSyllabus"
                android:orientation="vertical">


                <TextView
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="@string/syllabus"
                    android:textAlignment="viewStart"
                    android:textAllCaps="true"
                    android:textColor="@color/black"
                    android:textSize="@dimen/twele_sp"></TextView>

                <TextView
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:id="@+id/lblSyllabus"
                    android:textAlignment="viewStart"
                    android:textColor="@color/black"
                    android:textSize="@dimen/twele_sp"></TextView>

            </LinearLayout>


        </RelativeLayout>
    </LinearLayout>

    <!-- DATE -->



</LinearLayout>