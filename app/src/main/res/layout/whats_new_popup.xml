<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/fifteen_sp"
    android:background="@drawable/rect_white"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:orientation="vertical">


        <RelativeLayout
            android:id="@+id/rytUpdateAvailabe"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:background="@color/PrimaryColor"
            android:padding="@dimen/ten">

            <TextView
                android:id="@+id/lblUpdateAvailable"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_centerVertical="true"
                style="@style/CustomTextStylePoppinsBold"
                android:text="@string/update_available"
                android:textColor="@color/white" />


            <ImageView
                android:layout_width="@dimen/fourty"
                android:layout_height="@dimen/fourty"
                android:layout_alignParentEnd="true"
                android:src="@drawable/school_splash_logo" />

        </RelativeLayout>


        <RelativeLayout
            android:id="@+id/rytNew"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/rytUpdateAvailabe"
            android:background="@color/white"
            android:padding="@dimen/ten">

            <TextView
                android:id="@+id/lblNewVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="@string/new_version"
                style="@style/CustomTextStylePoppinsRegular"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/thirteen_sp" />

            <TextView
                android:id="@+id/lblNewVersionCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="1.1"
                style="@style/CustomTextStylePoppinsRegular"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />

        </RelativeLayout>

        <View
            android:id="@+id/vwNew"
            android:layout_width="match_parent"
            android:layout_height="@dimen/one"
            android:layout_below="@+id/rytNew"
            android:background="@color/AthensGray" />

        <RelativeLayout
            android:id="@+id/rytYour"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/vwNew"
            android:background="@color/white"
            android:padding="@dimen/ten">

            <TextView
                android:id="@+id/lblYourVersion"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:text="@string/your_version"
                style="@style/CustomTextStylePoppinsRegular"
                android:textColor="@color/colorPrimary"
                android:textSize="@dimen/thirteen_sp" />

            <TextView
                android:id="@+id/lblYourAppVersionCode"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:text="1.0"
                style="@style/CustomTextStylePoppinsRegular"
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp" />

        </RelativeLayout>

        <View
            android:id="@+id/vwYour"
            android:layout_width="match_parent"
            android:layout_height="@dimen/one"
            android:layout_below="@+id/rytYour"
            android:background="@color/AthensGray" />

        <TextView
            android:id="@+id/idUpdateTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/vwYour"
            android:layout_marginTop="@dimen/ten"
            android:padding="@dimen/ten"
            style="@style/CustomTextStylePoppinsBold"
            android:text="@string/the_new_version_changes"
            android:textColor="@color/orange"
            android:textSize="@dimen/sixteen_sp"
            android:textStyle="bold" />


        <androidx.core.widget.NestedScrollView
            android:id="@+id/nsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/idUpdateTitle">

            <LinearLayout
                android:id="@+id/lnrNewUpdates"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginStart="@dimen/twenty"
                android:layout_marginTop="@dimen/twenty"
                android:orientation="vertical"
                android:padding="@dimen/ten">

                <TextView
                    android:id="@+id/lblNewUpdates"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/vwYour"
                    android:padding="@dimen/five"
                    style="@style/CustomTextStylePoppinsRegular"
                    android:text="Bug fixed."
                    android:textColor="@color/black"
                    android:textSize="@dimen/sixteen_sp"
             />

            </LinearLayout>

        </androidx.core.widget.NestedScrollView>


        <RelativeLayout
            android:layout_below="@+id/nsScroll"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:padding="@dimen/ten">

            <TextView
                android:id="@+id/btnNotNow"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_marginStart="@dimen/ten"
                android:gravity="center"
                android:padding="@dimen/ten"
                android:text="@string/not_now"
                style="@style/CustomTextStylePoppinsRegular"
                android:textColor="@color/PrimaryColor"
                android:textSize="@dimen/sixteen_sp"
                android:visibility="visible" />

            <TextView
                android:id="@+id/btnUpdate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_marginEnd="@dimen/ten"
                android:gravity="center"
                android:padding="@dimen/ten"
                android:text="@string/update_now"
                style="@style/CustomTextStylePoppinsRegular"
                android:textColor="@color/PrimaryColor"
                android:textSize="@dimen/sixteen_sp"
                android:visibility="visible" />

        </RelativeLayout>

    </RelativeLayout>


</RelativeLayout>

