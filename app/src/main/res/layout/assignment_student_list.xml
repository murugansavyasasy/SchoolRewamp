<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:card_view="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/eight"
    android:backgroundTint="@android:color/white"
    card_view:cardCornerRadius="@dimen/twele"
    card_view:cardElevation="@dimen/four">

    <RelativeLayout
        android:id="@+id/rlarelativelayout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/twele">

        <TextView
            android:id="@+id/avatarText"
            android:layout_width="@dimen/fourty_eight"
            android:layout_height="@dimen/fourty_eight"
            android:layout_alignParentStart="true"
            android:layout_marginEnd="@dimen/twele"
            android:background="@drawable/avatar_circle"
            android:gravity="center"
            android:text="L"
            android:textColor="@android:color/white"
            android:textSize="@dimen/twenty_sp"
            android:textStyle="bold" />


        <TextView
            android:id="@+id/lblStudentName"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/eight"
            android:layout_toStartOf="@id/statusButton"
            android:layout_toEndOf="@id/avatarText"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="SARANRAJ SHANMUGAM"
            android:textColor="@android:color/black"
            android:textSize="@dimen/fifteen_sp" />


        <TextView
            android:id="@+id/sectionlabel"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/lblStudentName"
            android:layout_marginTop="@dimen/two"
            android:layout_toStartOf="@id/statusButton"
            android:layout_toEndOf="@id/avatarText"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="I - B"
            android:textColor="@color/light_gray_5"
            android:textSize="@dimen/thirteen_sp" />


        <TextView
            android:id="@+id/submittedLabel"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@id/sectionlabel"
            android:layout_marginTop="@dimen/six"
            android:layout_toEndOf="@id/avatarText"
            android:text="Submitted:"
            android:textColor="@color/grey"
            android:textSize="@dimen/thirteen_sp" />

        <TextView
            android:id="@+id/submittedDate"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignTop="@id/submittedLabel"
            android:layout_marginStart="@dimen/four"

            android:layout_toStartOf="@id/statusButton"
            android:layout_toEndOf="@id/submittedLabel"
            android:text="Mon, 11"
            android:textColor="@color/grey"
            android:textSize="@dimen/thirteen_sp" />

        <LinearLayout
            android:id="@+id/statusButton"
            android:layout_width="wrap_content"
            android:layout_height="@dimen/thirty_six"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:background="@drawable/pending_button_bg"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:paddingStart="@dimen/twele"
            android:paddingEnd="@dimen/twele">

            <ImageView
                android:id="@+id/cancelimage"
                android:layout_width="@dimen/sixteen"
                android:layout_height="@dimen/sixteen"
                android:layout_marginEnd="@dimen/six"
                android:gravity="center_vertical"
                android:paddingStart="@dimen/twele"
                android:paddingEnd="@dimen/twele"
                android:src="@drawable/downloadsvgformat" />


            <TextView
                android:id="@+id/statuslabel"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Pending"
                android:textColor="@android:color/holo_red_dark" />
        </LinearLayout>

    </RelativeLayout>
</androidx.cardview.widget.CardView>
