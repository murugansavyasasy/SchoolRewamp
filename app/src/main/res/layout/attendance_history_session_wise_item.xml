<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginBottom="@dimen/ten"
    android:orientation="vertical">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">
        <TextView
            android:layout_centerVertical="true"
            android:id="@+id/lblRoomNumber"
            android:layout_alignParentStart="true"
            android:layout_width="wrap_content"
            android:drawableTint="@color/PrimaryColor"
            android:text="Room 1135"
            style="@style/CustomTextStylePoppinsBold"
            android:drawablePadding="@dimen/five"
            android:gravity="center_vertical"
            android:drawableStart="@drawable/house_icon_2"
            android:layout_height="wrap_content">
        </TextView>
        <TextView
            android:layout_centerVertical="true"
            android:layout_toEndOf="@+id/lblRoomNumber"
            android:text="0 Sessions"
            android:layout_marginStart="@dimen/ten"
            android:background="@drawable/rect_radius_15"
            android:id="@+id/lblNoOfSessions"
            android:backgroundTint="@color/light_blue_13"
            android:textColor="@color/dark_blue_13"
            android:paddingVertical="@dimen/three"
            android:paddingHorizontal="@dimen/seven"
            android:layout_marginHorizontal="@dimen/five"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
           >

        </TextView>
    </RelativeLayout>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcSessionWiseAttendanceHistory"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/ten">
    </androidx.recyclerview.widget.RecyclerView>
</LinearLayout>