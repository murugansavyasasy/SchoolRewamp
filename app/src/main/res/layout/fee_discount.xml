<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="#f6f8fb"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toBottomOf="@+id/toolbarLayout">

        <!-- ================= FILTER CARD (fixed) ================= -->
        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_margin="@dimen/ten"
            android:background="@drawable/bg_fee_card_single"
            android:orientation="vertical"
            android:paddingBottom="@dimen/five">

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Type -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/type"
                        android:textColor="@color/fee_text_grey"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:background="@drawable/bg_fee_inner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <Spinner
                            android:id="@+id/isTypeSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/five"
                            android:padding="@dimen/five"
                            android:background="@drawable/custom_spinner_background_two"
                            android:spinnerMode="dropdown" />

                    </LinearLayout>
                </LinearLayout>

                <!-- Class -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/discount_type"
                        android:textColor="@color/fee_text_grey"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:background="@drawable/bg_fee_inner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <Spinner
                            android:id="@+id/isDiscountType"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/five"
                            android:padding="@dimen/five"
                            android:background="@drawable/custom_spinner_background_two"
                            android:spinnerMode="dropdown" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal">

                <!-- Class -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/fd_class"
                        android:textColor="@color/fee_text_grey"
                        android:textSize="12sp" />

                   <LinearLayout
                       android:background="@drawable/bg_fee_inner"
                       android:layout_width="match_parent"
                       android:layout_height="wrap_content">
                       <Spinner
                           android:id="@+id/isClassSpinner"
                           android:layout_width="match_parent"
                           android:layout_height="wrap_content"
                           android:layout_marginTop="@dimen/five"
                           android:padding="@dimen/five"
                           android:background="@drawable/custom_spinner_background_two"
                           android:spinnerMode="dropdown" />
                   </LinearLayout>
                </LinearLayout>

                <!-- Section -->
                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="12dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/Section"
                        android:textColor="@color/fee_text_grey"
                        android:textSize="12sp" />

                    <LinearLayout
                        android:background="@drawable/bg_fee_inner"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content">
                        <Spinner
                            android:id="@+id/isSectionSpinner"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/five"
                            android:padding="@dimen/five"
                            android:background="@drawable/custom_spinner_background_two"
                            android:spinnerMode="dropdown" />
                    </LinearLayout>
                </LinearLayout>
            </LinearLayout>


            <!-- Filter by given date + toggle -->
            <RelativeLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="@dimen/ten"
                android:layout_marginVertical="@dimen/five">

                <TextView
                    android:id="@+id/lblGivenDate"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:layout_alignParentStart="true"
                    android:text="@string/filter_by_given_date" />

                <androidx.appcompat.widget.SwitchCompat
                    android:id="@+id/switchDateFilter"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_alignParentEnd="true"
                    android:layout_centerVertical="true"
                    android:background="@null"
                    android:thumb="@drawable/switch_thumb_fee"
                    android:thumbTint="@null"
                    android:trackTint="@null"
                    app:thumbTint="@null"
                    app:track="@drawable/switch_track_fee"
                    app:showText="false" />
            </RelativeLayout>

            <View
                android:id="@+id/viewDivider"
                android:layout_marginVertical="@dimen/three"
                android:layout_width="match_parent"
                android:background="#f6f8fb"
                android:layout_height="2dp">
            </View>

            <!-- From / To (visible only when toggle is ON) -->
            <LinearLayout
                android:id="@+id/lytDateRange"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:baselineAligned="false"
                android:orientation="horizontal"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/from"
                        android:textColor="@color/fee_text_grey"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvFromDate"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/five"
                        android:background="@drawable/bg_fee_inner"
                        android:backgroundTint="#efeff0"
                        android:drawableEnd="@drawable/ic_sample_arrow_icon"
                        android:drawablePadding="@dimen/five"
                        android:padding="@dimen/five"
                        android:text="@string/select_date"
                        android:textSize="@dimen/thirteen_sp" />
                </LinearLayout>

                <LinearLayout
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:orientation="vertical"
                    android:padding="6dp">

                    <TextView
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="@string/to"
                        android:textColor="@color/fee_text_grey"
                        android:textSize="12sp" />

                    <TextView
                        android:id="@+id/tvToDate"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/five"
                        android:background="@drawable/bg_fee_inner"
                        android:backgroundTint="#efeff0"
                        android:drawableEnd="@drawable/ic_sample_arrow_icon"
                        android:drawablePadding="@dimen/five"
                        android:padding="@dimen/five"
                        android:text="@string/select_date"
                        android:textSize="@dimen/thirteen_sp" />
                </LinearLayout>
            </LinearLayout>
        </LinearLayout>

        <!-- ================= SCROLLING CONTENT ================= -->
        <FrameLayout
            android:layout_width="match_parent"
            android:layout_height="0dp"
            android:layout_weight="1">

            <androidx.core.widget.NestedScrollView
                android:id="@+id/scrollFeeDiscount"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:clipToPadding="false"
                android:paddingBottom="@dimen/twenty"
                android:visibility="gone">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="vertical">

                    <!-- Summary card -->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="20dp"
                        android:layout_marginTop="12dp"
                        android:background="@drawable/bg_fee_card_single"
                        android:orientation="vertical"
                        android:padding="16dp">

                        <TextView
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:text="@string/total_discount"
                            android:textColor="@color/fee_text_grey"
                            android:textSize="12sp" />

                        <TextView
                            android:id="@+id/tvTotalDiscount"
                            style="@style/CustomTextStylePoppinsBold"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/three"
                            android:textColor="@color/black"
                            android:textSize="28sp" />

                        <TextView
                            android:id="@+id/tvRecordsAndCategoriesCount"
                            android:layout_width="wrap_content"
                            android:layout_height="wrap_content"
                            android:textColor="@color/fee_text_grey"
                            android:textSize="12sp" />

                        <View
                            android:layout_width="match_parent"
                            android:layout_height="0.5dp"
                            android:layout_marginVertical="@dimen/five"
                            android:background="#e8e8e8" />

                        <LinearLayout
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:orientation="horizontal">

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/discount"
                                    android:textColor="@color/fee_text_grey"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/lblPaidFee"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/three"
                                    android:fontFamily="@font/poppins_bold"
                                    android:textColor="@color/fee_orange"
                                    android:textSize="20sp" />
                            </LinearLayout>

                            <LinearLayout
                                android:layout_width="0dp"
                                android:layout_height="wrap_content"
                                android:layout_weight="1"
                                android:orientation="vertical">

                                <TextView
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:text="@string/subsidy"
                                    android:textColor="@color/fee_text_grey"
                                    android:textSize="12sp" />

                                <TextView
                                    android:id="@+id/lblDiscountFee"
                                    android:layout_width="wrap_content"
                                    android:layout_height="wrap_content"
                                    android:layout_marginTop="@dimen/three"
                                    android:fontFamily="@font/poppins_bold"
                                    android:textColor="@color/fee_blue"
                                    android:textSize="20sp" />
                            </LinearLayout>
                        </LinearLayout>
                    </LinearLayout>

                    <TextView
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="36dp"
                        android:layout_marginTop="20dp"
                        android:layout_marginBottom="8dp"
                        android:text="@string/fd_categories"
                        android:textColor="@color/fee_text_grey"
                        android:textSize="15sp" />

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rcyFeeDiscount"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginHorizontal="20dp"
                        android:nestedScrollingEnabled="false" />
                </LinearLayout>
            </androidx.core.widget.NestedScrollView>

            <LinearLayout
                android:id="@+id/lytNoDataFound"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/two_hundred"
                    android:layout_height="@dimen/two_hundred"
                    android:src="@drawable/no_fee_pending_message" />

                <TextView
                    android:id="@+id/noDataFound"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_gravity="center"
                    android:layout_marginTop="@dimen/twenty"
                    android:text="" />
            </LinearLayout>
        </FrameLayout>
    </LinearLayout>
</androidx.constraintlayout.widget.ConstraintLayout>