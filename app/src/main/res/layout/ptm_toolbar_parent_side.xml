<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:id="@+id/rytHeader"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:background="@drawable/bg_header_rounded"
        android:paddingTop="@dimen/twenty"
        android:paddingBottom="@dimen/fifteen">

        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content">

            <ImageView
                android:id="@+id/imgBack"
                android:layout_width="@dimen/thirty_five"
                android:layout_height="@dimen/thirty_five"
                android:src="@drawable/arrow_left_white"></ImageView>

            <TextView
                android:id="@+id/lblParentToolBar"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/rlaStudentName"
                android:layout_toEndOf="@+id/imgBack"
                android:text=""
                android:textColor="@color/white"
                android:textSize="@dimen/fifteen_sp"
                android:visibility="gone">

            </TextView>

            <LinearLayout
                android:id="@+id/rlaStudentName"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_toStartOf="@+id/imgSearchToolBar"
                android:layout_toEndOf="@id/imgBack"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/lblStudentName"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="@dimen/fifteen_sp">

                </TextView>

                <TextView
                    android:id="@+id/lblStudentSection"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="@dimen/eleven_sp">

                </TextView>

                <RelativeLayout
                    android:id="@+id/cltDateSelection"
                    android:layout_width="match_parent"
                    android:layout_marginTop="@dimen/fifteen"
                    android:layout_height="wrap_content">

                    <LinearLayout

                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginStart="@dimen/ten"
                        android:layout_marginEnd="@dimen/ten"
                        android:orientation="horizontal"
                        android:weightSum="2">

                        <TextView
                            android:id="@+id/lblScheduleMeeting"
                            style="@style/CustomTextStylePoppinsBold1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:background="@drawable/white_bg_card"
                            android:gravity="center"
                            android:padding="@dimen/ten"
                            android:text="@string/book_ptm_slots"
                            android:textColor="@color/black"></TextView>

                        <TextView
                            android:id="@+id/lblYourMeeting"
                            style="@style/CustomTextStylePoppinsBold1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_weight="1"
                            android:gravity="center"
                            android:padding="@dimen/ten"
                            android:text="@string/your_meetings"
                            android:textColor="@color/black"></TextView>
                    </LinearLayout>

                </RelativeLayout>


                <TextView
                    android:id="@+id/lblSubjectName"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginEnd="@dimen/five"
                    android:text=""
                    android:textColor="@color/white"
                    android:visibility="gone">

                </TextView>

            </LinearLayout>


            <TextView
                android:id="@+id/lblPostedOn"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/five"
                android:textColor="@color/white"
                android:visibility="gone">

            </TextView>

            <ImageView
                android:id="@+id/imgSearchToolBar"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/ten"
                android:padding="@dimen/five"
                android:src="@drawable/search_icon_white"
                android:visibility="gone" />
        </RelativeLayout>
    </RelativeLayout>

    <LinearLayout
        android:id="@+id/lnrParent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/rytHeader"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="@dimen/ten"
        android:layout_marginTop="0dp"
        android:background="@drawable/bg_light_green"
        android:visibility="gone">

        <TextView
            android:id="@+id/lblRightSideBar"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginStart="@dimen/two"
            android:layout_marginTop="@dimen/two"
            android:layout_marginBottom="@dimen/two"
            android:layout_weight="1"
            android:background="@drawable/white_radious"
            android:gravity="center"
            android:padding="@dimen/eight"
            android:text=""
            android:textColor="@color/white"
            android:textSize="@dimen/thirteen_sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/lblLeftSideBar"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/two"
            android:layout_marginEnd="@dimen/two"
            android:layout_marginBottom="@dimen/two"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="@dimen/eight"
            android:text=""
            android:textColor="@color/white"
            android:textSize="@dimen/thirteen_sp"
            android:textStyle="bold" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/rytSearch"
        android:layout_width="match_parent"
        android:layout_height="@dimen/thirty_five"
        android:layout_below="@id/lnrParent"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginTop="@dimen/fifteen"
        android:layout_marginEnd="@dimen/ten"
        android:background="@drawable/rect_grey"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgSearch"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/ten"
            android:src="@drawable/ic_search" />

        <EditText
            android:id="@+id/txtVideoMenu"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toEndOf="@id/imgSearch"
            android:background="@android:color/transparent"
            android:hint="@string/lblSearch"
            android:imeOptions="actionDone"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:textColor="@color/black"
            android:textSize="@dimen/thirteen_sp" />
    </RelativeLayout>

</RelativeLayout>
