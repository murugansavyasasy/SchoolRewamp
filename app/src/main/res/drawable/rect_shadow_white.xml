<layer-list xmlns:android="http://schemas.android.com/apk/res/android">
    <!-- Soft Drop Shadow on All Sides -->
    <item>
        <shape>
            <padding android:top="2dp" android:right="2dp" android:bottom="2dp" android:left="2dp" />
            <solid android:color="#10000000" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <shape>
            <padding android:top="1.5dp" android:right="1.5dp" android:bottom="1.5dp" android:left="1.5dp" />
            <solid android:color="#20000000" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <shape>
            <padding android:top="1dp" android:right="1dp" android:bottom="1dp" android:left="1dp" />
            <solid android:color="@color/grey" />
            <corners android:radius="15dp" />
        </shape>
    </item>
    <item>
        <shape>
            <padding android:top="0.5dp" android:right="0.5dp" android:bottom="0.5dp" android:left="0.5dp" />
            <solid android:color="#40000000" />
            <corners android:radius="15dp" />
        </shape>
    </item>

    <!-- Background -->
    <item>
        <shape>
            <solid android:color="#FFFFFF" />
            <corners android:radius="15dp" />
        </shape>
    </item>
</layer-list>
