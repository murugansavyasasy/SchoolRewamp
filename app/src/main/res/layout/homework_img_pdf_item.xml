<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:id="@+id/fileItem"
    android:layout_width="@dimen/one_twenty"
    android:layout_height="@dimen/one_twenty"
    android:layout_marginTop="@dimen/fifteen"
    android:layout_marginStart="@dimen/fifteen"
    android:fitsSystemWindows="true">


    <WebView
        android:id="@+id/WVThumbnaildocument"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:scaleType="centerCrop"
        android:visibility="gone">

    </WebView>

    <ProgressBar
        android:id="@+id/loadingBar"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center"
        android:indeterminateDrawable="@drawable/progress_bar_white"
        android:indeterminateOnly="true"
        android:visibility="gone">

    </ProgressBar>

    <ImageView
        android:id="@+id/ImgPDF"
        android:layout_width="@dimen/one_twenty"
        android:layout_height="match_parent"
        android:layout_gravity="center"
        android:scaleType="centerCrop">

    </ImageView>

    <ImageView
        android:id="@+id/playButtonOverlay"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:layout_gravity="center"
        android:visibility="gone" />
    <ImageView
        android:id="@+id/imageOrDocumentType"
        android:layout_width="@dimen/thirty"
        android:layout_height="@dimen/thirty"
        android:layout_below="@+id/Rl_WV_Img"
        android:layout_gravity="end|bottom"
        android:layout_marginEnd="@dimen/two"
        android:elevation="@dimen/five">

    </ImageView>
</androidx.cardview.widget.CardView>
