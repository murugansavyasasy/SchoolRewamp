<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/main"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/parent_side_tool_bar"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground" />

    <TextView
        android:id="@+id/tvStudentName"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="16dp"
        android:layout_marginTop="12dp"
        android:layout_marginEnd="16dp"
        android:textSize="16sp"
        android:textStyle="bold"
        app:layout_constraintTop_toBottomOf="@id/toolbarLayout"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        tools:text="" />

    <RelativeLayout
        app:layout_constraintTop_toBottomOf="@+id/tvStudentName"
        android:id="@+id/rytSearch1"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="0dp"
        android:layout_height="@dimen/thirty_five"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:background="@drawable/rect_grey"
        android:visibility="gone">

        <ImageView
            android:id="@+id/imgSearch1"
            android:layout_width="@dimen/thirty"
            android:layout_height="@dimen/thirty"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/ten"
            android:src="@drawable/ic_search" />

        <EditText
            android:id="@+id/txtSearch1"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_toEndOf="@id/imgSearch1"
            android:background="@android:color/transparent"
            android:hint="@string/lblSearch"
            android:imeOptions="actionDone"
            android:maxLines="1"
            android:scrollHorizontally="true"
            android:singleLine="true"
            android:textColor="@color/black"
            android:textSize="@dimen/thirteen_sp" />
    </RelativeLayout>


    <HorizontalScrollView
        android:id="@+id/hsvProofStatusTabs"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        app:layout_constraintBottom_toTopOf="@+id/LnrMainLay"
        app:layout_constraintTop_toBottomOf="@+id/rytSearch1"
        android:layout_marginTop="@dimen/ten"
        android:fillViewport="true"
        android:overScrollMode="never"
        android:scrollbars="none">

        <LinearLayout
            android:id="@+id/lnrParent"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fifteen"
            android:layout_marginEnd="@dimen/fifteen"
            android:orientation="horizontal">

            <TextView
                android:paddingHorizontal="@dimen/fifteen"
                android:id="@+id/btnAll"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:background="@drawable/bg_payment_filter_selected"
                android:text="All"
                android:textColor="@color/white"
                android:textSize="@dimen/twele_sp" />

            <TextView
                android:id="@+id/btnPending"
                android:layout_marginHorizontal="@dimen/ten"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:paddingHorizontal="@dimen/fifteen"
                android:text="Pending"
                android:textColor="@color/light_gray_44"
                android:background="@drawable/bg_payment_filter_unselected"
                android:textSize="@dimen/twele_sp" />
            <TextView
                android:id="@+id/btnRejected"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:background="@drawable/bg_payment_filter_unselected"
                android:layout_marginHorizontal="@dimen/ten"
                android:paddingHorizontal="@dimen/fifteen"
                android:text="Rejected"
                android:textColor="@color/light_gray_44"
                android:textSize="@dimen/twele_sp" />
            <TextView
                android:id="@+id/btnApproved"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:background="@drawable/bg_payment_filter_unselected"
                android:layout_marginHorizontal="@dimen/ten"
                android:paddingHorizontal="@dimen/fifteen"
                android:text="Approved"
                android:textColor="@color/light_gray_44"
                android:textSize="@dimen/twele_sp" />

        </LinearLayout>
    </HorizontalScrollView>

    <LinearLayout
        app:layout_constraintTop_toBottomOf="@id/hsvProofStatusTabs"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="0dp"
        android:id="@+id/LnrMainLay"
        android:layout_marginTop="12dp"
        android:orientation="vertical"
        app:layout_constraintBottom_toBottomOf="parent"
        android:layout_height="0dp">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rvPaymentProof"
            android:layout_width="match_parent"
            android:nestedScrollingEnabled="false"
            android:layout_height="wrap_content"
            android:clipToPadding="false"
            android:paddingBottom="16dp"
             />

        <LinearLayout
            android:id="@+id/lytList"
            android:visibility="gone"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="vertical">

            <ImageView
                android:id="@+id/nomessage"
                android:layout_width="@dimen/two_fifty"
                android:layout_height="@dimen/two_fifty"
                android:layout_gravity="center"
                android:src="@drawable/no_fee_pending_message"
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp"
                />

            <TextView
                android:id="@+id/txtNoData"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:text="@string/no_list_found"
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp"
                />

        </LinearLayout>
    </LinearLayout>

</androidx.constraintlayout.widget.ConstraintLayout>