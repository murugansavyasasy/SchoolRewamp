<!-- res/drawable/bg_icon_circle.xml -->
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color -->
    <solid android:color="#6467D2" />

    <!-- Border stroke -->
    <stroke
        android:width="1dp"
        android:color="#000000" /> <!-- Black border -->

    <!-- Rounded corners -->
    <corners android:radius="16dp" />

    <!-- Fixed size -->
    <size
        android:width="60dp"
        android:height="60dp" />
</shape>
