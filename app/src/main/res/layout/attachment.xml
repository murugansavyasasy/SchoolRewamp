<?xml version="1.0" encoding="utf-8"?>
<ScrollView xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content">

        <include
            android:id="@+id/toolbarLayout"
            layout="@layout/school_side_tool_bar" />

        <RelativeLayout
            android:id="@+id/rytAttachment"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/toolbarLayout"
            android:visibility="visible">

            <RelativeLayout
                android:id="@+id/rlaTitleDescription"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <TextView
                    android:id="@+id/lblTitle"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/twenty"
                    android:layout_marginTop="@dimen/twenty"
                    android:text="@string/Title"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp">

                </TextView>

                <TextView
                    android:id="@+id/lblStar1"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/two"
                    android:layout_marginTop="@dimen/eighteen"
                    android:layout_toEndOf="@id/lblTitle"
                    android:text="@string/mandatory"
                    android:textColor="@color/red"
                    android:textSize="@dimen/thirteen_sp" />


                <EditText
                    android:id="@+id/edtTitle"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lblTitle"
                    android:layout_marginStart="@dimen/fifteen"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/fifteen"
                    android:maxLength="50"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp">

                </EditText>

                <TextView
                    android:id="@+id/lblTitleTextCount"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/edtTitle"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="@dimen/five"
                    android:layout_marginEnd="@dimen/fifteen"
                    android:text="0 / 50"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp">

                </TextView>

                <TextView

                    android:id="@+id/lblDescription"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lblTitleTextCount"
                    android:layout_marginStart="@dimen/twenty"
                    android:layout_marginTop="@dimen/eight"
                    android:text="@string/Description"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp">
                </TextView>


                <TextView
                    android:id="@+id/lblStar2"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lblTitleTextCount"
                    android:layout_marginStart="@dimen/two"
                    android:layout_marginTop="@dimen/eight"
                    android:layout_toEndOf="@id/lblDescription"
                    android:text="@string/mandatory"
                    android:textColor="@color/red"
                    android:textSize="@dimen/thirteen_sp" />


                <EditText
                    android:id="@+id/edtDescription"
                    style="@style/CustomTextStylePoppinsMedium"
                    android:layout_width="match_parent"
                    android:layout_height="@dimen/hundred"
                    android:layout_below="@+id/lblDescription"
                    android:layout_marginStart="@dimen/fifteen"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/fifteen"
                    android:background="@drawable/bg_stroke_rect_black"
                    android:editable="true"
                    android:focusable="true"
                    android:focusableInTouchMode="true"
                    android:gravity="start"
                    android:hint="@string/Enterdescription"
                    android:maxLength="500"
                    android:padding="@dimen/ten"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp">

                </EditText>


                <TextView
                    android:id="@+id/lblTextCount"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/edtDescription"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/fifteen"
                    android:text="0 / 500"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp">

                </TextView>


            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rlaFilePicking"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:layout_below="@+id/rlaTitleDescription"
                android:layout_marginTop="@dimen/five">

                <TextView
                    android:id="@+id/lblAddPhoto"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="@dimen/fifteen"
                    android:layout_marginTop="@dimen/ten"
                    android:text="Add Attachment"
                    android:textColor="@color/black"
                    android:textSize="@dimen/thirteen_sp">

                </TextView>
                <TextView
                    android:id="@+id/lblStar3"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_toEndOf="@id/lblAddPhoto"
                    android:text="@string/mandatory"
                    android:layout_marginTop="@dimen/eight"
                    android:layout_marginStart="@dimen/two"
                    android:textColor="@color/red"
                    android:textSize="@dimen/thirteen_sp" />

                <TextView
                    android:id="@+id/lblOptional"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_marginStart="8dp"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_toEndOf="@+id/lblAddPhoto"
                    android:text="@string/Optional"
                    android:textColor="@color/mild_grey1"
                    android:textSize="@dimen/thirteen_sp"
                    android:visibility="gone">

                </TextView>

                <ImageView
                    android:layout_width="@dimen/twenty_five"
                    android:layout_height="@dimen/twenty_five"
                    android:layout_alignParentEnd="true"
                    android:layout_marginTop="@dimen/ten"
                    android:layout_marginEnd="@dimen/twenty"
                    android:src="@drawable/ic_attach_file">

                </ImageView>

                <RelativeLayout
                    android:id="@+id/rytRecyclewview"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@+id/lblAddPhoto">

                    <androidx.recyclerview.widget.RecyclerView
                        android:id="@+id/rcyImages"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/ten"
                        android:orientation="vertical">

                    </androidx.recyclerview.widget.RecyclerView>

                    <VideoView
                        android:id="@+id/videoView"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/one_eighty"
                        android:layout_marginStart="@dimen/twenty"
                        android:layout_marginTop="@dimen/thirty"
                        android:layout_marginEnd="@dimen/twenty"
                        android:visibility="gone">

                    </VideoView>

                    <android.webkit.WebView
                        android:id="@+id/webView"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/one_eighty"
                        android:layout_marginStart="@dimen/twenty"
                        android:background="@color/black"
                        android:layout_marginTop="@dimen/thirty"
                        android:layout_marginEnd="@dimen/twenty"
                        android:visibility="gone">

                    </android.webkit.WebView>

                    <ProgressBar
                        android:id="@+id/loadingBar"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_centerInParent="true"
                        android:indeterminateDrawable="@drawable/progress_bar_white"
                        android:indeterminateOnly="true"
                        android:visibility="gone">

                    </ProgressBar>


                    <ImageView
                        android:id="@+id/thumbnailView"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/one_eighty"
                        android:layout_marginStart="@dimen/twenty"
                        android:layout_marginTop="@dimen/twenty_five"
                        android:layout_marginEnd="@dimen/twenty"
                        android:scaleType="centerCrop"
                        android:visibility="gone" />

                    <ImageView
                        android:id="@+id/imgDelete"
                        android:layout_width="@dimen/twenty_five"
                        android:layout_height="@dimen/twenty_five"
                        android:layout_alignParentEnd="true"
                        android:layout_marginStart="@dimen/twenty"
                        android:layout_marginTop="@dimen/twenty_five"
                        android:layout_marginEnd="@dimen/twenty"
                        android:background="@drawable/white_circle_bg"
                        android:padding="@dimen/five"
                        android:src="@drawable/del_icon"
                        android:visibility="gone">

                    </ImageView>

                    <ImageView
                        android:id="@+id/imgPlay"
                        android:layout_width="@dimen/fifty"
                        android:layout_height="@dimen/fifty"
                        android:layout_centerInParent="true"
                        android:src="@drawable/video_play"
                        android:visibility="gone">

                    </ImageView>

                </RelativeLayout>

                <TextView
                    android:id="@+id/btnChooseRecipient"
                    style="@style/CustomTextStylePoppinsBold"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_below="@id/rytRecyclewview"
                    android:layout_marginStart="@dimen/twenty_five"
                    android:layout_marginTop="@dimen/fifty"
                    android:layout_marginEnd="@dimen/twenty_five"
                    android:layout_marginBottom="@dimen/thirty"
                    android:background="@drawable/rect_btn_orange"
                    android:gravity="center"
                    android:padding="@dimen/ten"
                    android:text="@string/NEXT"
                    android:textColor="@color/white"
                    android:textSize="@dimen/thirteen_sp">

                </TextView>
            </RelativeLayout>
        </RelativeLayout>
    </RelativeLayout>
</ScrollView>


