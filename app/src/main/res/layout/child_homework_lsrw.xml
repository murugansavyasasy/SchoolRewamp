<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white"
    android:fillViewport="true">
    <ImageView
        android:id="@+id/imgBack"
        android:layout_width="@dimen/thirty_five"
        android:layout_height="@dimen/thirty_five"
        android:layout_marginTop="@dimen/twenty_three"
        android:src="@drawable/left_arrow"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent" />
    <TextView
        android:id="@+id/header_label"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_below="@+id/imgBack"
        android:layout_marginTop="10dp"
        android:text="Task Details :"
        android:textColor="@color/mild_grey_dark"
        android:textSize="15sp"
       />





    <RelativeLayout
        android:id="@+id/headerrelative_layout"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/header_label"
        android:background="@drawable/rect_shadow_white"
        android:padding="20dp">


        <LinearLayout
            android:id="@+id/iconContainer"
            android:layout_width="48dp"
            android:layout_height="48dp"
            android:layout_alignParentStart="true"
            android:layout_marginEnd="12dp"
            android:gravity="center"
            android:orientation="vertical"
            android:background="@drawable/bg_icon_round_lightyellow">

            <ImageView
                android:id="@+id/imgIcon"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:src="@drawable/booksvgformatstyle"
                android:contentDescription="icon" />
        </LinearLayout>


        <LinearLayout
            android:id="@+id/titleContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_toEndOf="@id/iconContainer"
            android:orientation="vertical">

            <TextView
                android:id="@+id/txtTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Test For Notification"
                android:textColor="@android:color/black"
                android:textSize="16sp"
                style="@style/CustomTextStylePoppinsBold" />

            <TextView
                android:id="@+id/txtSubTitle"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Reading"
                android:textColor="#007BFF"
                android:textSize="14sp"
                style="@style/CustomTextStylePoppinsBold"/>
        </LinearLayout>


        <TextView
            android:id="@+id/txtDescription"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/titleContainer"
            android:layout_toEndOf="@id/iconContainer"
            android:layout_marginTop="4dp"
            android:text="Purpose of testing student's skill"
            android:textColor="#666666"
            android:layout_marginEnd="20dp"
            android:textSize="13sp"
            android:maxLines="4"
            android:ellipsize="end"
            style="@style/CustomTextStylePoppinsMedium"/>

        <LinearLayout
            android:id="@+id/attachments_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/fifteen"
            android:gravity="center_vertical"
            android:orientation="horizontal"
            android:layout_below="@+id/txtDescription">

            <ImageView
                android:id="@+id/imgAttachmentIcon"
                android:layout_width="20dp"
                android:layout_height="20dp"
                android:src="@drawable/ic_attach_file" />

            <TextView
                android:id="@+id/lblAttachments"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginStart="8dp"
                android:text="Attachments"
                android:textSize="18sp" />
        </LinearLayout>


        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/rcChildHW"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/fifteen"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/fifteen"
            android:layout_marginBottom="@dimen/ten"
           android:layout_below="@+id/attachments_container" />


        <LinearLayout
            android:id="@+id/bottomRow"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@id/rcChildHW"
            android:layout_marginStart="5dp"
            android:layout_marginBottom="5dp"
            android:layout_marginTop="8dp"
            android:orientation="horizontal"
            android:gravity="center_vertical">


            <ImageView
                android:layout_width="16dp"
                android:layout_height="16dp"
                android:src="@drawable/calendersvgformatstyle"
                android:layout_marginEnd="4dp"
                android:contentDescription="date" />

            <TextView
                android:id="@+id/txtDate"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="09 August, 2025"
                android:textColor="#444444"
                android:textSize="12sp"
                style="@style/CustomTextStylePoppinsMedium"/>


            <Space
                android:layout_width="16dp"
                android:layout_height="1dp" />



            <TextView
                android:id="@+id/txtexportrecord"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Export Record"
                android:textColor="@color/white"
                android:padding="10dp"
                android:background="@drawable/bg_purple_circle"
                android:textSize="12sp"
                style="@style/CustomTextStylePoppinsMedium"/>
            <Space
                android:layout_width="16dp"
                android:layout_height="1dp" />

            <TextView
                android:id="@+id/txtremainder"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Remainder"
                android:textColor="@color/white"
                android:padding="10dp"
                android:background="@drawable/bg_green_radoius_10dp"
                android:textSize="12sp"
                style="@style/CustomTextStylePoppinsMedium"/>


        </LinearLayout>





    </RelativeLayout>




    <TextView
        android:id="@+id/footer_label"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_below="@+id/headerrelative_layout"
        android:layout_marginTop="10dp"
        android:text="Submitted Students :"
        android:textColor="@color/mild_grey_dark"
        android:textSize="15sp"
        />



    <FrameLayout
        android:id="@+id/lsrwgragmentcontainer"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:visibility="visible"
        android:layout_below="@+id/footer_label" />


</RelativeLayout>