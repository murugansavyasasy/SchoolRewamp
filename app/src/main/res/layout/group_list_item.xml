<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginStart="@dimen/fifteen"
        android:layout_marginEnd="@dimen/fifteen"
        android:padding="@dimen/five"
        android:layout_marginTop="@dimen/five">

        <CheckBox
            android:id="@+id/chMultipleSchool"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentStart="true"
            android:layout_centerVertical="true"/>

        <LinearLayout
            android:id="@+id/lnrTextContainer"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_toEndOf="@id/chMultipleSchool"
            android:layout_marginStart="@dimen/ten"
            android:layout_alignParentTop="true"
            android:layout_centerVertical="true">

            <TextView
                android:id="@+id/lblgroupname"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="@dimen/fifteen_sp"
                android:textColor="@color/black"/>

            <TextView
                android:id="@+id/lblEmployeeId"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="@dimen/fifteen_sp"
                android:textColor="@color/black"
                android:visibility="gone"/>

            <TextView
                android:id="@+id/lblDesignation"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text=""
                android:textSize="@dimen/fifteen_sp"
                android:textColor="@color/light_gray_"
                android:visibility="gone"/>

        </LinearLayout>

        <TextView
            android:id="@+id/lblCreated"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_alignParentEnd="true"
            android:layout_centerVertical="true"
            android:text="Created On:"
            android:textSize="@dimen/thirteen_sp"
            android:visibility="gone"
            android:textColor="@color/grey"/>

    </RelativeLayout>

</RelativeLayout>








