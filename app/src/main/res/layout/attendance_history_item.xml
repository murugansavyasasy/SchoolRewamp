<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginTop="@dimen/ten"
    android:elevation="@dimen/five"
    app:cardBackgroundColor="@color/white"
    app:cardCornerRadius="@dimen/twenty"
    app:strokeColor="@color/light_gray_10">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:padding="@dimen/twenty">

        <TextView
            android:id="@+id/lblAttendanceDate"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/five"
            android:text="Tuesday,Mar 3"
            android:textSize="@dimen/eighteen_sp"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintEnd_toStartOf="@+id/lblAttendancePercentage"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            ></TextView>

        <TextView
            android:id="@+id/lblAttendancePercentage"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/five"
            android:gravity="center"
            android:text="60%"
            android:textSize="@dimen/eighteen_sp"
            app:layout_constraintBottom_toBottomOf="@+id/lblAttendanceDate"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="0.4"
            app:layout_constraintStart_toEndOf="@+id/lblAttendanceDate"
            app:layout_constraintTop_toTopOf="@+id/lblAttendanceDate"></TextView>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/brAttendanceDatePercentDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="lblAttendanceDate,lblAttendancePercentage"></androidx.constraintlayout.widget.Barrier>


        <TextView
            android:id="@+id/lblYear"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/five"
            android:text="2026"
            android:textColor="@color/light_gray"
            app:layout_constraintTop_toBottomOf="@+id/brAttendanceDatePercentDetails"
            app:layout_constraintEnd_toStartOf="@+id/lblAttendanceLabel"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            ></TextView>

        <TextView
            android:id="@+id/lblAttendanceLabel"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/five"
            android:gravity="center"
            android:text="Attendance"
            android:textSize="@dimen/sixteen_sp"
            android:textColor="@color/light_gray"
            app:layout_constraintBottom_toBottomOf="@+id/lblYear"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="0.4"
            app:layout_constraintStart_toEndOf="@+id/lblYear"
            app:layout_constraintTop_toTopOf="@+id/lblYear"></TextView>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/brAttendancYearDetails"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="lblYear,lblAttendanceLabel"></androidx.constraintlayout.widget.Barrier>


        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/ten"
            android:padding="@dimen/fifteen"
            app:layout_constrainedWidth="true"
            app:layout_constrainedHeight="true"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintHorizontal_chainStyle="spread"
            android:background="@drawable/rect_radius_15"
            android:id="@+id/consTotalStudentDetails"
            app:layout_constraintEnd_toStartOf="@+id/consPresentDetails"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/brAttendancYearDetails"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/lblTotalStudents"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/total_students"
                android:textColor="@color/dark_blue_3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                />

            <TextView
                android:id="@+id/lblTotalStudentCount"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="0dp"
                android:layout_marginTop="@dimen/five"
                android:textSize="@dimen/eighteen_sp"
                android:layout_height="wrap_content"
                android:text="22"
                android:textColor="@color/dark_blue_3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblTotalStudents" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_marginHorizontal="@dimen/eight"
            android:layout_marginTop="@dimen/ten"
            android:padding="@dimen/fifteen"
            app:layout_constrainedWidth="true"
            app:layout_constrainedHeight="true"
            app:layout_constraintHorizontal_weight="1"
            android:background="@drawable/rect_radius_15"
            android:id="@+id/consPresentDetails"
            app:layout_constraintEnd_toStartOf="@+id/consAbsentDetails"
            app:layout_constraintStart_toEndOf="@+id/consTotalStudentDetails"
            app:layout_constraintTop_toBottomOf="@+id/brAttendancYearDetails"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/lblPresentDetails"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/present"
                android:textColor="@color/light_green_3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintBottom_toTopOf="@+id/lblPresentCount"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <TextView
                android:id="@+id/lblPresentCount"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="0dp"
                android:textSize="@dimen/eighteen_sp"
                android:layout_marginTop="@dimen/five"
                android:layout_height="wrap_content"
                android:text="12"
                android:textColor="@color/light_green_3"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblPresentDetails" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="0dp"
            android:layout_marginTop="@dimen/ten"
            android:padding="@dimen/fifteen"
            app:layout_constrainedWidth="true"
            app:layout_constrainedHeight="true"
            app:layout_constraintHorizontal_weight="1"
            android:background="@drawable/rect_radius_15"
            android:id="@+id/consAbsentDetails"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toEndOf="@+id/consPresentDetails"
            app:layout_constraintTop_toBottomOf="@+id/brAttendancYearDetails"
            android:layout_height="wrap_content">

            <TextView
                android:id="@+id/lblAbsentDetails"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:text="@string/absent"
                android:textColor="@color/red"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintTop_toTopOf="parent"
                />

            <TextView
                android:id="@+id/lblAbsentCount"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="0dp"
                android:textSize="@dimen/eighteen_sp"
                android:layout_height="wrap_content"
                android:text="22"
                android:layout_marginTop="@dimen/five"
                android:textColor="@color/red"
                app:layout_constraintEnd_toEndOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintBottom_toBottomOf="parent"
                app:layout_constraintTop_toBottomOf="@id/lblAbsentDetails" />

        </androidx.constraintlayout.widget.ConstraintLayout>

        <androidx.constraintlayout.widget.Barrier
            android:layout_width="wrap_content"
            android:id="@+id/brAttendanceDetails"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="consTotalStudentDetails,consPresentDetails,consAbsentDetails"
            android:layout_height="wrap_content">

        </androidx.constraintlayout.widget.Barrier>
        <TextView
            android:id="@+id/lblRoomMarked"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/five"
            android:text="@string/rooms_marked"
            android:textColor="@color/light_gray"
            app:layout_constraintEnd_toStartOf="@+id/lblMarkedPercentage"
            app:layout_constraintHorizontal_weight="1"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/brAttendanceDetails" />

        <TextView
            android:id="@+id/lblMarkedPercentage"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/five"
            android:gravity="end"
            android:text="6/8"
            android:textSize="@dimen/sixteen_sp"
            app:layout_constraintBottom_toBottomOf="@+id/lblRoomMarked"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintHorizontal_weight="0.2"
            app:layout_constraintStart_toEndOf="@+id/lblRoomMarked"
            app:layout_constraintTop_toTopOf="@+id/lblRoomMarked"></TextView>

        <androidx.constraintlayout.widget.Barrier
            android:id="@+id/brOccupancyPecentage"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            app:barrierDirection="bottom"
            app:constraint_referenced_ids="lblRoomMarked,lblMarkedPercentage"></androidx.constraintlayout.widget.Barrier>

        <ProgressBar
            android:id="@+id/proAttendanceProgressBar"
            style="@android:style/Widget.ProgressBar.Horizontal"
            android:layout_width="0dp"
            android:layout_height="@dimen/five"
            android:layout_marginTop="@dimen/fifteen"
            android:layout_marginBottom="@dimen/eight"
            android:max="100"
            android:progress="50"
            app:layout_constraintBottom_toBottomOf="parent"
            android:progressDrawable="@drawable/progress_voilet"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@id/brOccupancyPecentage" />



    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>