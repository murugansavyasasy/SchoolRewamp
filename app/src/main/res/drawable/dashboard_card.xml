<?xml version="1.0" encoding="utf-8"?>
<shape xmlns:android="http://schemas.android.com/apk/res/android"
    android:shape="rectangle">

    <!-- Background color (set to white or transparent as needed) -->
    <solid android:color="@color/mild_grey" />

    <!-- Border (stroke) -->
    <stroke
        android:width="2dp"
        android:color="#f3f3f3" /> <!-- You can change this to your desired stroke color -->

    <!-- Corner radius (match your CardView corner radius) -->
    <corners android:radius="15dp" /> <!-- Or use @dimen/fifteen if defined -->

</shape>
