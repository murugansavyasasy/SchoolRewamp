<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_margin="@dimen/twenty"
    android:background="@color/bpTransparent_black"
    android:orientation="vertical"
    android:fitsSystemWindows="true">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_centerInParent="true"
        android:layout_marginStart="@dimen/twenty"
        android:layout_marginTop="@dimen/twenty"
        android:layout_marginEnd="@dimen/twenty"
        android:layout_marginBottom="@dimen/twenty"
        android:background="@drawable/rect_white_light_radious"
        android:orientation="vertical">

        <TextView
            android:id="@+id/lblTitle"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/twenty"
            android:gravity="start"
            style="@style/CustomTextStylePoppinsBold"
            android:padding="@dimen/ten"
            android:text="@string/biometric_authentications"
            android:textColor="@color/bpBlue"
            android:textSize="@dimen/twenty_sp"
            android:visibility="visible" />

        <TextView
            android:id="@+id/lblHeader"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="start"
            android:padding="@dimen/ten"
            android:text="@string/biometric_authentication_is_required_to_present"
            android:textColor="@color/black"
            android:textSize="@dimen/sixteen_sp"
            android:visibility="visible" />

        <View
            android:layout_width="match_parent"
            android:layout_height="@dimen/one"
            android:layout_marginTop="@dimen/ten"
            android:background="@color/grey" />


        <TextView
            android:id="@+id/lblAuthenticate"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="@dimen/ten"
            android:gravity="center"
            android:padding="@dimen/ten"
            android:text="@string/authenticate_again"
            android:textColor="@color/green"
            android:textSize="@dimen/twenty_sp"
            android:textStyle="bold"
            android:visibility="visible" />


    </LinearLayout>
</RelativeLayout>

