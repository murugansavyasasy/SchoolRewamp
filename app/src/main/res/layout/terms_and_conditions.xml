<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:id="@+id/main"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:background="@color/white">

    <View
        android:id="@+id/statusBarBackground"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:background="@color/PrimaryColor"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />


    <RelativeLayout
        android:id="@+id/rytHeader"
        app:layout_constraintTop_toBottomOf="@id/statusBarBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

       <RelativeLayout
           android:background="@color/PrimaryColor"
           android:id="@+id/toolbarLayout"
           android:paddingVertical="@dimen/ten"
           android:layout_width="match_parent"
           android:layout_height="wrap_content">

           <ImageView
               android:id="@+id/imgBack"
               android:layout_width="@dimen/thirty_five"
               android:layout_height="@dimen/thirty_five"
               android:layout_marginTop="@dimen/fifteen"
               android:layout_centerVertical="true"
               android:src="@drawable/arrow_left_white">

           </ImageView>

           <TextView
               android:layout_toEndOf="@+id/imgBack"
               android:id="@+id/lblParentToolBar"
               style="@style/CustomTextStylePoppinsBold"
               android:layout_width="wrap_content"
               android:layout_height="wrap_content"
               android:layout_centerVertical="true"
               android:text=""
               android:textColor="@color/white"
               android:textSize="@dimen/fifteen_sp"/>

       </RelativeLayout>


    <RelativeLayout
        android:layout_below="@+id/toolbarLayout"
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <WebView
            android:id="@+id/webView"
            android:layout_width="match_parent"
            android:layout_height="match_parent"/>

    </RelativeLayout>

</RelativeLayout>
</androidx.constraintlayout.widget.ConstraintLayout>