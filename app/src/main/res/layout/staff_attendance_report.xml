<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">


    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar" />

    <LinearLayout
        android:id="@+id/lnrParent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbarLayout"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="@dimen/ten"
        android:layout_marginStart="@dimen/fifteen"
        android:layout_marginTop="@dimen/fifteen"
        android:layout_marginEnd="@dimen/fifteen"
        android:background="@drawable/bg_light_blue"
        android:padding="@dimen/one">

        <TextView
            android:id="@+id/btnCreate"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/white_bg_radius"
            android:gravity="center"
            android:text="Today's Report"
            android:textColor="@color/black"
            android:textSize="@dimen/thirteen_sp" />

        <TextView
            android:id="@+id/btnHistory"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="@dimen/eight"
            android:text="Staffwise Report"
            android:textColor="@color/dark_blue"
            android:textSize="@dimen/thirteen_sp" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/rytTodays"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/lnrParent"
        android:visibility="visible">

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycleAttendanceReports"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:visibility="gone"
            tools:listitem="@layout/giometric_attendance_report_item_list" />


        <ImageView
            android:id="@+id/imgNorecord"
            android:layout_width="match_parent"
            android:layout_height="@dimen/two_hundred"
            android:layout_centerInParent="true"
            android:src="@drawable/man_doing_fingerprint_research"
            android:visibility="gone">

        </ImageView>

        <TextView
            android:id="@+id/lblNoRecords"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/imgNorecord"
            android:layout_centerVertical="true"
            android:layout_marginStart="@dimen/twenty_five"
            android:layout_marginEnd="@dimen/twenty_five"
            android:gravity="center"
            android:text=""
            android:textColor="@color/black"
            android:textSize="15dp"
            android:visibility="gone" />

    </RelativeLayout>

    <RelativeLayout
        android:id="@+id/rytAttendanceHistorySceen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/lnrParent"
        android:layout_marginTop="@dimen/fifteen"
        android:visibility="gone">

        <LinearLayout
            android:id="@+id/lnrSpinners"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:orientation="horizontal">

            <RelativeLayout
                android:id="@+id/rytYears"
                android:layout_width="@dimen/one_fifty"
                android:layout_height="@dimen/fifty"
                android:layout_marginStart="@dimen/thirty"
                android:background="@drawable/bg_white_light_radious"
                android:gravity="center">

                <Spinner
                    android:id="@+id/spinnerYears"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:spinnerMode="dropdown" />

                <ImageView
                    android:id="@+id/imgYearDropDown"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/spinnerYears"
                    android:src="@drawable/ic_drop_down" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rytMonths"
                android:layout_width="@dimen/one_fifty"
                android:layout_height="@dimen/fifty"
                android:layout_marginStart="@dimen/five"
                android:layout_marginEnd="@dimen/thirty"
                android:background="@drawable/bg_white_light_radious"
                android:gravity="center">

                <Spinner
                    android:id="@+id/spinnerMonths"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:background="@android:color/transparent"
                    android:gravity="center"
                    android:spinnerMode="dropdown" />

                <ImageView
                    android:id="@+id/imgMonthDropDown"
                    android:layout_width="30dp"
                    android:layout_height="30dp"
                    android:layout_centerVertical="true"
                    android:layout_toEndOf="@+id/spinnerMonths"
                    android:src="@drawable/ic_drop_down" />

            </RelativeLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/lblSelectStaff"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lnrSpinners"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/five"
            android:text="Select Staff">

        </TextView>

        <RelativeLayout
            android:id="@+id/rlaStaff"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lblSelectStaff"
            android:layout_marginStart="@dimen/fifteen"
            android:layout_marginTop="@dimen/ten"
            android:layout_marginEnd="@dimen/fifteen"
            android:background="@drawable/bg_stroke_rect_black"
            android:padding="@dimen/ten">


            <ImageView
                android:id="@+id/imgStaff"
                android:layout_width="@dimen/twenty_five"
                android:layout_height="@dimen/twenty_five"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/ten"
                android:src="@drawable/ic_down_arrow">

            </ImageView>

            <TextView
                android:id="@+id/lblStaff"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/fifteen"
                android:fontFamily="@font/poppins_bold"
                android:text=""
                android:textColor="@color/black"
                android:textSize="@dimen/thirteen_sp"
                android:textStyle="bold">

            </TextView>
        </RelativeLayout>


        <RelativeLayout
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_marginTop="@dimen/ten"
            android:layout_below="@+id/rlaStaff">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/recycleAttendanceReport"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:visibility="gone"
                tools:listitem="@layout/giometric_attendance_report_item_list" />


            <ImageView
                android:id="@+id/imgNoRecord"
                android:layout_width="match_parent"
                android:layout_height="@dimen/two_hundred"
                android:layout_centerInParent="true"
                android:src="@drawable/man_doing_fingerprint_research"
                android:visibility="gone">

            </ImageView>

            <TextView
                android:id="@+id/lblNorecords"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/imgNoRecord"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/twenty_five"
                android:layout_marginEnd="@dimen/twenty_five"
                android:gravity="center"
                android:text=""
                android:textColor="@color/black"
                android:textSize="15dp"
                android:visibility="gone" />

        </RelativeLayout>

    </RelativeLayout>


</RelativeLayout>