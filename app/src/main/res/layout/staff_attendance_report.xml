<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white"
    android:fitsSystemWindows="true">

    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/school_side_tool_bar" />

    <LinearLayout
        android:id="@+id/lnrParent"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/toolbarLayout"
        android:layout_centerHorizontal="true"
        android:layout_marginHorizontal="@dimen/ten"
        android:layout_marginStart="@dimen/fifteen"
        android:layout_marginTop="@dimen/fifteen"
        android:layout_marginEnd="@dimen/fifteen"
        android:background="@drawable/bg_light_blue"
        android:padding="@dimen/one">

        <TextView
            android:id="@+id/btnCreate"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:background="@drawable/white_bg_radius"
            android:gravity="center"
            android:text="@string/today_s_report"
            android:textColor="@color/black"
            android:textSize="@dimen/thirteen_sp" />

        <TextView
            android:id="@+id/btnHistory"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_weight="1"
            android:gravity="center"
            android:padding="@dimen/eight"
            android:text="@string/staffwise_report"
            android:textColor="@color/dark_blue"
            android:textSize="@dimen/thirteen_sp" />

    </LinearLayout>

    <RelativeLayout
        android:id="@+id/rytAttendanceHistorySceen"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:layout_below="@+id/lnrParent"
        android:layout_marginTop="@dimen/fifteen"
        android:visibility="visible">

        <LinearLayout
            android:id="@+id/lnrSpinners"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:gravity="center"
            android:visibility="gone"
            android:orientation="horizontal">

            <RelativeLayout
                android:id="@+id/rytYears"
                android:layout_width="@dimen/one_fifty"
                android:layout_height="@dimen/fifty_five"
                android:layout_marginStart="@dimen/thirty"
                android:background="@drawable/bg_white_light_radious"
                android:gravity="center">

                <Spinner
                    android:id="@+id/spinnerYears"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:background="@drawable/custom_spinner_background"
                    android:gravity="center"
                    android:spinnerMode="dropdown" />

            </RelativeLayout>

            <RelativeLayout
                android:id="@+id/rytMonths"
                android:layout_width="@dimen/one_fifty"
                android:layout_height="@dimen/fifty_five"
                android:layout_marginStart="@dimen/five"
                android:layout_marginEnd="@dimen/thirty"
                android:background="@drawable/bg_white_light_radious"
                android:gravity="center">

                <Spinner
                    android:id="@+id/spinnerMonths"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_centerVertical="true"
                    android:background="@drawable/custom_spinner_background"
                    android:gravity="center"
                    android:spinnerMode="dropdown" />


            </RelativeLayout>

        </LinearLayout>

        <TextView
            android:id="@+id/lblSelectStaff"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_below="@+id/lnrSpinners"
            android:visibility="gone"
            android:layout_marginStart="@dimen/ten"
            android:layout_marginTop="@dimen/five"
            android:text="@string/select_staff">

        </TextView>

        <RelativeLayout
            android:id="@+id/rlaStaff"
            android:layout_width="match_parent"
            android:layout_marginStart="@dimen/thirty"
            android:layout_height="wrap_content"
            android:layout_marginEnd="@dimen/thirty"
            android:gravity="center"
            android:layout_below="@+id/lblSelectStaff"
            android:background="@drawable/bg_white_light_radious"
            android:visibility="gone">

            <Spinner
                android:id="@+id/spinnerStaffList"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:background="@drawable/custom_spinner_background"
                android:gravity="center"
                android:spinnerMode="dropdown" />


        </RelativeLayout>

        <androidx.recyclerview.widget.RecyclerView
            android:id="@+id/recycleAttendanceReportsToday"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/rlaStaff"
            android:visibility="gone"
            tools:listitem="@layout/giometric_attendance_report_item_list" />

        <LinearLayout
            android:id="@+id/lytNoRecordFound"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_centerInParent="true"
            android:orientation="vertical"
            android:visibility="gone">

            <ImageView
                android:id="@+id/imgNorecord"
                android:layout_width="match_parent"
                android:layout_height="@dimen/two_hundred"
                android:layout_centerInParent="true"
                android:src="@drawable/man_doing_fingerprint_research"
                android:visibility="visible">

            </ImageView>

            <TextView
                android:id="@+id/lblNoRecords"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_below="@+id/imgNorecord"
                android:layout_centerVertical="true"
                android:layout_marginStart="@dimen/twenty_five"
                android:layout_marginEnd="@dimen/twenty_five"
                android:gravity="center"
                android:text=""
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp"
                android:visibility="visible" />

        </LinearLayout>
    </RelativeLayout>

</RelativeLayout>