<?xml version="1.0" encoding="utf-8"?>
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@drawable/bg_card_white_rounded"
    android:orientation="vertical"
    android:padding="@dimen/twenty">

    <LinearLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:gravity="center_vertical"
        android:orientation="horizontal">

        <ImageView
            android:id="@+id/imgDialogIcon"
            android:layout_width="@dimen/twenty_two"
            android:layout_height="@dimen/twenty_two"
            android:src="@drawable/file_noticeboard"
            app:tint="@color/PrimaryColor"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

        <TextView
            android:id="@+id/lblDialogTitle"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:layout_marginStart="@dimen/eight"
            android:layout_weight="1"
            android:text="Acknowledgement Details"
            android:textColor="@color/black"
            android:textSize="@dimen/sixteen_sp" />

        <ImageView
            android:id="@+id/imgDialogClose"
            android:layout_width="@dimen/twenty_two"
            android:layout_height="@dimen/twenty_two"
            android:padding="@dimen/two"
            android:src="@drawable/close_icon"
            app:tint="@color/grey_color"
            xmlns:app="http://schemas.android.com/apk/res-auto" />

    </LinearLayout>

    <View
        android:layout_width="match_parent"
        android:layout_height="1dp"
        android:layout_marginTop="@dimen/fourteen"
        android:background="#EDEDED" />

    <LinearLayout
        android:id="@+id/lytDetailRows"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/six"
        android:orientation="vertical" />

    <TextView
        android:id="@+id/btnDialogOk"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_marginTop="@dimen/twenty"
        android:background="@drawable/bg_button_blue"
        android:gravity="center"
        android:paddingTop="@dimen/ten"
        android:paddingBottom="@dimen/ten"
        android:text="OK"
        android:textColor="@color/white"
        android:textSize="@dimen/thirteen_sp" />

</LinearLayout>