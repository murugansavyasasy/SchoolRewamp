<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:layout_height="match_parent"
    android:background="@color/white">

    <ImageView
        android:id="@+id/imgBack"
        android:layout_width="@dimen/twenty_five"
        android:layout_height="@dimen/twenty_five"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginTop="@dimen/twenty_five"
        android:src="@drawable/arrow_back_black">

    </ImageView>

    <TextView
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_centerHorizontal="true"
        android:layout_marginTop="@dimen/twenty_five"
        android:text="@string/punch_history"
        android:textColor="@color/navi_blue2"
        android:textSize="@dimen/fifteen_sp">

    </TextView>

    <androidx.recyclerview.widget.RecyclerView
        android:id="@+id/rcyPunchList"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:layout_below="@+id/imgBack">

    </androidx.recyclerview.widget.RecyclerView>


    <TextView
        android:id="@+id/lblNoRecordsFound"
        style="@style/CustomTextStylePoppinsBold"
        android:layout_width="wrap_content"
        android:layout_centerInParent="true"
        android:layout_height="wrap_content"
        android:text="">

    </TextView>

</RelativeLayout>