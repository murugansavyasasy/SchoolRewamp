<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout
    xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@color/white">

    <!-- Wave at bottom -->
    <ImageView
        android:id="@+id/imgWaveBackground"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:adjustViewBounds="true"
        android:scaleType="fitXY"
        android:src="@drawable/wave_primary_colour"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Main image floating above wave -->
    <ImageView
        android:id="@+id/imgOnboard"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:adjustViewBounds="true"
        android:scaleType="fitCenter"
        android:src="@drawable/disabled_girl_in_involved_in_business_presentation_discussion"
        app:layout_constraintWidth_percent="0.7"
        app:layout_constraintDimensionRatio="1:1"
        android:translationY="80dp"
        app:layout_constraintBottom_toTopOf="@id/imgWaveBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- 📝 Scrollable text content -->
    <ScrollView
        android:id="@+id/scrollTextContainer"
        android:layout_width="0dp"
        android:layout_height="0dp"
        android:fillViewport="true"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintBottom_toTopOf="@id/imgWaveBackground"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:id="@+id/layoutTextContent"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:paddingHorizontal="@dimen/twenty"
            android:paddingTop="40dp"
            android:paddingBottom="200dp"
            android:gravity="center_horizontal">

        <TextView
            android:id="@+id/txtTitle"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Super Easy Transaction"
            android:textColor="@color/PrimaryColor"
            android:textSize="@dimen/twenty_four_sp" />

        <TextView
            android:id="@+id/txtDesc"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            android:text="Pay anything, anywhere, anytime more easy with this emoney. This is a long sample text that will now scroll properly without being hidden behind the image or wave. Just keep adding more text to test scrolling comfortably."
            android:textColor="#808080"
            android:textSize="@dimen/fourteen_sp" />
    </LinearLayout>
</ScrollView>
    </androidx.constraintlayout.widget.ConstraintLayout>


