<?xml version="1.0" encoding="utf-8"?>
<androidx.cardview.widget.CardView xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/card_view"
    android:layout_width="match_parent"
    android:layout_height="match_parent">

    <RelativeLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent">

        <ImageView
            android:id="@+id/image_view_album_image"
            android:layout_width="match_parent"
            android:layout_height="@dimen/one_fifty"
            android:scaleType="centerCrop"
            android:src="@drawable/ic_more_vert" />

        <RelativeLayout
            android:id="@+id/frame_layout_album_select"
            android:layout_width="match_parent"
            android:layout_height="@dimen/two_hundred"
            android:background="@color/light_gray_8"
            android:paddingStart="@dimen/one"
            android:paddingTop="@dimen/one"
            android:paddingEnd="@dimen/one"
            android:paddingBottom="@dimen/one"
            android:visibility="visible">

            <LinearLayout
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_alignParentStart="true"
                android:layout_alignParentBottom="true"
                android:layout_marginStart="@dimen/eight"
                android:layout_marginEnd="@dimen/eight"
                android:layout_marginBottom="@dimen/ten"
                android:orientation="vertical">

                <TextView
                    android:id="@+id/text_view_album_name"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    android:shadowColor="@color/black"
                    android:shadowRadius="7.0"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="@dimen/twele_sp" />

                <TextView
                    android:id="@+id/gallery_count"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:ellipsize="end"
                    android:maxLines="1"
                    android:scrollHorizontally="true"
                    android:shadowColor="@color/black"
                    android:shadowRadius="7.0"
                    android:text=""
                    android:textColor="@color/white"
                    android:textSize="@dimen/fourteen_sp" />
            </LinearLayout>

        </RelativeLayout>
    </RelativeLayout>
</androidx.cardview.widget.CardView>