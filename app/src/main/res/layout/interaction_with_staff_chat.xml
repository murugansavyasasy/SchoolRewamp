<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/AthensGray">


    <LinearLayout
        android:id="@+id/linear_layout"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_alignParentEnd="true"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:background="@drawable/circle_background"
        android:orientation="vertical">

        <TextView
            android:id="@+id/user_name"
            style="@style/CustomTextStylePoppinsBold"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:text="Saran"
            android:textColor="@color/black"
            android:textSize="12sp" />


        <TextView
            android:id="@+id/questionText"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginStart="5dp"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="5dp"
            android:layout_marginBottom="5dp"
            android:text="How are you doing im fiena and how about you everything good ?"
            android:textColor="@color/black"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/time_value"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="5dp"
            android:layout_marginEnd="10dp"
            android:layout_marginBottom="5dp"
            android:text="10 min ago"
            android:textColor="@color/black"
            android:textSize="10sp" />

    </LinearLayout>


    <LinearLayout
        android:id="@+id/linear_layo212ut"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_below="@+id/linear_layout"
        android:layout_marginStart="@dimen/ten"
        android:layout_marginTop="@dimen/ten"
        android:layout_marginEnd="@dimen/ten"
        android:background="@drawable/circle_answer_background"
        android:orientation="vertical"
        android:padding="@dimen/ten">


        <TextView
            android:id="@+id/answerText"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Im doing great"
            android:textColor="@color/black"
            android:textSize="11sp" />

        <TextView
            android:id="@+id/time"
            style="@style/CustomTextStylePoppinsMedium"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_gravity="end"
            android:layout_marginTop="5dp"
            android:text="5 min ago"
            android:textColor="@color/black"
            android:textSize="10sp" />


    </LinearLayout>


</RelativeLayout>