<?xml version="1.0" encoding="utf-8"?>
<RelativeLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:fitsSystemWindows="true"
    android:background="@color/very_light_grey"
    android:layout_height="match_parent">


    <include
        android:id="@+id/toolbarLayout"
        layout="@layout/parent_side_tool_bar" />





        <LinearLayout
            android:layout_below="@+id/toolbarLayout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="@dimen/sixteen">


            <LinearLayout
                android:id="@+id/quiz_status"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:gravity="center"
                android:orientation="vertical"
                android:visibility="gone">

                <ImageView
                    android:layout_width="@dimen/fifty"
                    android:layout_height="@dimen/fifty"
                    android:src="@drawable/quiz_complete">
                </ImageView>

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:layout_marginTop="@dimen/ten"
                    android:gravity="center"
                    android:shadowColor="@color/black"
                    android:shadowDx="2"
                    android:shadowDy="1"
                    android:shadowRadius="3"
                    android:text="@string/submitted_the_quiz_successfully"
                    android:textColor="@color/neon_green"
                    android:textSize="@dimen/twenty_sp"
                    android:textStyle="bold">
                </TextView>
            </LinearLayout>

            <ScrollView
                android:scrollbars="none"
                android:layout_width="match_parent"
                android:layout_height="match_parent">
            <LinearLayout
                android:orientation="vertical"
                android:layout_width="match_parent"
                android:layout_height="wrap_content">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:orientation="vertical"
                    android:id="@+id/lnrQuiz"
                    android:layout_height="wrap_content">

                    <TextView
                        android:id="@+id/lblQuestion"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity=""
                        style="@style/CustomTextStylePoppinsMedium"
                        android:text="@string/question"
                        android:textSize="@dimen/twele_sp"
                        />

                    <TextView
                        android:id="@+id/questionCounter"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:layout_gravity=""
                        android:text="0/0"
                        style="@style/CustomTextStylePoppinsMedium"
                        android:layout_marginStart="@dimen/three"
                        android:textColor="@color/black"
                        android:textSize="@dimen/sixteen_sp"
                        />

                    <ProgressBar
                        android:id="@+id/progressBar"
                        style="?android:attr/progressBarStyleHorizontal"
                        android:layout_width="match_parent"
                        android:layout_height="@dimen/ten"
                        android:layout_marginTop="@dimen/five"
                        android:max="100"
                        android:progress="0"
                        android:progressDrawable="@android:drawable/progress_horizontal"
                        android:progressTint="@color/azure_radiance" />

                    <LinearLayout
                        android:layout_marginTop="@dimen/ten"
                        android:orientation="vertical"
                        android:background="@drawable/white_bg_card"
                        android:layout_width="match_parent"
                        android:padding="@dimen/ten"
                        android:layout_height="wrap_content">

                        <TextView
                            android:id="@+id/questionText"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:text="@string/question_will_appear_here"
                            android:textSize="@dimen/fifteen_sp"
                            android:gravity="start"
                            android:textColor="@color/black"
                            android:textStyle="bold" />

                        <androidx.recyclerview.widget.RecyclerView
                            android:layout_width="match_parent"
                            android:id="@+id/rcAttachement"
                            android:layout_marginTop="@dimen/ten"
                            android:layout_height="@dimen/one_fifty">
                        </androidx.recyclerview.widget.RecyclerView>

                        <me.relex.circleindicator.CircleIndicator2
                            android:id="@+id/indicator"
                            style="@style/IndicatorStyle"
                            android:layout_marginTop="@dimen/five"
                            android:layout_width="wrap_content"
                            android:layout_height="@dimen/twenty"
                            android:layout_gravity="center"
                            android:elevation="@dimen/four"
                            android:visibility="gone" />

                        <TextView
                            android:id="@+id/option1"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ten"
                            android:background="@drawable/quiz_option_bg"
                            android:clickable="true"
                            android:gravity="center"
                            android:padding="10dp"
                            android:text="Option 1"
                            style="@style/CustomTextStylePoppinsRegular"
                            android:textColor="@color/azure_radiance"
                            android:textSize="@dimen/fourteen_sp" />


                        <TextView
                            android:id="@+id/option2"
                            style="@style/CustomTextStylePoppinsRegular"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ten"
                            android:background="@drawable/quiz_option_bg"
                            android:clickable="true"
                            android:gravity="center"
                            android:padding="@dimen/ten"
                            android:text="Option 2"
                            android:textColor="@color/azure_radiance"
                            android:textSize="@dimen/fourteen_sp" />

                        <TextView
                            android:id="@+id/option3"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ten"
                            android:background="@drawable/quiz_option_bg"
                            android:clickable="true"
                            android:gravity="center"
                            style="@style/CustomTextStylePoppinsRegular"
                            android:padding="@dimen/ten"
                            android:text="Option 3"
                            android:textColor="@color/azure_radiance"
                            android:textSize="@dimen/fourteen_sp" />

                        <TextView
                            style="@style/CustomTextStylePoppinsRegular"
                            android:id="@+id/option4"
                            android:layout_width="match_parent"
                            android:layout_height="wrap_content"
                            android:layout_marginTop="@dimen/ten"
                            android:background="@drawable/quiz_option_bg"
                            android:clickable="true"
                            android:gravity="center"
                            android:padding="@dimen/ten"
                            android:text="Option 4"
                            android:textColor="@color/azure_radiance"
                            android:textSize="@dimen/fourteen_sp" />

                    </LinearLayout>

                    <!--Next and Previous Button-->
                    <LinearLayout
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:gravity="center"
                        android:weightSum="1"
                        android:orientation="horizontal"
                        android:layout_marginTop="@dimen/twenty">

                        <RelativeLayout
                            android:id="@+id/prevButton"
                            android:layout_marginEnd="@dimen/five"
                            android:layout_weight="0.5"
                            android:layout_width="match_parent"
                            android:gravity="center"
                            android:background="@drawable/bg_button_blue_color"
                            android:layout_height="wrap_content">
                            <ImageView
                                android:layout_centerVertical="true"
                                android:id="@+id/ig_left_image"
                                android:layout_alignParentStart="true"
                                android:layout_width="@dimen/twenty_five"
                                android:src="@drawable/ic_left_arrow"
                                android:layout_height="@dimen/twenty_five">
                            </ImageView>
                            <TextView
                                android:layout_toEndOf="@+id/ig_left_image"
                                android:id="@+id/prevButton1"
                                android:layout_width="wrap_content"
                                android:layout_height="wrap_content"
                                android:enabled="false"
                                android:padding="@dimen/ten"
                                android:gravity="center_horizontal"
                                android:textColor="@color/white"
                                android:textSize="@dimen/thirteen_sp"
                                android:textAllCaps="true"
                                android:text="@string/lblPrevious" />
                        </RelativeLayout>

                        <RelativeLayout

                            android:layout_marginStart="@dimen/five"
                            android:gravity="center"
                            android:id="@+id/nextButton"
                            android:layout_weight="0.5"
                            android:layout_width="match_parent"
                            android:background="@drawable/bg_button_blue_color"
                            android:layout_height="wrap_content">
                            <TextView
                                android:id="@+id/nextButton1"
                                android:layout_width="wrap_content"
                                android:padding="@dimen/ten"
                                android:layout_alignParentStart="true"
                                android:layout_height="wrap_content"
                                android:textColor="@color/white"
                                android:textSize="@dimen/thirteen_sp"
                                android:text="@string/NEXT" />

                            <ImageView
                                android:layout_centerVertical="true"
                                android:id="@+id/ig_right_image"
                                android:layout_toEndOf="@+id/nextButton1"
                                android:layout_width="@dimen/twenty_five"
                                android:src="@drawable/right_arrow_ic"
                                android:layout_height="@dimen/twenty_five">
                            </ImageView>
                        </RelativeLayout>


                    </LinearLayout>
                </LinearLayout>


                <LinearLayout
                    android:id="@+id/lytList"
                    android:layout_width="match_parent"
                    android:layout_centerInParent="true"
                    android:layout_height="wrap_content"
                    android:visibility="gone"
                    android:orientation="vertical">

                    <ImageView
                        android:id="@+id/nomessage"
                        android:layout_width="@dimen/two_fifty"
                        android:layout_height="@dimen/two_fifty"
                        android:layout_centerInParent="true"
                        android:layout_gravity="center"
                        android:layout_marginTop="@dimen/twenty"
                        android:src="@drawable/nomessages"
                        android:textColor="@color/black"
                        android:textSize="@dimen/fifteen_sp"
                        />

                    <TextView
                        android:id="@+id/txtNoData"
                        style="@style/CustomTextStylePoppinsBold"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:layout_marginTop="@dimen/twenty"
                        android:gravity="center"
                        android:text="@string/no_list_found"
                        android:textSize="@dimen/fifteen_sp" />
                </LinearLayout>
            </LinearLayout>
            </ScrollView>

        </LinearLayout>



</RelativeLayout>