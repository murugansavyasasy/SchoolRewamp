<?xml version="1.0" encoding="utf-8"?>
<!-- Banner ad slider added at the bottom of the parent menu screens (MenuAds.kt) -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:background="@color/bpWhite"
    android:orientation="vertical"
    android:paddingTop="@dimen/five"
    android:visibility="gone">

    <FrameLayout
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingBottom="@dimen/five">

        <androidx.viewpager2.widget.ViewPager2
            android:id="@+id/adViewPager"
            android:layout_width="match_parent"
            android:layout_height="120dp" />

        <!-- X button: hides the ad (AdSlider) -->
        <ImageView
            android:id="@+id/imgCloseAd"
            android:layout_width="26dp"
            android:layout_height="26dp"
            android:layout_gravity="top|end"
            android:layout_marginTop="6dp"
            android:layout_marginEnd="16dp"
            android:background="@drawable/bg_ad_close"
            android:contentDescription="@string/close_ad"
            android:padding="5dp"
            android:src="@drawable/ic_ad_close" />
    </FrameLayout>

    <LinearLayout
        android:id="@+id/adDotsIndicator"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:layout_gravity="center_horizontal"
        android:layout_marginBottom="@dimen/five"
        android:gravity="center"
        android:orientation="horizontal" />
</LinearLayout>
