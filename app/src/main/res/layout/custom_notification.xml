<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:orientation="vertical"
    android:elevation="@dimen/four"
    android:layout_marginStart="@dimen/five"
    android:layout_marginEnd="@dimen/five">

    <TextView
        android:id="@+id/notification_title"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:textSize="@dimen/sixteen_sp"
        android:text="School Chimes"
        style="@style/CustomTextStylePoppinsBold"
        android:maxLines="2"
        android:ellipsize="end" />

    <TextView
        android:id="@+id/notification_body"
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:textColor="@color/black"
        android:textSize="@dimen/fourteen_sp"
        style="@style/CustomTextStylePoppinsMedium"
        android:layout_marginTop="@dimen/eight"
        android:text="This is a new message from your school"
        android:maxLines="3"
        android:ellipsize="end" />


    <ImageView
        android:id="@+id/notification_imageview"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:scaleType="centerCrop"
        android:visibility="gone"
        android:layout_marginTop="@dimen/eight" />

</LinearLayout>
