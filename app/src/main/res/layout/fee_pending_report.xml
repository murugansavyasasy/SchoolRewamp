        <RelativeLayout
            android:id="@+id/relative_layout5"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/toolbarLayout1"
            android:layout_centerInParent="true"
            android:layout_margin="@dimen/fifteen"
            android:layout_marginTop="@dimen/eight">

            <TextView
                android:id="@+id/totalcollectionlabel"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerHorizontal="true"
                android:gravity="center"
                android:text="@string/total_pending"
                android:textColor="@color/grey"
                android:textSize="@dimen/thirteen_sp" />

            <TextView
                android:id="@+id/total_collection"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@id/totalcollectionlabel"
                android:layout_centerHorizontal="true"
                android:layout_marginTop="@dimen/five"
                android:gravity="center"
                android:text="00.00"
                android:textSize="@dimen/thirty_five_sp" />
        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/relative_layout6"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:layout_below="@+id/relative_layout5"
            android:layout_marginStart="@dimen/fifteen"
            android:layout_marginEnd="@dimen/fifteen">

            <TextView
                android:textAlignment="viewStart"
                style="@style/CustomTextStylePoppinsMedium"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_centerVertical="true"
                android:layout_marginStart="5dp"
                android:text="@string/payment_history"
                android:textColor="@color/light_gray" />

            <ImageView
                android:layout_width="@dimen/twenty"
                android:layout_height="@dimen/twenty"
                android:layout_alignParentEnd="true"
                android:layout_centerVertical="true"
                android:layout_marginEnd="@dimen/twele"
                android:src="@drawable/sandclockorange" />


        </RelativeLayout>

        <RelativeLayout
            android:id="@+id/lytList"
            android:layout_width="match_parent"
            android:layout_height="match_parent"
            android:layout_below="@+id/relative_layout6"
            android:layout_marginStart="@dimen/fifteen"
            android:layout_marginEnd="@dimen/fifteen"
            android:layout_marginBottom="@dimen/fifteen"
            android:orientation="vertical">

            <androidx.recyclerview.widget.RecyclerView
                android:id="@+id/totalsummary1"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="@dimen/ten">

            </androidx.recyclerview.widget.RecyclerView>

            <ImageView
                android:id="@+id/nomessage"
                android:layout_width="@dimen/two_fifty"
                android:layout_height="@dimen/two_fifty"
                android:layout_below="@+id/totalsummary1"
                android:layout_centerInParent="true"
                android:layout_gravity="center"
                android:src="@drawable/no_fee_pending_message"
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp"
                android:visibility="gone" />

            <TextView
                android:id="@+id/txtNoData"
                style="@style/CustomTextStylePoppinsBold"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_below="@+id/nomessage"
                android:layout_centerInParent="true"
                android:layout_gravity="center"
                android:layout_marginTop="@dimen/twenty"
                android:gravity="center"
                android:text="@string/no_list_found"
                android:textColor="@color/black"
                android:textSize="@dimen/fifteen_sp"
                android:visibility="gone" />

        </RelativeLayout>


    </RelativeLayout>
